// Left shell column combining activity navigation with the optional assets sidebar.

import { ThemeTokens } from "../theme/tokens.slint";
import { AssetsSidebar, ConsoleAssetItem } from "assets-sidebar.slint";
import { SidebarNavButton } from "../components/sidebar-nav-button.slint";

export struct SidebarNavItem {
    id: string,
    label: string,
    active: bool,
}

export component Sidebar inherits Rectangle {
    in property <[SidebarNavItem]> items;
    in property <bool> show-assets-sidebar: true;
    in property <string> active-sidebar-destination: "console";
    in property <string> assets-search-query: "";
    in property <bool> asset-search-expanded: false;
    in property <bool> asset-create-menu-open: false;
    in property <bool> asset-uses-create-popover: false;
    in property <bool> asset-tree-fully-expanded: false;
    in property <string> asset-view-mode: "tree";
    in property <string> asset-primary-create-action-id: "";
    in property <string> asset-primary-create-tooltip: "";
    in property <string> asset-search-tooltip: "";
    in property <string> asset-view-mode-tooltip: "";
    in property <string> asset-tree-expansion-tooltip: "";
    in property <bool> asset-show-tree-controls: true;
    in property <bool> asset-tree-controls-enabled: true;
    in property <[ConsoleAssetItem]> console-asset-items: [];
    in property <[ConsoleAssetItem]> snippet-asset-items: [];
    private property <string> tooltip-text-value: "";
    private property <bool> tooltip-visible-value: false;
    private property <string> tooltip-source-id-value: "";
    private property <string> tooltip-close-source-id-value: "";
    private property <length> tooltip-anchor-x-value: 0px;
    private property <length> tooltip-anchor-y-value: 0px;
    private property <length> tooltip-anchor-width-value: 0px;
    out property <string> tooltip-text <=> root.tooltip-text-value;
    out property <bool> tooltip-visible <=> root.tooltip-visible-value;
    out property <length> tooltip-anchor-x <=> root.tooltip-anchor-x-value;
    out property <length> tooltip-anchor-y <=> root.tooltip-anchor-y-value;
    out property <length> tooltip-anchor-width <=> root.tooltip-anchor-width-value;
    out property <length> search-row-height: assets-sidebar.search-row-height;
    out property <length> create-menu-anchor-x: assets-sidebar.create-menu-anchor-x;
    out property <length> create-menu-anchor-y: assets-sidebar.create-menu-anchor-y;
    out property <length> create-menu-anchor-width: assets-sidebar.create-menu-anchor-width;
    out property <length> create-menu-anchor-height: assets-sidebar.create-menu-anchor-height;
    out property <length> activity-bar-width: activity-bar.width;
    out property <length> assets-sidebar-width: assets-sidebar.width;
    callback toggle-assets-sidebar-requested();
    callback destination-selected(string);
    callback toggle-assets-search-requested();
    callback assets-search-query-changed(string);
    callback close-assets-search-requested();
    callback collapse-assets-search-requested();
    callback toggle-assets-view-mode-requested();
    callback toggle-assets-tree-expansion-requested();
    callback toggle-assets-create-menu-requested();
    callback close-assets-create-menu-requested();
    callback assets-create-action-selected(string);
    callback asset-selected(string);
    callback asset-activated(string);
    callback toggle-expanded-requested(string);
    callback asset-context-menu-requested(string, string, length, length);
    callback shell-interaction-requested();

    width: 44px + (root.show-assets-sidebar ? 320px : 0px);
    background: transparent;

    function schedule-tooltip(source-id: string, text: string, anchor-x: length, anchor-y: length, anchor-width: length) {
        root.tooltip-anchor-x-value = anchor-x;
        root.tooltip-anchor-y-value = anchor-y;
        root.tooltip-anchor-width-value = anchor-width;

        if root.tooltip-source-id-value == source-id && root.tooltip-text-value == text {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
        } else {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-source-id-value = source-id;
            root.tooltip-text-value = text;
            root.tooltip-visible-value = false;
            tooltip-delay.start();
        }
    }

    function queue-tooltip-close(source-id: string) {
        if root.tooltip-source-id-value == source-id && source-id != "" {
            root.tooltip-close-source-id-value = source-id;
            tooltip-close-delay.start();
        }
    }

    function close-tooltip(source-id: string) {
        if root.tooltip-source-id-value == source-id || source-id == "" {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-visible-value = false;
            root.tooltip-text-value = "";
            root.tooltip-source-id-value = "";
            tooltip-delay.stop();
        }
    }

    HorizontalLayout {
        spacing: 0px;

        activity-bar := Rectangle {
            width: 44px;
            background: ThemeTokens.activity-surface;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;

            VerticalLayout {
                padding-top: 6px;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;

                toggle-button := SidebarNavButton {
                    item-id: "sidebar-toggle";
                    label: "Toggle Sidebar";
                    sidebar-open: root.show-assets-sidebar;
                    tooltip-text: root.show-assets-sidebar ? "Collapse sidebar" : "Expand sidebar";
                    tooltip-source-id: "sidebar-toggle";
                    clicked(clicked-id) => {
                        root.toggle-assets-sidebar-requested();
                    }

                    pointer-activity-requested => {
                        root.shell-interaction-requested();
                    }

                    tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                        root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                    }

                    tooltip-close-requested(source-id) => {
                        root.queue-tooltip-close(source-id);
                    }
                }

                divider-line := Rectangle {
                    width: parent.width - 12px;
                    height: 1px;
                    background: ThemeTokens.divider-subtle;
                }

                for item in root.items : SidebarNavButton {
                    item-id: item.id;
                    label: item.label;
                    active: item.active;
                    sidebar-open: root.show-assets-sidebar;
                    tooltip-text: item.label;
                    tooltip-source-id: item.id;
                    clicked(clicked-id) => {
                        root.destination-selected(clicked-id);
                    }

                    pointer-activity-requested => {
                        root.shell-interaction-requested();
                    }

                    tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                        root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                    }

                    tooltip-close-requested(source-id) => {
                        root.queue-tooltip-close(source-id);
                    }
                }
            }
        }

        assets-sidebar := AssetsSidebar {
            expanded: root.show-assets-sidebar;
            active-panel: root.active-sidebar-destination;
            assets-search-query: root.assets-search-query;
            asset-search-expanded: root.asset-search-expanded;
            asset-create-menu-open: root.asset-create-menu-open;
            asset-uses-create-popover: root.asset-uses-create-popover;
            asset-tree-fully-expanded: root.asset-tree-fully-expanded;
            asset-view-mode: root.asset-view-mode;
            asset-primary-create-action-id: root.asset-primary-create-action-id;
            asset-primary-create-tooltip: root.asset-primary-create-tooltip;
            asset-search-tooltip: root.asset-search-tooltip;
            asset-view-mode-tooltip: root.asset-view-mode-tooltip;
            asset-tree-expansion-tooltip: root.asset-tree-expansion-tooltip;
            asset-show-tree-controls: root.asset-show-tree-controls;
            asset-tree-controls-enabled: root.asset-tree-controls-enabled;
            console-asset-items: root.console-asset-items;
            snippet-asset-items: root.snippet-asset-items;

            toggle-assets-search-requested => {
                root.toggle-assets-search-requested();
            }

            assets-search-query-changed(query) => {
                root.assets-search-query-changed(query);
            }

            close-assets-search-requested => {
                root.close-assets-search-requested();
            }

            collapse-assets-search-requested => {
                root.collapse-assets-search-requested();
            }

            toggle-assets-view-mode-requested => {
                root.toggle-assets-view-mode-requested();
            }

            toggle-assets-tree-expansion-requested => {
                root.toggle-assets-tree-expansion-requested();
            }

            toggle-assets-create-menu-requested => {
                root.toggle-assets-create-menu-requested();
            }

            close-assets-create-menu-requested => {
                root.close-assets-create-menu-requested();
            }

            assets-create-action-selected(action-id) => {
                root.assets-create-action-selected(action-id);
            }

            asset-selected(item-id) => {
                root.asset-selected(item-id);
            }

            asset-activated(item-id) => {
                root.asset-activated(item-id);
            }

            toggle-expanded-requested(item-id) => {
                root.toggle-expanded-requested(item-id);
            }

            asset-context-menu-requested(item-id, item-kind, anchor-x, anchor-y) => {
                root.asset-context-menu-requested(item-id, item-kind, anchor-x, anchor-y);
            }

            shell-interaction-requested => {
                root.shell-interaction-requested();
            }

            tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
            }

            tooltip-close-requested(source-id) => {
                root.queue-tooltip-close(source-id);
            }
        }
    }

    tooltip-delay := Timer {
        interval: 280ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-text-value != "" {
                root.tooltip-visible-value = true;
            }
        }
    }

    tooltip-close-delay := Timer {
        interval: 80ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-close-source-id-value != "" {
                root.close-tooltip(root.tooltip-close-source-id-value);
            }
        }
    }
}
