// Custom frameless titlebar that owns drag affordances, tooltips, and window controls.

import { ThemeTokens } from "../theme/tokens.slint";
import { TitlebarIconButton } from "../components/titlebar-icon-button.slint";
import { TitlebarMenu } from "../components/titlebar-menu.slint";
import { WindowControlButton } from "../components/window-control-button.slint";

export component Titlebar inherits Rectangle {
    in property <bool> dark-mode: true;
    in property <bool> sync-modal-open: false;
    in property <string> sync-feedback-text: "";
    in property <int> sync-feedback-sequence: 0;
    in property <bool> sync-feedback-running: false;
    in property <bool> show-right-panel: false;
    in property <bool> workspace-focus-mode: false;
    in property <bool> transfer-center-open: false;
    in property <int> transfer-queue-total: 0;
    in property <int> transfer-queue-active: 0;
    in property <int> transfer-queue-failed: 0;
    in property <int> transfer-queue-current-session: 0;
    in property <bool> show-global-menu: false;
    in property <bool> is-window-maximized: false;
    in property <bool> is-window-active: true;
    in property <bool> is-window-always-on-top: false;
    in property <bool> active-session-summary-visible: false;
    in property <string> active-session-primary-summary: "";
    in property <string> active-session-display-name: "";
    in property <string> active-session-host: "";
    in property <string> active-session-status-label: "";
    in property <string> active-session-summary-tooltip: "";

    private property <image> navigation-icon: @image-url("../../assets/icons/fluent/navigation-24-regular.svg");
    private property <image> header-logotype: @image-url("../../assets/icons/mica-term-header-logotype.svg");
    private property <image> dark-theme-icon: @image-url("../../assets/icons/fluent/dark-theme-20-regular.svg");
    private property <image> weather-sunny-icon: @image-url("../../assets/icons/fluent/weather-sunny-20-regular.svg");
    private property <image> sync-icon: @image-url("../../assets/icons/fluent/arrow-clockwise-20-regular.svg");
    private property <image> panel-right-icon-regular: @image-url("../../assets/icons/fluent/panel-right-20-regular.svg");
    private property <image> panel-right-icon-filled: @image-url("../../assets/icons/fluent/panel-right-20-filled.svg");
    private property <image> focus-mode-icon-regular: @image-url("../../assets/icons/fluent/arrow-collapse-all-20-regular.svg");
    private property <image> focus-mode-icon-active: @image-url("../../assets/icons/fluent/arrow-expand-all-20-regular.svg");
    private property <image> transfer-icon: @image-url("../../assets/icons/fluent/arrow-upload-20-regular.svg");
    private property <image> pin-icon: @image-url("../../assets/icons/fluent/pin-20-regular.svg");
    private property <image> pin-off-icon: @image-url("../../assets/icons/fluent/pin-off-20-regular.svg");
    private property <image> minimize-icon: @image-url("../../assets/icons/fluent/subtract-20-regular.svg");
    private property <image> maximize-icon: @image-url("../../assets/icons/fluent/maximize-20-regular.svg");
    private property <image> restore-icon: @image-url("../../assets/icons/fluent/restore-20-regular.svg");
    private property <image> close-icon: @image-url("../../assets/icons/fluent/dismiss-20-regular.svg");
    private property <string> tooltip-text-value: "";
    private property <bool> tooltip-visible-value: false;
    private property <bool> sync-feedback-visible-value: false;
    private property <string> tooltip-source-id-value: "";
    private property <string> tooltip-close-source-id-value: "";
    private property <length> tooltip-anchor-x-value: 0px;
    private property <length> tooltip-anchor-y-value: 0px;
    private property <bool> transfer-summary-visible: root.transfer-queue-active > 0
        || root.transfer-queue-failed > 0;
    private property <string> transfer-summary-text: root.transfer-queue-failed > 0
        ? "Transfer issues need attention"
        : "Transfers active";
    private property <string> transfer-summary-tooltip: root.transfer-summary-visible
        ? "Open transfer center"
        : "Open transfer center";
    private property <brush> transfer-summary-surface: root.transfer-queue-failed > 0
        ? ThemeTokens.status-error-surface
        : root.transfer-queue-active > 0
            ? ThemeTokens.status-busy-surface
            : ThemeTokens.status-pill-surface;
    private property <brush> transfer-summary-border: root.transfer-queue-failed > 0
        ? ThemeTokens.status-error-accent
        : root.transfer-queue-active > 0
            ? ThemeTokens.status-busy-accent
            : ThemeTokens.status-pill-border;
    private property <brush> transfer-summary-accent: root.transfer-queue-failed > 0
        ? ThemeTokens.status-error-accent
        : root.transfer-queue-active > 0
            ? ThemeTokens.status-busy-accent
            : ThemeTokens.accent;
    private property <string> active-session-summary-detail: root.active-session-status-label;
    private property <length> active-session-summary-reserved-right-width: root.transfer-summary-visible ? 220px : 24px;
    private property <length> transfer-summary-anchor-width: max(0px, min(196px, drag-zone.width - 12px));
    out property <string> tooltip-text <=> root.tooltip-text-value;
    out property <bool> tooltip-visible <=> root.tooltip-visible-value;
    out property <length> tooltip-anchor-x <=> root.tooltip-anchor-x-value;
    out property <length> tooltip-anchor-y <=> root.tooltip-anchor-y-value;
    out property <length> layout-content-width: content.width;
    out property <length> layout-nav-zone-width: nav-zone.width;
    out property <length> layout-window-controls-width: window-controls.width;
    out property <length> layout-radius: root.border-radius;
    out property <length> layout-border-width: root.border-width;
    out property <length> layout-maximize-button-x: maximize-button.absolute-position.x + 5px;
    out property <length> layout-maximize-button-y: maximize-button.absolute-position.y;
    out property <length> layout-maximize-button-width: 36px;
    out property <length> layout-maximize-button-height: 36px;
    out property <length> layout-transfer-button-anchor-x: root.transfer-summary-visible
        ? drag-zone.absolute-position.x + max(0px, drag-zone.width - root.transfer-summary-anchor-width - 12px) + root.transfer-summary-anchor-width / 2
        : transfer-button.absolute-position.x + transfer-button.width / 2;
    out property <length> layout-transfer-button-anchor-y: root.transfer-summary-visible
        ? drag-zone.absolute-position.y + 38px
        : transfer-button.absolute-position.y + transfer-button.height + 10px;
    out property <bool> sync-feedback-visible <=> root.sync-feedback-visible-value;
    out property <length> sync-feedback-anchor-x: sync-button.absolute-position.x + sync-button.width / 2;
    out property <length> sync-feedback-anchor-y: sync-button.absolute-position.y + sync-button.height + 8px;

    callback drag-requested;
    callback drag-double-clicked;
    callback toggle-theme-mode-requested;
    callback sync-now-requested;
    callback open-sync-modal-requested;
    callback toggle-right-panel-requested;
    callback toggle-workspace-focus-mode-requested;
    callback open-transfer-center-requested;
    callback open-settings-panel-requested;
    callback open-appearance-panel-requested;
    callback toggle-global-menu-requested;
    callback close-global-menu-requested;
    callback toggle-window-always-on-top-requested;
    callback minimize-requested;
    callback maximize-toggle-requested;
    callback close-requested;

    height: 48px;
    background: ThemeTokens.titlebar-background;
    border-radius: 0px;
    border-width: 0px;
    border-color: ThemeTokens.divider-subtle;

    // Slint popups need explicit open/close orchestration so their visibility stays consistent
    // with the Rust-side view-model toggle state.
    changed show-global-menu => {
        close-tooltip("");
        if root.show-global-menu {
            global-menu.show();
        } else {
            global-menu.close();
        }
    }

    changed sync-feedback-sequence => {
        sync-feedback-hide.stop();
        root.sync-feedback-visible-value = false;
        if root.sync-feedback-running {
            root.sync-feedback-visible-value = true;
        } else if root.sync-feedback-text != "" {
            root.sync-feedback-visible-value = true;
            sync-feedback-hide.start();
        }
    }

    changed sync-feedback-running => {
        sync-feedback-hide.stop();
        if root.sync-feedback-running {
            root.sync-feedback-visible-value = true;
        } else if root.sync-feedback-text == "" {
            root.sync-feedback-visible-value = false;
        }
    }

    function schedule-tooltip(source-id: string, text: string, anchor-x: length, anchor-y: length) {
        root.tooltip-anchor-x-value = anchor-x;
        root.tooltip-anchor-y-value = anchor-y;

        // Reopening the same tooltip should feel instant, while switching sources restarts the
        // delay so hover transitions do not flash between neighboring controls.
        if root.tooltip-source-id-value == source-id && root.tooltip-text-value == text {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
        } else {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-source-id-value = source-id;
            root.tooltip-text-value = text;
            root.tooltip-visible-value = false;
            tooltip-delay.start();
        }
    }

    function queue-tooltip-close(source-id: string) {
        if root.tooltip-source-id-value == source-id && source-id != "" {
            root.tooltip-close-source-id-value = source-id;
            tooltip-close-delay.start();
        }
    }

    function close-tooltip(source-id: string) {
        if root.tooltip-source-id-value == source-id || source-id == "" {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-visible-value = false;
            root.tooltip-text-value = "";
            root.tooltip-source-id-value = "";
            tooltip-delay.stop();
        }
    }

    content := HorizontalLayout {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: 36px;
        spacing: 0px;

        nav-zone := Rectangle {
            width: 44px;
            height: parent.height;
            background: transparent;
            opacity: root.is-window-active ? 1 : 0.72;

            nav-button := TitlebarIconButton {
                x: 4px;
                y: 0px;
                icon-source: root.navigation-icon;
                active: root.show-global-menu;
                tooltip-text: "Open menu";
                tooltip-source-id: "nav-button";

                clicked => {
                    root.toggle-global-menu-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }
        }

        brand-zone := Rectangle {
            width: 188px;
            height: parent.height;
            background: transparent;
            opacity: root.is-window-active ? 1 : 0.84;

            brand-logotype := Image {
                x: 0px;
                y: 6px;
                width: 170px;
                height: 24px;
                source: root.header-logotype;
                image-fit: contain;
                colorize: ThemeTokens.text-primary;
            }
        }

        drag-zone := Rectangle {
            background: transparent;
            border-radius: 0px;
            opacity: root.is-window-active ? 1 : 0.72;

            drag-touch := TouchArea {
                width: parent.width;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left
                    {
                        root.drag-requested();
                    }
                }

                double-clicked => {
                    root.drag-double-clicked();
                }
            }

            if root.active-session-summary-visible : active-session-summary-lane := Rectangle {
                x: 12px;
                y: 0px;
                width: max(0px, parent.width - root.active-session-summary-reserved-right-width);
                height: parent.height;
                background: transparent;
                private property <bool> has-hover: active-session-summary-touch.has-hover;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 6px;
                    padding-left: 0px;
                    padding-right: 0px;

                    active-session-name := Text {
                        min-width: 0px;
                        horizontal-stretch: 3;
                        text: root.active-session-primary-summary;
                        color: ThemeTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.active-session-summary-detail != "" : active-session-detail := Text {
                        min-width: 0px;
                        horizontal-stretch: 2;
                        text: root.active-session-summary-detail;
                        color: ThemeTokens.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                active-session-summary-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left
                        {
                            root.drag-requested();
                        }
                    }

                    double-clicked => {
                        root.drag-double-clicked();
                    }
                }

                changed has-hover => {
                    if self.has-hover && root.active-session-summary-tooltip != "" {
                        root.schedule-tooltip(
                            "active-session-summary",
                            root.active-session-summary-tooltip,
                            self.absolute-position.x + self.width / 2,
                            self.absolute-position.y + self.height + 8px,
                        );
                    } else {
                        root.queue-tooltip-close("active-session-summary");
                    }
                }
            }

            if root.transfer-summary-visible : transfer-summary-button := Rectangle {
                x: max(0px, parent.width - self.width - 12px);
                y: 4px;
                width: max(0px, min(196px, parent.width - 12px));
                height: 28px;
                border-radius: 14px;
                border-width: 1px;
                private property <bool> has-hover: transfer-summary-touch.has-hover;
                border-color: transfer-summary-touch.has-hover
                    ? ThemeTokens.divider-strong
                    : root.transfer-summary-border;
                background: transfer-summary-touch.pressed
                    ? ThemeTokens.control-pressed-surface
                    : transfer-summary-touch.has-hover
                        ? ThemeTokens.control-hover-surface
                        : root.transfer-summary-surface;
                clip: true;

                Image {
                    x: 10px;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    source: root.transfer-icon;
                    image-fit: contain;
                    colorize: root.transfer-summary-accent;
                }

                Rectangle {
                    x: 32px;
                    y: 10px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.transfer-summary-accent;
                }

                Text {
                    x: 44px;
                    y: 0px;
                    width: parent.width - 54px;
                    height: parent.height;
                    text: root.transfer-summary-text;
                    color: ThemeTokens.text-primary;
                    vertical-alignment: center;
                    font-size: 11px;
                    font-weight: 700;
                    overflow: elide;
                }

                transfer-summary-touch := TouchArea {
                    clicked => {
                        root.open-transfer-center-requested();
                    }
                }

                changed has-hover => {
                    if self.has-hover {
                        root.schedule-tooltip(
                            "transfer-summary-button",
                            root.transfer-summary-tooltip,
                            self.absolute-position.x + self.width / 2,
                            self.absolute-position.y + self.height + 8px,
                        );
                    } else {
                        root.queue-tooltip-close("transfer-summary-button");
                    }
                }
            }
        }

        utility-zone := Rectangle {
            width: 260px;
            height: parent.height;
            background: transparent;
            opacity: root.is-window-active ? 1 : 0.72;

            theme-button := TitlebarIconButton {
                x: 0px;
                y: 0px;
                icon-source: root.dark-mode ? root.dark-theme-icon : root.weather-sunny-icon;
                tooltip-text: root.dark-mode ? "Switch to light mode" : "Switch to dark mode";
                tooltip-source-id: "theme-button";

                clicked => {
                    root.toggle-theme-mode-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            sync-button := TitlebarIconButton {
                x: 40px;
                y: 0px;
                icon-source: root.sync-icon;
                active: root.sync-feedback-visible || root.sync-feedback-running;
                tooltip-text: "Sync now";
                tooltip-source-id: "sync-button";

                clicked => {
                    root.sync-now-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            panel-toggle-button := TitlebarIconButton {
                x: 80px;
                y: 0px;
                icon-source: root.panel-right-icon-regular;
                active-icon-source: root.panel-right-icon-filled;
                active: root.show-right-panel;
                tooltip-text: "Toggle right panel";
                tooltip-source-id: "panel-toggle-button";

                clicked => {
                    root.toggle-right-panel-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            transfer-button := TitlebarIconButton {
                x: 160px;
                y: 0px;
                icon-source: root.transfer-icon;
                active: root.transfer-center-open;
                tooltip-text: root.transfer-summary-tooltip;
                tooltip-source-id: "transfer-button";

                clicked => {
                    root.open-transfer-center-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            focus-mode-button := TitlebarIconButton {
                x: 120px;
                y: 0px;
                icon-source: root.focus-mode-icon-regular;
                active-icon-source: root.focus-mode-icon-active;
                active: root.workspace-focus-mode;
                tooltip-text: root.workspace-focus-mode ? "Exit focus mode" : "Enter focus mode";
                tooltip-source-id: "focus-mode-button";

                clicked => {
                    root.toggle-workspace-focus-mode-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            divider-line := Rectangle {
                x: 204px;
                y: 8px;
                width: 1px;
                height: 20px;
                border-radius: 0px;
                background: ThemeTokens.divider-subtle;
            }

            pin-button := TitlebarIconButton {
                x: 220px;
                y: 0px;
                icon-source: root.is-window-always-on-top ? root.pin-icon : root.pin-off-icon;
                active: root.is-window-always-on-top;
                tooltip-text: root.is-window-always-on-top ? "Unpin window from top" : "Pin window on top";
                tooltip-source-id: "pin-button";

                clicked => {
                    root.toggle-window-always-on-top-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }
        }

        window-controls := Rectangle {
            width: 138px;
            height: parent.height;
            background: transparent;
            opacity: root.is-window-active ? 1 : 0.72;

            minimize-button := WindowControlButton {
                x: 0px;
                y: 0px;
                icon-source: root.minimize-icon;
                tooltip-text: "Minimize window";
                tooltip-source-id: "minimize-button";

                clicked => {
                    root.minimize-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            maximize-button := WindowControlButton {
                x: 46px;
                y: 0px;
                icon-source: root.is-window-maximized ? root.restore-icon : root.maximize-icon;
                tooltip-text: root.is-window-maximized ? "Restore window" : "Maximize window";
                tooltip-source-id: "maximize-button";

                clicked => {
                    root.maximize-toggle-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            close-button := WindowControlButton {
                x: 92px;
                y: 0px;
                icon-source: root.close-icon;
                danger: true;
                tooltip-text: "Close window";
                tooltip-source-id: "close-button";

                clicked => {
                    root.close-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }
        }
    }

    tooltip-delay := Timer {
        interval: 280ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-text-value != "" {
                root.tooltip-visible-value = true;
            }
        }
    }

    tooltip-close-delay := Timer {
        interval: 80ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-close-source-id-value != "" {
                root.close-tooltip(root.tooltip-close-source-id-value);
            }
        }
    }

    sync-feedback-hide := Timer {
        interval: 1800ms;
        running: false;

        triggered => {
            self.running = false;
            root.sync-feedback-visible-value = false;
        }
    }

    global-menu := TitlebarMenu {
        x: nav-button.absolute-position.x;
        y: nav-button.absolute-position.y + nav-button.height + 6px;

        close-requested => {
            root.close-global-menu-requested();
        }

        settings-selected => {
            root.open-settings-panel-requested();
        }

        sync-settings-selected => {
            root.open-sync-modal-requested();
        }
    }

}
