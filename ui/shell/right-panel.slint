// Optional right-side utility panel that collapses out of layout when hidden.

import { ListView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

export struct SftpPanelItem {
    id: string,
    name: string,
    type_label: string,
    modified_label: string,
    size_label: string,
    kind: string,
    selected: bool,
}

component SftpToolbarButton inherits Rectangle {
    in property <image> icon-source;
    in property <bool> enabled: true;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 6px;
    border-width: 0px;
    border-color: transparent;
    background: !root.enabled ? ThemeTokens.control-disabled-surface
        : touch.pressed ? ThemeTokens.control-pressed-surface
        : touch.has-hover ? ThemeTokens.control-hover-surface
        : transparent;
    opacity: root.enabled ? 1.0 : 0.42;

    if (root.icon-source.width > 0 && root.icon-source.height > 0) : Image {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        source <=> root.icon-source;
        image-fit: contain;
        colorize: ThemeTokens.text-primary;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;

        clicked => {
            root.clicked();
        }
    }
}

component SftpHeaderCell inherits Rectangle {
    in property <string> label;
    in property <string> column-id;
    in property <string> active-sort-column: "default";
    in property <string> active-sort-direction: "none";
    in property <bool> right-aligned: false;
    callback sort-requested(string);

    background: header-touch.has-hover ? ThemeTokens.control-hover-surface : transparent;

    label-text := Text {
        x: 0px;
        y: 0px;
        width: parent.width - (sort-indicator.visible ? 14px : 0px);
        height: parent.height;
        text: root.label;
        font-family: AppTypography.ui-font-family;
        color: ThemeTokens.text-secondary;
        font-size: AppTypography.ui-font-size-caption;
        font-weight: AppTypography.ui-font-weight-medium;
        horizontal-alignment: root.right-aligned ? right : left;
        vertical-alignment: center;
        overflow: elide;
    }

    sort-indicator := Text {
        x: parent.width - self.width;
        y: 0px;
        width: 12px;
        height: parent.height;
        visible: root.active-sort-column == root.column-id;
        text: root.active-sort-direction == "desc" ? "↓" : "↑";
        font-family: AppTypography.ui-font-family;
        color: ThemeTokens.text-primary;
        font-size: AppTypography.ui-font-size-caption;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    header-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.sort-requested(root.column-id);
        }
    }
}

component SftpColumnResizeHandle inherits Rectangle {
    in property <string> column-id;
    in property <length> column-origin-x: 0px;
    in property <length> min-column-width: 0px;
    callback width-change-requested(string, length);
    private property <bool> drag-active: false;

    width: 8px;
    background: transparent;

    if drag-active || resize-touch.has-hover : resize-handle := Rectangle {
        x: parent.width / 2;
        y: 6px;
        width: 1px;
        height: parent.height - 12px;
        background: ThemeTokens.divider-strong;
    }

    resize-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag-active = true;
                root.width-change-requested(
                    root.column-id,
                    max(
                        root.min-column-width,
                        self.absolute-position.x + self.mouse-x - root.column-origin-x,
                    ),
                );
            } else if event.kind == PointerEventKind.move && root.drag-active {
                root.width-change-requested(
                    root.column-id,
                    max(
                        root.min-column-width,
                        self.absolute-position.x + self.mouse-x - root.column-origin-x,
                    ),
                );
            } else if event.kind == PointerEventKind.up {
                root.drag-active = false;
            }
        }
    }
}

export component RightPanel inherits Rectangle {
    in property <bool> expanded: false;
    in property <string> view: "sftp";
    in property <string> sftp-panel-mode: "empty";
    in property <string> sftp-panel-host-label: "";
    in property <string> sftp-panel-path: "";
    in property <string> sftp-panel-follow-mode: "follow-cwd";
    in property <bool> sftp-panel-can-go-back: false;
    in property <bool> sftp-panel-can-go-forward: false;
    in property <bool> sftp-panel-can-go-up: false;
    in property <bool> sftp-panel-actions-enabled: false;
    in property <string> sftp-panel-sort-column: "default";
    in property <string> sftp-panel-sort-direction: "none";
    in property <length> sftp-panel-name-column-width: 226px;
    in property <length> sftp-panel-type-column-width: 78px;
    in property <length> sftp-panel-modified-column-width: 150px;
    in property <length> sftp-panel-size-column-width: 72px;
    in property <[SftpPanelItem]> sftp-panel-items: [];
    in property <[string]> sftp-panel-selected-entry-ids: [];
    in property <int> sftp-panel-queue-active: 0;
    in property <int> sftp-panel-queue-failed: 0;
    in property <int> sftp-panel-queue-current-session: 0;
    in property <bool> sftp-queue-drawer-open: false;
    out property <length> layout-radius: root.border-radius;
    out property <length> layout-border-width: root.border-width;
    in-out property <length> sftp-list-viewport-x: 0px;
    private property <image> arrow-hook-up-left-icon: @image-url("../../assets/icons/fluent/arrow-hook-up-left-20-regular.svg");
    private property <image> arrow-clockwise-icon: @image-url("../../assets/icons/fluent/arrow-clockwise-20-regular.svg");
    private property <image> add-square-multiple-icon: @image-url("../../assets/icons/fluent/add-square-multiple-20-regular.svg");
    private property <image> folder-icon: @image-url("../../assets/icons/fluent/folder-20-regular.svg");
    private property <image> document-icon: @image-url("../../assets/icons/fluent/document-20-regular.svg");
    callback sftp-panel-back-requested();
    callback sftp-panel-forward-requested();
    callback sftp-panel-refresh-requested();
    callback sftp-panel-up-requested();
    callback sftp-panel-path-submitted(string);
    callback sftp-panel-sort-requested(string);
    callback sftp-panel-column-width-change-requested(string, length);
    callback sftp-panel-item-selected(string);
    callback sftp-panel-item-activated(string, string);
    callback sftp-panel-context-menu-requested(string, string, length, length);
    callback sftp-panel-upload-requested();
    callback sftp-panel-new-folder-requested();
    callback sftp-panel-open-queue-requested();
    callback sftp-panel-retry-requested();
    callback sftp-panel-reenable-follow-requested();
    private property <length> sftp-status-row-height:
        root.sftp-panel-mode == "connecting"
        || root.sftp-panel-mode == "loading"
        || root.sftp-panel-mode == "disconnected"
        || root.sftp-panel-mode == "error"
            ? 60px
            : 0px;
    private property <length> sftp-table-header-height: 28px;
    private property <length> sftp-table-row-height: 30px;
    private property <length> sftp-name-column-x: 14px;
    private property <length> sftp-type-column-x: root.sftp-name-column-x + root.sftp-panel-name-column-width + 12px;
    private property <length> sftp-modified-column-x: root.sftp-type-column-x + root.sftp-panel-type-column-width + 10px;
    private property <length> sftp-size-column-x: root.sftp-modified-column-x + root.sftp-panel-modified-column-width + 10px;
    private property <length> sftp-table-content-width: root.sftp-size-column-x + root.sftp-panel-size-column-width + 12px;

    function sftp-empty-headline() -> string {
        return "Open an SSH session";
    }

    function sftp-empty-copy() -> string {
        return "The SFTP browser follows the active SSH tab and projects the current remote path into a compact file table.";
    }

    function sftp-status-headline() -> string {
        if (root.sftp-panel-mode == "connecting") {
            return "Connecting SFTP channel";
        }
        if (root.sftp-panel-mode == "loading") {
            return "Refreshing remote directory";
        }
        if (root.sftp-panel-mode == "disconnected") {
            return "Session disconnected";
        }
        if (root.sftp-panel-mode == "error") {
            return "SFTP action failed";
        }

        return "";
    }

    function sftp-status-copy() -> string {
        if (root.sftp-panel-mode == "connecting") {
            return "Opening the browser for the active SSH session.";
        }
        if (root.sftp-panel-mode == "loading") {
            return "Reading the latest remote path and keeping the current table context.";
        }
        if (root.sftp-panel-mode == "disconnected") {
            return "Reconnect the SSH session or retry to restore remote browsing.";
        }
        if (root.sftp-panel-mode == "error") {
            return "The last path is preserved. Retry the request or resume follow mode after recovery.";
        }

        return "";
    }

    width: root.expanded ? 392px : 0px;
    visible: root.expanded;
    clip: true;
    background: ThemeTokens.inspector-surface;
    border-radius: 0px;
    border-width: 0px;
    border-color: transparent;

    left-divider := Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: ThemeTokens.divider-strong;
    }

    sftp-panel := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        toolbar-row := Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: 30px;
            border-radius: 0px;
            border-width: 0px;
            border-color: transparent;
            background: transparent;

            back-button := SftpToolbarButton {
                x: 0px;
                y: 1px;
                width: 28px;
                height: 28px;
                icon-source: root.arrow-hook-up-left-icon;
                enabled: root.sftp-panel-can-go-back;

                clicked => {
                    root.sftp-panel-back-requested();
                }
            }

            overflow-button := SftpToolbarButton {
                x: parent.width - self.width;
                y: 1px;
                width: 28px;
                height: 28px;
                icon-source: root.add-square-multiple-icon;
                enabled: root.sftp-panel-actions-enabled;

                clicked => {
                    root.sftp-panel-context-menu-requested(
                        "",
                        "sftp-blank",
                        self.absolute-position.x + self.width / 2,
                        self.absolute-position.y + self.height,
                    );
                }
            }

            refresh-button := SftpToolbarButton {
                x: overflow-button.x - self.width - 2px;
                y: 1px;
                width: 28px;
                height: 28px;
                icon-source: root.arrow-clockwise-icon;
                enabled: root.sftp-panel-actions-enabled;

                clicked => {
                    root.sftp-panel-refresh-requested();
                }
            }

            path-bar := Rectangle {
                x: back-button.x + back-button.width + 4px;
                y: 0px;
                width: refresh-button.x - self.x - 4px;
                height: parent.height;
                border-radius: 6px;
                border-width: 1px;
                border-color: ThemeTokens.input-border;
                background: ThemeTokens.input-surface;

                path-input := TextInput {
                    x: 10px;
                    y: 0px;
                    width: parent.width - 20px;
                    height: parent.height;
                    single-line: true;
                    font-family: AppTypography.ui-font-family;
                    font-size: AppTypography.ui-font-size-caption;
                    font-weight: AppTypography.ui-font-weight-regular;
                    vertical-alignment: center;
                    text: root.sftp-panel-path;
                    enabled: root.sftp-panel-actions-enabled;
                    color: ThemeTokens.text-primary;
                    selection-background-color: ThemeTokens.accent;
                    selection-foreground-color: ThemeTokens.text-primary;

                    key-pressed(event) => {
                        if (event.text == Key.Return) {
                            root.sftp-panel-path-submitted(self.text);
                            accept
                        } else if (event.text == Key.Escape) {
                            root.sftp-panel-reenable-follow-requested();
                            accept
                        } else {
                            reject
                        }
                    }
                }
            }
        }

        table-card := Rectangle {
            x: 8px;
            y: 46px;
            width: parent.width - 8px;
            height: max(0px, parent.height - 54px);
            border-radius: 0px;
            border-width: 0px;
            border-color: transparent;
            background: ThemeTokens.workspace-surface;
            clip: true;

            table-header := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.sftp-table-header-height;
                background: ThemeTokens.workspace-surface;
                clip: true;

                header-content := Rectangle {
                    x: root.sftp-list-viewport-x;
                    y: 0px;
                    width: max(parent.width, root.sftp-table-content-width);
                    height: parent.height;
                    background: transparent;

                    Rectangle {
                        x: 0px;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: ThemeTokens.divider-subtle;
                    }

                    SftpHeaderCell {
                        x: root.sftp-name-column-x;
                        y: 0px;
                        width: root.sftp-panel-name-column-width;
                        height: parent.height;
                        label: "Name";
                        column-id: "name";
                        active-sort-column: root.sftp-panel-sort-column;
                        active-sort-direction: root.sftp-panel-sort-direction;

                        sort-requested(column-id) => {
                            root.sftp-panel-sort-requested(column-id);
                        }
                    }

                    SftpHeaderCell {
                        x: root.sftp-type-column-x;
                        y: 0px;
                        width: root.sftp-panel-type-column-width;
                        height: parent.height;
                        label: "Type";
                        column-id: "type";
                        active-sort-column: root.sftp-panel-sort-column;
                        active-sort-direction: root.sftp-panel-sort-direction;

                        sort-requested(column-id) => {
                            root.sftp-panel-sort-requested(column-id);
                        }
                    }

                    SftpHeaderCell {
                        x: root.sftp-modified-column-x;
                        y: 0px;
                        width: root.sftp-panel-modified-column-width;
                        height: parent.height;
                        label: "Modified";
                        column-id: "modified";
                        active-sort-column: root.sftp-panel-sort-column;
                        active-sort-direction: root.sftp-panel-sort-direction;

                        sort-requested(column-id) => {
                            root.sftp-panel-sort-requested(column-id);
                        }
                    }

                    SftpHeaderCell {
                        x: root.sftp-size-column-x;
                        y: 0px;
                        width: root.sftp-panel-size-column-width;
                        height: parent.height;
                        label: "Size";
                        column-id: "size";
                        active-sort-column: root.sftp-panel-sort-column;
                        active-sort-direction: root.sftp-panel-sort-direction;
                        right-aligned: true;

                        sort-requested(column-id) => {
                            root.sftp-panel-sort-requested(column-id);
                        }
                    }

                    SftpColumnResizeHandle {
                        x: root.sftp-type-column-x - self.width / 2;
                        y: 0px;
                        height: parent.height;
                        column-id: "name";
                        column-origin-x: header-content.absolute-position.x + root.sftp-name-column-x;
                        min-column-width: 120px;

                        width-change-requested(column-id, width) => {
                            root.sftp-panel-column-width-change-requested(column-id, width);
                        }
                    }

                    SftpColumnResizeHandle {
                        x: root.sftp-modified-column-x - self.width / 2;
                        y: 0px;
                        height: parent.height;
                        column-id: "type";
                        column-origin-x: header-content.absolute-position.x + root.sftp-type-column-x;
                        min-column-width: 72px;

                        width-change-requested(column-id, width) => {
                            root.sftp-panel-column-width-change-requested(column-id, width);
                        }
                    }

                    SftpColumnResizeHandle {
                        x: root.sftp-size-column-x - self.width / 2;
                        y: 0px;
                        height: parent.height;
                        column-id: "modified";
                        column-origin-x: header-content.absolute-position.x + root.sftp-modified-column-x;
                        min-column-width: 132px;

                        width-change-requested(column-id, width) => {
                            root.sftp-panel-column-width-change-requested(column-id, width);
                        }
                    }

                    SftpColumnResizeHandle {
                        x: root.sftp-size-column-x + root.sftp-panel-size-column-width - self.width / 2;
                        y: 0px;
                        height: parent.height;
                        column-id: "size";
                        column-origin-x: header-content.absolute-position.x + root.sftp-size-column-x;
                        min-column-width: 72px;

                        width-change-requested(column-id, width) => {
                            root.sftp-panel-column-width-change-requested(column-id, width);
                        }
                    }
                }
            }

            if root.sftp-panel-mode == "empty" : empty-state := Rectangle {
                x: 0px;
                y: root.sftp-table-header-height;
                width: parent.width;
                height: parent.height - root.sftp-table-header-height;
                background: transparent;

                empty-state-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.sftp-panel-context-menu-requested(
                                "",
                                "sftp-blank",
                                self.mouse-x + self.absolute-position.x,
                                self.mouse-y + self.absolute-position.y,
                            );
                        }
                    }
                }

                Rectangle {
                    x: 16px;
                    y: 18px;
                    width: 52px;
                    height: 4px;
                    background: ThemeTokens.accent;
                }

                Text {
                    x: 16px;
                    y: 34px;
                    width: parent.width - 32px;
                    text: root.sftp-empty-headline();
                    color: ThemeTokens.text-primary;
                    font-size: 24px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                empty-copy-shell := Rectangle {
                    x: 16px;
                    y: 96px;
                    width: parent.width - 32px;
                    height: min(128px, parent.height - 116px);
                    border-radius: 0px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-subtle;
                    background: ThemeTokens.control-hover-surface;

                    Text {
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        text: root.sftp-empty-copy();
                        color: ThemeTokens.text-primary;
                        wrap: word-wrap;
                    }
                }

            }

            if root.sftp-status-row-height > 0px : status-row := Rectangle {
                x: 0px;
                y: root.sftp-table-header-height;
                width: parent.width;
                height: root.sftp-status-row-height;
                background: ThemeTokens.control-hover-surface;

                Rectangle {
                    x: 16px;
                    y: 12px;
                    width: 4px;
                    height: parent.height - 24px;
                    border-radius: 2px;
                    background: root.sftp-panel-mode == "error" || root.sftp-panel-mode == "disconnected"
                        ? ThemeTokens.accent
                        : ThemeTokens.divider-strong;
                }

                Text {
                    x: 30px;
                    y: 10px;
                    width: parent.width - 140px;
                    text: root.sftp-status-headline();
                    color: ThemeTokens.text-primary;
                    font-size: 12px;
                    font-weight: 700;
                    overflow: elide;
                }

                Text {
                    x: 30px;
                    y: 28px;
                    width: parent.width - 140px;
                    text: root.sftp-status-copy();
                    color: ThemeTokens.text-secondary;
                    font-size: 12px;
                    overflow: elide;
                }

                if root.sftp-panel-mode == "disconnected" || root.sftp-panel-mode == "error" : retry-button := Rectangle {
                    x: parent.width - 88px;
                    y: 14px;
                    width: 72px;
                    height: 28px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-subtle;
                    background: ThemeTokens.control-active-surface;

                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: "Retry";
                        color: ThemeTokens.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    TouchArea {
                        width: parent.width;
                        height: parent.height;

                        clicked => {
                            root.sftp-panel-retry-requested();
                        }
                    }
                }
            }

            if root.sftp-panel-mode != "empty" : list-host := ListView {
                x: 0px;
                y: root.sftp-table-header-height + root.sftp-status-row-height;
                width: parent.width;
                height: parent.height - root.sftp-table-header-height - root.sftp-status-row-height;
                viewport-x <=> root.sftp-list-viewport-x;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                viewport-width: max(self.visible-width, root.sftp-table-content-width);

                for item in root.sftp-panel-items : Rectangle {
                    width: list-host.viewport-width;
                    height: root.sftp-table-row-height;
                    background: item.selected ? ThemeTokens.explorer-row-selected-surface
                        : row-touch.has-hover ? ThemeTokens.explorer-row-hover-surface
                        : transparent;

                    Rectangle {
                        x: 12px;
                        y: parent.height - 1px;
                        width: parent.width - 24px;
                        height: 1px;
                        background: ThemeTokens.divider-subtle;
                    }

                    Image {
                        x: root.sftp-name-column-x;
                        y: 6px;
                        width: 16px;
                        height: 16px;
                        source: item.kind == "directory" ? root.folder-icon : root.document-icon;
                        image-fit: contain;
                        colorize: ThemeTokens.text-primary;
                    }

                    Text {
                        x: root.sftp-name-column-x + 24px;
                        y: 0px;
                        width: root.sftp-panel-name-column-width - 28px;
                        height: parent.height;
                        text: item.name;
                        color: ThemeTokens.text-primary;
                        font-size: 12px;
                        font-weight: item.selected ? 700 : 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        x: root.sftp-type-column-x;
                        y: 0px;
                        width: root.sftp-panel-type-column-width;
                        height: parent.height;
                        text: item.type_label;
                        color: ThemeTokens.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        x: root.sftp-modified-column-x;
                        y: 0px;
                        width: root.sftp-panel-modified-column-width;
                        height: parent.height;
                        text: item.modified_label;
                        color: ThemeTokens.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        x: root.sftp-size-column-x;
                        y: 0px;
                        width: root.sftp-panel-size-column-width;
                        height: parent.height;
                        text: item.size_label;
                        color: ThemeTokens.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;

                        clicked => {
                            root.sftp-panel-item-selected(item.id);
                        }

                        double-clicked => {
                            root.sftp-panel-item-activated(item.id, item.kind);
                        }

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                root.sftp-panel-context-menu-requested(
                                    item.id,
                                    item.kind == "directory" ? "sftp-directory" : "sftp-file",
                                    self.mouse-x + self.absolute-position.x,
                                    self.mouse-y + self.absolute-position.y,
                                );
                            }
                        }
                    }
                }
            }
        }
    }
}
