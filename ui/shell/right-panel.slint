// Optional right-side utility panel that collapses out of layout when hidden.

import { ListView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export struct SftpPanelItem {
    id: string,
    name: string,
    detail: string,
    kind: string,
    selected: bool,
}

component SftpToolbarButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    callback clicked();

    width: 52px;
    height: 28px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-subtle;
    background: !root.enabled ? ThemeTokens.control-disabled-surface
        : touch.pressed ? ThemeTokens.control-pressed-surface
        : touch.has-hover ? ThemeTokens.control-hover-surface
        : ThemeTokens.control-active-surface;
    opacity: root.enabled ? 1.0 : 0.48;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;

        clicked => {
            root.clicked();
        }
    }
}

component SftpQueueChip inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";

    width: 108px;
    height: 30px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-subtle;
    background: ThemeTokens.control-active-surface;

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label + " · " + root.value;
        color: ThemeTokens.text-primary;
        vertical-alignment: center;
        font-size: 12px;
    }
}

export component RightPanel inherits Rectangle {
    in property <bool> expanded: false;
    in property <string> view: "sftp";
    in property <string> sftp-panel-mode: "empty";
    in property <string> sftp-panel-host-label: "";
    in property <string> sftp-panel-path: "";
    in property <string> sftp-panel-follow-mode: "follow-cwd";
    in property <bool> sftp-panel-can-go-back: false;
    in property <bool> sftp-panel-can-go-forward: false;
    in property <bool> sftp-panel-can-go-up: false;
    in property <bool> sftp-panel-actions-enabled: false;
    in property <[SftpPanelItem]> sftp-panel-items: [];
    in property <[string]> sftp-panel-selected-entry-ids: [];
    in property <int> sftp-panel-queue-active: 0;
    in property <int> sftp-panel-queue-failed: 0;
    in property <int> sftp-panel-queue-current-session: 0;
    in property <bool> sftp-queue-drawer-open: false;
    out property <length> layout-radius: root.border-radius;
    out property <length> layout-border-width: root.border-width;
    callback sftp-panel-back-requested();
    callback sftp-panel-forward-requested();
    callback sftp-panel-refresh-requested();
    callback sftp-panel-up-requested();
    callback sftp-panel-path-submitted(string);
    callback sftp-panel-context-menu-requested(string, string, length, length);
    callback sftp-panel-upload-requested();
    callback sftp-panel-new-folder-requested();
    callback sftp-panel-open-queue-requested();
    callback sftp-panel-retry-requested();
    callback sftp-panel-reenable-follow-requested();

    function sftp-session-title() -> string {
        return root.sftp-panel-host-label != "" ? root.sftp-panel-host-label : "No active SSH session";
    }

    function sftp-session-status() -> string {
        if (root.sftp-panel-mode == "ready") {
            return root.sftp-panel-follow-mode == "manual-browse"
                ? "Manual browse"
                : "Following terminal working directory";
        }
        if (root.sftp-panel-mode == "loading") {
            return "Loading remote directory listing";
        }
        if (root.sftp-panel-mode == "connecting") {
            return "Connecting SFTP channel";
        }
        if (root.sftp-panel-mode == "disconnected") {
            return "Connection lost. Retry to restore browsing.";
        }
        if (root.sftp-panel-mode == "error") {
            return "SFTP request failed. Retry or re-follow the shell path.";
        }

        return "Pick an SSH session to browse the remote file system.";
    }

    function sftp-empty-headline() -> string {
        if (root.sftp-panel-mode == "disconnected") {
            return "Session disconnected";
        }
        if (root.sftp-panel-mode == "error") {
            return "SFTP action failed";
        }

        return "Open an SSH session";
    }

    function sftp-empty-copy() -> string {
        if (root.sftp-panel-mode == "disconnected") {
            return "Reconnect the current SSH session, then retry the SFTP browser to resume listing, upload, and queue controls.";
        }
        if (root.sftp-panel-mode == "error") {
            return "The panel keeps the last navigation context. Retry the request or switch back to follow-cwd to recover.";
        }

        return "The SFTP panel follows the active SSH tab. Open a session and it will project the current remote path, toolbar, and transfer summary here.";
    }

    function sftp-item-kind-label(kind: string) -> string {
        if (kind == "directory") {
            return "DIR";
        }
        if (kind == "symlink") {
            return "LINK";
        }
        if (kind == "file") {
            return "FILE";
        }

        return "ITEM";
    }

    width: root.expanded ? 392px : 0px;
    visible: root.expanded;
    clip: true;
    background: ThemeTokens.inspector-surface;
    border-radius: 0px;
    border-width: 0px;
    border-color: transparent;

    left-divider := Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: ThemeTokens.divider-strong;
    }

    sftp-panel := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        session-strip := Rectangle {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: 52px;
            border-radius: 0px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.control-active-surface;

            Text {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                text: root.sftp-session-title();
                color: ThemeTokens.text-primary;
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                x: 12px;
                y: 28px;
                width: parent.width - 24px;
                text: root.sftp-session-status();
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                font-size: 12px;
                overflow: elide;
            }
        }

        toolbar-card := Rectangle {
            x: 16px;
            y: 76px;
            width: parent.width - 32px;
            height: 80px;
            border-radius: 0px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.control-hover-surface;

            back-button := SftpToolbarButton {
                x: 12px;
                y: 10px;
                label: "Back";
                enabled: root.sftp-panel-can-go-back;

                clicked => {
                    root.sftp-panel-back-requested();
                }
            }

            forward-button := SftpToolbarButton {
                x: back-button.x + back-button.width + 8px;
                y: 10px;
                label: "Next";
                enabled: root.sftp-panel-can-go-forward;

                clicked => {
                    root.sftp-panel-forward-requested();
                }
            }

            up-button := SftpToolbarButton {
                x: forward-button.x + forward-button.width + 8px;
                y: 10px;
                label: "Up";
                enabled: root.sftp-panel-can-go-up;

                clicked => {
                    root.sftp-panel-up-requested();
                }
            }

            refresh-button := SftpToolbarButton {
                x: up-button.x + up-button.width + 8px;
                y: 10px;
                label: "Sync";
                enabled: root.sftp-panel-actions-enabled;

                clicked => {
                    root.sftp-panel-refresh-requested();
                }
            }

            follow-button := SftpToolbarButton {
                x: parent.width - self.width - 12px;
                y: 10px;
                width: 84px;
                label: root.sftp-panel-follow-mode == "manual-browse" ? "Re-follow" : "Follow";
                enabled: root.sftp-panel-follow-mode == "manual-browse";

                clicked => {
                    root.sftp-panel-reenable-follow-requested();
                }
            }

            path-frame := Rectangle {
                x: 12px;
                y: 44px;
                width: parent.width - 24px;
                height: 26px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.inspector-surface;

                path-input := TextInput {
                    x: 10px;
                    y: 2px;
                    width: parent.width - 20px;
                    height: parent.height - 4px;
                    text: root.sftp-panel-path;
                    enabled: root.sftp-panel-actions-enabled;
                    color: ThemeTokens.text-primary;
                    selection-background-color: ThemeTokens.accent;
                    selection-foreground-color: ThemeTokens.text-primary;

                    key-pressed(event) => {
                        if (event.text == Key.Return) {
                            root.sftp-panel-path-submitted(self.text);
                            accept
                        } else if (event.text == Key.Escape) {
                            root.sftp-panel-reenable-follow-requested();
                            accept
                        } else {
                            reject
                        }
                    }
                }
            }
        }

        list-card := Rectangle {
            x: 16px;
            y: 168px;
            width: parent.width - 32px;
            height: max(0px, parent.height - 252px);
            border-radius: 0px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.workspace-surface;
            clip: true;

            list-header := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 36px;
                background: ThemeTokens.control-hover-surface;

                Text {
                    x: 12px;
                    y: 9px;
                    text: "Remote items";
                    color: ThemeTokens.text-primary;
                    font-size: 13px;
                    font-weight: 700;
                }

                Text {
                    x: parent.width - 128px;
                    y: 9px;
                    width: 116px;
                    text: root.sftp-panel-items.length + " rows";
                    color: ThemeTokens.text-primary;
                    opacity: 0.62;
                    font-size: 12px;
                    horizontal-alignment: right;
                }
            }

            if root.sftp-panel-mode == "empty" || root.sftp-panel-mode == "disconnected" || root.sftp-panel-mode == "error" : empty-state := Rectangle {
                x: 0px;
                y: 36px;
                width: parent.width;
                height: parent.height - 36px;
                background: transparent;

                empty-state-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.sftp-panel-context-menu-requested(
                                "",
                                "sftp-blank",
                                self.mouse-x + self.absolute-position.x,
                                self.mouse-y + self.absolute-position.y,
                            );
                        }
                    }
                }

                Rectangle {
                    x: 16px;
                    y: 20px;
                    width: 52px;
                    height: 4px;
                    background: ThemeTokens.accent;
                }

                Text {
                    x: 16px;
                    y: 38px;
                    width: parent.width - 32px;
                    text: root.sftp-empty-headline();
                    color: ThemeTokens.text-primary;
                    font-size: 24px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                copy-card := Rectangle {
                    x: 16px;
                    y: 102px;
                    width: parent.width - 32px;
                    height: min(124px, parent.height - 118px);
                    border-radius: 0px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-subtle;
                    background: ThemeTokens.control-hover-surface;

                    Text {
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        text: root.sftp-empty-copy();
                        color: ThemeTokens.text-primary;
                        wrap: word-wrap;
                    }
                }

                if root.sftp-panel-mode == "disconnected" || root.sftp-panel-mode == "error" : retry-button := SftpToolbarButton {
                    x: 16px;
                    y: copy-card.y + copy-card.height + 16px;
                    width: 86px;
                    label: "Retry";
                    enabled: true;

                    clicked => {
                        root.sftp-panel-retry-requested();
                    }
                }
            }

            if root.sftp-panel-mode != "empty" && root.sftp-panel-mode != "disconnected" && root.sftp-panel-mode != "error" : list-host := ListView {
                x: 0px;
                y: 36px;
                width: parent.width;
                height: parent.height - 36px;

                for item in root.sftp-panel-items : Rectangle {
                    width: list-host.width;
                    height: 44px;
                    background: item.selected ? ThemeTokens.explorer-row-selected-surface
                        : row-touch.has-hover ? ThemeTokens.explorer-row-hover-surface
                        : transparent;

                    Rectangle {
                        x: 12px;
                        y: parent.height - 1px;
                        width: parent.width - 24px;
                        height: 1px;
                        background: ThemeTokens.divider-subtle;
                    }

                    Text {
                        x: 12px;
                        y: 7px;
                        width: parent.width - 120px;
                        text: item.name;
                        color: ThemeTokens.text-primary;
                        font-size: 13px;
                        font-weight: item.selected ? 700 : 500;
                        overflow: elide;
                    }

                    Text {
                        x: 12px;
                        y: 24px;
                        width: parent.width - 140px;
                        text: item.detail;
                        color: ThemeTokens.text-primary;
                        opacity: 0.62;
                        font-size: 11px;
                        overflow: elide;
                    }

                    kind-pill := Rectangle {
                        x: parent.width - 72px;
                        y: 10px;
                        width: 56px;
                        height: 22px;
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-subtle;
                        background: ThemeTokens.control-active-surface;

                        Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: root.sftp-item-kind-label(item.kind);
                            color: ThemeTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }

                    row-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                root.sftp-panel-context-menu-requested(
                                    item.id,
                                    item.kind == "directory" ? "sftp-directory" : "sftp-file",
                                    self.mouse-x + self.absolute-position.x,
                                    self.mouse-y + self.absolute-position.y,
                                );
                            }
                        }
                    }
                }
            }
        }

        queue-strip := Rectangle {
            x: 16px;
            y: parent.height - 84px;
            width: parent.width - 32px;
            height: 72px;
            border-radius: 0px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.status-busy-surface;

            Text {
                x: 12px;
                y: 10px;
                text: "Transfer queue";
                color: ThemeTokens.text-primary;
                font-size: 13px;
                font-weight: 700;
            }

            open-queue-button := SftpToolbarButton {
                x: parent.width - self.width - 12px;
                y: 8px;
                width: 78px;
                label: "Queue";
                enabled: true;

                clicked => {
                    root.sftp-panel-open-queue-requested();
                }
            }

            active-chip := SftpQueueChip {
                x: 12px;
                y: 34px;
                label: "Active";
                value: "" + root.sftp-panel-queue-active;
            }

            failed-chip := SftpQueueChip {
                x: active-chip.x + active-chip.width + 8px;
                y: 34px;
                label: "Failed";
                value: "" + root.sftp-panel-queue-failed;
            }

            session-chip := SftpQueueChip {
                x: failed-chip.x + failed-chip.width + 8px;
                y: 34px;
                width: 124px;
                label: "This session";
                value: "" + root.sftp-panel-queue-current-session;
            }
        }

        if root.sftp-queue-drawer-open : queue-drawer := Rectangle {
            x: 16px;
            y: parent.height - 268px;
            width: parent.width - 32px;
            height: 172px;
            border-radius: 0px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.workspace-surface;

            Text {
                x: 12px;
                y: 10px;
                text: "Queue drawer";
                color: ThemeTokens.text-primary;
                font-size: 14px;
                font-weight: 700;
            }

            Text {
                x: 12px;
                y: 38px;
                width: parent.width - 24px;
                text: "Transfer details land in the next task. This drawer already tracks the shared queue summary state and reserves the final layout slot.";
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                wrap: word-wrap;
            }
        }
    }
}
