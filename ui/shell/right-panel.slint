// Optional right-side utility panel that collapses out of layout when hidden.

import { ScrollView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";
import { SidebarToolbarIconButton } from "../components/sidebar-toolbar-icon-button.slint";

export struct SftpPanelItem {
    id: string,
    name: string,
    meta_label: string,
    type_label: string,
    modified_label: string,
    size_label: string,
    kind: string,
    selected: bool,
}

export component RightPanel inherits Rectangle {
    in property <bool> expanded: false;
    in property <length> expanded-width: 392px;
    in property <string> view: "sftp";
    in property <string> sftp-panel-mode: "empty";
    in property <string> sftp-panel-host-label: "";
    in property <string> sftp-panel-path: "";
    in property <string> sftp-panel-follow-mode: "follow-cwd";
    in property <string> sftp-panel-connection-badge: "";
    in property <string> sftp-panel-binding-mode-label: "Follow";
    in property <bool> sftp-panel-binding-mode-active: true;
    in property <bool> sftp-panel-path-editing: false;
    in property <bool> sftp-panel-can-go-back: false;
    in property <bool> sftp-panel-can-go-forward: false;
    in property <bool> sftp-panel-can-go-up: false;
    in property <bool> sftp-panel-actions-enabled: false;
    in property <string> sftp-panel-sort-column: "default";
    in property <string> sftp-panel-sort-direction: "none";
    in property <length> sftp-panel-name-column-width: 226px;
    in property <length> sftp-panel-type-column-width: 78px;
    in property <length> sftp-panel-modified-column-width: 150px;
    in property <length> sftp-panel-size-column-width: 72px;
    in property <length> sftp-panel-total-content-height: 0px;
    in property <length> sftp-panel-top-spacer-height: 0px;
    in property <length> sftp-panel-bottom-spacer-height: 0px;
    in property <[SftpPanelItem]> sftp-panel-items: [];
    in property <[string]> sftp-panel-selected-entry-ids: [];
    in property <int> sftp-panel-queue-active: 0;
    in property <int> sftp-panel-queue-failed: 0;
    in property <int> sftp-panel-queue-current-session: 0;
    in property <bool> transfer-center-open: false;
    in property <bool> transfer-center-pinned: false;
    in property <bool> sftp-queue-drawer-open: false;
    in property <bool> sftp-panel-drop-target-active: false;
    in property <color> shell-right-panel-background: ThemeTokens.right-panel-background;
    in property <color> shell-separator: ThemeTokens.separator;
    in property <color> shell-border: ThemeTokens.divider-subtle;
    in property <color> shell-text-primary: ThemeTokens.text-primary;
    in property <color> shell-text-secondary: ThemeTokens.text-secondary;
    in property <color> shell-text-muted: ThemeTokens.text-muted;
    in property <color> shell-accent: ThemeTokens.accent;
    in property <color> shell-focus-ring: ThemeTokens.focus-ring;
    in property <color> shell-sidebar-item-hover: ThemeTokens.sidebar-item-hover-background;
    in property <color> shell-sidebar-item-selected: ThemeTokens.sidebar-item-selected-background;
    in property <color> shell-sidebar-item-selected-border: ThemeTokens.sidebar-item-selected-border;
    out property <length> layout-radius: root.border-radius;
    out property <length> layout-border-width: root.border-width;
    out property <length> sftp-drop-target-x: table-card.x;
    out property <length> sftp-drop-target-y: table-card.y;
    out property <length> sftp-drop-target-width: table-card.width;
    out property <length> sftp-drop-target-height: table-card.height;
    private property <string> tooltip-text-value: "";
    private property <bool> tooltip-visible-value: false;
    private property <string> tooltip-source-id-value: "";
    private property <string> tooltip-close-source-id-value: "";
    private property <length> tooltip-anchor-x-value: 0px;
    private property <length> tooltip-anchor-y-value: 0px;
    private property <length> tooltip-anchor-width-value: 0px;
    private property <length> edge-handle-width: 8px;
    private property <string> edge-handle-tooltip: "Click to collapse, drag to resize";
    out property <string> tooltip-text <=> root.tooltip-text-value;
    out property <bool> tooltip-visible <=> root.tooltip-visible-value;
    out property <length> tooltip-anchor-x <=> root.tooltip-anchor-x-value;
    out property <length> tooltip-anchor-y <=> root.tooltip-anchor-y-value;
    out property <length> tooltip-anchor-width <=> root.tooltip-anchor-width-value;
    in-out property <length> sftp-list-viewport-x: 0px;
    private property <image> arrow-hook-up-left-icon: @image-url("../../assets/icons/fluent/arrow-hook-up-left-20-regular.svg");
    private property <image> arrow-sync-icon: @image-url("../../assets/icons/fluent/arrow-sync-20-regular.svg");
    private property <image> expand-icon: @image-url("../../assets/icons/fluent/panel-right-expand-20-regular.svg");
    private property <image> expand-icon-active: @image-url("../../assets/icons/fluent/panel-right-expand-20-filled.svg");
    private property <image> link-icon: @image-url("../../assets/icons/fluent/link-20-regular.svg");
    private property <image> link-icon-active: @image-url("../../assets/icons/fluent/link-20-filled.svg");
    private property <image> folder-icon: @image-url("../../assets/icons/fluent/folder-20-regular.svg");
    private property <image> document-icon: @image-url("../../assets/icons/fluent/document-20-regular.svg");
    private property <image> document-code-icon: @image-url("../../assets/icons/fluent/document-code-16-regular.svg");
    private property <image> archive-icon: @image-url("../../assets/icons/fluent/archive-20-regular.svg");
    private property <image> image-icon: @image-url("../../assets/icons/fluent/image-20-regular.svg");
    private property <image> executable-icon: @image-url("../../assets/icons/fluent/window-console-20-regular.svg");
    callback sftp-panel-back-requested();
    callback sftp-panel-forward-requested();
    callback sftp-panel-refresh-requested();
    callback sftp-panel-up-requested();
    callback sftp-panel-expand-requested();
    callback sftp-panel-binding-mode-toggle-requested();
    callback sftp-panel-path-edit-requested();
    callback sftp-panel-path-submitted(string);
    callback sftp-panel-sort-requested(string);
    callback sftp-panel-column-width-change-requested(string, length);
    callback sftp-panel-viewport-changed(length, length);
    callback sftp-panel-item-selected(string);
    callback sftp-panel-item-activated(string, string);
    callback sftp-panel-context-menu-requested(string, string, length, length);
    callback sftp-panel-upload-requested();
    callback sftp-panel-new-folder-requested();
    callback sftp-panel-open-queue-requested();
    callback sftp-panel-retry-requested();
    callback sftp-panel-reenable-follow-requested();
    callback right-panel-edge-toggle-requested();
    callback right-panel-edge-drag-start-requested(length);
    callback right-panel-edge-drag-move-requested(length);
    callback right-panel-edge-drag-end-requested(length);
    callback transfer-center-close-requested();
    private property <length> sftp-status-row-height:
        root.sftp-panel-mode == "connecting"
        || root.sftp-panel-mode == "disconnected"
        || root.sftp-panel-mode == "error"
            ? 60px
            : root.sftp-panel-mode == "loading" && root.sftp-panel-items.length == 0
                ? 60px
            : 0px;
    private property <length> sftp-table-header-height: 28px;
    private property <length> sftp-table-row-height: 30px;
    private property <length> sftp-name-column-x: 14px;
    private property <length> sftp-type-column-x: root.sftp-name-column-x + root.sftp-panel-name-column-width + 12px;
    private property <length> sftp-modified-column-x: root.sftp-type-column-x + root.sftp-panel-type-column-width + 10px;
    private property <length> sftp-size-column-x: root.sftp-modified-column-x + root.sftp-panel-modified-column-width + 10px;
    private property <length> sftp-table-content-width: root.sftp-size-column-x + root.sftp-panel-size-column-width + 12px;
    private property <string> sftp-panel-connection-badge-text:
        root.sftp-panel-connection-badge == ""
            ? root.sftp-panel-host-label
            : root.sftp-panel-connection-badge;
    private property <string> sftp-panel-connection-tooltip:
        "Current connection: " + root.sftp-panel-connection-badge-text;

    function schedule-tooltip(source-id: string, text: string, anchor-x: length, anchor-y: length, anchor-width: length) {
        root.tooltip-anchor-x-value = anchor-x;
        root.tooltip-anchor-y-value = anchor-y;
        root.tooltip-anchor-width-value = anchor-width;

        if root.tooltip-source-id-value == source-id && root.tooltip-text-value == text {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
        } else {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-source-id-value = source-id;
            root.tooltip-text-value = text;
            root.tooltip-visible-value = false;
            tooltip-delay.start();
        }
    }

    function queue-tooltip-close(source-id: string) {
        if root.tooltip-source-id-value == source-id && source-id != "" {
            root.tooltip-close-source-id-value = source-id;
            tooltip-close-delay.start();
        }
    }

    function close-tooltip(source-id: string) {
        if root.tooltip-source-id-value == source-id || source-id == "" {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-visible-value = false;
            root.tooltip-text-value = "";
            root.tooltip-source-id-value = "";
            tooltip-delay.stop();
        }
    }

    function edge-width-proposal(pointer-x: length) -> length {
        return max(0px, root.absolute-position.x + root.width - pointer-x);
    }

    function sftp-empty-headline() -> string {
        return "Open an SSH session";
    }

    function sftp-empty-copy() -> string {
        return "The SFTP browser follows the active SSH tab and projects the current remote path into a compact file table.";
    }

    function sftp-status-headline() -> string {
        if (root.sftp-panel-mode == "connecting") {
            return "Connecting SFTP channel";
        }
        if (root.sftp-panel-mode == "loading") {
            return "Loading remote directory";
        }
        if (root.sftp-panel-mode == "disconnected") {
            return "Session disconnected";
        }
        if (root.sftp-panel-mode == "error") {
            return "SFTP action failed";
        }

        return "";
    }

    function sftp-status-copy() -> string {
        if (root.sftp-panel-mode == "connecting") {
            return "Opening the browser for the active SSH session.";
        }
        if (root.sftp-panel-mode == "loading") {
            return "Loading the latest remote path.";
        }
        if (root.sftp-panel-mode == "disconnected") {
            return "Reconnect the SSH session or retry to restore remote browsing.";
        }
        if (root.sftp-panel-mode == "error") {
            return "The last path is preserved. Retry the request or resume follow mode after recovery.";
        }

        return "";
    }

    width: root.expanded ? root.expanded-width : 0px;
    visible: root.expanded;
    clip: true;
    background: root.shell-right-panel-background;
    border-radius: 0px;
    border-width: 0px;
    border-color: transparent;

    left-divider := Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: root.shell-border;
    }

    edge-handle := Rectangle {
        x: 0px;
        y: 0px;
        width: root.edge-handle-width;
        height: parent.height;
        background: handle-touch.has-hover || handle-touch.pressed
            ? ThemeTokens.control-hover-surface
            : transparent;

        handle-touch := TouchArea {
            changed has-hover => {
                if self.has-hover {
                    root.schedule-tooltip(
                        "right-panel-edge-handle",
                        root.edge-handle-tooltip,
                        parent.absolute-position.x + parent.width / 2,
                        parent.absolute-position.y + parent.height / 2,
                        parent.width,
                    );
                } else {
                    root.queue-tooltip-close("right-panel-edge-handle");
                }
            }

            width: parent.width;
            height: parent.height;
            mouse-cursor: MouseCursor.w-resize;

            clicked => {
                root.queue-tooltip-close("right-panel-edge-handle");
                root.right-panel-edge-toggle-requested();
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.left
                {
                    root.right-panel-edge-drag-start-requested(
                        root.edge-width-proposal(self.absolute-position.x + self.mouse-x),
                    );
                } else if event.kind == PointerEventKind.move && self.pressed {
                    root.right-panel-edge-drag-move-requested(
                        root.edge-width-proposal(self.absolute-position.x + self.mouse-x),
                    );
                } else if event.kind == PointerEventKind.up {
                    root.right-panel-edge-drag-end-requested(
                        root.edge-width-proposal(self.absolute-position.x + self.mouse-x),
                    );
                }
            }
        }
    }

    sftp-panel := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        toolbar-row := Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: 74px;
            border-radius: 12px;
            border-width: 1px;
            border-color: root.shell-border;
            background: root.shell-right-panel-background;

            Rectangle {
                x: 12px;
                y: 37px;
                width: parent.width - 24px;
                height: 1px;
                background: root.shell-border;
            }

            connection-badge := Rectangle {
                x: 12px;
                y: 8px;
                width: max(96px, parent.width - 132px);
                height: 28px;
                border-radius: 14px;
                border-width: 1px;
                border-color: ThemeTokens.status-pill-border;
                background: ThemeTokens.status-pill-surface;

                Text {
                    x: 10px;
                    y: 0px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: root.sftp-panel-connection-badge-text;
                    font-family: AppTypography.ui-font-family;
                    font-size: AppTypography.ui-font-size-caption;
                    font-weight: AppTypography.ui-font-weight-semibold;
                    color: root.shell-text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                badge-touch := TouchArea {
                    changed has-hover => {
                        if self.has-hover && root.sftp-panel-connection-badge-text != "" {
                            root.schedule-tooltip(
                                "sftp-connection-badge",
                                root.sftp-panel-connection-tooltip,
                                parent.absolute-position.x,
                                parent.absolute-position.y + parent.height / 2,
                                parent.width,
                            );
                        } else {
                            root.queue-tooltip-close("sftp-connection-badge");
                        }
                    }
                }
            }

            follow-button := SidebarToolbarIconButton {
                x: parent.width - 108px;
                y: 8px;
                width: 28px;
                height: 28px;
                icon-source: root.link-icon;
                active-icon-source: root.link-icon-active;
                active: root.sftp-panel-binding-mode-active;
                enabled: root.sftp-panel-path != "";
                tooltip-text: "Follow active terminal";
                tooltip-source-id: "sftp-follow";

                clicked => {
                    root.sftp-panel-binding-mode-toggle-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            refresh-button := SidebarToolbarIconButton {
                x: parent.width - 72px;
                y: 8px;
                width: 28px;
                height: 28px;
                icon-source: root.arrow-sync-icon;
                active-icon-source: root.arrow-sync-icon;
                enabled: root.sftp-panel-actions-enabled;
                tooltip-text: "Refresh files";
                tooltip-source-id: "sftp-refresh";

                clicked => {
                    root.sftp-panel-refresh-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            expand-button := SidebarToolbarIconButton {
                x: parent.width - 36px;
                y: 8px;
                width: 28px;
                height: 28px;
                icon-source: root.expand-icon;
                active-icon-source: root.expand-icon-active;
                enabled: root.sftp-panel-actions-enabled;
                tooltip-text: "Open in SFTP workspace";
                tooltip-source-id: "sftp-expand";

                clicked => {
                    root.sftp-panel-expand-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            breadcrumb-row := Rectangle {
                x: 12px;
                y: 43px;
                width: parent.width - 24px;
                height: 30px;
                border-radius: 6px;
                border-width: 1px;
                border-color: ThemeTokens.input-border;
                background: ThemeTokens.input-surface;

                if root.sftp-panel-path-editing : path-input := TextInput {
                    x: 10px;
                    y: 0px;
                    width: parent.width - 20px;
                    height: parent.height;
                    single-line: true;
                    font-family: AppTypography.ui-font-family;
                    font-size: AppTypography.ui-font-size-caption;
                    font-weight: AppTypography.ui-font-weight-regular;
                    vertical-alignment: center;
                    text: root.sftp-panel-path;
                    enabled: root.sftp-panel-actions-enabled;
                    color: root.shell-text-primary;
                    selection-background-color: root.shell-accent;
                    selection-foreground-color: root.shell-text-primary;

                    key-pressed(event) => {
                        if (event.text == Key.Return) {
                            root.sftp-panel-path-submitted(self.text);
                            accept
                        } else if (event.text == Key.Escape) {
                            if root.transfer-center-open && !root.transfer-center-pinned {
                                root.transfer-center-close-requested();
                            } else {
                                root.sftp-panel-reenable-follow-requested();
                            }
                            accept
                        } else {
                            reject
                        }
                    }
                }

                if !root.sftp-panel-path-editing : breadcrumb-shell := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    breadcrumb-text := Text {
                        x: 10px;
                        y: 0px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: root.sftp-panel-path;
                        font-family: AppTypography.ui-font-family;
                        font-size: AppTypography.ui-font-size-caption;
                        font-weight: AppTypography.ui-font-weight-regular;
                        color: root.shell-text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        enabled: root.sftp-panel-actions-enabled;

                        clicked => {
                            root.sftp-panel-path-edit-requested();
                        }
                    }
                }
            }
        }

        table-card := Rectangle {
            x: 8px;
            y: 90px;
            width: parent.width - 16px;
            height: max(0px, parent.height - 98px);
            border-radius: 0px;
            border-width: 0px;
            border-color: transparent;
            background: root.shell-right-panel-background;
            clip: true;

            if root.sftp-panel-drop-target-active : drop-overlay := Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                z: 20;
                border-radius: 14px;
                border-width: 1px;
                border-color: ThemeTokens.link-accent;
                background: ThemeTokens.terminal-selection-surface;

                Rectangle {
                    x: 14px;
                    y: 14px;
                    width: parent.width - 28px;
                    height: parent.height - 28px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: ThemeTokens.link-accent;
                    background: transparent;
                }

                Text {
                    x: 20px;
                    y: 0px;
                    width: parent.width - 40px;
                    height: parent.height;
                    text: "Drop files to upload";
                    color: root.shell-text-primary;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.sftp-panel-mode == "empty" : empty-state := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: transparent;

                empty-state-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.sftp-panel-context-menu-requested(
                                "",
                                "sftp-blank",
                                self.mouse-x + self.absolute-position.x,
                                self.mouse-y + self.absolute-position.y,
                            );
                        }
                    }
                }

                Rectangle {
                    x: 16px;
                    y: 18px;
                    width: 52px;
                    height: 4px;
                    background: ThemeTokens.accent;
                }

                Text {
                    x: 16px;
                    y: 34px;
                    width: parent.width - 32px;
                    text: root.sftp-empty-headline();
                    color: ThemeTokens.text-primary;
                    font-size: 24px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                empty-copy-shell := Rectangle {
                    x: 16px;
                    y: 96px;
                    width: parent.width - 32px;
                    height: min(128px, parent.height - 116px);
                    border-radius: 0px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-subtle;
                    background: ThemeTokens.control-hover-surface;

                    Text {
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        text: root.sftp-empty-copy();
                        color: ThemeTokens.text-primary;
                        wrap: word-wrap;
                    }
                }

            }

            if root.sftp-status-row-height > 0px : status-row := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.sftp-status-row-height;
                background: ThemeTokens.control-hover-surface;

                Rectangle {
                    x: 16px;
                    y: 12px;
                    width: 4px;
                    height: parent.height - 24px;
                    border-radius: 2px;
                    background: root.sftp-panel-mode == "error" || root.sftp-panel-mode == "disconnected"
                        ? ThemeTokens.accent
                        : ThemeTokens.divider-strong;
                }

                Text {
                    x: 30px;
                    y: 10px;
                    width: parent.width - 140px;
                    text: root.sftp-status-headline();
                    color: ThemeTokens.text-primary;
                    font-size: 12px;
                    font-weight: 700;
                    overflow: elide;
                }

                Text {
                    x: 30px;
                    y: 28px;
                    width: parent.width - 140px;
                    text: root.sftp-status-copy();
                    color: ThemeTokens.text-secondary;
                    font-size: 12px;
                    overflow: elide;
                }

                if root.sftp-panel-mode == "disconnected" || root.sftp-panel-mode == "error" : retry-button := Rectangle {
                    x: parent.width - 88px;
                    y: 14px;
                    width: 72px;
                    height: 28px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-subtle;
                    background: ThemeTokens.control-active-surface;

                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: "Retry";
                        color: ThemeTokens.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    TouchArea {
                        width: parent.width;
                        height: parent.height;

                        clicked => {
                            root.sftp-panel-retry-requested();
                        }
                    }
                }
            }

            if root.sftp-panel-mode != "empty" : list-host := ScrollView {
                x: 0px;
                y: root.sftp-status-row-height;
                width: parent.width;
                height: parent.height - root.sftp-status-row-height;
                viewport-width: scroll-body.width;
                viewport-height: scroll-body.height;
                mouse-drag-pan-enabled: false;
                horizontal-scrollbar-policy: always-off;

                init => {
                    root.sftp-panel-viewport-changed(self.viewport-y, self.visible-height);
                }

                changed viewport-y => {
                    root.sftp-panel-viewport-changed(self.viewport-y, self.visible-height);
                }

                changed visible-height => {
                    root.sftp-panel-viewport-changed(self.viewport-y, self.visible-height);
                }

                scrolled => {
                    root.sftp-panel-viewport-changed(self.viewport-y, self.visible-height);
                }

                scroll-body := Rectangle {
                    width: list-host.visible-width;
                    height: max(list-host.visible-height, root.sftp-panel-total-content-height);
                    background: transparent;

                    blank-area-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                root.sftp-panel-context-menu-requested(
                                    "",
                                    "sftp-blank",
                                    self.mouse-x + self.absolute-position.x,
                                    self.mouse-y + self.absolute-position.y,
                                );
                            }
                        }
                    }

                    top-spacer := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: root.sftp-panel-top-spacer-height;
                        background: transparent;
                    }

                    visible-row-host := VerticalLayout {
                        x: 0px;
                        y: root.sftp-panel-top-spacer-height;
                        width: parent.width;
                        spacing: 0px;

                        for item in root.sftp-panel-items : Rectangle {
                            width: parent.width;
                            height: 44px;
                            background: item.selected ? ThemeTokens.explorer-row-selected-surface
                                : row-touch.has-hover ? ThemeTokens.explorer-row-hover-surface
                                : transparent;

                            Rectangle {
                                x: 12px;
                                y: parent.height - 1px;
                                width: parent.width - 24px;
                                height: 1px;
                                background: ThemeTokens.divider-subtle;
                            }

                            Image {
                                x: 14px;
                                y: 12px;
                                width: 16px;
                                height: 16px;
                                source: item.kind == "parent-directory"
                                    ? root.arrow-hook-up-left-icon
                                    : item.kind == "directory" ? root.folder-icon
                                    : item.kind == "symlink" ? root.link-icon
                                    : item.kind == "archive" ? root.archive-icon
                                    : item.kind == "image" ? root.image-icon
                                    : item.kind == "config" ? root.document-code-icon
                                    : item.kind == "executable" ? root.executable-icon
                                    : root.document-icon;
                                image-fit: contain;
                                colorize: item.kind == "directory"
                                    ? ThemeTokens.status-busy-accent
                                    : item.kind == "parent-directory"
                                        ? ThemeTokens.text-muted
                                        : item.kind == "symlink"
                                            ? ThemeTokens.link-accent
                                            : item.kind == "archive"
                                                ? ThemeTokens.accent
                                                : item.kind == "image"
                                                    ? ThemeTokens.status-error-accent
                                                    : item.kind == "config"
                                                        ? ThemeTokens.text-muted
                                                        : item.kind == "executable"
                                                            ? ThemeTokens.status-success-accent
                                        : ThemeTokens.text-secondary;
                            }

                            Text {
                                x: 40px;
                                y: 4px;
                                width: parent.width - 52px;
                                height: 18px;
                                text: item.name;
                                color: ThemeTokens.text-primary;
                                font-size: 12px;
                                font-weight: item.selected ? 700 : 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            meta-text := Text {
                                x: 40px;
                                y: 22px;
                                width: parent.width - 52px;
                                height: 16px;
                                text: item.meta_label;
                                color: ThemeTokens.text-secondary;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            row-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;

                                clicked => {
                                    root.sftp-panel-item-selected(item.id);
                                }

                                double-clicked => {
                                    root.sftp-panel-item-activated(item.id, item.kind);
                                }

                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                        root.sftp-panel-context-menu-requested(
                                            item.id,
                                            item.kind == "parent-directory"
                                                ? "sftp-blank"
                                                : item.kind == "directory" ? "sftp-directory" : "sftp-file",
                                            self.mouse-x + self.absolute-position.x,
                                            self.mouse-y + self.absolute-position.y,
                                        );
                                    }
                                }
                            }
                        }
                    }

                    bottom-spacer := Rectangle {
                        x: 0px;
                        y: visible-row-host.y + visible-row-host.height;
                        width: parent.width;
                        height: root.sftp-panel-bottom-spacer-height;
                        background: transparent;
                    }
                }
            }

        }
    }

    tooltip-delay := Timer {
        interval: 280ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-text-value != "" {
                root.tooltip-visible-value = true;
            }
        }
    }

    tooltip-close-delay := Timer {
        interval: 80ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-close-source-id-value != "" {
                root.close-tooltip(root.tooltip-close-source-id-value);
            }
        }
    }
}
