// Optional right-side utility panel that collapses out of layout when hidden.

import { ScrollView } from "std-widgets.slint";
import { VaultProviderCard } from "../components/vault-provider-card.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component RightPanel inherits Rectangle {
    in property <bool> expanded: false;
    in property <string> panel-view: "appearance";
    in property <string> vault-lock-state-label: "Locked";
    in property <string> vault-primary-status-label: "Primary not configured";
    in property <string> vault-primary-action-label: "Set";
    in property <string> vault-secondary-action-label: "Change";
    in property <string> vault-tertiary-action-label: "Lock now";
    in property <string> vault-sync-now-label: "Sync now";
    in property <string> vault-export-bootstrap-label: "Export bootstrap";
    in property <string> vault-import-bootstrap-label: "Import bootstrap";
    out property <length> layout-radius: root.border-radius;
    out property <length> layout-border-width: root.border-width;

    width: root.expanded ? 392px : 0px;
    visible: root.expanded;
    clip: true;
    background: ThemeTokens.inspector-surface;
    border-radius: 0px;
    border-width: 0px;
    border-color: transparent;

    left-divider := Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: ThemeTokens.divider-strong;
    }

    if root.panel-view == "vault" : vault-scroll := ScrollView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewport-width: vault-body.width;
        viewport-height: vault-body.height;

        vault-body := Rectangle {
            width: vault-scroll.visible-width;
            height: max(vault-scroll.visible-height, vault-column.preferred-height + 32px);
            background: transparent;

            vault-column := VerticalLayout {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                spacing: 14px;

                Text {
                    width: parent.width;
                    text: "Sync & Vault";
                    color: ThemeTokens.text-primary;
                    font-size: 24px;
                    font-weight: 700;
                }

                Rectangle {
                    width: parent.width;
                    height: 78px;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-strong;
                    background: ThemeTokens.control-active-surface;

                    Text {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        text: "Vault state";
                        color: ThemeTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    Text {
                        x: 16px;
                        y: 34px;
                        width: parent.width - 32px;
                        text: root.vault-lock-state-label;
                        color: ThemeTokens.text-primary;
                        font-size: 18px;
                        font-weight: 600;
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: 116px;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-strong;
                    background: ThemeTokens.control-active-surface;

                    Text {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        text: "Master Password";
                        color: ThemeTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    primary-action := Rectangle {
                        x: 16px;
                        y: 48px;
                        width: 90px;
                        height: 40px;
                        border-radius: 12px;
                        background: ThemeTokens.control-hover-surface;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.vault-primary-action-label;
                            color: ThemeTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                    }

                    secondary-action := Rectangle {
                        x: 116px;
                        y: 48px;
                        width: 96px;
                        height: 40px;
                        border-radius: 12px;
                        background: ThemeTokens.control-hover-surface;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.vault-secondary-action-label;
                            color: ThemeTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                    }

                    tertiary-action := Rectangle {
                        x: 222px;
                        y: 48px;
                        width: parent.width - 238px;
                        height: 40px;
                        border-radius: 12px;
                        background: ThemeTokens.control-hover-surface;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.vault-tertiary-action-label;
                            color: ThemeTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: 232px;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-strong;
                    background: ThemeTokens.control-active-surface;

                    Text {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        text: "Remotes";
                        color: ThemeTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    primary-provider := VaultProviderCard {
                        x: 16px;
                        y: 44px;
                        width: parent.width - 32px;
                        role: "primary";
                        provider-name: "Primary remote";
                        status-label: root.vault-primary-status-label;
                        action-label: root.vault-primary-action-label;
                    }

                    mirror-provider := VaultProviderCard {
                        x: 16px;
                        y: 148px;
                        width: parent.width - 32px;
                        role: "mirror";
                        provider-name: "Mirror remote";
                        status-label: "Mirror not configured";
                        action-label: "Add";
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: 152px;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-strong;
                    background: ThemeTokens.control-active-surface;

                    Text {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        text: "Bootstrap & Sync";
                        color: ThemeTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    sync-now-button := Rectangle {
                        x: 16px;
                        y: 48px;
                        width: parent.width - 32px;
                        height: 28px;
                        border-radius: 10px;
                        background: ThemeTokens.control-hover-surface;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.vault-sync-now-label;
                            color: ThemeTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                    }

                    export-bootstrap-button := Rectangle {
                        x: 16px;
                        y: 84px;
                        width: parent.width - 32px;
                        height: 28px;
                        border-radius: 10px;
                        background: ThemeTokens.control-hover-surface;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.vault-export-bootstrap-label;
                            color: ThemeTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                    }

                    import-bootstrap-button := Rectangle {
                        x: 16px;
                        y: 120px;
                        width: parent.width - 32px;
                        height: 28px;
                        border-radius: 10px;
                        background: ThemeTokens.control-hover-surface;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.vault-import-bootstrap-label;
                            color: ThemeTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                    }
                }
            }
        }
    }

    if root.panel-view == "appearance" : appearance-panel := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        Text {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            text: "Appearance";
            color: ThemeTokens.text-primary;
            font-size: 24px;
            font-weight: 700;
        }

        Text {
            x: 16px;
            y: 52px;
            width: parent.width - 32px;
            text: "Use the titlebar menu to switch between appearance controls and Sync & Vault.";
            color: ThemeTokens.text-primary;
            opacity: 0.72;
            wrap: word-wrap;
        }
    }
}
