// Optional right-side utility panel that collapses out of layout when hidden.

import { ThemeTokens } from "../theme/tokens.slint";
import { SegmentedControl } from "../components/segmented-control.slint";

export component RightPanel inherits Rectangle {
    in property <bool> expanded: false;
    out property <length> layout-radius: root.border-radius;
    out property <length> layout-border-width: root.border-width;
    callback debug-event-requested(string);

    width: root.expanded ? 392px : 0px;
    visible: root.expanded;
    clip: true;
    background: ThemeTokens.inspector-surface;
    border-radius: 0px;
    border-width: 0px;
    border-color: transparent;

    changed expanded => {
        root.debug-event-requested(root.expanded ? "right-panel.expanded.true" : "right-panel.expanded.false");
    }

    changed width => {
        root.debug-event-requested("right-panel.width.changed");
    }

    changed height => {
        root.debug-event-requested("right-panel.height.changed");
    }

    left-divider := Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: ThemeTokens.divider-strong;
    }

    SegmentedControl {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: 36px;
    }
}
