// Secondary sidebar hosting asset navigation, inline search, and creation affordances.

import { ListView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AssetNodeRow } from "../components/asset-node-row.slint";
import { AssetsSearchPopover } from "../components/assets-search-popover.slint";
import { SidebarToolbarIconButton } from "../components/sidebar-toolbar-icon-button.slint";

export struct ConsoleAssetItem {
    id: string,
    kind: string,
    label: string,
    depth: int,
    has_children: bool,
    expanded: bool,
    selected: bool,
    focused: bool,
    disclosure_state: string,
    path_hint: string,
    compact_flat_mode: bool,
}

export component AssetsSidebar inherits Rectangle {
    in property <bool> expanded: true;
    in property <string> active-panel: "console";
    in property <string> assets-search-query: "";
    in property <bool> asset-search-expanded: false;
    in property <bool> asset-create-menu-open: false;
    in property <bool> asset-uses-create-popover: false;
    in property <bool> asset-tree-fully-expanded: false;
    in property <string> asset-view-mode: "tree";
    in property <string> asset-primary-create-action-id: "";
    in property <string> asset-primary-create-tooltip: "";
    in property <string> asset-search-tooltip: "";
    in property <string> asset-view-mode-tooltip: "";
    in property <string> asset-tree-expansion-tooltip: "";
    in property <bool> asset-show-tree-controls: true;
    in property <bool> asset-tree-controls-enabled: true;
    in property <[ConsoleAssetItem]> console-asset-items: [];
    out property <length> search-row-height: search-row-host.height;
    out property <length> create-menu-anchor-x: create-button.absolute-position.x;
    out property <length> create-menu-anchor-y: create-button.absolute-position.y;
    out property <length> create-menu-anchor-width: create-button.width;
    out property <length> create-menu-anchor-height: create-button.height;
    callback toggle-assets-search-requested();
    callback assets-search-query-changed(string);
    callback close-assets-search-requested();
    callback collapse-assets-search-requested();
    callback toggle-assets-view-mode-requested();
    callback toggle-assets-tree-expansion-requested();
    callback toggle-assets-create-menu-requested();
    callback close-assets-create-menu-requested();
    callback assets-create-action-selected(string);
    callback asset-selected(string);
    callback toggle-expanded-requested(string);
    callback asset-context-menu-requested(string, string, length, length);
    callback shell-interaction-requested();
    callback tooltip-open-requested(string, string, length, length, length);
    callback tooltip-close-requested(string);
    private property <image> search-icon: @image-url("../../assets/icons/fluent/search-20-regular.svg");
    private property <image> tree-expand-icon: @image-url("../../assets/icons/fluent/arrow-expand-all-20-regular.svg");
    private property <image> tree-collapse-icon: @image-url("../../assets/icons/fluent/arrow-collapse-all-20-regular.svg");
    private property <image> tree-view-icon: @image-url("../../assets/icons/fluent/branch-20-regular.svg");
    private property <image> list-view-icon: @image-url("../../assets/icons/fluent/list-20-regular.svg");
    private property <image> create-add-icon: @image-url("../../assets/icons/fluent/add-20-regular.svg");

    width: expanded ? 320px : 0px;
    visible: expanded;
    clip: true;
    background: ThemeTokens.assets-surface;
    border-width: 1px;
    border-color: ThemeTokens.divider-subtle;

    VerticalLayout {
        spacing: 0px;

        header := Rectangle {
            height: 44px;
            background: transparent;

            toolbar-content := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;

                Text { text: "Assets"; color: ThemeTokens.text-primary; vertical-alignment: center; }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                search-button := SidebarToolbarIconButton {
                    icon-source: root.search-icon;
                    active: root.asset-search-expanded;
                    tooltip-text: root.asset-search-tooltip;
                    tooltip-source-id: "assets-search";
                    clicked => {
                        if root.asset-search-expanded {
                            inline-search.focus-input();
                        } else {
                            root.toggle-assets-search-requested();
                        }
                    }

                    tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                        root.tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width);
                    }

                    tooltip-close-requested(source-id) => {
                        root.tooltip-close-requested(source-id);
                    }
                }

                tree-expansion-button := SidebarToolbarIconButton {
                    icon-source: root.asset-tree-fully-expanded ? root.tree-collapse-icon : root.tree-expand-icon;
                    active: root.asset-tree-fully-expanded;
                    enabled: root.asset-show-tree-controls && root.asset-tree-controls-enabled;
                    visible: root.asset-show-tree-controls;
                    tooltip-text: root.asset-tree-expansion-tooltip;
                    tooltip-source-id: "assets-tree-expansion";
                    clicked => {
                        root.toggle-assets-tree-expansion-requested();
                    }

                    tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                        root.tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width);
                    }

                    tooltip-close-requested(source-id) => {
                        root.tooltip-close-requested(source-id);
                    }
                }

                view-mode-button := SidebarToolbarIconButton {
                    icon-source: root.asset-view-mode == "flat" ? root.list-view-icon : root.tree-view-icon;
                    active: root.asset-view-mode == "flat";
                    tooltip-text: root.asset-view-mode-tooltip;
                    tooltip-source-id: "assets-view-mode";
                    clicked => {
                        root.toggle-assets-view-mode-requested();
                    }

                    tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                        root.tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width);
                    }

                    tooltip-close-requested(source-id) => {
                        root.tooltip-close-requested(source-id);
                    }
                }

                create-button := SidebarToolbarIconButton {
                    icon-source: root.create-add-icon;
                    active: root.asset-create-menu-open;
                    tooltip-text: root.asset-primary-create-tooltip;
                    tooltip-source-id: "assets-primary-create";
                    clicked => {
                        if root.asset-uses-create-popover {
                            root.toggle-assets-create-menu-requested();
                        } else if root.asset-primary-create-action-id != "" {
                            root.assets-create-action-selected(root.asset-primary-create-action-id);
                        }
                    }

                    tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                        root.tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width);
                    }

                    tooltip-close-requested(source-id) => {
                        root.tooltip-close-requested(source-id);
                    }
                }
            }
        }

        search-row-host := Rectangle {
            height: root.asset-search-expanded ? 44px : 0px;
            clip: true;
            background: transparent;

            inline-search := AssetsSearchPopover {
                x: 12px;
                y: 6px;
                width: parent.width - 24px;
                visible: parent.height > 0px;
                query: root.assets-search-query;

                query-changed(value) => {
                    root.assets-search-query-changed(value);
                }

                collapse-requested => {
                    root.collapse-assets-search-requested();
                }

                close-requested => {
                    root.close-assets-search-requested();
                }
            }
        }

        panel-content-host := Rectangle {
            vertical-stretch: 1;
            background: transparent;

            if root.active-panel == "console" && root.console-asset-items.length == 0 : Rectangle {
                vertical-stretch: 1;
                background: transparent;

                empty-state-context-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.shell-interaction-requested();
                    }

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.asset-context-menu-requested(
                                "",
                                "blank",
                                self.mouse-x + self.absolute-position.x,
                                self.mouse-y + self.absolute-position.y,
                            );
                        }
                    }
                }

                VerticalLayout {
                    x: 16px;
                    y: 24px;
                    width: parent.width - 32px;
                    spacing: 6px;

                    Text {
                        width: parent.width;
                        text: "No assets yet";
                        color: ThemeTokens.text-primary;
                        horizontal-alignment: center;
                    }

                    Text {
                        width: parent.width;
                        text: "Right-click or use Create to add a folder or SSH connection.";
                        color: ThemeTokens.text-primary;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            if root.active-panel == "console" && root.console-asset-items.length > 0 : Rectangle {
                vertical-stretch: 1;
                background: transparent;

                list-blank-fill-context-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.shell-interaction-requested();
                    }

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.asset-context-menu-requested(
                                "",
                                "blank",
                                self.mouse-x + self.absolute-position.x,
                                self.mouse-y + self.absolute-position.y,
                            );
                        }
                    }
                }

                list-host := ListView {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: parent.height - 24px;

                    for item in root.console-asset-items : AssetNodeRow {
                        width: list-host.width;
                        item-id: item.id;
                        item-kind: item.kind;
                        label: item.label;
                        depth: item.depth;
                        has-children: item.has_children;
                        expanded: item.expanded;
                        selected: item.selected;
                        focused: item.focused;
                        disclosure-state: item.disclosure_state;
                        path-hint: item.path_hint;
                        compact-flat-mode: item.compact_flat_mode;

                        selected-requested(item-id) => {
                            root.asset-selected(item-id);
                        }

                        toggle-expanded-requested(item-id) => {
                            root.toggle-expanded-requested(item-id);
                        }

                        context-menu-requested(item-id, item-kind, anchor-x, anchor-y) => {
                            root.asset-context-menu-requested(item-id, item-kind, anchor-x, anchor-y);
                        }

                        pointer-activity-requested => {
                            root.shell-interaction-requested();
                        }
                    }
                }
            }

            if root.active-panel == "snippets" : VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: "Snippets";
                    color: ThemeTokens.text-primary;
                }

                Text {
                    text: "Groups, favorites, templates";
                    color: ThemeTokens.text-primary;
                }
            }

            if root.active-panel == "keychain" : VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: "Keychain";
                    color: ThemeTokens.text-primary;
                }

                Text {
                    text: "Accounts, identities, SSH keys";
                    color: ThemeTokens.text-primary;
                }
            }
        }
    }
}
