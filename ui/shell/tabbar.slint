// Workspace tab strip backed by a real session-tab model.

import { ThemeTokens } from "../theme/tokens.slint";
import { ActiveTab } from "../components/active-tab.slint";

export struct WorkspaceTabItem {
    session_id: string,
    title: string,
    subtitle: string,
    state: string,
    active: bool,
}

export component TabBar inherits Rectangle {
    in property <[WorkspaceTabItem]> items: [];
    callback tab-selected(string);
    callback tab-close-requested(string);
    // State contract forwarded from Rust projections: connecting / connected / disconnected / error.

    width: 100%;
    min-width: 0px;
    height: 36px;
    background: ThemeTokens.titlebar-surface;
    border-width: 0px;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 12px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        for item in root.items : ActiveTab {
            horizontal-stretch: 0;
            min-width: 0px;
            title: item.title;
            subtitle: item.subtitle;
            state: item.state;
            active: item.active;

            selected => {
                root.tab-selected(item.session_id);
            }

            close-requested => {
                root.tab-close-requested(item.session_id);
            }
        }

        trailing-spacer := Rectangle {
            min-width: 0px;
            horizontal-stretch: 1;
            background: transparent;

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }
        }
    }
}
