// Workspace tab strip backed by a real session-tab model.

import { ThemeTokens } from "../theme/tokens.slint";
import { ActiveTab } from "../components/active-tab.slint";

export struct WorkspaceTabItem {
    tab_id: string,
    title: string,
    subtitle: string,
    state: string,
    enhanced_session_state: string,
    active: bool,
}

export component TabBar inherits Rectangle {
    in property <[WorkspaceTabItem]> items: [];
    in property <bool> suppress-hover-tooltip: false;
    in property <color> shell-tabbar-background: ThemeTokens.tabbar-background;
    in property <color> shell-titlebar-background: ThemeTokens.titlebar-background;
    in property <color> shell-separator: ThemeTokens.separator;
    in property <color> shell-border: ThemeTokens.divider-subtle;
    in property <color> shell-hairline: ThemeTokens.hairline;
    in property <color> shell-text-primary: ThemeTokens.text-primary;
    in property <color> shell-text-secondary: ThemeTokens.text-secondary;
    in property <color> shell-text-inactive: ThemeTokens.text-muted;
    in property <color> shell-accent: ThemeTokens.accent;
    in property <color> shell-tab-active: ThemeTokens.tab-active-surface;
    in property <color> shell-tab-inactive: ThemeTokens.tab-inactive-surface;
    in property <color> shell-tab-hover: ThemeTokens.tab-hover-surface;
    in property <color> shell-tab-active-indicator: ThemeTokens.tab-active-indicator;
    callback tab-selected(string);
    callback tab-close-requested(string);
    callback tab-reorder-requested(string, int);
    callback tab-context-menu-requested(string, length, length);
    callback tab-hovered(string, length, length);
    callback tab-hover-ended(string);
    callback new-tab-requested();
    // State contract forwarded from Rust projections: connecting / connected / disconnected / error.

    private property <image> new-tab-icon: @image-url("../../assets/icons/fluent/add-20-regular.svg");
    private property <bool> drag-active: false;
    private property <string> dragged-tab-id: "";
    private property <int> drag-source-index: -1;
    private property <length> drag-origin-x: 0px;
    private property <length> drag-current-x: 0px;
    private property <length> drag-tab-width: 0px;
    private property <int> drag-preview-slot: -1;
    private property <length> drag-preview-gap-width: root.show-reorder-preview()
        ? min(44px, max(28px, root.drag-tab-width * 0.36))
        : 0px;

    function drag-step-count() -> int {
        if root.drag-tab-width <= 0px {
            return 0;
        }
        let delta = (root.drag-current-x - root.drag-origin-x) / root.drag-tab-width;
        return delta >= 0
            ? Math.floor(delta + 0.5)
            : -Math.floor((-delta) + 0.5);
    }

    function drag-target-index() -> int {
        if !root.drag-active || root.drag-source-index < 0 || root.items.length == 0 {
            return -1;
        }
        let candidate = root.drag-source-index + root.drag-step-count();
        return min(root.items.length - 1, max(0, candidate));
    }

    function show-reorder-preview() -> bool {
        return root.drag-active
            && root.drag-preview-slot >= 0
            && root.drag-target-index() != root.drag-source-index;
    }

    function begin-drag(tab-id: string, source-index: int, tab-width: length, pointer-x: length) {
        root.drag-active = true;
        root.dragged-tab-id = tab-id;
        root.drag-source-index = source-index;
        root.drag-origin-x = pointer-x;
        root.drag-current-x = pointer-x;
        root.drag-tab-width = max(1px, tab-width);
        root.drag-preview-slot = source-index;
        root.tab-hover-ended(tab-id);
    }

    function update-drag(pointer-x: length) {
        if !root.drag-active {
            return;
        }
        root.drag-current-x = pointer-x;
        let target-index = root.drag-target-index();
        if target-index < 0 {
            root.drag-preview-slot = -1;
        } else if target-index <= root.drag-source-index {
            root.drag-preview-slot = target-index;
        } else {
            root.drag-preview-slot = target-index + 1;
        }
    }

    function reset-drag() {
        root.drag-active = false;
        root.dragged-tab-id = "";
        root.drag-source-index = -1;
        root.drag-origin-x = 0px;
        root.drag-current-x = 0px;
        root.drag-tab-width = 0px;
        root.drag-preview-slot = -1;
    }

    width: 100%;
    min-width: 0px;
    height: 36px;
    background: ThemeTokens.tabbar-background;
    border-width: 0px;

    chrome-reference := Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        background: ThemeTokens.titlebar-background;
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 12px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        for item[index] in root.items : ActiveTab {
            horizontal-stretch: 0;
            min-width: 0px;
            title: item.title;
            subtitle: item.subtitle;
            state: item.state;
            active: item.active;
            drag-active: root.drag-active && root.dragged-tab-id == item.tab_id;
            leading-gap-width: root.show-reorder-preview() && root.drag-preview-slot == index
                ? root.drag-preview-gap-width
                : 0px;
            show-leading-insertion-line: root.show-reorder-preview() && root.drag-preview-slot == index;

            selected => {
                root.tab-selected(item.tab_id);
            }

            close-requested => {
                root.tab-close-requested(item.tab_id);
            }

            drag-started(pointer-x, _pointer-y) => {
                root.begin-drag(item.tab_id, index, self.width, pointer-x);
            }

            drag-moved(pointer-x, _pointer-y) => {
                if root.dragged-tab-id == item.tab_id {
                    root.update-drag(pointer-x);
                }
            }

            drag-ended(pointer-x, _pointer-y) => {
                if root.dragged-tab-id == item.tab_id {
                    root.update-drag(pointer-x);
                    let target-index = root.drag-target-index();
                    let dragged-tab-id = root.dragged-tab-id;
                    let should-commit =
                        target-index >= 0 && target-index != root.drag-source-index;
                    root.reset-drag();
                    if should-commit {
                        root.tab-reorder-requested(dragged-tab-id, target-index);
                    }
                }
            }

            drag-cancelled => {
                if root.dragged-tab-id == item.tab_id {
                    root.reset-drag();
                }
            }

            context-menu-requested(anchor-x, anchor-y) => {
                root.tab-context-menu-requested(item.tab_id, anchor-x, anchor-y);
            }

            hovered(anchor-x, anchor-y) => {
                if !(root.suppress-hover-tooltip || root.drag-active) {
                    root.tab-hovered(item.tab_id, anchor-x, anchor-y);
                }
            }

            hover-ended => {
                root.tab-hover-ended(item.tab_id);
            }
        }

        end-insertion-line := Rectangle {
            width: root.show-reorder-preview() && root.drag-preview-slot == root.items.length ? root.drag-preview-gap-width : 0px;
            height: parent.height;
            background: transparent;
            animate width { duration: 140ms; easing: ease-out; }

            Rectangle {
                x: 2px;
                y: 4px;
                width: max(0px, parent.width - 6px);
                height: parent.height - 8px;
                border-radius: 8px;
                border-width: parent.width > 0px ? 1px : 0px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.control-hover-surface;
                opacity: parent.width > 0px ? 0.72 : 0;
                visible: parent.width > 0px;
            }

            Rectangle {
                x: max(3px, parent.width - 4px);
                y: 4px;
                width: 3px;
                height: parent.height - 8px;
                border-radius: 2px;
                background: ThemeTokens.tab-active-line;
                opacity: parent.width > 0px ? 1 : 0;
                visible: parent.width > 0px;
            }
        }

        new-tab-button := Rectangle {
            width: 34px;
            height: 30px;
            y: 3px;
            border-radius: 8px;
            border-width: new-tab-touch.has-hover ? 1px : 0px;
            border-color: ThemeTokens.divider-subtle;
            background: new-tab-touch.pressed
                ? ThemeTokens.control-pressed-surface
                : new-tab-touch.has-hover
                    ? ThemeTokens.tab-inactive-surface
                    : transparent;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                source: root.new-tab-icon;
                image-fit: contain;
                colorize: new-tab-touch.has-hover ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
            }

            new-tab-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                enabled: !root.drag-active;

                clicked => {
                    root.new-tab-requested();
                }
            }
        }

        trailing-spacer := Rectangle {
            min-width: 0px;
            horizontal-stretch: 1;
            background: transparent;

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }
        }
    }
}
