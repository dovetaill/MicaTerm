// Workspace content host that switches between welcome, terminal, and error states.

import { ThemeTokens } from "../theme/tokens.slint";
import { QuickLaunchCardRow, QuickLaunchDetailRow, QuickLaunchGroupRow } from "../welcome/quick-launch-types.slint";
import { WelcomeView } from "../welcome/welcome-view.slint";

component TerminalContextMenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> has-hover: touch.has-hover;
    callback invoked();

    height: 32px;
    border-radius: 6px;
    background: !root.enabled
        ? transparent
        : touch.pressed
            ? ThemeTokens.menu-row-open-surface
            : touch.has-hover
                ? ThemeTokens.menu-row-hover-surface
                : transparent;

    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        opacity: root.enabled ? 1.0 : 0.48;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.invoked();
        }
    }
}

export struct ConnectionProgressStepRow {
    state: string,
    hop_label: string,
    title: string,
    detail: string,
}

export struct ConnectionProgressDiagnosticRow {
    text: string,
}

export struct TerminalCommandBlockRow {
    start_row: int,
    end_row: int,
    status: string,
    label: string,
}

export struct TerminalOverviewMarkerRow {
    row: int,
    kind: string,
}

component ConnectionProgressActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();

    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.primary ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: !root.enabled
        ? ThemeTokens.control-disabled-surface
        : button-touch.pressed
            ? ThemeTokens.control-pressed-surface
            : button-touch.has-hover
                ? ThemeTokens.control-hover-surface
                : root.primary
                    ? ThemeTokens.accent
                    : ThemeTokens.control-active-surface;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        opacity: root.enabled ? 1.0 : 0.48;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

export component TerminalSessionHost inherits Rectangle {
    in property <string> session-id: "";
    in property <string> mode: "welcome";
    in property <string> session-title: "";
    in property <string> session-subtitle: "";
    in property <string> session-state: "";
    in property <string> session-error-detail: "";
    in property <bool> can-reconnect: false;
    in property <string> session-render-mode: "bitmap";
    in property <string> connection-progress-headline: "";
    in property <string> connection-progress-current-hop: "";
    in property <string> connection-progress-current-detail: "";
    in property <string> connection-progress-page-mode: "";
    in property <string> connection-progress-task-title: "";
    in property <string> connection-progress-task-detail: "";
    in property <string> connection-progress-host-key-prompt-host: "";
    in property <string> connection-progress-host-key-prompt-fingerprint: "";
    in property <[ConnectionProgressStepRow]> connection-progress-steps: [];
    in property <[ConnectionProgressDiagnosticRow]> connection-progress-diagnostics: [];
    in property <[QuickLaunchCardRow]> welcome-quick-launch-recent-items: [];
    in property <[QuickLaunchCardRow]> welcome-quick-launch-favorite-items: [];
    in property <[QuickLaunchGroupRow]> welcome-quick-launch-group-items: [];
    in property <[QuickLaunchCardRow]> welcome-quick-launch-visible-group-items: [];
    in property <QuickLaunchDetailRow> welcome-quick-launch-selected-detail: {
        asset_id: "",
        title: "",
        subtitle: "",
        environment: "",
        auth_summary: "",
        proxy_summary: "",
        remark: "",
        recent_label: "",
    };
    in property <string> welcome-quick-launch-search-query: "";
    in property <image> session-surface-image;
    in property <int> session-native-frame-token: 0;
    in property <int> session-rows: 24;
    in property <int> session-cols: 80;
    in property <length> session-cell-width: 10px;
    in property <length> session-cell-height: 22px;
    in property <int> session-cursor-row: 0;
    in property <int> session-cursor-col: 0;
    in property <bool> session-cursor-visible: false;
    in property <bool> session-cursor-blinking: false;
    in property <string> session-cursor-shape: "block";
    in property <color> session-cursor-fg: ThemeTokens.terminal-cursor-fg;
    in property <color> session-cursor-bg: ThemeTokens.terminal-cursor-bg;
    in property <color> session-default-fg: ThemeTokens.terminal-default-fg;
    in property <color> session-default-bg: ThemeTokens.terminal-default-bg;
    in property <color> session-scrollbar-thumb: ThemeTokens.terminal-scrollbar-thumb-surface;
    in property <color> session-scrollbar-thumb-active: ThemeTokens.terminal-scrollbar-thumb-active-surface;
    in property <bool> session-mouse-grabbed: false;
    in property <bool> link-hovered: false;
    in property <bool> link-armed: false;
    in property <[string]> session-visible-lines: [];
    in property <[TerminalCommandBlockRow]> session-command-blocks: [];
    in property <[TerminalOverviewMarkerRow]> session-overview-markers: [];
    in property <bool> session-search-open: false;
    in property <string> session-search-query: "";
    in property <int> session-search-match-count: 0;
    in property <int> session-search-focus-sequence: 0;
    in property <int> session-surface-seqno: 0;
    in property <int> session-viewport-offset-lines: 0;
    in property <int> session-viewport-max-offset-lines: 0;
    in property <bool> session-viewport-at-bottom: true;
    in property <float> session-device-scale-factor: 1.0;
    in-out property <bool> selection-active: false;
    in-out property <int> selection-start-row: -1;
    in-out property <int> selection-start-col: -1;
    in-out property <int> selection-end-row: -1;
    in-out property <int> selection-end-col: -1;
    out property <length> native-surface-x: root.terminal-surface-origin-x();
    out property <length> native-surface-y: root.terminal-surface-origin-y();
    out property <length> native-surface-width: root.snapped-terminal-content-width();
    out property <length> native-surface-height: root.snapped-terminal-content-height();
    out property <length> preferred-surface-width: root.preferred-terminal-content-width();
    out property <length> preferred-surface-height: root.preferred-terminal-content-height();
    out property <int> preferred-terminal-rows: root.preferred-terminal-row-count();
    out property <int> preferred-terminal-cols: root.preferred-terminal-col-count();
    callback text-input(string);
    callback key-input(string, bool, bool, bool);
    callback surface-resize-requested(int, int);
    callback normalize-hit-col(int, int) -> int;
    callback normalize-selection-hit-col(int, int) -> int;
    callback copy-selection-requested(int, int, int, int);
    callback selection-changed();
    callback paste-requested();
    callback local-action-requested(string);
    callback scroll-requested(int, int, int, bool, bool, bool);
    callback scroll-thumb-drag-requested(float);
    callback scroll-jump-requested(float);
    callback mouse-input(string, string, int, int, bool, bool, bool);
    callback context-menu-open-changed(bool);
    callback search-open-requested();
    callback search-close-requested();
    callback search-query-changed(string);
    callback welcome-quick-launch-asset-selected(string);
    callback welcome-quick-launch-search-changed(string);
    callback welcome-quick-launch-connect-requested(string);
    callback welcome-quick-launch-connect-in-new-tab-requested(string);
    callback welcome-quick-launch-toggle-favorite-requested(string);
    callback welcome-quick-launch-reveal-in-assets-requested(string);
    callback welcome-open-saved-ssh-requested();

    public function restore-primary-focus() {
        if root.mode == "terminal" {
            terminal-input.focus();
        }
    }

    private property <length> terminal-font-size: 16px;
    private property <length> terminal-cell-width: max(1px, root.session-cell-width);
    private property <length> terminal-cell-height: max(1px, root.session-cell-height);
    private property <length> terminal-cursor-thickness: 1px;
    private property <length> terminal-padding-left: 10px;
    private property <length> terminal-padding-top: 8px;
    private property <length> terminal-padding-right: 10px;
    private property <length> terminal-padding-bottom: 8px;
    private property <length> command-gutter-width: 4px;
    private property <length> command-gutter-gap: 3px;
    private property <length> command-gutter-min-height: 10px;
    private property <length> overview-ruler-width: 3px;
    private property <length> overview-ruler-gap: 5px;
    private property <length> overview-marker-height: 10px;
    private property <length> scrollbar-reserved-width: 12px;
    private property <length> scrollbar-track-width: 7px;
    private property <length> scrollbar-thumb-min-height: 28px;
    private property <float> wheel-delta-remainder: 0;
    private property <float> wheel-delta-threshold: 120;
    private property <int> wheel-lines-per-notch: 6;
    private property <int> selection-anchor-row: -1;
    private property <int> selection-anchor-col: -1;
    private property <int> selection-focus-row: -1;
    private property <int> selection-focus-col: -1;
    private property <bool> selection-drag-active: false;
    private property <bool> link-open-candidate: false;
    private property <bool> link-press-active: false;
    private property <bool> scrollbar-thumb-drag-active: false;
    private property <bool> cursor-blink-visible: true;
    in-out property <bool> context-menu-open: false;
    private property <length> terminal-context-menu-x: 12px;
    private property <length> terminal-context-menu-y: 12px;
    private property <length> terminal-link-tooltip-x: 12px;
    private property <length> terminal-link-tooltip-y: 12px;
    private property <bool> connection-progress-diagnostics-expanded: false;

    function terminal-content-width() -> length {
        return max(
            0px,
            root.width - root.terminal-padding-left - root.terminal-padding-right
                - (root.scrollbar-visible() ? root.scrollbar-reserved-width : 0px),
        );
    }

    function terminal-content-height() -> length {
        return max(0px, root.height - root.terminal-padding-top - root.terminal-padding-bottom);
    }

    function terminal-grid-width() -> length {
        return root.session-cols * root.terminal-cell-width;
    }

    function terminal-grid-height() -> length {
        return root.session-rows * root.terminal-cell-height;
    }

    function terminal-visible-grid-width() -> length {
        return min(root.terminal-grid-width(), root.terminal-content-width());
    }

    function terminal-visible-grid-height() -> length {
        return min(root.terminal-grid-height(), root.terminal-content-height());
    }

    function snap-length-to-device-pixel(value: length) -> length {
        let scale = max(1.0, root.session-device-scale-factor);
        return (Math.floor(((value / 1px) * scale) + 0.5) / scale) * 1px;
    }

    function terminal-surface-origin-x() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-padding-left);
    }

    function terminal-surface-origin-y() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-padding-top);
    }

    function snapped-terminal-visible-grid-width() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-visible-grid-width());
    }

    function snapped-terminal-visible-grid-height() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-visible-grid-height());
    }

    function snapped-terminal-content-width() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-content-width());
    }

    function snapped-terminal-content-height() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-content-height());
    }

    function preferred-terminal-content-width() -> length {
        return root.snap-length-to-device-pixel(root.terminal-content-width());
    }

    function preferred-terminal-content-height() -> length {
        return root.snap-length-to-device-pixel(root.terminal-content-height());
    }

    function preferred-terminal-row-count() -> int {
        return max(
            1,
            (root.preferred-terminal-content-height() / 1px) / (root.terminal-cell-height / 1px),
        );
    }

    function preferred-terminal-col-count() -> int {
        return max(
            1,
            (root.preferred-terminal-content-width() / 1px) / (root.terminal-cell-width / 1px),
        );
    }

    function terminal-viewport-rows() -> int {
        return root.preferred-terminal-row-count();
    }

    function terminal-viewport-cols() -> int {
        return root.preferred-terminal-col-count();
    }

    function scrollbar-visible() -> bool {
        return !root.session-mouse-grabbed && root.session-viewport-max-offset-lines > 0;
    }

    function scrollbar-track-x() -> length {
        return root.width - root.terminal-padding-right - root.scrollbar-track-width;
    }

    function scrollbar-track-y() -> length {
        return root.terminal-surface-origin-y();
    }

    function scrollbar-track-height() -> length {
        return root.terminal-visible-grid-height();
    }

    function scrollbar-thumb-height() -> length {
        return min(
            root.scrollbar-track-height(),
            max(
                root.scrollbar-thumb-min-height,
                (root.scrollbar-track-height() * max(1, root.session-rows))
                    / max(1, root.session-rows + root.session-viewport-max-offset-lines),
            ),
        );
    }

    function scrollbar-thumb-y() -> length {
        return root.scrollbar-track-y()
            + max(
                0px,
                ((root.scrollbar-track-height() - root.scrollbar-thumb-height())
                    * max(0, root.session-viewport-max-offset-lines - root.session-viewport-offset-lines))
                    / max(1, root.session-viewport-max-offset-lines),
            );
    }

    function scroll-ratio-for-track-position(pointer-y: length) -> float {
        return min(
            1.0,
            max(
                0.0,
                1.0 - ((pointer-y - root.scrollbar-track-y())
                    / max(1px, root.scrollbar-track-height() - root.scrollbar-thumb-height())),
            ),
        );
    }

    function accumulated-wheel-lines() -> int {
        return root.wheel-delta-remainder >= 0
            ? Math.floor(root.wheel-delta-remainder)
            : -Math.floor(-root.wheel-delta-remainder);
    }

    function terminal-cell-x(col: int) -> length {
        return root.snap-length-to-device-pixel(root.terminal-surface-origin-x() + (col * root.terminal-cell-width));
    }

    function terminal-cell-y(row: int) -> length {
        return root.snap-length-to-device-pixel(root.terminal-surface-origin-y() + (row * root.terminal-cell-height));
    }

    function terminal-local-cell-x(col: int) -> length {
        return root.snap-length-to-device-pixel(col * root.terminal-cell-width);
    }

    function terminal-local-cell-y(row: int) -> length {
        return root.snap-length-to-device-pixel(row * root.terminal-cell-height);
    }

    function selection-overlay-active() -> bool {
        return root.session-render-mode == "bitmap" && root.selection-active
            && root.selection-start-row >= 0 && root.selection-start-col >= 0
            && root.selection-end-row >= root.selection-start-row
            && root.selection-end-col >= 0;
    }

    function selection-span-x(start-col: int) -> length {
        return root.terminal-cell-x(max(0, min(root.session-cols, start-col)));
    }

    function selection-span-width(start-col: int, end-col: int) -> length {
        let clamped-start-col = max(0, min(root.session-cols, start-col));
        let clamped-end-col = max(clamped-start-col, min(root.session-cols, end-col));
        return max(
            0px,
            root.terminal-cell-x(clamped-end-col) - root.terminal-cell-x(clamped-start-col),
        );
    }

    function selection-span-height(start-row: int, end-row: int) -> length {
        let clamped-start-row = max(0, min(root.session-rows, start-row));
        let clamped-end-row = max(clamped-start-row, min(root.session-rows, end-row + 1));
        return max(
            0px,
            root.terminal-cell-y(clamped-end-row) - root.terminal-cell-y(clamped-start-row),
        );
    }

    function selection-local-span-x(start-col: int) -> length {
        return root.terminal-local-cell-x(max(0, min(root.session-cols, start-col)));
    }

    function selection-local-span-width(start-col: int, end-col: int) -> length {
        let clamped-start-col = max(0, min(root.session-cols, start-col));
        let clamped-end-col = max(clamped-start-col, min(root.session-cols, end-col));
        return max(
            0px,
            root.terminal-local-cell-x(clamped-end-col) - root.terminal-local-cell-x(clamped-start-col),
        );
    }

    function selection-local-span-height(start-row: int, end-row: int) -> length {
        let clamped-start-row = max(0, min(root.session-rows, start-row));
        let clamped-end-row = max(clamped-start-row, min(root.session-rows, end-row + 1));
        return max(
            0px,
            root.terminal-local-cell-y(clamped-end-row) - root.terminal-local-cell-y(clamped-start-row),
        );
    }

    function command-block-gutter-x() -> length {
        return max(
            0px,
            root.terminal-surface-origin-x() - root.command-gutter-width - root.command-gutter-gap,
        );
    }

    function command-block-local-y(start-row: int) -> length {
        return max(
            0px,
            min(
                root.snapped-terminal-visible-grid-height(),
                root.terminal-local-cell-y(max(0, start-row)) + 2px,
            ),
        );
    }

    function command-block-local-height(start-row: int, end-row: int) -> length {
        let y = root.command-block-local-y(start-row);
        let raw-height = max(
            root.command-gutter-min-height,
            root.selection-local-span-height(start-row, end-row) - 4px,
        );
        return max(
            0px,
            min(root.snapped-terminal-visible-grid-height() - y, raw-height),
        );
    }

    function overview-ruler-x() -> length {
        return root.scrollbar-visible()
            ? root.scrollbar-track-x() - root.overview-ruler-gap - root.overview-ruler-width
            : root.width - root.terminal-padding-right - root.overview-ruler-width;
    }

    function overview-marker-local-y(row: int) -> length {
        return max(
            0px,
            min(
                max(0px, root.snapped-terminal-visible-grid-height() - root.overview-marker-height),
                root.terminal-local-cell-y(max(0, row)) + 2px,
            ),
        );
    }

    function terminal-hit-row(pointer-y: length) -> int {
        return max(0, min(
            root.session-rows - 1,
            Math.floor((pointer-y / 1px) / (root.terminal-cell-height / 1px)),
        ));
    }

    function terminal-hit-col(pointer-x: length) -> int {
        return max(0, min(
            root.session-cols - 1,
            Math.floor((pointer-x / 1px) / (root.terminal-cell-width / 1px)),
        ));
    }

    function terminal-selection-hit-col(pointer-x: length) -> int {
        return max(0, min(
            root.session-cols,
            Math.floor(((pointer-x / 1px) / (root.terminal-cell-width / 1px)) + 0.5),
        ));
    }

    function is-copy-shortcut-key(text: string) -> bool {
        return text == "c" || text == "C" || text == "\u{3}";
    }

    function is-paste-shortcut-key(text: string) -> bool {
        return text == "v" || text == "V" || text == "\u{16}";
    }

    function terminal-local-action-id(text: string) -> string {
        if text == "t" || text == "T" {
            return "new-tab";
        }
        if text == "w" || text == "W" {
            return "close-tab";
        }
        if text == "p" || text == "P" {
            return "toggle-global-menu";
        }
        if text == "f" || text == "F" {
            return "toggle-asset-search";
        }
        if text == "m" || text == "M" {
            return "toggle-workspace-focus-mode";
        }
        return "";
    }

    function emit-surface-resize() {
        if root.mode == "terminal" {
            root.surface-resize-requested(
                root.terminal-viewport-rows(),
                root.terminal-viewport-cols(),
            );
        }
    }

    function schedule-surface-resize() {
        if root.mode != "terminal" {
            surface-resize-coalesce-timer.stop();
            return;
        }
        surface-resize-coalesce-timer.restart();
    }

    function clear-selection() {
        root.selection-anchor-row = -1;
        root.selection-anchor-col = -1;
        root.selection-focus-row = -1;
        root.selection-focus-col = -1;
        root.selection-drag-active = false;
        root.link-open-candidate = false;
        root.link-press-active = false;
        root.sync-selection-state();
    }

    function sync-selection-state() {
        let next-active = root.has-selection();
        let next-start-row = next-active ? root.normalized-selection-start-row() : -1;
        let next-start-col = next-active ? root.normalized-selection-start-col() : -1;
        let next-end-row = next-active ? root.normalized-selection-end-row() : -1;
        let next-end-col = next-active ? root.normalized-selection-end-col() : -1;
        let changed = root.selection-active != next-active
            || root.selection-start-row != next-start-row
            || root.selection-start-col != next-start-col
            || root.selection-end-row != next-end-row
            || root.selection-end-col != next-end-col;

        if root.has-selection() {
            root.selection-active = next-active;
            root.selection-start-row = next-start-row;
            root.selection-start-col = next-start-col;
            root.selection-end-row = next-end-row;
            root.selection-end-col = next-end-col;
        } else {
            root.selection-active = next-active;
            root.selection-start-row = next-start-row;
            root.selection-start-col = next-start-col;
            root.selection-end-row = next-end-row;
            root.selection-end-col = next-end-col;
        }

        if changed {
            root.selection-changed();
        }
    }

    function close-context-menu() {
        root.context-menu-open = false;
        root.link-open-candidate = false;
        root.link-press-active = false;
    }

    function terminal-link-tooltip-text() -> string {
        return root.link-armed ? "Ctrl+click to open link" : "Hold Ctrl and click to open link";
    }

    function terminal-link-tooltip-visible() -> bool {
        return root.mode == "terminal"
            && root.link-hovered
            && !root.selection-drag-active
            && !root.context-menu-open;
    }

    function has-selection() -> bool {
        return root.selection-anchor-row >= 0
            && root.selection-focus-row >= 0
            && (root.ordered-selection-start-row() != root.ordered-selection-end-row()
                || root.ordered-selection-start-col() != root.ordered-selection-end-col());
    }

    function ordered-selection-start-row() -> int {
        return root.selection-anchor-row < root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col <= root.selection-focus-col)
            ? root.selection-anchor-row
            : root.selection-focus-row;
    }

    function ordered-selection-start-col() -> int {
        return root.selection-anchor-row < root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col <= root.selection-focus-col)
            ? root.selection-anchor-col
            : root.selection-focus-col;
    }

    function ordered-selection-end-row() -> int {
        return root.selection-anchor-row > root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col > root.selection-focus-col)
            ? root.selection-anchor-row
            : root.selection-focus-row;
    }

    function ordered-selection-end-col() -> int {
        return root.selection-anchor-row > root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col > root.selection-focus-col)
            ? root.selection-anchor-col
            : root.selection-focus-col;
    }

    function normalized-selection-start-row() -> int {
        return root.ordered-selection-start-row();
    }

    function normalized-selection-start-col() -> int {
        return root.ordered-selection-start-col();
    }

    function normalized-selection-end-row() -> int {
        return root.ordered-selection-end-row();
    }

    function normalized-selection-end-col() -> int {
        return root.ordered-selection-end-col();
    }

    function selection-copy-enabled() -> bool {
        return root.has-selection();
    }

    function cell-selected(row: int, col: int, width: int) -> bool {
        if !root.has-selection() {
            return false;
        }
        let start-row = root.normalized-selection-start-row();
        let end-row = root.normalized-selection-end-row();
        if row < start-row || row > end-row {
            return false;
        }
        let row-start-col = row == start-row ? root.normalized-selection-start-col() : 0;
        let row-end-col = row == end-row ? root.normalized-selection-end-col() : root.session-cols;
        let cell-end-col = col + width;
        return cell-end-col > row-start-col && col < row-end-col;
    }

    function terminal-menu-width() -> length {
        return 168px;
    }

    function terminal-menu-height() -> length {
        return 148px;
    }

    function search-match-summary() -> string {
        if root.session-search-query == "" {
            return "Find in terminal";
        }
        if root.session-search-match-count == 1 {
            return "1 match";
        }
        if root.session-search-match-count == 0 {
            return "No matches";
        }
        return "" + root.session-search-match-count + " matches";
    }

    function open-context-menu(pointer-x: length, pointer-y: length) {
        root.context-menu-open = true;
        root.terminal-context-menu-x = min(
            max(12px, pointer-x),
            max(12px, root.width - root.terminal-menu-width() - 12px),
        );
        root.terminal-context-menu-y = min(
            max(12px, pointer-y),
            max(12px, root.height - root.terminal-menu-height() - 12px),
        );
    }

    function connection-progress-headline-label() -> string {
        if root.connection-progress-headline == "waiting-user" {
            return "Waiting for Your Input";
        }
        if root.connection-progress-headline == "connected" {
            return "Connected";
        }
        if root.connection-progress-headline == "cancelled" {
            return "Cancelled";
        }
        if root.connection-progress-headline == "error" {
            return "Connection Failed";
        }
        return "Connecting";
    }

    function connection-progress-shows-cancel() -> bool {
        return root.connection-progress-headline == "connecting"
            || root.connection-progress-headline == "waiting-user";
    }

    function connection-progress-shows-retry() -> bool {
        return root.connection-progress-headline == "error"
            || root.connection-progress-headline == "cancelled";
    }

    function connection-progress-has-host-key-prompt() -> bool {
        return root.connection-progress-host-key-prompt-host != "";
    }

    width: 100%;
    height: 100%;
    min-width: 0px;
    background: transparent;

    changed mode => {
        root.close-context-menu();
        root.clear-selection();
        root.connection-progress-diagnostics-expanded = false;
        if root.mode == "terminal" {
            root.schedule-surface-resize();
        } else {
            surface-resize-coalesce-timer.stop();
        }
    }

    changed session-id => {
        root.close-context-menu();
        root.clear-selection();
        root.connection-progress-diagnostics-expanded = false;
        if root.mode == "terminal" && root.session-id != "" {
            root.schedule-surface-resize();
        }
    }

    changed session-surface-seqno => {
        root.cursor-blink-visible = true;
        cursor-blink-timer.stop();
        if root.mode == "terminal" && root.session-render-mode == "bitmap" && root.session-cursor-visible && root.session-cursor-blinking {
            cursor-blink-timer.start();
        }
    }

    changed width => {
        root.schedule-surface-resize();
    }

    changed height => {
        root.schedule-surface-resize();
    }

    changed terminal-cell-width => {
        root.schedule-surface-resize();
    }

    changed terminal-cell-height => {
        root.schedule-surface-resize();
    }

    changed context-menu-open => {
        root.context-menu-open-changed(root.context-menu-open);
    }

    changed session-search-open => {
        if !root.session-search-open && root.mode == "terminal" {
            terminal-input.focus();
        }
    }

    cursor-blink-timer := Timer {
        interval: 520ms;
        running: false;

        triggered => {
            if root.mode != "terminal" || root.session-render-mode != "bitmap" || !root.session-cursor-visible || !root.session-cursor-blinking {
                self.running = false;
                root.cursor-blink-visible = true;
            } else {
                root.cursor-blink-visible = !root.cursor-blink-visible;
                self.restart();
            }
        }
    }

    surface-resize-coalesce-timer := Timer {
        interval: 48ms;
        running: false;

        triggered => {
            root.emit-surface-resize();
        }
    }

    terminal-input := TextInput {
            x: 0px;
            y: 0px;
            width: 1px;
            height: 1px;
            text: "";
            color: transparent;

            edited => {
                if self.text != "" {
                    root.text-input(self.text);
                    self.text = "";
                }
            }

            key-pressed(event) => {
                if (event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt) {
                    accept
                } else if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                    && (event.text == "f" || event.text == "F" || event.text == "\u{6}")) {
                    root.search-open-requested();
                    accept
                } else if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && root.is-copy-shortcut-key(event.text)) {
                    if root.has-selection() {
                        root.copy-selection-requested(
                            root.normalized-selection-start-row(),
                            root.normalized-selection-start-col(),
                            root.normalized-selection-end-row(),
                            root.normalized-selection-end-col(),
                        );
                        accept
                    } else {
                        reject
                    }
                } else if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && root.is-paste-shortcut-key(event.text)) {
                    root.paste-requested();
                    accept
                } else if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && root.terminal-local-action-id(event.text) != "") {
                    root.local-action-requested(root.terminal-local-action-id(event.text));
                    accept
                } else if (event.modifiers.control && event.text == Key.Insert
                    && !event.modifiers.shift && !event.modifiers.alt) {
                    if root.has-selection() {
                        root.copy-selection-requested(
                            root.normalized-selection-start-row(),
                            root.normalized-selection-start-col(),
                            root.normalized-selection-end-row(),
                            root.normalized-selection-end-col(),
                        );
                        accept
                    } else {
                        reject
                    }
                } else if (!event.modifiers.control && !event.modifiers.alt && event.modifiers.shift && event.text == Key.Insert) {
                    root.paste-requested();
                    accept
                } else if (event.modifiers.shift && event.text == Key.PageUp
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.scroll-requested(max(1, root.session-rows - 2), 0, 0, true, false, false);
                    accept
                } else if (event.modifiers.shift && event.text == Key.PageDown
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.scroll-requested(-max(1, root.session-rows - 2), 0, 0, true, false, false);
                    accept
                } else if (event.modifiers.shift && event.text == Key.Home
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.scroll-jump-requested(1.0);
                    accept
                } else if (event.modifiers.shift && event.text == Key.End
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.scroll-jump-requested(0.0);
                    accept
                } else if (event.text == Key.Return) {
                    root.key-input("enter", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Tab) {
                    root.key-input("tab", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Backtab) {
                    root.key-input("tab", event.modifiers.alt, event.modifiers.control, true);
                    accept
                } else if (event.text == Key.Escape && root.session-search-open) {
                    root.search-close-requested();
                    accept
                } else if (event.text == Key.Escape) {
                    root.close-context-menu();
                    root.key-input("escape", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Backspace) {
                    root.key-input("backspace", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Delete) {
                    root.key-input("delete", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.UpArrow) {
                    root.key-input("up", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.DownArrow) {
                    root.key-input("down", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.LeftArrow) {
                    root.key-input("left", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.RightArrow) {
                    root.key-input("right", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Home) {
                    root.key-input("home", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.End) {
                    root.key-input("end", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.PageUp) {
                    root.key-input("page-up", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.PageDown) {
                    root.key-input("page-down", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Insert) {
                    root.key-input("insert", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F1) {
                    root.key-input("f1", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F2) {
                    root.key-input("f2", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F3) {
                    root.key-input("f3", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F4) {
                    root.key-input("f4", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F5) {
                    root.key-input("f5", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F6) {
                    root.key-input("f6", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F7) {
                    root.key-input("f7", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F8) {
                    root.key-input("f8", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F9) {
                    root.key-input("f9", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F10) {
                    root.key-input("f10", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F11) {
                    root.key-input("f11", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F12) {
                    root.key-input("f12", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F13) {
                    root.key-input("f13", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F14) {
                    root.key-input("f14", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F15) {
                    root.key-input("f15", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F16) {
                    root.key-input("f16", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F17) {
                    root.key-input("f17", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F18) {
                    root.key-input("f18", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F19) {
                    root.key-input("f19", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F20) {
                    root.key-input("f20", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F21) {
                    root.key-input("f21", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F22) {
                    root.key-input("f22", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F23) {
                    root.key-input("f23", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F24) {
                    root.key-input("f24", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if ((event.modifiers.control || event.modifiers.alt) && event.text != "") {
                    root.key-input(event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else {
                    reject
                }
            }
        }

    if root.mode == "welcome" : WelcomeView {
        width: parent.width;
        height: parent.height;
        recent-items: root.welcome-quick-launch-recent-items;
        favorite-items: root.welcome-quick-launch-favorite-items;
        group-items: root.welcome-quick-launch-group-items;
        visible-group-items: root.welcome-quick-launch-visible-group-items;
        selected-detail: root.welcome-quick-launch-selected-detail;
        search-query: root.welcome-quick-launch-search-query;

        asset-selected(asset-id) => {
            root.welcome-quick-launch-asset-selected(asset-id);
        }

        search-changed(query) => {
            root.welcome-quick-launch-search-changed(query);
        }

        connect-requested(asset-id) => {
            root.welcome-quick-launch-connect-requested(asset-id);
        }

        connect-in-new-tab-requested(asset-id) => {
            root.welcome-quick-launch-connect-in-new-tab-requested(asset-id);
        }

        toggle-favorite-requested(asset-id) => {
            root.welcome-quick-launch-toggle-favorite-requested(asset-id);
        }

        reveal-in-assets-requested(asset-id) => {
            root.welcome-quick-launch-reveal-in-assets-requested(asset-id);
        }

        open-saved-ssh-requested => {
            root.welcome-open-saved-ssh-requested();
        }
    }

    if root.mode == "terminal" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        search-bar := Rectangle {
            visible: root.session-search-open;
            x: max(14px, parent.width - self.width - 16px);
            y: 14px;
            width: min(352px, max(248px, parent.width * 0.28));
            height: 38px;
            private property <int> focus-sequence: root.session-search-focus-sequence;
            border-radius: 10px;
            border-width: 1px;
            border-color: search-input.has-focus ? ThemeTokens.input-focus-ring : ThemeTokens.input-border;
            background: ThemeTokens.input-surface;
            z: 20;

            glow-frame := Rectangle {
                x: -1px;
                y: -1px;
                width: parent.width + 2px;
                height: parent.height + 2px;
                border-radius: parent.border-radius + 1px;
                border-width: 1px;
                border-color: ThemeTokens.input-focus-ring;
                background: transparent;
                opacity: search-input.has-focus ? (ThemeTokens.dark-mode ? 0.24 : 0.16) : 0;
            }

            search-input := TextInput {
                x: 12px;
                y: 7px;
                width: max(48px, parent.width - 112px);
                height: parent.height - 14px;
                text: root.session-search-query;
                color: ThemeTokens.text-primary;
                selection-background-color: ThemeTokens.focus-ring;
                selection-foreground-color: ThemeTokens.text-primary;

                edited => {
                    root.search-query-changed(self.text);
                }

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.search-close-requested();
                        accept
                    } else if (event.text == Key.Return) {
                        root.search-query-changed(self.text);
                        accept
                    } else {
                        reject
                    }
                }
            }

            if search-input.text == "" : placeholder := Text {
                x: search-input.x;
                y: search-input.y;
                width: search-input.width;
                height: search-input.height;
                text: "Find in terminal";
                color: ThemeTokens.text-muted;
                vertical-alignment: center;
            }

            match-count := Text {
                x: parent.width - 90px;
                y: 0px;
                width: 52px;
                height: parent.height;
                text: root.search-match-summary();
                color: root.session-search-query != "" && root.session-search-match-count == 0
                    ? ThemeTokens.status-error-accent
                    : ThemeTokens.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-size: 11px;
            }

            close-touch := TouchArea {
                x: parent.width - 34px;
                y: 5px;
                width: 28px;
                height: 28px;

                clicked => {
                    root.search-close-requested();
                }
            }

            close-glyph := Text {
                x: close-touch.x;
                y: close-touch.y;
                width: close-touch.width;
                height: close-touch.height;
                text: "×";
                color: close-touch.has-hover ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 16px;
            }

            changed focus-sequence => {
                if root.session-search-open {
                    search-input.focus();
                }
            }

        }

        surface-frame := Rectangle {
            width: parent.width;
            height: parent.height;
            clip: true;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: root.session-render-mode == "native"
                ? root.session-default-bg
                : ThemeTokens.panel-surface;

            blank-surface := Rectangle {
                x: root.terminal-surface-origin-x();
                y: root.terminal-surface-origin-y();
                width: root.snapped-terminal-content-width();
                height: root.snapped-terminal-content-height();
                clip: true;
                background: root.session-default-bg;

                Image {
                    x: 0px;
                    y: 0px;
                    width: root.session-render-mode == "native" ? parent.width : root.terminal-grid-width();
                    height: root.session-render-mode == "native" ? parent.height : root.terminal-grid-height();
                    source: root.session-surface-image;
                    image-fit: fill;
                    image-rendering: root.session-render-mode == "native" ? smooth : pixelated;
                    visible: root.session-render-mode == "bitmap" || root.session-render-mode == "native";
                }

                if root.selection-overlay-active() && root.selection-start-row == root.selection-end-row : selection-overlay-single-row := Rectangle {
                    x: root.selection-local-span-x(root.selection-start-col);
                    y: root.terminal-local-cell-y(root.selection-start-row);
                    width: root.selection-local-span-width(root.selection-start-col, root.selection-end-col);
                    height: root.selection-local-span-height(root.selection-start-row, root.selection-start-row);
                    background: ThemeTokens.terminal-selection-surface;
                }

                if root.selection-overlay-active() && root.selection-start-row < root.selection-end-row : selection-overlay-first-row := Rectangle {
                    x: root.selection-local-span-x(root.selection-start-col);
                    y: root.terminal-local-cell-y(root.selection-start-row);
                    width: root.selection-local-span-width(root.selection-start-col, root.session-cols);
                    height: root.selection-local-span-height(root.selection-start-row, root.selection-start-row);
                    background: ThemeTokens.terminal-selection-surface;
                }

                if root.selection-overlay-active() && root.selection-start-row + 1 < root.selection-end-row : selection-overlay-middle-rows := Rectangle {
                    x: root.selection-local-span-x(0);
                    y: root.terminal-local-cell-y(root.selection-start-row + 1);
                    width: root.selection-local-span-width(0, root.session-cols);
                    height: root.selection-local-span-height(
                        root.selection-start-row + 1,
                        root.selection-end-row - 1,
                    );
                    background: ThemeTokens.terminal-selection-surface;
                }

                if root.selection-overlay-active() && root.selection-start-row < root.selection-end-row : selection-overlay-last-row := Rectangle {
                    x: root.selection-local-span-x(0);
                    y: root.terminal-local-cell-y(root.selection-end-row);
                    width: root.selection-local-span-width(0, root.selection-end-col);
                    height: root.selection-local-span-height(root.selection-end-row, root.selection-end-row);
                    background: ThemeTokens.terminal-selection-surface;
                }

                input-capture := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: root.link-hovered
                        && !root.selection-drag-active
                        && !root.context-menu-open
                        ? MouseCursor.pointer
                        : MouseCursor.text;

                    scroll-event(event) => {
                        if event.delta-y > 0px || event.delta-y < 0px {
                            let row = root.terminal-hit-row(self.mouse-y);
                            let col = root.normalize-hit-col(
                                row,
                                root.terminal-hit-col(self.mouse-x),
                            );
                            root.wheel-delta-remainder = root.wheel-delta-remainder
                                + (((event.delta-y / 1px) / root.wheel-delta-threshold)
                                    * root.wheel-lines-per-notch);
                            let delta-lines = root.accumulated-wheel-lines();
                            terminal-input.focus();
                            root.close-context-menu();
                            if delta-lines != 0 {
                                root.wheel-delta-remainder = root.wheel-delta-remainder - delta-lines;
                                root.scroll-requested(
                                    delta-lines,
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            }
                            return accept;
                        }
                        reject
                    }

                    pointer-event(event) => {
                        let row = root.terminal-hit-row(self.mouse-y);
                        let col = root.normalize-hit-col(
                            row,
                            root.terminal-hit-col(self.mouse-x),
                        );
                        let selection-col = root.normalize-selection-hit-col(
                            row,
                            root.terminal-selection-hit-col(self.mouse-x),
                        );
                        root.terminal-link-tooltip-x = self.mouse-x + 14px;
                        root.terminal-link-tooltip-y = self.mouse-y + 14px;
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            terminal-input.focus();
                            root.close-context-menu();
                            if root.session-mouse-grabbed {
                                root.mouse-input(
                                    "down",
                                    "left",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else if root.link-armed {
                                root.link-open-candidate = true;
                                root.link-press-active = true;
                                root.mouse-input(
                                    "down",
                                    "left",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else {
                                root.selection-anchor-row = row;
                                root.selection-anchor-col = col;
                                root.selection-focus-row = row;
                                root.selection-focus-col = col;
                                root.selection-drag-active = true;
                                root.sync-selection-state();
                            }
                        } else if event.kind == PointerEventKind.move {
                            if root.session-mouse-grabbed {
                                root.mouse-input(
                                    "move",
                                    "none",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else {
                                root.mouse-input(
                                    "move",
                                    "none",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                                if root.link-open-candidate {
                                    root.link-open-candidate = false;
                                    root.link-press-active = false;
                                }
                                if root.selection-drag-active {
                                    terminal-input.focus();
                                    root.selection-focus-row = row;
                                    root.selection-focus-col = selection-col;
                                    root.sync-selection-state();
                                }
                            }
                        } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                            terminal-input.focus();
                            if root.session-mouse-grabbed {
                                root.mouse-input(
                                    "up",
                                    "left",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else if root.link-open-candidate {
                                root.link-open-candidate = false;
                                root.link-press-active = false;
                                root.mouse-input(
                                    "up",
                                    "left",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else {
                                if root.selection-anchor-row == root.selection-focus-row
                                    && root.selection-anchor-col == root.selection-focus-col {
                                    root.clear-selection();
                                }
                                root.selection-drag-active = false;
                            }
                        } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            terminal-input.focus();
                            if root.session-mouse-grabbed {
                                root.mouse-input(
                                    "down",
                                    "right",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else {
                                root.open-context-menu(
                                    root.terminal-surface-origin-x() + self.mouse-x,
                                    root.terminal-surface-origin-y() + self.mouse-y,
                                );
                            }
                        } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right && root.session-mouse-grabbed {
                            root.mouse-input(
                                "up",
                                "right",
                                row,
                                col,
                                event.modifiers.shift,
                                event.modifiers.control,
                                event.modifiers.alt,
                            );
                        }
                    }
                }

                if root.terminal-link-tooltip-visible() : link-tooltip := Rectangle {
                    x: min(max(8px, root.terminal-link-tooltip-x), max(8px, parent.width - self.width - 8px));
                    y: min(
                        max(8px, root.terminal-link-tooltip-y + (root.link-press-active ? 2px : 0px)),
                        max(8px, parent.height - self.height - 8px),
                    );
                    width: max(168px, link-tooltip-label.preferred-width + 20px);
                    height: max(28px, link-tooltip-label.preferred-height + 10px);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.link-press-active || root.link-armed
                        ? ThemeTokens.link-accent
                        : ThemeTokens.divider-subtle;
                    background: root.link-press-active
                        ? ThemeTokens.control-active-surface
                        : root.link-armed
                            ? ThemeTokens.menu-row-open-surface
                            : ThemeTokens.menu-row-hover-surface;
                    opacity: root.link-press-active ? 0.94 : 1;
                    animate y { duration: 90ms; easing: ease-out; }
                    animate opacity { duration: 90ms; }

                    link-tooltip-label := Text {
                        x: 10px;
                        y: 0px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: root.terminal-link-tooltip-text();
                        color: ThemeTokens.text-primary;
                        vertical-alignment: center;
                    }
                }
            }

            if root.session-overview-markers.length > 0 : overview-ruler := Rectangle {
                x: root.overview-ruler-x();
                y: root.terminal-surface-origin-y();
                width: root.overview-ruler-width;
                height: root.snapped-terminal-visible-grid-height();
                border-radius: parent.width / 2;
                background: ThemeTokens.terminal-scrollbar-track-surface;
                opacity: 0.42;

                for marker in root.session-overview-markers : Rectangle {
                    x: 0px;
                    y: root.overview-marker-local-y(marker.row);
                    width: parent.width;
                    height: root.overview-marker-height;
                    border-radius: parent.width / 2;
                    background: marker.kind == "command_failure"
                        ? ThemeTokens.status-error-accent
                        : marker.kind == "command_running"
                            ? ThemeTokens.status-busy-accent
                            : ThemeTokens.status-success-accent;
                    opacity: marker.kind == "command_running" ? 1.0 : 0.9;
                }
            }

            if root.session-render-mode == "bitmap" && root.session-cursor-visible && root.cursor-blink-visible : cursor-overlay := Rectangle {
                x: root.terminal-cell-x(root.session-cursor-col);
                width: root.session-cursor-shape == "bar"
                    ? root.terminal-cursor-thickness
                    : root.terminal-cell-width;
                height: root.session-cursor-shape == "underline"
                    ? root.terminal-cursor-thickness
                    : root.terminal-cell-height;
                background: root.session-cursor-bg;
                opacity: root.session-cursor-shape == "block" ? 0.72 : 1.0;
                y: root.session-cursor-shape == "underline"
                    ? root.terminal-cell-y(root.session-cursor-row + 1) - root.terminal-cursor-thickness
                    : root.terminal-cell-y(root.session-cursor-row);
            }

            if root.scrollbar-visible() : scrollbar-track := Rectangle {
                x: root.scrollbar-track-x();
                y: root.scrollbar-track-y();
                width: root.scrollbar-track-width;
                height: root.scrollbar-track-height();
                border-radius: self.width / 2;
                background: scrollbar-track-touch.has-hover || root.scrollbar-thumb-drag-active
                    ? root.session-scrollbar-thumb
                    : ThemeTokens.terminal-scrollbar-track-surface;

                scrollbar-track-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            terminal-input.focus();
                            root.close-context-menu();
                            root.scroll-jump-requested(
                                root.scroll-ratio-for-track-position(
                                    self.mouse-y - root.scrollbar-thumb-height() / 2,
                                ),
                            );
                        }
                    }
                }

                scrollbar-thumb := Rectangle {
                    x: 0px;
                    y: root.scrollbar-thumb-y() - root.scrollbar-track-y();
                    width: parent.width;
                    height: root.scrollbar-thumb-height();
                    border-radius: self.width / 2;
                    background: scrollbar-thumb-touch.has-hover || root.scrollbar-thumb-drag-active
                        ? root.session-scrollbar-thumb-active
                        : root.session-scrollbar-thumb;

                    scrollbar-thumb-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                terminal-input.focus();
                                root.close-context-menu();
                                root.scrollbar-thumb-drag-active = true;
                                root.scroll-thumb-drag-requested(
                                    root.scroll-ratio-for-track-position(
                                        scrollbar-thumb.y + self.mouse-y - root.scrollbar-thumb-height() / 2,
                                    ),
                                );
                            } else if event.kind == PointerEventKind.move && root.scrollbar-thumb-drag-active {
                                root.scroll-thumb-drag-requested(
                                    root.scroll-ratio-for-track-position(
                                        scrollbar-thumb.y + self.mouse-y - root.scrollbar-thumb-height() / 2,
                                    ),
                                );
                            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                root.scrollbar-thumb-drag-active = false;
                            }
                        }
                    }
                }
            }

            if root.context-menu-open : terminal-context-menu-dismiss-layer := TouchArea {
                width: parent.width;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.close-context-menu();
                    }
                }
            }

            if root.context-menu-open : terminal-context-menu := Rectangle {
                x: root.terminal-context-menu-x;
                y: root.terminal-context-menu-y;
                width: root.terminal-menu-width();
                height: root.terminal-menu-height();
                border-radius: 8px;
                border-width: 1px;
                border-color: ThemeTokens.divider-strong;
                background: ThemeTokens.panel-surface;

                VerticalLayout {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    spacing: 4px;

                    copy-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Copy";
                        enabled: root.selection-copy-enabled();

                        invoked => {
                            root.close-context-menu();
                            root.copy-selection-requested(
                                root.normalized-selection-start-row(),
                                root.normalized-selection-start-col(),
                                root.normalized-selection-end-row(),
                                root.normalized-selection-end-col(),
                            );
                        }
                    }

                    paste-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Paste";

                        invoked => {
                            root.close-context-menu();
                            root.paste-requested();
                        }
                    }

                    select-all-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Select All";

                        invoked => {
                            root.close-context-menu();
                            root.selection-anchor-row = 0;
                            root.selection-anchor-col = 0;
                            root.selection-focus-row = max(0, root.session-rows - 1);
                            root.selection-focus-col = max(0, root.session-cols);
                            root.sync-selection-state();
                            terminal-input.focus();
                        }
                    }

                    find-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Find";

                        invoked => {
                            root.close-context-menu();
                            root.search-open-requested();
                        }
                    }
                }
            }

        }
    }

    if root.mode == "connection-progress" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 20px;
            padding-top: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
            spacing: 14px;

            header-card := Rectangle {
                width: parent.width;
                height: 92px;
                border-radius: 12px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.panel-surface;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 18px;
                    padding-top: 16px;
                    padding-right: 18px;
                    padding-bottom: 16px;
                    spacing: 6px;

                    Text {
                        text: root.session-title != "" ? root.session-title : "SSH Session";
                        color: ThemeTokens.text-primary;
                        font-size: 18px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.session-subtitle != "" ? root.session-subtitle : root.connection-progress-headline-label();
                        color: ThemeTokens.text-secondary;
                        font-size: 12px;
                    }

                    Text {
                        text: root.connection-progress-current-hop != ""
                            ? root.connection-progress-headline-label() + " · " + root.connection-progress-current-hop
                            : root.connection-progress-headline-label();
                        color: ThemeTokens.text-secondary;
                        font-size: 12px;
                    }
                }
            }

            timeline-card := Rectangle {
                width: parent.width;
                vertical-stretch: 1;
                border-radius: 12px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.panel-surface;
                clip: true;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 18px;
                    padding-top: 18px;
                    padding-right: 18px;
                    padding-bottom: 18px;
                    spacing: 12px;

                    for step in root.connection-progress-steps : Rectangle {
                        width: parent.width;
                        height: 56px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: step.state == "running"
                            ? ThemeTokens.focus-ring
                            : ThemeTokens.divider-subtle;
                        background: step.state == "running"
                            ? ThemeTokens.sidebar-selected-surface
                            : step.state == "failed"
                                ? ThemeTokens.status-error-surface
                                : step.state == "done"
                                    ? ThemeTokens.status-success-surface
                                    : ThemeTokens.input-surface;

                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 14px;
                            padding-top: 10px;
                            padding-right: 14px;
                            padding-bottom: 10px;
                            spacing: 12px;

                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                y: 6px;
                                background: step.state == "running"
                                    ? ThemeTokens.status-busy-accent
                                    : step.state == "failed"
                                        ? ThemeTokens.status-error-accent
                                        : step.state == "done"
                                            ? ThemeTokens.status-success-accent
                                            : ThemeTokens.divider-strong;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                Text {
                                    text: step.hop_label + " · " + step.title;
                                    color: ThemeTokens.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: step.detail;
                                    color: ThemeTokens.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            current-detail-card := Rectangle {
                width: parent.width;
                height: 54px;
                border-radius: 10px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.input-surface;

                Text {
                    x: 16px;
                    y: 0px;
                    width: parent.width - 32px;
                    height: parent.height;
                    text: root.connection-progress-current-detail != ""
                        ? root.connection-progress-current-detail
                        : "Preparing SSH connection timeline...";
                    color: ThemeTokens.text-secondary;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.connection-progress-has-host-key-prompt() : host-key-card := Rectangle {
                width: parent.width;
                height: 118px;
                border-radius: 10px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.input-surface;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 16px;
                    padding-top: 14px;
                    padding-right: 16px;
                    padding-bottom: 14px;
                    spacing: 10px;

                    Text {
                        text: "Verify Host Key";
                        color: ThemeTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.connection-progress-host-key-prompt-host;
                        color: ThemeTokens.text-secondary;
                        font-size: 11px;
                    }

                    Text {
                        text: root.connection-progress-host-key-prompt-fingerprint;
                        color: ThemeTokens.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        ConnectionProgressActionButton {
                            width: 144px;
                            label: "Trust and Continue";
                            primary: true;

                            clicked => {
                                root.local-action-requested("trust-host-key");
                            }
                        }

                        ConnectionProgressActionButton {
                            width: 88px;
                            label: "Reject";

                            clicked => {
                                root.local-action-requested("reject-host-key");
                            }
                        }
                    }
                }
            }

            if root.connection-progress-diagnostics.length > 0 : diagnostics-card := Rectangle {
                width: parent.width;
                height: root.connection-progress-diagnostics-expanded
                    ? min(180px, 44px + (root.connection-progress-diagnostics.length * 24px))
                    : 0px;
                clip: true;
                border-radius: 10px;
                border-width: root.connection-progress-diagnostics-expanded ? 1px : 0px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.input-surface;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 16px;
                    padding-top: 12px;
                    padding-right: 16px;
                    padding-bottom: 12px;
                    spacing: 6px;

                    for line in root.connection-progress-diagnostics : Text {
                        text: line.text;
                        color: ThemeTokens.text-secondary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            footer-row := HorizontalLayout {
                width: parent.width;
                spacing: 10px;

                if root.connection-progress-shows-cancel() : ConnectionProgressActionButton {
                    width: 88px;
                    label: "Cancel";
                    primary: false;

                    clicked => {
                        root.local-action-requested("cancel-connection-attempt");
                    }
                }

                if root.connection-progress-shows-retry() : ConnectionProgressActionButton {
                    width: 84px;
                    label: "Retry";
                    primary: true;

                    clicked => {
                        root.local-action-requested("retry-connection-attempt");
                    }
                }

                if root.connection-progress-shows-retry() : ConnectionProgressActionButton {
                    width: 124px;
                    label: "Edit Connection";

                    clicked => {
                        root.local-action-requested("edit-connection");
                    }
                }

                ConnectionProgressActionButton {
                    width: 134px;
                    enabled: root.connection-progress-diagnostics.length > 0;
                    label: root.connection-progress-diagnostics-expanded ? "Hide Diagnostics" : "Show Diagnostics";

                    clicked => {
                        root.connection-progress-diagnostics-expanded = !root.connection-progress-diagnostics-expanded;
                    }
                }

                ConnectionProgressActionButton {
                    width: 128px;
                    enabled: root.connection-progress-diagnostics.length > 0;
                    label: "Copy Diagnostics";

                    clicked => {
                        root.local-action-requested("copy-connection-diagnostics");
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }
        }
    }

    if root.mode == "session-error" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        VerticalLayout {
            padding-left: 16px;
            padding-top: 16px;
            padding-right: 16px;
            padding-bottom: 16px;
            spacing: 6px;

            Text {
                text: root.session-title != "" ? root.session-title : "Session Issue";
                color: ThemeTokens.text-primary;
                font-size: 16px;
                font-weight: 700;
            }

            Text {
                text: root.session-state == "disconnected" && root.can-reconnect ? "Connection dropped. Reconnect is available." :
                      root.session-state == "disconnected" ? "Connection dropped." :
                      root.session-state == "error" && root.session-error-detail != "" ? root.session-error-detail :
                      root.session-state == "error" ? "Connection failed." :
                      "Session is unavailable.";
                color: ThemeTokens.text-primary;
                font-size: 12px;
                wrap: word-wrap;
            }

        }
    }
}
