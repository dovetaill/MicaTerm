// Workspace content host that switches between welcome, terminal, and error states.

import { ThemeTokens } from "../theme/tokens.slint";
import { QuickLaunchCardRow } from "../welcome/quick-launch-types.slint";
import { WelcomeView } from "../welcome/welcome-view.slint";

component TerminalContextMenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> has-hover: touch.has-hover;
    callback invoked();

    height: 32px;
    border-radius: 6px;
    background: !root.enabled
        ? transparent
        : touch.pressed
            ? ThemeTokens.menu-row-open-surface
            : touch.has-hover
                ? ThemeTokens.menu-row-hover-surface
                : transparent;

    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        opacity: root.enabled ? 1.0 : 0.48;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.invoked();
        }
    }
}

export struct ConnectionProgressStepRow {
    state: string,
    hop_label: string,
    title: string,
    detail: string,
}

export struct ConnectionProgressDiagnosticRow {
    text: string,
}

export struct ConnectionProgressHopRow {
    kind: string,
    state: string,
    label: string,
    subtitle: string,
    host: string,
    port: string,
}

export struct ConnectionProgressFieldRow {
    label: string,
    value: string,
    copy_value: string,
    monospace: bool,
}

export struct TerminalCommandBlockRow {
    start_row: int,
    end_row: int,
    status: string,
    label: string,
}

export struct TerminalOverviewMarkerRow {
    row: int,
    kind: string,
}

component SshStatusText inherits Text {
    font-family: "Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif";
}

component ConnectionProgressDotRail inherits Rectangle {
    in property <brush> dot-color: ThemeTokens.ssh-status-hop-divider;

    width: 30px;
    height: 2px;
    background: transparent;

    Rectangle { x: 0px; y: 0px; width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; opacity: 0.52; }
    Rectangle { x: 7px; y: 0px; width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; opacity: 0.72; }
    Rectangle { x: 14px; y: 0px; width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; opacity: 0.9; }
    Rectangle { x: 21px; y: 0px; width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; opacity: 0.72; }
    Rectangle { x: 28px; y: 0px; width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; opacity: 0.52; }
}

component ConnectionProgressActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <string> tone: "secondary";
    in property <bool> show-icon: false;
    in property <image> icon-source;
    callback clicked();

    height: root.tone == "tertiary" ? 28px : 56px;
    border-radius: root.tone == "tertiary" ? 0px : 16px;
    border-width: root.tone == "tertiary" ? 0px : 1px;
    border-color: root.tone == "primary"
        ? ThemeTokens.ssh-status-green-surface
        : root.tone == "danger"
            ? ThemeTokens.ssh-status-danger-border
            : ThemeTokens.ssh-status-card-border;
    background: !root.enabled
        ? ThemeTokens.control-disabled-surface
        : button-touch.pressed
            ? root.tone == "primary"
                ? ThemeTokens.ssh-status-green-pressed-surface
                : root.tone == "tertiary"
                    ? transparent
                    : ThemeTokens.control-pressed-surface
            : button-touch.has-hover
                ? root.tone == "primary"
                    ? ThemeTokens.ssh-status-green-hover-surface
                    : root.tone == "tertiary"
                        ? transparent
                        : ThemeTokens.control-hover-surface
                : root.tone == "primary"
                    ? ThemeTokens.ssh-status-green-surface
                    : root.tone == "danger"
                        ? ThemeTokens.ssh-status-danger-surface
                        : root.tone == "tertiary"
                            ? transparent
                            : ThemeTokens.control-active-surface;

    if !root.show-icon : SshStatusText {
        x: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.tone == "primary"
            ? #f7fbf8
            : root.tone == "danger"
                ? ThemeTokens.text-primary
                : root.tone == "tertiary"
                    ? ThemeTokens.text-secondary
                    : ThemeTokens.text-primary;
        opacity: root.enabled ? 1.0 : 0.48;
        horizontal-alignment: root.tone == "tertiary" ? left : center;
        vertical-alignment: center;
        font-size: root.tone == "tertiary" ? 14px : 16px;
        font-weight: root.tone == "tertiary" ? 550 : 600;
    }

    if root.show-icon : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        HorizontalLayout {
            x: (parent.width - self.preferred-width) / 2;
            y: 0px;
            width: self.preferred-width;
            height: parent.height;
            spacing: 10px;

            Image {
                width: 18px;
                height: 18px;
                source: root.icon-source;
                image-fit: contain;
                colorize: root.tone == "primary" ? #f7fbf8 : ThemeTokens.text-primary;
                opacity: root.enabled ? 0.96 : 0.48;
            }

            SshStatusText {
                width: self.preferred-width;
                height: parent.height;
                text: root.label;
                color: root.tone == "primary" ? #f7fbf8 : ThemeTokens.text-primary;
                opacity: root.enabled ? 1.0 : 0.48;
                vertical-alignment: center;
                font-size: 16px;
                font-weight: 600;
            }
        }
    }

    button-touch := TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

component ConnectionProgressEscapeBlock inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <image> icon-source;
    callback clicked();

    width: max(164px, max(title-text.preferred-width, detail-text.preferred-width) + 30px);
    height: 44px;
    border-radius: 0px;
    border-width: 0px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 0px;
        padding-top: 4px;
        padding-right: 0px;
        padding-bottom: 4px;
        spacing: 8px;

        Rectangle {
            width: 18px;
            height: 18px;
            background: transparent;

            Rectangle {
                x: 1px;
                y: 1px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1px;
                border-color: ThemeTokens.text-secondary;
                background: transparent;
                opacity: 0.82;
            }

            Image {
                x: 4px;
                y: 4px;
                width: 10px;
                height: 10px;
                source: root.icon-source;
                image-fit: contain;
                colorize: ThemeTokens.text-secondary;
                opacity: 0.9;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;

            title-text := SshStatusText {
                height: 18px;
                text: root.title;
                color: ThemeTokens.text-primary;
                font-size: 14px;
                font-weight: 560;
                vertical-alignment: center;
            }

            detail-text := SshStatusText {
                height: 16px;
                text: root.detail;
                color: ThemeTokens.text-muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

export component TerminalSessionHost inherits Rectangle {
    in property <string> session-id: "";
    in property <string> mode: "welcome";
    in property <string> session-title: "";
    in property <string> session-subtitle: "";
    in property <string> session-state: "";
    in property <string> session-error-detail: "";
    in property <bool> can-reconnect: false;
    in property <string> session-render-mode: "bitmap";
    in property <string> connection-progress-headline: "";
    in property <string> connection-progress-visual-state: "";
    in property <string> connection-progress-current-hop: "";
    in property <string> connection-progress-current-detail: "";
    in property <string> connection-progress-page-mode: "";
    in property <string> connection-progress-task-title: "";
    in property <string> connection-progress-task-detail: "";
    in property <string> connection-progress-host-key-prompt-host: "";
    in property <string> connection-progress-host-key-prompt-fingerprint: "";
    in property <string> connection-progress-host-key-warning-host: "";
    in property <string> connection-progress-host-key-warning-expected: "";
    in property <string> connection-progress-host-key-warning-current: "";
    in property <[ConnectionProgressHopRow]> connection-progress-hops: [];
    in property <[ConnectionProgressStepRow]> connection-progress-steps: [];
    in property <[ConnectionProgressFieldRow]> connection-progress-main-fields: [];
    in property <[ConnectionProgressFieldRow]> connection-progress-detail-fields: [];
    in property <[ConnectionProgressDiagnosticRow]> connection-progress-diagnostics: [];
    in property <[QuickLaunchCardRow]> welcome-quick-launch-recent-items: [];
    in property <image> session-surface-image;
    in property <int> session-native-frame-token: 0;
    in property <int> session-rows: 24;
    in property <int> session-cols: 80;
    in property <length> session-cell-width: 10px;
    in property <length> session-cell-height: 22px;
    in property <int> session-cursor-row: 0;
    in property <int> session-cursor-col: 0;
    in property <bool> session-cursor-visible: false;
    in property <bool> session-cursor-blinking: false;
    in property <string> session-cursor-shape: "block";
    in property <color> session-cursor-fg: ThemeTokens.terminal-cursor-fg;
    in property <color> session-cursor-bg: ThemeTokens.terminal-cursor-bg;
    in property <color> session-default-fg: ThemeTokens.terminal-default-fg;
    in property <color> session-default-bg: ThemeTokens.terminal-default-bg;
    // Terminal frame, selection, and scrollbar colors stay session-scoped runtime values.
    in property <color> session-selection-surface: ThemeTokens.terminal-selection-surface;
    in property <color> session-scrollbar-track: ThemeTokens.terminal-scrollbar-track-surface;
    in property <color> session-scrollbar-thumb: ThemeTokens.terminal-scrollbar-thumb-surface;
    in property <color> session-scrollbar-thumb-active: ThemeTokens.terminal-scrollbar-thumb-active-surface;
    in property <color> session-frame-surface: ThemeTokens.terminal-frame-background;
    in property <color> session-frame-border: ThemeTokens.divider-subtle;
    in property <bool> session-mouse-grabbed: false;
    in property <bool> link-hovered: false;
    in property <bool> link-armed: false;
    in property <[string]> session-visible-lines: [];
    in property <[TerminalCommandBlockRow]> session-command-blocks: [];
    in property <[TerminalOverviewMarkerRow]> session-overview-markers: [];
    in property <bool> session-search-open: false;
    in property <string> session-search-query: "";
    in property <int> session-search-match-count: 0;
    in property <int> session-search-focus-sequence: 0;
    in property <int> session-surface-seqno: 0;
    in property <int> session-viewport-offset-lines: 0;
    in property <int> session-viewport-max-offset-lines: 0;
    in property <bool> session-viewport-at-bottom: true;
    in property <bool> session-alternate-screen-active: false;
    in property <float> session-device-scale-factor: 1.0;
    in-out property <bool> selection-active: false;
    in-out property <int> selection-start-row: -1;
    in-out property <int> selection-start-col: -1;
    in-out property <int> selection-end-row: -1;
    in-out property <int> selection-end-col: -1;
    out property <length> native-surface-x: root.terminal-surface-origin-x();
    out property <length> native-surface-y: root.terminal-surface-origin-y();
    out property <length> native-surface-width: root.snapped-terminal-content-width();
    out property <length> native-surface-height: root.snapped-terminal-content-height();
    out property <length> preferred-surface-width: root.preferred-terminal-content-width();
    out property <length> preferred-surface-height: root.preferred-terminal-content-height();
    out property <int> preferred-terminal-rows: root.preferred-terminal-row-count();
    out property <int> preferred-terminal-cols: root.preferred-terminal-col-count();
    callback text-input(string);
    callback key-input(string, bool, bool, bool);
    callback surface-resize-requested(int, int);
    callback normalize-hit-col(int, int) -> int;
    callback normalize-selection-hit-col(int, int) -> int;
    callback copy-selection-requested(int, int, int, int);
    callback selection-changed();
    callback paste-requested();
    callback local-action-requested(string);
    callback scroll-requested(int, int, int, bool, bool, bool);
    callback scroll-thumb-drag-requested(float);
    callback scroll-jump-requested(float);
    callback mouse-input(string, string, int, int, bool, bool, bool);
    callback context-menu-open-changed(bool);
    callback search-open-requested();
    callback search-close-requested();
    callback search-query-changed(string);
    callback welcome-quick-launch-connect-requested(string);
    callback welcome-open-saved-ssh-requested();

    public function restore-primary-focus() {
        if root.mode == "terminal" {
            terminal-input.focus();
        }
    }

    private property <length> terminal-font-size: 16px;
    private property <length> terminal-cell-width: max(1px, root.session-cell-width);
    private property <length> terminal-cell-height: max(1px, root.session-cell-height);
    private property <length> terminal-cursor-thickness: 1px;
    private property <length> terminal-padding-left: 10px;
    private property <length> terminal-padding-top: 8px;
    private property <length> terminal-padding-right: 10px;
    private property <length> terminal-padding-bottom: 8px;
    private property <length> command-gutter-width: 4px;
    private property <length> command-gutter-gap: 3px;
    private property <length> command-gutter-min-height: 10px;
    private property <length> overview-ruler-width: 3px;
    private property <length> overview-ruler-gap: 5px;
    private property <length> overview-marker-height: 10px;
    private property <length> scrollbar-reserved-width: 12px;
    private property <length> scrollbar-track-width: 7px;
    private property <length> scrollbar-thumb-min-height: 28px;
    private property <float> wheel-delta-remainder: 0;
    private property <float> wheel-delta-threshold: 120;
    private property <int> wheel-lines-per-notch: 6;
    private property <int> selection-anchor-row: -1;
    private property <int> selection-anchor-col: -1;
    private property <int> selection-focus-row: -1;
    private property <int> selection-focus-col: -1;
    private property <bool> selection-drag-active: false;
    private property <bool> link-open-candidate: false;
    private property <bool> link-press-active: false;
    private property <bool> scrollbar-thumb-drag-active: false;
    private property <bool> cursor-blink-visible: true;
    in-out property <bool> context-menu-open: false;
    private property <length> terminal-context-menu-x: 12px;
    private property <length> terminal-context-menu-y: 12px;
    private property <length> terminal-link-tooltip-x: 12px;
    private property <length> terminal-link-tooltip-y: 12px;
    private property <bool> connection-progress-diagnostics-expanded: false;
    private property <image> ssh-local-device-icon: @image-url("../../assets/icons/ssh-flow/ssh-local-device.svg");
    private property <image> ssh-jump-host-icon: @image-url("../../assets/icons/ssh-flow/ssh-jump-host.svg");
    private property <image> ssh-target-server-icon: @image-url("../../assets/icons/ssh-flow/ssh-target-server.svg");
    private property <image> ssh-connecting-hero-outline-icon: @image-url("../../assets/icons/ssh-flow/ssh-connecting-hero-outline.svg");
    private property <image> ssh-verify-shield-key-dark-icon: @image-url("../../assets/icons/ssh-flow/reference/ssh-verify-shield-key-dark.png");
    private property <image> ssh-verify-shield-key-light-icon: @image-url("../../assets/icons/ssh-flow/reference/ssh-verify-shield-key-light.png");
    private property <image> ssh-details-gear-icon: @image-url("../../assets/icons/ssh-flow/ssh-connection-details-gear.svg");
    private property <image> ssh-copy-dark-icon: @image-url("../../assets/icons/ssh-flow/reference/ssh-copy-dark.png");
    private property <image> ssh-copy-light-icon: @image-url("../../assets/icons/ssh-flow/reference/ssh-copy-light.png");
    private property <image> ssh-chevron-right-icon: @image-url("../../assets/icons/ssh-flow/reference/ssh-chevron-right.png");
    private property <image> ssh-status-waiting-icon: @image-url("../../assets/icons/ssh-flow/ssh-status-waiting.svg");
    private property <image> ssh-status-warning-icon: @image-url("../../assets/icons/ssh-flow/ssh-status-warning.svg");
    private property <image> ssh-status-failed-icon: @image-url("../../assets/icons/ssh-flow/ssh-status-failed.svg");
    private property <image> ssh-verify-shield-glyph-icon: @image-url("../../assets/icons/ssh-flow/ssh-verify-shield-key.svg");
    private property <image> fluent-chevron-right-icon: @image-url("../../assets/icons/fluent/chevron-right-20-regular.svg");
    private property <image> fluent-chevron-down-icon: @image-url("../../assets/icons/fluent/chevron-down-20-regular.svg");
    private property <image> fluent-dismiss-icon: @image-url("../../assets/icons/fluent/dismiss-20-regular.svg");

    function terminal-content-width() -> length {
        return max(
            0px,
            root.width - root.terminal-padding-left - root.terminal-padding-right
                - (root.scrollbar-visible() ? root.scrollbar-reserved-width : 0px),
        );
    }

    function terminal-content-height() -> length {
        return max(0px, root.height - root.terminal-padding-top - root.terminal-padding-bottom);
    }

    function terminal-grid-width() -> length {
        return root.session-cols * root.terminal-cell-width;
    }

    function terminal-grid-height() -> length {
        return root.session-rows * root.terminal-cell-height;
    }

    function terminal-visible-grid-width() -> length {
        return min(root.terminal-grid-width(), root.terminal-content-width());
    }

    function terminal-visible-grid-height() -> length {
        return min(root.terminal-grid-height(), root.terminal-content-height());
    }

    function snap-length-to-device-pixel(value: length) -> length {
        let scale = max(1.0, root.session-device-scale-factor);
        return (Math.floor(((value / 1px) * scale) + 0.5) / scale) * 1px;
    }

    function terminal-surface-origin-x() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-padding-left);
    }

    function terminal-surface-origin-y() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-padding-top);
    }

    function snapped-terminal-visible-grid-width() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-visible-grid-width());
    }

    function snapped-terminal-visible-grid-height() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-visible-grid-height());
    }

    function snapped-terminal-content-width() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-content-width());
    }

    function snapped-terminal-content-height() -> length {
        if root.mode != "terminal" {
            return 0px;
        }
        return root.snap-length-to-device-pixel(root.terminal-content-height());
    }

    function preferred-terminal-content-width() -> length {
        return root.snap-length-to-device-pixel(root.terminal-content-width());
    }

    function preferred-terminal-content-height() -> length {
        return root.snap-length-to-device-pixel(root.terminal-content-height());
    }

    function preferred-terminal-row-count() -> int {
        return max(
            1,
            (root.preferred-terminal-content-height() / 1px) / (root.terminal-cell-height / 1px),
        );
    }

    function preferred-terminal-col-count() -> int {
        return max(
            1,
            (root.preferred-terminal-content-width() / 1px) / (root.terminal-cell-width / 1px),
        );
    }

    function terminal-viewport-rows() -> int {
        return root.preferred-terminal-row-count();
    }

    function terminal-viewport-cols() -> int {
        return root.preferred-terminal-col-count();
    }

    function scrollbar-visible() -> bool {
        return !root.session-alternate-screen-active
            && !root.session-mouse-grabbed
            // Ignore a one-line scrollback wobble so the host width stays stable
            // while main-screen TUIs repaint near the bottom edge.
            && root.session-viewport-max-offset-lines > 1;
    }

    function scrollbar-track-x() -> length {
        return root.width - root.terminal-padding-right - root.scrollbar-track-width;
    }

    function scrollbar-track-y() -> length {
        return root.terminal-surface-origin-y();
    }

    function scrollbar-track-height() -> length {
        return root.terminal-visible-grid-height();
    }

    function scrollbar-thumb-height() -> length {
        return min(
            root.scrollbar-track-height(),
            max(
                root.scrollbar-thumb-min-height,
                (root.scrollbar-track-height() * max(1, root.session-rows))
                    / max(1, root.session-rows + root.session-viewport-max-offset-lines),
            ),
        );
    }

    function scrollbar-thumb-y() -> length {
        return root.scrollbar-track-y()
            + max(
                0px,
                ((root.scrollbar-track-height() - root.scrollbar-thumb-height())
                    * max(0, root.session-viewport-max-offset-lines - root.session-viewport-offset-lines))
                    / max(1, root.session-viewport-max-offset-lines),
            );
    }

    function scroll-ratio-for-track-position(pointer-y: length) -> float {
        return min(
            1.0,
            max(
                0.0,
                1.0 - ((pointer-y - root.scrollbar-track-y())
                    / max(1px, root.scrollbar-track-height() - root.scrollbar-thumb-height())),
            ),
        );
    }

    function accumulated-wheel-lines() -> int {
        return root.wheel-delta-remainder >= 0
            ? Math.floor(root.wheel-delta-remainder)
            : -Math.floor(-root.wheel-delta-remainder);
    }

    function terminal-cell-x(col: int) -> length {
        return root.snap-length-to-device-pixel(root.terminal-surface-origin-x() + (col * root.terminal-cell-width));
    }

    function terminal-cell-y(row: int) -> length {
        return root.snap-length-to-device-pixel(root.terminal-surface-origin-y() + (row * root.terminal-cell-height));
    }

    function terminal-local-cell-x(col: int) -> length {
        return root.snap-length-to-device-pixel(col * root.terminal-cell-width);
    }

    function terminal-local-cell-y(row: int) -> length {
        return root.snap-length-to-device-pixel(row * root.terminal-cell-height);
    }

    function visible-top-buffer-row() -> int {
        return max(0, root.session-viewport-max-offset-lines - root.session-viewport-offset-lines);
    }

    function visible-bottom-buffer-row-exclusive() -> int {
        return root.visible-top-buffer-row() + max(1, root.session-rows);
    }

    function viewport-row-to-buffer-row(row: int) -> int {
        return root.visible-top-buffer-row() + max(0, row);
    }

    function buffer-row-to-viewport-row(row: int) -> int {
        return row - root.visible-top-buffer-row();
    }

    function selection-visible-start-row() -> int {
        return max(0, root.buffer-row-to-viewport-row(root.selection-start-row));
    }

    function selection-visible-end-row() -> int {
        return min(
            max(0, root.session-rows - 1),
            root.buffer-row-to-viewport-row(root.selection-end-row),
        );
    }

    function selection-visible-start-col() -> int {
        return root.selection-start-row < root.visible-top-buffer-row()
            ? 0
            : root.selection-start-col;
    }

    function selection-visible-end-col() -> int {
        return root.selection-end-row >= root.visible-bottom-buffer-row-exclusive()
            ? root.session-cols
            : root.selection-end-col;
    }

    function selection-overlay-active() -> bool {
        return root.session-render-mode == "bitmap" && root.selection-active
            && root.selection-start-row >= 0 && root.selection-start-col >= 0
            && root.selection-end-row >= root.selection-start-row
            && root.selection-end-col >= 0
            && root.selection-end-row >= root.visible-top-buffer-row()
            && root.selection-start-row < root.visible-bottom-buffer-row-exclusive();
    }

    function selection-span-x(start-col: int) -> length {
        return root.terminal-cell-x(max(0, min(root.session-cols, start-col)));
    }

    function selection-span-width(start-col: int, end-col: int) -> length {
        let clamped-start-col = max(0, min(root.session-cols, start-col));
        let clamped-end-col = max(clamped-start-col, min(root.session-cols, end-col));
        return max(
            0px,
            root.terminal-cell-x(clamped-end-col) - root.terminal-cell-x(clamped-start-col),
        );
    }

    function selection-span-height(start-row: int, end-row: int) -> length {
        let clamped-start-row = max(0, min(root.session-rows, start-row));
        let clamped-end-row = max(clamped-start-row, min(root.session-rows, end-row + 1));
        return max(
            0px,
            root.terminal-cell-y(clamped-end-row) - root.terminal-cell-y(clamped-start-row),
        );
    }

    function selection-local-span-x(start-col: int) -> length {
        return root.terminal-local-cell-x(max(0, min(root.session-cols, start-col)));
    }

    function selection-local-span-width(start-col: int, end-col: int) -> length {
        let clamped-start-col = max(0, min(root.session-cols, start-col));
        let clamped-end-col = max(clamped-start-col, min(root.session-cols, end-col));
        return max(
            0px,
            root.terminal-local-cell-x(clamped-end-col) - root.terminal-local-cell-x(clamped-start-col),
        );
    }

    function selection-local-span-height(start-row: int, end-row: int) -> length {
        let clamped-start-row = max(0, min(root.session-rows, start-row));
        let clamped-end-row = max(clamped-start-row, min(root.session-rows, end-row + 1));
        return max(
            0px,
            root.terminal-local-cell-y(clamped-end-row) - root.terminal-local-cell-y(clamped-start-row),
        );
    }

    function command-block-gutter-x() -> length {
        return max(
            0px,
            root.terminal-surface-origin-x() - root.command-gutter-width - root.command-gutter-gap,
        );
    }

    function command-block-local-y(start-row: int) -> length {
        return max(
            0px,
            min(
                root.snapped-terminal-visible-grid-height(),
                root.terminal-local-cell-y(max(0, start-row)) + 2px,
            ),
        );
    }

    function command-block-local-height(start-row: int, end-row: int) -> length {
        let y = root.command-block-local-y(start-row);
        let raw-height = max(
            root.command-gutter-min-height,
            root.selection-local-span-height(start-row, end-row) - 4px,
        );
        return max(
            0px,
            min(root.snapped-terminal-visible-grid-height() - y, raw-height),
        );
    }

    function overview-ruler-x() -> length {
        return root.scrollbar-visible()
            ? root.scrollbar-track-x() - root.overview-ruler-gap - root.overview-ruler-width
            : root.width - root.terminal-padding-right - root.overview-ruler-width;
    }

    function overview-marker-local-y(row: int) -> length {
        return max(
            0px,
            min(
                max(0px, root.snapped-terminal-visible-grid-height() - root.overview-marker-height),
                root.terminal-local-cell-y(max(0, row)) + 2px,
            ),
        );
    }

    function terminal-hit-row(pointer-y: length) -> int {
        return max(0, min(
            root.session-rows - 1,
            Math.floor((pointer-y / 1px) / (root.terminal-cell-height / 1px)),
        ));
    }

    function terminal-hit-col(pointer-x: length) -> int {
        return max(0, min(
            root.session-cols - 1,
            Math.floor((pointer-x / 1px) / (root.terminal-cell-width / 1px)),
        ));
    }

    function terminal-selection-hit-col(pointer-x: length) -> int {
        return max(0, min(
            root.session-cols,
            Math.floor(((pointer-x / 1px) / (root.terminal-cell-width / 1px)) + 0.5),
        ));
    }

    function is-copy-shortcut-key(text: string) -> bool {
        return text == "c" || text == "C" || text == "\u{3}";
    }

    function is-paste-shortcut-key(text: string) -> bool {
        return text == "v" || text == "V" || text == "\u{16}";
    }

    function terminal-local-action-id(text: string) -> string {
        if text == "t" || text == "T" {
            return "new-tab";
        }
        if text == "w" || text == "W" {
            return "close-tab";
        }
        if text == "p" || text == "P" {
            return "toggle-global-menu";
        }
        if text == "f" || text == "F" {
            return "toggle-asset-search";
        }
        if text == "m" || text == "M" {
            return "toggle-workspace-focus-mode";
        }
        return "";
    }

    function emit-surface-resize() {
        if root.mode == "terminal" {
            root.surface-resize-requested(
                root.terminal-viewport-rows(),
                root.terminal-viewport-cols(),
            );
        }
    }

    function schedule-surface-resize() {
        if root.mode != "terminal" {
            surface-resize-coalesce-timer.stop();
            return;
        }
        surface-resize-coalesce-timer.restart();
    }

    function clear-selection() {
        root.selection-anchor-row = -1;
        root.selection-anchor-col = -1;
        root.selection-focus-row = -1;
        root.selection-focus-col = -1;
        root.selection-drag-active = false;
        root.link-open-candidate = false;
        root.link-press-active = false;
        root.sync-selection-state();
    }

    function sync-selection-state() {
        let next-active = root.has-selection();
        let next-start-row = next-active ? root.normalized-selection-start-row() : -1;
        let next-start-col = next-active ? root.normalized-selection-start-col() : -1;
        let next-end-row = next-active ? root.normalized-selection-end-row() : -1;
        let next-end-col = next-active ? root.normalized-selection-end-col() : -1;
        let changed = root.selection-active != next-active
            || root.selection-start-row != next-start-row
            || root.selection-start-col != next-start-col
            || root.selection-end-row != next-end-row
            || root.selection-end-col != next-end-col;

        if root.has-selection() {
            root.selection-active = next-active;
            root.selection-start-row = next-start-row;
            root.selection-start-col = next-start-col;
            root.selection-end-row = next-end-row;
            root.selection-end-col = next-end-col;
        } else {
            root.selection-active = next-active;
            root.selection-start-row = next-start-row;
            root.selection-start-col = next-start-col;
            root.selection-end-row = next-end-row;
            root.selection-end-col = next-end-col;
        }

        if changed {
            root.selection-changed();
        }
    }

    function close-context-menu() {
        root.context-menu-open = false;
        root.link-open-candidate = false;
        root.link-press-active = false;
    }

    function terminal-link-tooltip-text() -> string {
        return root.link-armed ? "Ctrl+click to open link" : "Hold Ctrl and click to open link";
    }

    function terminal-link-tooltip-visible() -> bool {
        return root.mode == "terminal"
            && root.link-hovered
            && !root.selection-drag-active
            && !root.context-menu-open;
    }

    function has-selection() -> bool {
        return root.selection-anchor-row >= 0
            && root.selection-focus-row >= 0
            && (root.ordered-selection-start-row() != root.ordered-selection-end-row()
                || root.ordered-selection-start-col() != root.ordered-selection-end-col());
    }

    function ordered-selection-start-row() -> int {
        return root.selection-anchor-row < root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col <= root.selection-focus-col)
            ? root.selection-anchor-row
            : root.selection-focus-row;
    }

    function ordered-selection-start-col() -> int {
        return root.selection-anchor-row < root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col <= root.selection-focus-col)
            ? root.selection-anchor-col
            : root.selection-focus-col;
    }

    function ordered-selection-end-row() -> int {
        return root.selection-anchor-row > root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col > root.selection-focus-col)
            ? root.selection-anchor-row
            : root.selection-focus-row;
    }

    function ordered-selection-end-col() -> int {
        return root.selection-anchor-row > root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col > root.selection-focus-col)
            ? root.selection-anchor-col
            : root.selection-focus-col;
    }

    function normalized-selection-start-row() -> int {
        return root.ordered-selection-start-row();
    }

    function normalized-selection-start-col() -> int {
        return root.ordered-selection-start-col();
    }

    function normalized-selection-end-row() -> int {
        return root.ordered-selection-end-row();
    }

    function normalized-selection-end-col() -> int {
        return root.ordered-selection-end-col();
    }

    function selection-copy-enabled() -> bool {
        return root.has-selection();
    }

    function cell-selected(row: int, col: int, width: int) -> bool {
        if !root.has-selection() {
            return false;
        }
        let start-row = root.normalized-selection-start-row();
        let end-row = root.normalized-selection-end-row();
        let buffer-row = root.viewport-row-to-buffer-row(row);
        if buffer-row < start-row || buffer-row > end-row {
            return false;
        }
        let row-start-col = buffer-row == start-row ? root.normalized-selection-start-col() : 0;
        let row-end-col = buffer-row == end-row
            ? root.normalized-selection-end-col()
            : root.session-cols;
        let cell-end-col = col + width;
        return cell-end-col > row-start-col && col < row-end-col;
    }

    function terminal-menu-width() -> length {
        return 168px;
    }

    function terminal-menu-height() -> length {
        return 148px;
    }

    function search-match-summary() -> string {
        if root.session-search-query == "" {
            return "Find in terminal";
        }
        if root.session-search-match-count == 1 {
            return "1 match";
        }
        if root.session-search-match-count == 0 {
            return "No matches";
        }
        return "" + root.session-search-match-count + " matches";
    }

    function open-context-menu(pointer-x: length, pointer-y: length) {
        root.context-menu-open = true;
        root.terminal-context-menu-x = min(
            max(12px, pointer-x),
            max(12px, root.width - root.terminal-menu-width() - 12px),
        );
        root.terminal-context-menu-y = min(
            max(12px, pointer-y),
            max(12px, root.height - root.terminal-menu-height() - 12px),
        );
    }

    function connection-progress-headline-label() -> string {
        if root.connection-progress-visual-state == "verifying_host_key" {
            return "Waiting for confirmation";
        }
        if root.connection-progress-visual-state == "host_key_warning" {
            return "Security warning";
        }
        if root.connection-progress-visual-state == "failed" {
            return "Connection failed";
        }
        if root.connection-progress-visual-state == "connected" {
            return "Connected";
        }
        if root.connection-progress-headline == "waiting-user" {
            return "Waiting for confirmation";
        }
        if root.connection-progress-headline == "connected" {
            return "Connected";
        }
        if root.connection-progress-headline == "cancelled" {
            return "Cancelled";
        }
        if root.connection-progress-headline == "error" {
            return "Connection Failed";
        }
        return "Connecting";
    }

    function connection-progress-shows-cancel() -> bool {
        return root.connection-progress-visual-state == "verifying_host_key"
            || root.connection-progress-visual-state == "connecting"
            || root.connection-progress-visual-state == "host_key_warning";
    }

    function connection-progress-shows-retry() -> bool {
        return root.connection-progress-visual-state == "failed";
    }

    function connection-progress-has-host-key-prompt() -> bool {
        return root.connection-progress-host-key-prompt-host != "";
    }

    function connection-progress-panel-supporting-copy() -> string {
        if root.connection-progress-page-mode == "decision" {
            return "Trusting this key saves it for future connections and resumes the session.";
        }
        if root.connection-progress-page-mode == "troubleshooting" {
            return "Try again or edit settings to review the connection.";
        }
        return "Working through the SSH connection flow.";
    }

    function connection-progress-cancel-supporting-copy() -> string {
        if root.connection-progress-visual-state == "failed" {
            return "Close this connection status.";
        }
        return "Abort this session.";
    }

    function connection-progress-stage-title() -> string {
        if root.connection-progress-current-hop != "" {
            return root.connection-progress-current-hop;
        }
        return "Preparing session";
    }

    function connection-progress-stage-detail() -> string {
        if root.connection-progress-current-detail != "" {
            return root.connection-progress-current-detail;
        }
        return root.connection-progress-task-detail;
    }

    function connection-progress-has-steps() -> bool {
        return root.connection-progress-steps.length > 0;
    }

    function connection-progress-local-icon() -> image {
        return root.ssh-local-device-icon;
    }

    function connection-progress-jump-host-icon() -> image {
        return root.ssh-jump-host-icon;
    }

    function connection-progress-target-icon() -> image {
        return root.ssh-target-server-icon;
    }

    function connection-progress-verify-shield-icon() -> image {
        return ThemeTokens.dark-mode ? root.ssh-verify-shield-key-dark-icon : root.ssh-verify-shield-key-light-icon;
    }

    function connection-progress-details-gear-icon() -> image {
        return root.ssh-details-gear-icon;
    }

    function connection-progress-copy-icon() -> image {
        return ThemeTokens.dark-mode ? root.ssh-copy-dark-icon : root.ssh-copy-light-icon;
    }

    function connection-progress-connecting-focus-icon() -> image {
        return root.ssh-connecting-hero-outline-icon;
    }

    function connection-progress-status-surface() -> brush {
        if root.connection-progress-visual-state == "verifying_host_key" {
            return ThemeTokens.ssh-status-amber-surface;
        }
        if root.connection-progress-visual-state == "host_key_warning" {
            return ThemeTokens.ssh-status-warning-surface;
        }
        if root.connection-progress-visual-state == "failed" {
            return ThemeTokens.ssh-status-danger-surface;
        }
        if root.connection-progress-visual-state == "connected" {
            return ThemeTokens.status-success-surface;
        }
        if root.connection-progress-visual-state == "connecting" {
            return ThemeTokens.status-busy-surface;
        }
        return ThemeTokens.ssh-status-neutral-surface;
    }

    function connection-progress-status-border() -> brush {
        if root.connection-progress-visual-state == "verifying_host_key" {
            return ThemeTokens.ssh-status-amber-border;
        }
        if root.connection-progress-visual-state == "host_key_warning" {
            return ThemeTokens.ssh-status-warning-border;
        }
        if root.connection-progress-visual-state == "failed" {
            return ThemeTokens.ssh-status-danger-border;
        }
        if root.connection-progress-visual-state == "connected" {
            return ThemeTokens.status-success-accent;
        }
        if root.connection-progress-visual-state == "connecting" {
            return ThemeTokens.status-busy-accent;
        }
        return ThemeTokens.ssh-status-neutral-border;
    }

    function connection-progress-status-foreground() -> brush {
        if root.connection-progress-visual-state == "verifying_host_key" {
            return ThemeTokens.ssh-status-amber-fg;
        }
        if root.connection-progress-visual-state == "host_key_warning" {
            return ThemeTokens.ssh-status-warning-fg;
        }
        if root.connection-progress-visual-state == "failed" {
            return ThemeTokens.status-error-accent;
        }
        if root.connection-progress-visual-state == "connected" {
            return ThemeTokens.status-success-accent;
        }
        if root.connection-progress-visual-state == "connecting" {
            return ThemeTokens.status-busy-accent;
        }
        return ThemeTokens.ssh-status-neutral-fg;
    }

    function connection-progress-status-indicator() -> brush {
        if root.connection-progress-visual-state == "connecting" {
            return ThemeTokens.status-busy-accent;
        }
        return root.connection-progress-status-foreground();
    }

    function connection-progress-hop-node-surface(state: string) -> brush {
        if state == "failed" {
            return ThemeTokens.ssh-status-danger-surface;
        }
        if state == "current" {
            return ThemeTokens.ssh-status-hop-current-surface;
        }
        return ThemeTokens.ssh-status-hop-node-surface;
    }

    function connection-progress-hop-node-border(state: string) -> brush {
        if state == "failed" {
            return ThemeTokens.ssh-status-danger-border;
        }
        if state == "current" {
            return ThemeTokens.ssh-status-hop-current-border;
        }
        return ThemeTokens.ssh-status-hop-node-border;
    }

    function connection-progress-hop-icon-surface(state: string) -> brush {
        if state == "failed" {
            return ThemeTokens.ssh-status-danger-surface;
        }
        if state == "current" {
            return ThemeTokens.ssh-status-hop-current-icon-surface;
        }
        return ThemeTokens.ssh-status-hop-icon-surface;
    }

    function connection-progress-hop-icon-border(state: string) -> brush {
        if state == "failed" {
            return ThemeTokens.ssh-status-danger-border;
        }
        if state == "current" {
            return ThemeTokens.ssh-status-hop-current-icon-border;
        }
        return ThemeTokens.ssh-status-hop-icon-border;
    }

    function connection-progress-hop-connector-brush(state: string) -> brush {
        if state == "failed" {
            return ThemeTokens.ssh-status-danger-border;
        }
        if state == "current" {
            return ThemeTokens.ssh-status-progress-accent;
        }
        return ThemeTokens.ssh-status-hop-divider;
    }

    function connection-progress-main-card-height() -> length {
        if root.connection-progress-visual-state == "verifying_host_key" {
            return 326px;
        }
        if root.connection-progress-visual-state == "host_key_warning" {
            return 344px;
        }
        if root.connection-progress-visual-state == "connecting" {
            return root.connection-progress-has-steps() ? 318px : 286px;
        }
        return 236px;
    }

    function connection-progress-footer-height() -> length {
        return root.connection-progress-visual-state == "connecting" ? 62px : 78px;
    }

    function connection-progress-diagnostics-summary() -> string {
        if root.connection-progress-diagnostics.length <= 0 {
            return "No details yet";
        }
        if root.connection-progress-diagnostics.length == 1 {
            return "1 detail";
        }
        return "" + root.connection-progress-diagnostics.length + " details";
    }

    function connection-progress-step-is-active(state: string) -> bool {
        return state == "running" || state == "blocked";
    }

    function connection-progress-step-is-error(state: string) -> bool {
        return state == "failed" || state == "cancelled";
    }

    function connection-progress-step-shows-detail(state: string) -> bool {
        return root.connection-progress-step-is-active(state)
            || root.connection-progress-step-is-error(state);
    }

    function connection-progress-step-row-height(state: string) -> length {
        return root.connection-progress-step-shows-detail(state) ? 40px : 28px;
    }

    function connection-progress-field-is-copyable(field: ConnectionProgressFieldRow) -> bool {
        return field.copy_value != "";
    }

    function bitmap-cursor-blink-active() -> bool {
        if root.mode == "terminal" && root.session-render-mode == "bitmap" && root.session-cursor-visible && root.session-cursor-blinking {
            return true;
        }
        return false;
    }

    function sync-cursor-blink-timer(reset-phase: bool) {
        if !root.bitmap-cursor-blink-active() {
            root.cursor-blink-visible = true;
            cursor-blink-timer.stop();
            return;
        }
        if reset-phase {
            root.cursor-blink-visible = true;
        }
        cursor-blink-timer.restart();
    }

    width: 100%;
    height: 100%;
    min-width: 0px;
    background: transparent;

    changed mode => {
        root.close-context-menu();
        root.clear-selection();
        root.connection-progress-diagnostics-expanded = false;
        root.sync-cursor-blink-timer(true);
        if root.mode == "terminal" {
            root.schedule-surface-resize();
        } else {
            surface-resize-coalesce-timer.stop();
        }
    }

    changed session-id => {
        root.close-context-menu();
        root.clear-selection();
        root.connection-progress-diagnostics-expanded = false;
        root.sync-cursor-blink-timer(true);
        if root.mode == "terminal" && root.session-id != "" {
            root.schedule-surface-resize();
        }
    }

    changed session-render-mode => {
        root.sync-cursor-blink-timer(true);
    }

    changed session-cursor-row => {
        root.sync-cursor-blink-timer(true);
    }

    changed session-cursor-col => {
        root.sync-cursor-blink-timer(true);
    }

    changed session-cursor-visible => {
        root.sync-cursor-blink-timer(true);
    }

    changed session-cursor-blinking => {
        root.sync-cursor-blink-timer(true);
    }

    changed session-rows => {
        if root.has-selection() {
            root.clear-selection();
        }
    }

    changed session-cols => {
        if root.has-selection() {
            root.clear-selection();
        }
    }

    changed session-alternate-screen-active => {
        if root.has-selection() {
            root.clear-selection();
        }
    }

    changed width => {
        root.schedule-surface-resize();
    }

    changed height => {
        root.schedule-surface-resize();
    }

    changed terminal-cell-width => {
        root.schedule-surface-resize();
    }

    changed terminal-cell-height => {
        root.schedule-surface-resize();
    }

    changed context-menu-open => {
        root.context-menu-open-changed(root.context-menu-open);
    }

    changed session-search-open => {
        if !root.session-search-open && root.mode == "terminal" {
            terminal-input.focus();
        }
    }

    cursor-blink-timer := Timer {
        interval: 600ms;
        running: false;

        triggered => {
            if root.mode != "terminal" || root.session-render-mode != "bitmap" || !root.session-cursor-visible || !root.session-cursor-blinking {
                self.running = false;
                root.cursor-blink-visible = true;
            } else {
                root.cursor-blink-visible = !root.cursor-blink-visible;
                self.restart();
            }
        }
    }

    surface-resize-coalesce-timer := Timer {
        interval: 48ms;
        running: false;

        triggered => {
            root.emit-surface-resize();
        }
    }

    terminal-input := TextInput {
            x: 0px;
            y: 0px;
            width: 1px;
            height: 1px;
            text: "";
            color: transparent;

            edited => {
                if self.text != "" {
                    root.text-input(self.text);
                    self.text = "";
                }
            }

            key-pressed(event) => {
                if (event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt) {
                    accept
                } else if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                    && (event.text == "f" || event.text == "F" || event.text == "\u{6}")) {
                    root.search-open-requested();
                    accept
                } else if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && root.is-copy-shortcut-key(event.text)) {
                    if root.has-selection() {
                        root.copy-selection-requested(
                            root.normalized-selection-start-row(),
                            root.normalized-selection-start-col(),
                            root.normalized-selection-end-row(),
                            root.normalized-selection-end-col(),
                        );
                        accept
                    } else {
                        reject
                    }
                } else if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && root.is-paste-shortcut-key(event.text)) {
                    root.paste-requested();
                    accept
                } else if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && root.terminal-local-action-id(event.text) != "") {
                    root.local-action-requested(root.terminal-local-action-id(event.text));
                    accept
                } else if (event.modifiers.control && event.text == Key.Insert
                    && !event.modifiers.shift && !event.modifiers.alt) {
                    if root.has-selection() {
                        root.copy-selection-requested(
                            root.normalized-selection-start-row(),
                            root.normalized-selection-start-col(),
                            root.normalized-selection-end-row(),
                            root.normalized-selection-end-col(),
                        );
                        accept
                    } else {
                        reject
                    }
                } else if (!event.modifiers.control && !event.modifiers.alt && event.modifiers.shift && event.text == Key.Insert) {
                    root.paste-requested();
                    accept
                } else if (event.modifiers.shift && event.text == Key.PageUp
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.scroll-requested(max(1, root.session-rows - 2), 0, 0, true, false, false);
                    accept
                } else if (event.modifiers.shift && event.text == Key.PageDown
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.scroll-requested(-max(1, root.session-rows - 2), 0, 0, true, false, false);
                    accept
                } else if (event.modifiers.shift && event.text == Key.Home
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.scroll-jump-requested(1.0);
                    accept
                } else if (event.modifiers.shift && event.text == Key.End
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.scroll-jump-requested(0.0);
                    accept
                } else if (event.text == Key.Return) {
                    root.key-input("enter", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Tab) {
                    root.key-input("tab", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Backtab) {
                    root.key-input("tab", event.modifiers.alt, event.modifiers.control, true);
                    accept
                } else if (event.text == Key.Escape && root.session-search-open) {
                    root.search-close-requested();
                    accept
                } else if (event.text == Key.Escape) {
                    root.close-context-menu();
                    root.key-input("escape", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Backspace) {
                    root.key-input("backspace", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Delete) {
                    root.key-input("delete", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.UpArrow) {
                    root.key-input("up", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.DownArrow) {
                    root.key-input("down", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.LeftArrow) {
                    root.key-input("left", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.RightArrow) {
                    root.key-input("right", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Home) {
                    root.key-input("home", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.End) {
                    root.key-input("end", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.PageUp) {
                    root.key-input("page-up", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.PageDown) {
                    root.key-input("page-down", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Insert) {
                    root.key-input("insert", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F1) {
                    root.key-input("f1", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F2) {
                    root.key-input("f2", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F3) {
                    root.key-input("f3", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F4) {
                    root.key-input("f4", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F5) {
                    root.key-input("f5", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F6) {
                    root.key-input("f6", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F7) {
                    root.key-input("f7", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F8) {
                    root.key-input("f8", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F9) {
                    root.key-input("f9", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F10) {
                    root.key-input("f10", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F11) {
                    root.key-input("f11", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F12) {
                    root.key-input("f12", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F13) {
                    root.key-input("f13", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F14) {
                    root.key-input("f14", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F15) {
                    root.key-input("f15", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F16) {
                    root.key-input("f16", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F17) {
                    root.key-input("f17", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F18) {
                    root.key-input("f18", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F19) {
                    root.key-input("f19", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F20) {
                    root.key-input("f20", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F21) {
                    root.key-input("f21", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F22) {
                    root.key-input("f22", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F23) {
                    root.key-input("f23", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.F24) {
                    root.key-input("f24", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if ((event.modifiers.control || event.modifiers.alt) && event.text != "") {
                    root.key-input(event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else {
                    reject
                }
            }
        }

    if root.mode == "welcome" : WelcomeView {
        width: parent.width;
        height: parent.height;
        recent-items: root.welcome-quick-launch-recent-items;

        connect-requested(asset-id) => {
            root.welcome-quick-launch-connect-requested(asset-id);
        }

        open-saved-ssh-requested => {
            root.welcome-open-saved-ssh-requested();
        }
    }

    if root.mode == "terminal" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        search-bar := Rectangle {
            visible: root.session-search-open;
            x: max(14px, parent.width - self.width - 16px);
            y: 14px;
            width: min(352px, max(248px, parent.width * 0.28));
            height: 38px;
            private property <int> focus-sequence: root.session-search-focus-sequence;
            border-radius: 10px;
            border-width: 1px;
            border-color: search-input.has-focus ? ThemeTokens.input-focus-ring : ThemeTokens.input-border;
            background: ThemeTokens.input-surface;
            z: 20;

            glow-frame := Rectangle {
                x: -1px;
                y: -1px;
                width: parent.width + 2px;
                height: parent.height + 2px;
                border-radius: parent.border-radius + 1px;
                border-width: 1px;
                border-color: ThemeTokens.input-focus-ring;
                background: transparent;
                opacity: search-input.has-focus ? (ThemeTokens.dark-mode ? 0.24 : 0.16) : 0;
            }

            search-input := TextInput {
                x: 12px;
                y: 7px;
                width: max(48px, parent.width - 112px);
                height: parent.height - 14px;
                text: root.session-search-query;
                color: ThemeTokens.text-primary;
                selection-background-color: ThemeTokens.focus-ring;
                selection-foreground-color: ThemeTokens.text-primary;

                edited => {
                    root.search-query-changed(self.text);
                }

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.search-close-requested();
                        accept
                    } else if (event.text == Key.Return) {
                        root.search-query-changed(self.text);
                        accept
                    } else {
                        reject
                    }
                }
            }

            if search-input.text == "" : placeholder := Text {
                x: search-input.x;
                y: search-input.y;
                width: search-input.width;
                height: search-input.height;
                text: "Find in terminal";
                color: ThemeTokens.text-muted;
                vertical-alignment: center;
            }

            match-count := Text {
                x: parent.width - 90px;
                y: 0px;
                width: 52px;
                height: parent.height;
                text: root.search-match-summary();
                color: root.session-search-query != "" && root.session-search-match-count == 0
                    ? ThemeTokens.status-error-accent
                    : ThemeTokens.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-size: 11px;
            }

            close-touch := TouchArea {
                x: parent.width - 34px;
                y: 5px;
                width: 28px;
                height: 28px;

                clicked => {
                    root.search-close-requested();
                }
            }

            close-glyph := Text {
                x: close-touch.x;
                y: close-touch.y;
                width: close-touch.width;
                height: close-touch.height;
                text: "×";
                color: close-touch.has-hover ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 16px;
            }

            changed focus-sequence => {
                if root.session-search-open {
                    search-input.focus();
                }
            }

        }

        surface-frame := Rectangle {
            width: parent.width;
            height: parent.height;
            clip: true;
            border-width: 1px;
            border-color: root.session-frame-border;
            background: root.session-frame-surface;

            blank-surface := Rectangle {
                x: root.terminal-surface-origin-x();
                y: root.terminal-surface-origin-y();
                width: root.snapped-terminal-content-width();
                height: root.snapped-terminal-content-height();
                clip: true;
                background: root.session-default-bg;

                Image {
                    x: 0px;
                    y: 0px;
                    width: root.session-render-mode == "native" ? parent.width : root.terminal-grid-width();
                    height: root.session-render-mode == "native" ? parent.height : root.terminal-grid-height();
                    source: root.session-surface-image;
                    image-fit: fill;
                    image-rendering: root.session-render-mode == "native" ? smooth : pixelated;
                    visible: root.session-render-mode == "bitmap" || root.session-render-mode == "native";
                }

                if root.selection-overlay-active() && root.selection-visible-start-row() == root.selection-visible-end-row() : selection-overlay-single-row := Rectangle {
                    x: root.selection-local-span-x(root.selection-visible-start-col());
                    y: root.terminal-local-cell-y(root.selection-visible-start-row());
                    width: root.selection-local-span-width(
                        root.selection-visible-start-col(),
                        root.selection-visible-end-col(),
                    );
                    height: root.selection-local-span-height(
                        root.selection-visible-start-row(),
                        root.selection-visible-start-row(),
                    );
                    background: root.session-selection-surface;
                }

                if root.selection-overlay-active() && root.selection-visible-start-row() < root.selection-visible-end-row() : selection-overlay-first-row := Rectangle {
                    x: root.selection-local-span-x(root.selection-visible-start-col());
                    y: root.terminal-local-cell-y(root.selection-visible-start-row());
                    width: root.selection-local-span-width(
                        root.selection-visible-start-col(),
                        root.session-cols,
                    );
                    height: root.selection-local-span-height(
                        root.selection-visible-start-row(),
                        root.selection-visible-start-row(),
                    );
                    background: root.session-selection-surface;
                }

                if root.selection-overlay-active() && root.selection-visible-start-row() + 1 < root.selection-visible-end-row() : selection-overlay-middle-rows := Rectangle {
                    x: root.selection-local-span-x(0);
                    y: root.terminal-local-cell-y(root.selection-visible-start-row() + 1);
                    width: root.selection-local-span-width(0, root.session-cols);
                    height: root.selection-local-span-height(
                        root.selection-visible-start-row() + 1,
                        root.selection-visible-end-row() - 1,
                    );
                    background: root.session-selection-surface;
                }

                if root.selection-overlay-active() && root.selection-visible-start-row() < root.selection-visible-end-row() : selection-overlay-last-row := Rectangle {
                    x: root.selection-local-span-x(0);
                    y: root.terminal-local-cell-y(root.selection-visible-end-row());
                    width: root.selection-local-span-width(0, root.selection-visible-end-col());
                    height: root.selection-local-span-height(
                        root.selection-visible-end-row(),
                        root.selection-visible-end-row(),
                    );
                    background: root.session-selection-surface;
                }

                input-capture := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: root.link-hovered
                        && !root.selection-drag-active
                        && !root.context-menu-open
                        ? MouseCursor.pointer
                        : MouseCursor.text;

                    scroll-event(event) => {
                        if event.delta-y > 0px || event.delta-y < 0px {
                            let row = root.terminal-hit-row(self.mouse-y);
                            let col = root.normalize-hit-col(
                                row,
                                root.terminal-hit-col(self.mouse-x),
                            );
                            root.wheel-delta-remainder = root.wheel-delta-remainder
                                + (((event.delta-y / 1px) / root.wheel-delta-threshold)
                                    * root.wheel-lines-per-notch);
                            let delta-lines = root.accumulated-wheel-lines();
                            terminal-input.focus();
                            root.close-context-menu();
                            if delta-lines != 0 {
                                root.wheel-delta-remainder = root.wheel-delta-remainder - delta-lines;
                                root.scroll-requested(
                                    delta-lines,
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            }
                            return accept;
                        }
                        reject
                    }

                    pointer-event(event) => {
                        let row = root.terminal-hit-row(self.mouse-y);
                        let col = root.normalize-hit-col(
                            row,
                            root.terminal-hit-col(self.mouse-x),
                        );
                        let selection-col = root.normalize-selection-hit-col(
                            row,
                            root.terminal-selection-hit-col(self.mouse-x),
                        );
                        root.terminal-link-tooltip-x = self.mouse-x + 14px;
                        root.terminal-link-tooltip-y = self.mouse-y + 14px;
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            terminal-input.focus();
                            root.close-context-menu();
                            if root.session-mouse-grabbed {
                                root.mouse-input(
                                    "down",
                                    "left",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else if root.link-armed {
                                root.link-open-candidate = true;
                                root.link-press-active = true;
                                root.mouse-input(
                                    "down",
                                    "left",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else {
                                root.selection-anchor-row = root.viewport-row-to-buffer-row(row);
                                root.selection-anchor-col = col;
                                root.selection-focus-row = root.viewport-row-to-buffer-row(row);
                                root.selection-focus-col = col;
                                root.selection-drag-active = true;
                                root.sync-selection-state();
                            }
                        } else if event.kind == PointerEventKind.move {
                            if root.session-mouse-grabbed {
                                root.mouse-input(
                                    "move",
                                    "none",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else {
                                root.mouse-input(
                                    "move",
                                    "none",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                                if root.link-open-candidate {
                                    root.link-open-candidate = false;
                                    root.link-press-active = false;
                                }
                                if root.selection-drag-active {
                                    terminal-input.focus();
                                    root.selection-focus-row = root.viewport-row-to-buffer-row(row);
                                    root.selection-focus-col = selection-col;
                                    root.sync-selection-state();
                                }
                            }
                        } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                            terminal-input.focus();
                            if root.session-mouse-grabbed {
                                root.mouse-input(
                                    "up",
                                    "left",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else if root.link-open-candidate {
                                root.link-open-candidate = false;
                                root.link-press-active = false;
                                root.mouse-input(
                                    "up",
                                    "left",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else {
                                if root.selection-anchor-row == root.selection-focus-row
                                    && root.selection-anchor-col == root.selection-focus-col {
                                    root.clear-selection();
                                }
                                root.selection-drag-active = false;
                            }
                        } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            terminal-input.focus();
                            if root.session-mouse-grabbed {
                                root.mouse-input(
                                    "down",
                                    "right",
                                    row,
                                    col,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                );
                            } else {
                                root.open-context-menu(
                                    root.terminal-surface-origin-x() + self.mouse-x,
                                    root.terminal-surface-origin-y() + self.mouse-y,
                                );
                            }
                        } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right && root.session-mouse-grabbed {
                            root.mouse-input(
                                "up",
                                "right",
                                row,
                                col,
                                event.modifiers.shift,
                                event.modifiers.control,
                                event.modifiers.alt,
                            );
                        }
                    }
                }

                if root.terminal-link-tooltip-visible() : link-tooltip := Rectangle {
                    x: min(max(8px, root.terminal-link-tooltip-x), max(8px, parent.width - self.width - 8px));
                    y: min(
                        max(8px, root.terminal-link-tooltip-y + (root.link-press-active ? 2px : 0px)),
                        max(8px, parent.height - self.height - 8px),
                    );
                    width: max(168px, link-tooltip-label.preferred-width + 20px);
                    height: max(28px, link-tooltip-label.preferred-height + 10px);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.link-press-active || root.link-armed
                        ? ThemeTokens.link-accent
                        : ThemeTokens.divider-subtle;
                    background: root.link-press-active
                        ? ThemeTokens.control-active-surface
                        : root.link-armed
                            ? ThemeTokens.menu-row-open-surface
                            : ThemeTokens.menu-row-hover-surface;
                    opacity: root.link-press-active ? 0.94 : 1;
                    animate y { duration: 90ms; easing: ease-out; }
                    animate opacity { duration: 90ms; }

                    link-tooltip-label := Text {
                        x: 10px;
                        y: 0px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: root.terminal-link-tooltip-text();
                        color: ThemeTokens.text-primary;
                        vertical-alignment: center;
                    }
                }
            }

            if root.session-overview-markers.length > 0 : overview-ruler := Rectangle {
                x: root.overview-ruler-x();
                y: root.terminal-surface-origin-y();
                width: root.overview-ruler-width;
                height: root.snapped-terminal-visible-grid-height();
                border-radius: parent.width / 2;
                background: root.session-scrollbar-track;
                opacity: 0.42;

                for marker in root.session-overview-markers : Rectangle {
                    x: 0px;
                    y: root.overview-marker-local-y(marker.row);
                    width: parent.width;
                    height: root.overview-marker-height;
                    border-radius: parent.width / 2;
                    background: marker.kind == "command_failure"
                        ? ThemeTokens.status-error-accent
                        : marker.kind == "command_running"
                            ? ThemeTokens.status-busy-accent
                            : ThemeTokens.status-success-accent;
                    opacity: marker.kind == "command_running" ? 1.0 : 0.9;
                }
            }

            if root.session-render-mode == "bitmap" && root.session-cursor-visible && root.cursor-blink-visible : cursor-overlay := Rectangle {
                x: root.terminal-cell-x(root.session-cursor-col);
                width: root.session-cursor-shape == "bar"
                    ? root.terminal-cursor-thickness
                    : root.terminal-cell-width;
                height: root.session-cursor-shape == "underline"
                    ? root.terminal-cursor-thickness
                    : root.terminal-cell-height;
                background: root.session-cursor-bg;
                opacity: root.session-cursor-shape == "block" ? 0.6 : 1.0;
                y: root.session-cursor-shape == "underline"
                    ? root.terminal-cell-y(root.session-cursor-row + 1) - root.terminal-cursor-thickness
                    : root.terminal-cell-y(root.session-cursor-row);
            }

            if root.scrollbar-visible() : scrollbar-track := Rectangle {
                x: root.scrollbar-track-x();
                y: root.scrollbar-track-y();
                width: root.scrollbar-track-width;
                height: root.scrollbar-track-height();
                border-radius: self.width / 2;
                background: scrollbar-track-touch.has-hover || root.scrollbar-thumb-drag-active
                    ? root.session-scrollbar-thumb
                    : root.session-scrollbar-track;

                scrollbar-track-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            terminal-input.focus();
                            root.close-context-menu();
                            root.scroll-jump-requested(
                                root.scroll-ratio-for-track-position(
                                    self.mouse-y - root.scrollbar-thumb-height() / 2,
                                ),
                            );
                        }
                    }
                }

                scrollbar-thumb := Rectangle {
                    x: 0px;
                    y: root.scrollbar-thumb-y() - root.scrollbar-track-y();
                    width: parent.width;
                    height: root.scrollbar-thumb-height();
                    border-radius: self.width / 2;
                    background: scrollbar-thumb-touch.has-hover || root.scrollbar-thumb-drag-active
                        ? root.session-scrollbar-thumb-active
                        : root.session-scrollbar-thumb;

                    scrollbar-thumb-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                terminal-input.focus();
                                root.close-context-menu();
                                root.scrollbar-thumb-drag-active = true;
                                root.scroll-thumb-drag-requested(
                                    root.scroll-ratio-for-track-position(
                                        scrollbar-thumb.y + self.mouse-y - root.scrollbar-thumb-height() / 2,
                                    ),
                                );
                            } else if event.kind == PointerEventKind.move && root.scrollbar-thumb-drag-active {
                                root.scroll-thumb-drag-requested(
                                    root.scroll-ratio-for-track-position(
                                        scrollbar-thumb.y + self.mouse-y - root.scrollbar-thumb-height() / 2,
                                    ),
                                );
                            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                root.scrollbar-thumb-drag-active = false;
                            }
                        }
                    }
                }
            }

            if root.context-menu-open : terminal-context-menu-dismiss-layer := TouchArea {
                width: parent.width;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.close-context-menu();
                    }
                }
            }

            if root.context-menu-open : terminal-context-menu := Rectangle {
                x: root.terminal-context-menu-x;
                y: root.terminal-context-menu-y;
                width: root.terminal-menu-width();
                height: root.terminal-menu-height();
                border-radius: 8px;
                border-width: 1px;
                border-color: ThemeTokens.divider-strong;
                background: ThemeTokens.panel-surface;

                VerticalLayout {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    spacing: 4px;

                    copy-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Copy";
                        enabled: root.selection-copy-enabled();

                        invoked => {
                            root.close-context-menu();
                            root.copy-selection-requested(
                                root.normalized-selection-start-row(),
                                root.normalized-selection-start-col(),
                                root.normalized-selection-end-row(),
                                root.normalized-selection-end-col(),
                            );
                        }
                    }

                    paste-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Paste";

                        invoked => {
                            root.close-context-menu();
                            root.paste-requested();
                        }
                    }

                    select-all-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Select All";

                        invoked => {
                            root.close-context-menu();
                            root.selection-anchor-row = root.visible-top-buffer-row();
                            root.selection-anchor-col = 0;
                            root.selection-focus-row = root.visible-bottom-buffer-row-exclusive() - 1;
                            root.selection-focus-col = max(0, root.session-cols);
                            root.sync-selection-state();
                            terminal-input.focus();
                        }
                    }

                    find-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Find";

                        invoked => {
                            root.close-context-menu();
                            root.search-open-requested();
                        }
                    }
                }
            }

        }
    }

    if root.mode == "connection-progress" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.ssh-status-page-surface;

        Rectangle {
            y: -24px;
            width: min(parent.width - 280px, 760px);
            x: (parent.width - self.width) / 2;
            height: 184px;
            border-radius: 92px;
            background: ThemeTokens.ssh-status-page-atmosphere;
        }

        Rectangle {
            y: 8px;
            width: min(parent.width - 560px, 420px);
            x: (parent.width - self.width) / 2;
            height: 116px;
            border-radius: 58px;
            background: ThemeTokens.ssh-status-page-atmosphere-core;
        }

        content-shell := Rectangle {
            y: 26px;
            width: min(parent.width - 56px, 1180px);
            x: (parent.width - self.width) / 2;
            height: parent.height - 56px;
            background: transparent;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 14px;

                header-block := Rectangle {
                    width: parent.width;
                    height: 78px;
                    background: transparent;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 10px;

                        SshStatusText {
                            height: 38px;
                            text: root.session-title != "" ? root.session-title : "Interserver";
                            color: ThemeTokens.text-primary;
                            font-size: 22px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        status-pill := Rectangle {
                            width: max(168px, status-pill-label.preferred-width + 48px);
                            height: 34px;
                            border-radius: ThemeTokens.ssh-status-pill-radius;
                            border-width: 1px;
                            border-color: root.connection-progress-status-border();
                            background: root.connection-progress-status-surface();

                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                padding-left: 10px;
                                padding-right: 14px;
                                spacing: 7px;

                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    y: 9px;
                                    background: transparent;

                                    if root.connection-progress-visual-state == "verifying_host_key" : Image {
                                        x: 0px;
                                        y: 0px;
                                        width: 16px;
                                        height: 16px;
                                        source: root.ssh-status-waiting-icon;
                                    }
                                    if root.connection-progress-visual-state == "host_key_warning" : Image {
                                        x: 0px;
                                        y: 0px;
                                        width: 16px;
                                        height: 16px;
                                        source: root.ssh-status-warning-icon;
                                        image-fit: contain;
                                    }
                                    if root.connection-progress-visual-state == "failed" : Image {
                                        x: 0px;
                                        y: 0px;
                                        width: 16px;
                                        height: 16px;
                                        source: root.ssh-status-failed-icon;
                                    }
                                    if root.connection-progress-visual-state != "verifying_host_key" && root.connection-progress-visual-state != "host_key_warning" && root.connection-progress-visual-state != "failed" : Rectangle {
                                        x: 4px;
                                        y: 4px;
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.connection-progress-status-indicator();
                                    }
                                }

                                status-pill-label := SshStatusText {
                                    text: root.connection-progress-headline-label();
                                    color: root.connection-progress-status-foreground();
                                    vertical-alignment: center;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                }

                hop-card := Rectangle {
                    width: parent.width;
                    height: 80px;
                    border-radius: ThemeTokens.ssh-status-card-radius;
                    border-width: 1px;
                    border-color: ThemeTokens.ssh-status-card-border;
                    background: ThemeTokens.ssh-status-card-surface;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: ThemeTokens.ssh-status-inner-highlight;
                        opacity: 0.35;
                    }

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 18px;
                        padding-top: 10px;
                        padding-right: 18px;
                        padding-bottom: 10px;
                        spacing: 0px;

                        for hop[index] in root.connection-progress-hops : Rectangle {
                            horizontal-stretch: 1;
                            height: parent.height;
                            background: transparent;

                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 10px;

                                if index > 0 : connector := Rectangle {
                                    width: 60px;
                                    height: parent.height;
                                    background: transparent;

                                    ConnectionProgressDotRail {
                                        x: 0px;
                                        y: 25px;
                                        width: 30px;
                                        dot-color: root.connection-progress-hop-connector-brush(hop.state);
                                    }

                                    Rectangle {
                                        x: (parent.width - 22px) / 2;
                                        y: 14px;
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 11px;
                                        border-width: 1px;
                                        border-color: hop.state == "current"
                                            ? ThemeTokens.ssh-status-hop-current-border
                                            : ThemeTokens.ssh-status-hop-node-border;
                                        background: hop.state == "current"
                                            ? ThemeTokens.ssh-status-hop-current-icon-surface
                                            : ThemeTokens.ssh-status-card-elevated-surface;

                                        Image {
                                            x: 5px;
                                            y: 5px;
                                            width: 12px;
                                            height: 12px;
                                            source: root.ssh-chevron-right-icon;
                                            image-fit: contain;
                                            colorize: hop.state == "current"
                                                ? ThemeTokens.ssh-status-progress-accent
                                                : ThemeTokens.text-secondary;
                                            opacity: hop.state == "current" ? 0.98 : 0.8;
                                        }
                                    }

                                    ConnectionProgressDotRail {
                                        x: parent.width - self.width;
                                        y: 25px;
                                        width: 30px;
                                        dot-color: root.connection-progress-hop-connector-brush(hop.state);
                                    }
                                }

                                node-card := Rectangle {
                                    horizontal-stretch: 1;
                                    height: 52px;
                                    border-radius: ThemeTokens.ssh-status-hop-radius;
                                    border-width: 1px;
                                    border-color: root.connection-progress-hop-node-border(hop.state);
                                    background: root.connection-progress-hop-node-surface(hop.state);

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        padding-left: 10px;
                                        padding-top: 7px;
                                        padding-right: 12px;
                                        padding-bottom: 7px;
                                        spacing: 10px;

                                        icon-shell-wrap := Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            background: transparent;

                                            icon-shell := Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: 36px;
                                                height: 36px;
                                                border-radius: 11px;
                                                border-width: 1px;
                                                border-color: root.connection-progress-hop-icon-border(hop.state);
                                                background: root.connection-progress-hop-icon-surface(hop.state);

                                                if hop.kind == "local" : Image {
                                                    x: 7px;
                                                    y: 7px;
                                                    width: 22px;
                                                    height: 22px;
                                                    source: root.connection-progress-local-icon();
                                                    image-fit: contain;
                                                    colorize: ThemeTokens.dark-mode ? #8cfab4 : #37a868;
                                                }
                                                if hop.kind == "jump_host" : Image {
                                                    x: 7px;
                                                    y: 7px;
                                                    width: 22px;
                                                    height: 22px;
                                                    source: root.connection-progress-jump-host-icon();
                                                    image-fit: contain;
                                                    colorize: ThemeTokens.dark-mode ? #99adff : #6f86d3;
                                                }
                                                if hop.kind == "target" : Image {
                                                    x: 7px;
                                                    y: 7px;
                                                    width: 22px;
                                                    height: 22px;
                                                    source: root.connection-progress-target-icon();
                                                    image-fit: contain;
                                                    colorize: hop.state == "current"
                                                        ? (ThemeTokens.dark-mode ? #d2a6ff : #8f58c7)
                                                        : (ThemeTokens.dark-mode ? #b798dd : #9168bd);
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 1px;

                                            SshStatusText {
                                                height: 22px;
                                                text: hop.label;
                                                color: hop.state == "failed"
                                                    ? ThemeTokens.text-primary
                                                    : hop.state == "pending"
                                                        ? ThemeTokens.text-secondary
                                                        : ThemeTokens.text-primary;
                                                font-size: 15px;
                                                font-weight: hop.state == "current" || hop.state == "failed" ? 640 : 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            SshStatusText {
                                                height: 19px;
                                                text: hop.subtitle;
                                                color: hop.state == "failed"
                                                    ? ThemeTokens.status-error-accent
                                                    : hop.state == "current"
                                                        ? ThemeTokens.text-secondary
                                                        : ThemeTokens.text-muted;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                main-card := Rectangle {
                    width: parent.width;
                    height: root.connection-progress-main-card-height();
                    border-radius: ThemeTokens.ssh-status-card-radius;
                    border-width: 1px;
                    border-color: root.connection-progress-visual-state == "host_key_warning"
                        ? ThemeTokens.ssh-status-warning-border
                        : root.connection-progress-visual-state == "failed"
                            ? ThemeTokens.ssh-status-danger-border
                            : ThemeTokens.ssh-status-card-border;
                    background: ThemeTokens.ssh-status-card-surface;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: ThemeTokens.ssh-status-inner-highlight;
                        opacity: 0.35;
                    }

                    if root.connection-progress-visual-state == "verifying_host_key" : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        Rectangle {
                            x: 36px;
                            y: 34px;
                            width: 148px;
                            height: 148px;
                            background: transparent;

                            Image {
                                x: 2px;
                                y: 0px;
                                width: 144px;
                                height: 144px;
                                source: root.connection-progress-verify-shield-icon();
                                image-fit: contain;
                            }
                        }

                        SshStatusText {
                            x: 204px;
                            y: 30px;
                            width: parent.width - 232px;
                            height: 30px;
                            text: root.connection-progress-task-title;
                            color: ThemeTokens.text-primary;
                            font-size: 19px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        SshStatusText {
                            x: 204px;
                            y: 66px;
                            width: parent.width - 232px;
                            height: 44px;
                            text: root.connection-progress-task-detail;
                            color: ThemeTokens.text-secondary;
                            font-size: 14px;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            x: 204px;
                            y: 118px;
                            width: parent.width - 232px;
                            height: 1px;
                            background: ThemeTokens.divider-subtle;
                        }

                        for field[index] in root.connection-progress-main-fields : Rectangle {
                            x: 204px;
                            y: 130px + (index * 38px);
                            width: parent.width - 232px;
                            height: 34px;
                            background: transparent;

                            value-measure := SshStatusText {
                                x: 0px;
                                y: 0px;
                                width: 0px;
                                height: 0px;
                                text: field.value;
                                font-size: field.monospace ? 12px : 13px;
                                font-family: field.monospace ? "JetBrains Maple Mono" : "Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif";
                                color: transparent;
                            }

                            SshStatusText {
                                x: 0px;
                                y: 0px;
                                width: 126px;
                                height: parent.height;
                                text: field.label;
                                color: ThemeTokens.text-secondary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            if field.monospace : Rectangle {
                                x: 126px;
                                y: 0px;
                                width: parent.width - 154px;
                                height: 40px;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: ThemeTokens.ssh-status-field-border;
                                background: ThemeTokens.ssh-status-field-surface;

                                SshStatusText {
                                    x: 12px;
                                    y: 0px;
                                    width: parent.width - 42px;
                                    height: parent.height;
                                    text: field.value;
                                    color: ThemeTokens.text-secondary;
                                    font-size: 12px;
                                    font-family: "JetBrains Maple Mono";
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if !field.monospace : SshStatusText {
                                x: 126px;
                                y: 0px;
                                width: parent.width - 154px;
                                height: parent.height;
                                text: field.value;
                                color: ThemeTokens.text-primary;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if field.copy_value != "" : Rectangle {
                                x: field.monospace
                                    ? parent.width - 22px
                                    : min(parent.width - 22px, 126px + value-measure.preferred-width + 6px);
                                y: field.monospace ? 10px : 7px;
                                width: 20px;
                                height: 20px;
                                border-radius: 0px;
                                border-width: 0px;
                                background: transparent;

                                Image {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.connection-progress-copy-icon();
                                    image-fit: contain;
                                }

                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => {
                                        root.local-action-requested("copy-connection-field:" + field.copy_value);
                                    }
                                }
                            }
                        }
                    }

                    if root.connection-progress-visual-state == "host_key_warning" : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        Rectangle {
                            x: 24px;
                            y: 24px;
                            width: 88px;
                            height: 88px;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: ThemeTokens.ssh-status-warning-border;
                            background: ThemeTokens.ssh-status-warning-surface;

                            Image {
                                x: 24px;
                                y: 24px;
                                width: 40px;
                                height: 40px;
                                source: root.ssh-status-warning-icon;
                            }
                        }

                        SshStatusText {
                            x: 136px;
                            y: 24px;
                            width: parent.width - 160px;
                            height: 30px;
                            text: root.connection-progress-task-title;
                            color: ThemeTokens.text-primary;
                            font-size: 19px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        SshStatusText {
                            x: 136px;
                            y: 60px;
                            width: parent.width - 160px;
                            height: 48px;
                            text: root.connection-progress-task-detail;
                            color: ThemeTokens.text-secondary;
                            font-size: 14px;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            x: 136px;
                            y: 116px;
                            width: (parent.width - 172px) / 2;
                            height: 112px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: ThemeTokens.ssh-status-card-border;
                            background: ThemeTokens.ssh-status-card-elevated-surface;

                            SshStatusText {
                                x: 14px;
                                y: 12px;
                                width: parent.width - 28px;
                                height: 18px;
                                text: "Expected";
                                color: ThemeTokens.text-secondary;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            SshStatusText {
                                x: 14px;
                                y: 38px;
                                width: parent.width - 28px;
                                height: 52px;
                                text: root.connection-progress-host-key-warning-expected;
                                color: ThemeTokens.text-primary;
                                font-size: 12px;
                                font-family: "JetBrains Maple Mono";
                                wrap: word-wrap;
                            }
                        }

                        Rectangle {
                            x: 148px + (parent.width - 172px) / 2;
                            y: 116px;
                            width: (parent.width - 172px) / 2;
                            height: 112px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: ThemeTokens.ssh-status-warning-border;
                            background: ThemeTokens.ssh-status-warning-surface;

                            SshStatusText {
                                x: 14px;
                                y: 12px;
                                width: parent.width - 28px;
                                height: 18px;
                                text: "Current";
                                color: ThemeTokens.ssh-status-warning-fg;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            SshStatusText {
                                x: 14px;
                                y: 38px;
                                width: parent.width - 28px;
                                height: 52px;
                                text: root.connection-progress-host-key-warning-current;
                                color: ThemeTokens.text-primary;
                                font-size: 12px;
                                font-family: "JetBrains Maple Mono";
                                wrap: word-wrap;
                            }
                        }

                        for field[index] in root.connection-progress-main-fields : Rectangle {
                            x: 136px;
                            y: 240px + (index * 30px);
                            width: parent.width - 160px;
                            height: 26px;
                            background: transparent;

                            if index < 2 : SshStatusText {
                                x: 0px;
                                y: 0px;
                                width: 122px;
                                height: parent.height;
                                text: field.label;
                                color: ThemeTokens.text-secondary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            if index < 2 : SshStatusText {
                                x: 122px;
                                y: 0px;
                                width: parent.width - 122px;
                                height: parent.height;
                                text: field.value;
                                color: ThemeTokens.text-primary;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    if root.connection-progress-visual-state == "connecting" : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        Rectangle {
                            x: 24px;
                            y: 28px;
                            width: 116px;
                            height: 104px;
                            background: transparent;

                            Rectangle {
                                x: 10px;
                                y: 4px;
                                width: 92px;
                                height: 92px;
                                border-radius: 26px;
                                border-width: 1px;
                                border-color: ThemeTokens.ssh-status-hero-border;
                                background: ThemeTokens.ssh-status-hero-glow;

                                Rectangle {
                                    x: 5px;
                                    y: 5px;
                                    width: parent.width - 10px;
                                    height: parent.height - 10px;
                                    border-radius: 22px;
                                    border-width: 1px;
                                    border-color: ThemeTokens.ssh-status-hero-border;
                                    background: ThemeTokens.ssh-status-hero-surface;
                                }

                                Image {
                                    x: 20px;
                                    y: 20px;
                                    width: 52px;
                                    height: 52px;
                                    source: root.connection-progress-connecting-focus-icon();
                                    image-fit: contain;
                                    colorize: ThemeTokens.ssh-status-hero-icon;
                                }
                            }
                        }

                        right-column := Rectangle {
                            x: 164px;
                            y: 24px;
                            width: parent.width - 188px;
                            height: parent.height - 40px;
                            background: transparent;

                            VerticalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 10px;

                                connecting-header-row := Rectangle {
                                    width: parent.width;
                                    height: 56px;
                                    background: transparent;

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        spacing: 14px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;

                                            SshStatusText {
                                                height: 24px;
                                                text: root.connection-progress-task-title;
                                                color: ThemeTokens.text-primary;
                                                font-size: 19px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            SshStatusText {
                                                height: 30px;
                                                text: root.connection-progress-stage-detail();
                                                color: ThemeTokens.text-secondary;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        if root.connection-progress-current-hop != "" : Rectangle {
                                            width: max(108px, stage-pill-label.preferred-width + 30px);
                                            height: 32px;
                                            border-radius: ThemeTokens.ssh-status-pill-radius;
                                            border-width: 1px;
                                            border-color: ThemeTokens.ssh-status-field-border;
                                            background: ThemeTokens.ssh-status-field-surface;

                                            HorizontalLayout {
                                                width: parent.width;
                                                height: parent.height;
                                                padding-left: 10px;
                                                padding-right: 11px;
                                                spacing: 7px;

                                                Rectangle {
                                                    width: 8px;
                                                    height: 8px;
                                                    y: 12px;
                                                    border-radius: 4px;
                                                    background: ThemeTokens.ssh-status-progress-accent;
                                                }

                                                stage-pill-label := SshStatusText {
                                                    text: root.connection-progress-stage-title();
                                                    color: ThemeTokens.text-primary;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.connection-progress-has-steps() : Rectangle {
                                    width: parent.width;
                                    height: 1px;
                                    background: ThemeTokens.divider-subtle;
                                }

                                if root.connection-progress-has-steps() : VerticalLayout {
                                    width: parent.width;
                                    spacing: 4px;

                                    for step in root.connection-progress-steps : Rectangle {
                                        width: parent.width;
                                        height: root.connection-progress-step-row-height(step.state);
                                        border-radius: 11px;
                                        border-width: root.connection-progress-step-is-active(step.state)
                                            || root.connection-progress-step-is-error(step.state)
                                            ? 1px
                                            : 0px;
                                        border-color: root.connection-progress-step-is-error(step.state)
                                            ? ThemeTokens.ssh-status-danger-border
                                            : ThemeTokens.ssh-status-field-border;
                                        background: root.connection-progress-step-is-error(step.state)
                                            ? ThemeTokens.ssh-status-danger-surface
                                            : root.connection-progress-step-is-active(step.state)
                                                ? ThemeTokens.ssh-status-card-elevated-surface
                                                : transparent;

                                        HorizontalLayout {
                                            width: parent.width;
                                            height: parent.height;
                                            padding-left: 10px;
                                            padding-top: 5px;
                                            padding-right: 10px;
                                            padding-bottom: 5px;
                                            spacing: 10px;

                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                y: root.connection-progress-step-shows-detail(step.state) ? 8px : 6px;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: step.state == "done"
                                                    ? ThemeTokens.status-success-accent
                                                    : root.connection-progress-step-is-active(step.state)
                                                        ? ThemeTokens.ssh-status-progress-accent
                                                        : root.connection-progress-step-is-error(step.state)
                                                            ? ThemeTokens.status-error-accent
                                                            : ThemeTokens.divider-strong;
                                                background: step.state == "done"
                                                    ? ThemeTokens.status-success-accent
                                                    : root.connection-progress-step-is-active(step.state)
                                                        ? ThemeTokens.ssh-status-progress-accent
                                                        : root.connection-progress-step-is-error(step.state)
                                                            ? ThemeTokens.status-error-accent
                                                            : transparent;

                                                if step.state == "done" : Rectangle {
                                                    x: 4px;
                                                    y: 4px;
                                                    width: 4px;
                                                    height: 4px;
                                                    border-radius: 2px;
                                                    background: ThemeTokens.ssh-status-card-surface;
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: root.connection-progress-step-shows-detail(step.state) ? 3px : 0px;

                                                SshStatusText {
                                                    height: 18px;
                                                    text: step.title;
                                                    color: step.state == "pending" ? ThemeTokens.text-secondary : ThemeTokens.text-primary;
                                                    font-size: 13px;
                                                    font-weight: root.connection-progress-step-is-active(step.state) ? 620 : 580;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }

                                                if root.connection-progress-step-shows-detail(step.state) : SshStatusText {
                                                    height: 16px;
                                                    text: step.detail;
                                                    color: root.connection-progress-step-is-error(step.state)
                                                        ? ThemeTokens.status-error-accent
                                                        : ThemeTokens.text-secondary;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            if step.hop_label != "" : SshStatusText {
                                                width: 70px;
                                                height: parent.height;
                                                text: step.hop_label;
                                                color: ThemeTokens.text-muted;
                                                font-size: 11px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }

                                if !root.connection-progress-has-steps() : Rectangle {
                                    width: parent.width;
                                    height: 136px;
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: ThemeTokens.ssh-status-field-border;
                                    background: ThemeTokens.ssh-status-card-elevated-surface;

                                    VerticalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        padding-left: 14px;
                                        padding-top: 12px;
                                        padding-right: 14px;
                                        padding-bottom: 12px;
                                        spacing: 8px;

                                        for field[index] in root.connection-progress-main-fields : Rectangle {
                                            if index < 4 : HorizontalLayout {
                                                width: parent.width;
                                                height: 22px;
                                                spacing: 12px;

                                                SshStatusText {
                                                    width: 108px;
                                                    height: parent.height;
                                                    text: field.label;
                                                    color: ThemeTokens.text-secondary;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }

                                                SshStatusText {
                                                    horizontal-stretch: 1;
                                                    height: parent.height;
                                                    text: field.value;
                                                    color: ThemeTokens.text-primary;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.connection-progress-visual-state == "failed" : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        Rectangle {
                            x: 24px;
                            y: 24px;
                            width: 88px;
                            height: 88px;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: ThemeTokens.ssh-status-danger-border;
                            background: ThemeTokens.ssh-status-danger-surface;

                            Image {
                                x: 24px;
                                y: 24px;
                                width: 40px;
                                height: 40px;
                                source: root.ssh-status-failed-icon;
                            }
                        }

                        SshStatusText {
                            x: 136px;
                            y: 24px;
                            width: parent.width - 160px;
                            height: 30px;
                            text: root.connection-progress-task-title;
                            color: ThemeTokens.text-primary;
                            font-size: 19px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        SshStatusText {
                            x: 136px;
                            y: 60px;
                            width: parent.width - 160px;
                            height: 44px;
                            text: root.connection-progress-task-detail;
                            color: ThemeTokens.text-secondary;
                            font-size: 14px;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            x: 136px;
                            y: 116px;
                            width: parent.width - 160px;
                            height: 1px;
                            background: ThemeTokens.divider-subtle;
                        }

                        for field[index] in root.connection-progress-main-fields : Rectangle {
                            x: 136px;
                            y: 132px + (index * 34px);
                            width: parent.width - 160px;
                            height: 30px;
                            background: transparent;

                            SshStatusText {
                                x: 0px;
                                y: 0px;
                                width: 122px;
                                height: parent.height;
                                text: field.label;
                                color: ThemeTokens.text-secondary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            SshStatusText {
                                x: 122px;
                                y: 0px;
                                width: parent.width - 122px;
                                height: parent.height;
                                text: field.value;
                                color: ThemeTokens.text-primary;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                }

                details-card := Rectangle {
                    width: parent.width;
                    height: root.connection-progress-diagnostics-expanded ? 232px : 80px;
                    border-radius: ThemeTokens.ssh-status-card-radius;
                    border-width: 1px;
                    border-color: ThemeTokens.ssh-status-card-border;
                    background: ThemeTokens.ssh-status-card-surface;
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: ThemeTokens.ssh-status-inner-highlight;
                        opacity: 0.35;
                    }

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 16px;
                        padding-top: 12px;
                        padding-right: 16px;
                        padding-bottom: 12px;
                        spacing: 10px;

                        details-header-row := Rectangle {
                            width: parent.width;
                            height: 40px;
                            background: transparent;

                            HorizontalLayout {
                                width: parent.width - 28px;
                                height: parent.height;
                                spacing: 10px;

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: ThemeTokens.ssh-status-field-border;
                                    background: ThemeTokens.ssh-status-field-surface;

                                    Image {
                                        x: 6px;
                                        y: 6px;
                                        width: 20px;
                                        height: 20px;
                                        source: root.connection-progress-details-gear-icon();
                                        image-fit: contain;
                                        colorize: ThemeTokens.dark-mode ? #dce4ef : #7f90a5;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;

                                    SshStatusText {
                                        height: 22px;
                                        text: "Connection details";
                                        color: ThemeTokens.text-primary;
                                        font-size: 15px;
                                        font-weight: 650;
                                        vertical-alignment: center;
                                    }

                                    SshStatusText {
                                        height: 18px;
                                        text: "User, authentication, and advanced SSH options";
                                        color: ThemeTokens.text-secondary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                            }

                            Rectangle {
                                x: parent.width - 44px;
                                y: 11px;
                                width: 16px;
                                height: 16px;
                                background: transparent;

                                Image {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.connection-progress-diagnostics-expanded
                                        ? root.fluent-chevron-down-icon
                                        : root.fluent-chevron-right-icon;
                                    image-fit: contain;
                                    colorize: ThemeTokens.text-secondary;
                                    opacity: 0.9;
                                }
                            }

                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.connection-progress-diagnostics-expanded = !root.connection-progress-diagnostics-expanded;
                                }
                            }
                        }

                        if root.connection-progress-diagnostics-expanded : Rectangle {
                            width: parent.width;
                            vertical-stretch: 1;
                            background: transparent;

                            VerticalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 10px;

                                Rectangle {
                                    width: parent.width;
                                    height: 1px;
                                    background: ThemeTokens.divider-subtle;
                                }

                                SshStatusText {
                                    height: 18px;
                                    text: "SSH settings";
                                    color: ThemeTokens.text-secondary;
                                    font-size: 12px;
                                    font-weight: 600;
                                }

                                for field in root.connection-progress-detail-fields : Rectangle {
                                    width: parent.width;
                                    height: 30px;
                                    background: transparent;

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        spacing: 14px;

                                        SshStatusText {
                                            width: 160px;
                                            height: parent.height;
                                            text: field.label;
                                            color: ThemeTokens.text-secondary;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }

                                        SshStatusText {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            text: field.value;
                                            color: field.monospace ? ThemeTokens.text-secondary : ThemeTokens.text-primary;
                                            font-size: 13px;
                                            font-family: field.monospace ? "JetBrains Maple Mono" : "Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif";
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                if root.connection-progress-diagnostics.length > 0 : Rectangle {
                                    width: parent.width;
                                    height: 1px;
                                    background: ThemeTokens.divider-subtle;
                                }

                                if root.connection-progress-diagnostics.length > 0 : SshStatusText {
                                    height: 18px;
                                    text: "Diagnostics";
                                    color: ThemeTokens.text-secondary;
                                    font-size: 12px;
                                    font-weight: 600;
                                }

                                for line in root.connection-progress-diagnostics : SshStatusText {
                                    width: parent.width;
                                    text: line.text;
                                    color: ThemeTokens.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Rectangle {
                    width: parent.width;
                    height: 1px;
                    background: ThemeTokens.divider-subtle;
                }

                action-bar := Rectangle {
                    width: parent.width;
                    height: root.connection-progress-footer-height();
                    border-radius: 0px;
                    border-width: 0px;
                    border-color: transparent;
                    background: ThemeTokens.ssh-status-footer-surface;

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 0px;
                        padding-top: root.connection-progress-visual-state == "connecting" ? 6px : 10px;
                        padding-right: 18px;
                        padding-bottom: root.connection-progress-visual-state == "connecting" ? 6px : 10px;
                        spacing: 14px;

                        ConnectionProgressEscapeBlock {
                            title: root.connection-progress-visual-state == "failed" ? "Dismiss" : "Cancel connection";
                            detail: root.connection-progress-cancel-supporting-copy();
                            icon-source: root.fluent-dismiss-icon;

                            clicked => {
                                root.local-action-requested("cancel-connection-attempt");
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        if root.connection-progress-visual-state == "verifying_host_key" : ConnectionProgressActionButton {
                            width: 192px;
                            label: "Reject";
                            tone: "secondary";
                            show-icon: true;
                            icon-source: root.ssh-verify-shield-glyph-icon;

                            clicked => {
                                root.local-action-requested("reject-host-key");
                            }
                        }

                        if root.connection-progress-visual-state == "verifying_host_key" : ConnectionProgressActionButton {
                            width: 312px;
                            label: "Trust & Continue";
                            tone: "primary";
                            show-icon: true;
                            icon-source: root.ssh-verify-shield-glyph-icon;

                            clicked => {
                                root.local-action-requested("trust-host-key");
                            }
                        }

                        if root.connection-progress-visual-state == "host_key_warning" : ConnectionProgressActionButton {
                            width: 188px;
                            label: "Reject";
                            tone: "secondary";

                            clicked => {
                                root.local-action-requested("reject-host-key");
                            }
                        }

                        if root.connection-progress-visual-state == "host_key_warning" : ConnectionProgressActionButton {
                            width: 244px;
                            label: "Update trusted key...";
                            tone: "danger";

                            clicked => {
                                root.local-action-requested("update-trusted-host-key");
                            }
                        }

                        if root.connection-progress-visual-state == "failed" : ConnectionProgressActionButton {
                            width: 120px;
                            label: "Copy details";
                            tone: "secondary";

                            clicked => {
                                root.local-action-requested("copy-connection-diagnostics");
                            }
                        }

                        if root.connection-progress-visual-state == "failed" : ConnectionProgressActionButton {
                            width: 96px;
                            label: "Retry";
                            tone: "primary";

                            clicked => {
                                root.local-action-requested("retry-connection-attempt");
                            }
                        }
                    }
                }
            }
        }
    }

    if root.mode == "session-error" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        VerticalLayout {
            padding-left: 16px;
            padding-top: 16px;
            padding-right: 16px;
            padding-bottom: 16px;
            spacing: 6px;

            Text {
                text: root.session-title != "" ? root.session-title : "Session Issue";
                color: ThemeTokens.text-primary;
                font-size: 16px;
                font-weight: 700;
            }

            Text {
                text: root.session-state == "disconnected" && root.can-reconnect ? "Connection dropped. Reconnect is available." :
                      root.session-state == "disconnected" ? "Connection dropped." :
                      root.session-state == "error" && root.session-error-detail != "" ? root.session-error-detail :
                      root.session-state == "error" ? "Connection failed." :
                      "Session is unavailable.";
                color: ThemeTokens.text-primary;
                font-size: 12px;
                wrap: word-wrap;
            }

        }
    }
}
