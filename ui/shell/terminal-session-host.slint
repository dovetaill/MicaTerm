// Workspace content host that switches between welcome, terminal, and error states.

import { ThemeTokens } from "../theme/tokens.slint";
import { WelcomeView } from "../welcome/welcome-view.slint";

export struct TerminalCellItem {
    row: int,
    col: int,
    width: int,
    text: string,
    fg: color,
    bg: color,
}

component TerminalContextMenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> has-hover: touch.has-hover;
    callback invoked();

    height: 32px;
    border-radius: 6px;
    background: !root.enabled
        ? transparent
        : touch.pressed
            ? ThemeTokens.menu-row-open-surface
            : touch.has-hover
                ? ThemeTokens.menu-row-hover-surface
                : transparent;

    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        opacity: root.enabled ? 1.0 : 0.48;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.invoked();
        }
    }
}

export component TerminalSessionHost inherits Rectangle {
    in property <string> session-id: "";
    in property <string> mode: "welcome";
    in property <string> session-title: "";
    in property <string> session-subtitle: "";
    in property <string> session-state: "";
    in property <string> session-error-detail: "";
    in property <bool> can-reconnect: false;
    in property <[TerminalCellItem]> session-cells: [];
    in property <int> session-rows: 24;
    in property <int> session-cols: 80;
    in property <int> session-cursor-row: 0;
    in property <int> session-cursor-col: 0;
    in property <bool> session-cursor-visible: false;
    in property <bool> session-cursor-blinking: false;
    in property <string> session-cursor-shape: "block";
    in property <color> session-cursor-fg: #000000;
    in property <color> session-cursor-bg: #52ad70;
    in property <bool> session-mouse-grabbed: false;
    in property <[string]> session-visible-lines: [];
    in property <int> session-surface-seqno: 0;
    callback text-input(string);
    callback key-input(string, bool, bool, bool);
    callback surface-resize-requested(int, int);
    callback copy-selection-requested(int, int, int, int);
    callback paste-requested();
    callback scroll-requested(int, int, int, bool, bool, bool);
    callback mouse-input(string, string, int, int, bool, bool, bool);

    private property <string> terminal-font-family: "Cascadia Mono";
    private property <length> terminal-font-size: 12px;
    private property <length> terminal-cell-width: 8px;
    private property <length> terminal-cell-height: 16px;
    private property <length> terminal-cursor-thickness: 2px;
    private property <length> terminal-padding-left: 12px;
    private property <length> terminal-padding-top: 10px;
    private property <length> terminal-padding-right: 12px;
    private property <length> terminal-padding-bottom: 10px;
    private property <int> selection-anchor-row: -1;
    private property <int> selection-anchor-col: -1;
    private property <int> selection-focus-row: -1;
    private property <int> selection-focus-col: -1;
    private property <bool> selection-drag-active: false;
    private property <bool> cursor-blink-visible: true;
    private property <bool> terminal-context-menu-open: false;
    private property <length> terminal-context-menu-x: 12px;
    private property <length> terminal-context-menu-y: 12px;

    function terminal-content-width() -> length {
        return max(0px, root.width - root.terminal-padding-left - root.terminal-padding-right);
    }

    function terminal-content-height() -> length {
        return max(0px, root.height - root.terminal-padding-top - root.terminal-padding-bottom);
    }

    function terminal-grid-width() -> length {
        return root.session-cols * root.terminal-cell-width;
    }

    function terminal-grid-height() -> length {
        return root.session-rows * root.terminal-cell-height;
    }

    function terminal-cell-x(col: int) -> length {
        return root.terminal-padding-left + (col * root.terminal-cell-width);
    }

    function terminal-cell-y(row: int) -> length {
        return root.terminal-padding-top + (row * root.terminal-cell-height);
    }

    function terminal-hit-row(pointer-y: length) -> int {
        return max(0, min(
            root.session-rows - 1,
            (((pointer-y - root.terminal-padding-top) / 1px) / (root.terminal-cell-height / 1px)),
        ));
    }

    function terminal-hit-col(pointer-x: length) -> int {
        return max(0, min(
            root.session-cols - 1,
            (((pointer-x - root.terminal-padding-left) / 1px) / (root.terminal-cell-width / 1px)),
        ));
    }

    function emit-surface-resize() {
        if root.mode == "terminal" {
            root.surface-resize-requested(
                max(1, (root.terminal-content-height() / 1px) / (root.terminal-cell-height / 1px)),
                max(1, (root.terminal-content-width() / 1px) / (root.terminal-cell-width / 1px)),
            );
        }
    }

    function clear-selection() {
        root.selection-anchor-row = -1;
        root.selection-anchor-col = -1;
        root.selection-focus-row = -1;
        root.selection-focus-col = -1;
        root.selection-drag-active = false;
    }

    function close-context-menu() {
        root.terminal-context-menu-open = false;
    }

    function has-selection() -> bool {
        return root.selection-anchor-row >= 0 && root.selection-focus-row >= 0;
    }

    function normalized-selection-start-row() -> int {
        return root.selection-anchor-row < root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col <= root.selection-focus-col)
            ? root.selection-anchor-row
            : root.selection-focus-row;
    }

    function normalized-selection-start-col() -> int {
        return root.selection-anchor-row < root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col <= root.selection-focus-col)
            ? root.selection-anchor-col
            : root.selection-focus-col;
    }

    function normalized-selection-end-row() -> int {
        return root.selection-anchor-row > root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col > root.selection-focus-col)
            ? root.selection-anchor-row
            : root.selection-focus-row;
    }

    function normalized-selection-end-col() -> int {
        return root.selection-anchor-row > root.selection-focus-row
            || (root.selection-anchor-row == root.selection-focus-row
                && root.selection-anchor-col > root.selection-focus-col)
            ? root.selection-anchor-col
            : root.selection-focus-col;
    }

    function selection-copy-enabled() -> bool {
        return root.has-selection();
    }

    function cell-selected(row: int, col: int, width: int) -> bool {
        if !root.has-selection() {
            return false;
        }
        let start-row = root.normalized-selection-start-row();
        let end-row = root.normalized-selection-end-row();
        if row < start-row || row > end-row {
            return false;
        }
        let row-start-col = row == start-row ? root.normalized-selection-start-col() : 0;
        let row-end-col = row == end-row ? root.normalized-selection-end-col() : root.session-cols - 1;
        let cell-end-col = col + width - 1;
        return cell-end-col >= row-start-col && col <= row-end-col;
    }

    function terminal-menu-width() -> length {
        return 168px;
    }

    function terminal-menu-height() -> length {
        return 108px;
    }

    function open-context-menu(pointer-x: length, pointer-y: length) {
        root.terminal-context-menu-open = true;
        root.terminal-context-menu-x = min(
            max(12px, pointer-x),
            max(12px, root.width - root.terminal-menu-width() - 12px),
        );
        root.terminal-context-menu-y = min(
            max(12px, pointer-y),
            max(12px, root.height - root.terminal-menu-height() - 12px),
        );
    }

    width: 100%;
    height: 100%;
    min-width: 0px;
    background: transparent;

    changed mode => {
        root.close-context-menu();
        root.clear-selection();
        if root.mode == "terminal" {
            root.emit-surface-resize();
        }
    }

    changed session-id => {
        root.close-context-menu();
        root.clear-selection();
        if root.mode == "terminal" && root.session-id != "" {
            root.emit-surface-resize();
        }
    }

    changed session-surface-seqno => {
        root.cursor-blink-visible = true;
        cursor-blink-timer.stop();
        if root.mode == "terminal" && root.session-cursor-visible && root.session-cursor-blinking {
            cursor-blink-timer.start();
        }
    }

    changed width => {
        root.emit-surface-resize();
    }

    changed height => {
        root.emit-surface-resize();
    }

    cursor-blink-timer := Timer {
        interval: 520ms;
        running: false;

        triggered => {
            if root.mode != "terminal" || !root.session-cursor-visible || !root.session-cursor-blinking {
                self.running = false;
                root.cursor-blink-visible = true;
            } else {
                root.cursor-blink-visible = !root.cursor-blink-visible;
                self.restart();
            }
        }
    }

    if root.mode == "welcome" : WelcomeView {
        width: parent.width;
        height: parent.height;
    }

    if root.mode == "terminal" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        terminal-input := TextInput {
            x: 0px;
            y: 0px;
            width: 1px;
            height: 1px;
            text: "";
            color: transparent;

            edited => {
                if self.text != "" {
                    root.text-input(self.text);
                    self.text = "";
                }
            }

            key-pressed(event) => {
                if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && (event.text == "c" || event.text == "C")) {
                    if root.has-selection() {
                        root.copy-selection-requested(
                            root.normalized-selection-start-row(),
                            root.normalized-selection-start-col(),
                            root.normalized-selection-end-row(),
                            root.normalized-selection-end-col(),
                        );
                        accept
                    } else {
                        reject
                    }
                } else if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && (event.text == "v" || event.text == "V")) {
                    root.paste-requested();
                    accept
                } else if (!event.modifiers.control && !event.modifiers.alt && event.modifiers.shift && event.text == Key.Insert) {
                    root.paste-requested();
                    accept
                } else if (event.text == Key.Return) {
                    root.key-input("enter", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Tab) {
                    root.key-input("tab", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Escape) {
                    root.close-context-menu();
                    root.key-input("escape", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Backspace) {
                    root.key-input("backspace", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Delete) {
                    root.key-input("delete", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.UpArrow) {
                    root.key-input("up", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.DownArrow) {
                    root.key-input("down", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.LeftArrow) {
                    root.key-input("left", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.RightArrow) {
                    root.key-input("right", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.Home) {
                    root.key-input("home", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.End) {
                    root.key-input("end", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.PageUp) {
                    root.key-input("page-up", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.text == Key.PageDown) {
                    root.key-input("page-down", event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && event.text == "a") {
                    root.selection-anchor-row = 0;
                    root.selection-anchor-col = 0;
                    root.selection-focus-row = max(0, root.session-rows - 1);
                    root.selection-focus-col = max(0, root.session-cols - 1);
                    accept
                } else if ((event.modifiers.control || event.modifiers.alt) && event.text != "") {
                    root.key-input(event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift);
                    accept
                } else {
                    reject
                }
            }
        }

        surface-frame := Rectangle {
            width: parent.width;
            height: parent.height;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.terminal-canvas-surface;

            blank-surface := Rectangle {
                x: root.terminal-padding-left;
                y: root.terminal-padding-top;
                width: root.terminal-grid-width();
                height: root.terminal-grid-height();
                background: ThemeTokens.terminal-canvas-surface;
            }

            input-capture := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.text;

                scroll-event(event) => {
                    if event.delta-y > 0px || event.delta-y < 0px {
                        let row = root.terminal-hit-row(self.mouse-y);
                        let col = root.terminal-hit-col(self.mouse-x);
                        let delta-lines = event.delta-y > 0px ? 1 : -1;
                        terminal-input.focus();
                        root.close-context-menu();
                        root.scroll-requested(
                            delta-lines,
                            row,
                            col,
                            event.modifiers.shift,
                            event.modifiers.control,
                            event.modifiers.alt,
                        );
                        return accept;
                    }
                    reject
                }

                pointer-event(event) => {
                    let row = root.terminal-hit-row(self.mouse-y);
                    let col = root.terminal-hit-col(self.mouse-x);
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        terminal-input.focus();
                        root.close-context-menu();
                        if root.session-mouse-grabbed {
                            root.mouse-input(
                                "down",
                                "left",
                                row,
                                col,
                                event.modifiers.shift,
                                event.modifiers.control,
                                event.modifiers.alt,
                            );
                        } else {
                            root.selection-anchor-row = row;
                            root.selection-anchor-col = col;
                            root.selection-focus-row = row;
                            root.selection-focus-col = col;
                            root.selection-drag-active = true;
                        }
                    } else if event.kind == PointerEventKind.move {
                        if root.session-mouse-grabbed {
                            root.mouse-input(
                                "move",
                                "none",
                                row,
                                col,
                                event.modifiers.shift,
                                event.modifiers.control,
                                event.modifiers.alt,
                            );
                        } else if root.selection-drag-active {
                            root.selection-focus-row = row;
                            root.selection-focus-col = col;
                        }
                    } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        if root.session-mouse-grabbed {
                            root.mouse-input(
                                "up",
                                "left",
                                row,
                                col,
                                event.modifiers.shift,
                                event.modifiers.control,
                                event.modifiers.alt,
                            );
                        } else {
                            if root.selection-anchor-row == root.selection-focus-row
                                && root.selection-anchor-col == root.selection-focus-col {
                                root.clear-selection();
                            }
                            root.selection-drag-active = false;
                        }
                    } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        terminal-input.focus();
                        if root.session-mouse-grabbed {
                            root.mouse-input(
                                "down",
                                "right",
                                row,
                                col,
                                event.modifiers.shift,
                                event.modifiers.control,
                                event.modifiers.alt,
                            );
                        } else {
                            root.open-context-menu(self.mouse-x, self.mouse-y);
                        }
                    } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right && root.session-mouse-grabbed {
                        root.mouse-input(
                            "up",
                            "right",
                            row,
                            col,
                            event.modifiers.shift,
                            event.modifiers.control,
                            event.modifiers.alt,
                        );
                    }
                }
            }

            for cell in root.session-cells : Rectangle {
                x: root.terminal-cell-x(cell.col);
                y: root.terminal-cell-y(cell.row);
                width: max(root.terminal-cell-width, cell.width * root.terminal-cell-width);
                height: root.terminal-cell-height;
                background: root.cell-selected(cell.row, cell.col, cell.width)
                    ? ThemeTokens.accent
                    : cell.bg;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: cell.text;
                    color: root.cell-selected(cell.row, cell.col, cell.width)
                        ? (ThemeTokens.dark-mode ? #0b1117 : #ffffff)
                        : cell.fg;
                    font-size: root.terminal-font-size;
                    font-family: root.terminal-font-family;
                    vertical-alignment: center;
                }
            }

            if root.session-cursor-visible && root.cursor-blink-visible : cursor-overlay := Rectangle {
                x: root.terminal-cell-x(root.session-cursor-col);
                width: root.session-cursor-shape == "bar"
                    ? root.terminal-cursor-thickness
                    : root.terminal-cell-width;
                height: root.session-cursor-shape == "underline"
                    ? root.terminal-cursor-thickness
                    : root.terminal-cell-height;
                background: root.session-cursor-bg;
                opacity: root.session-cursor-shape == "block" ? 0.72 : 1.0;
                y: root.session-cursor-shape == "underline"
                    ? root.terminal-cell-y(root.session-cursor-row + 1) - root.terminal-cursor-thickness
                    : root.terminal-cell-y(root.session-cursor-row);
            }

            if root.terminal-context-menu-open : terminal-context-menu-dismiss-layer := TouchArea {
                width: parent.width;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.close-context-menu();
                    }
                }
            }

            if root.terminal-context-menu-open : terminal-context-menu := Rectangle {
                x: root.terminal-context-menu-x;
                y: root.terminal-context-menu-y;
                width: root.terminal-menu-width();
                height: root.terminal-menu-height();
                border-radius: 8px;
                border-width: 1px;
                border-color: ThemeTokens.divider-strong;
                background: ThemeTokens.inspector-surface;

                VerticalLayout {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    spacing: 4px;

                    copy-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Copy";
                        enabled: root.selection-copy-enabled();

                        invoked => {
                            root.close-context-menu();
                            root.copy-selection-requested(
                                root.normalized-selection-start-row(),
                                root.normalized-selection-start-col(),
                                root.normalized-selection-end-row(),
                                root.normalized-selection-end-col(),
                            );
                        }
                    }

                    paste-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Paste";

                        invoked => {
                            root.close-context-menu();
                            root.paste-requested();
                        }
                    }

                    select-all-row := TerminalContextMenuRow {
                        width: parent.width;
                        label: "Select All";

                        invoked => {
                            root.close-context-menu();
                            root.selection-anchor-row = 0;
                            root.selection-anchor-col = 0;
                            root.selection-focus-row = max(0, root.session-rows - 1);
                            root.selection-focus-col = max(0, root.session-cols - 1);
                            terminal-input.focus();
                        }
                    }
                }
            }
        }
    }

    if root.mode == "session-error" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        VerticalLayout {
            padding-left: 16px;
            padding-top: 16px;
            padding-right: 16px;
            padding-bottom: 16px;
            spacing: 6px;

            Text {
                text: root.session-title != "" ? root.session-title : "Session Issue";
                color: ThemeTokens.text-primary;
                font-size: 16px;
                font-weight: 700;
            }

            Text {
                text: root.session-state == "disconnected" && root.can-reconnect ? "Connection dropped. Reconnect is available." :
                      root.session-state == "disconnected" ? "Connection dropped." :
                      root.session-state == "error" && root.session-error-detail != "" ? root.session-error-detail :
                      root.session-state == "error" ? "Connection failed." :
                      "Session is unavailable.";
                color: ThemeTokens.text-primary;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
