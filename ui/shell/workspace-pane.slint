// Workspace pane that owns the tab strip and content host width contract.

import { ThemeTokens } from "../theme/tokens.slint";
import { QuickLaunchCardRow, QuickLaunchDetailRow, QuickLaunchGroupRow } from "../welcome/quick-launch-types.slint";
import { SftpWorkspaceHost } from "./sftp-workspace-host.slint";
import { TabBar, WorkspaceTabItem } from "./tabbar.slint";
import { ConnectionProgressDiagnosticRow, ConnectionProgressStepRow, TerminalCommandBlockRow, TerminalOverviewMarkerRow, TerminalSessionHost } from "./terminal-session-host.slint";

export component WorkspacePane inherits Rectangle {
    in property <[WorkspaceTabItem]> workspace-tab-items: [];
    in property <string> active-workspace-session-id: "";
    in property <string> workspace-session-host-mode: "welcome";
    in property <string> workspace-session-title: "";
    in property <string> workspace-session-subtitle: "";
    in property <string> workspace-session-state: "";
    in property <string> workspace-session-error-detail: "";
    in property <bool> workspace-session-can-reconnect: false;
    in property <string> workspace-session-render-mode: "bitmap";
    in property <string> workspace-session-connection-headline: "";
    in property <string> workspace-session-connection-current-hop: "";
    in property <string> workspace-session-connection-current-detail: "";
    in property <string> workspace-session-host-key-prompt-host: "";
    in property <string> workspace-session-host-key-prompt-fingerprint: "";
    in property <[ConnectionProgressStepRow]> workspace-session-connection-steps: [];
    in property <[ConnectionProgressDiagnosticRow]> workspace-session-connection-diagnostics: [];
    in property <[QuickLaunchCardRow]> welcome-quick-launch-recent-items: [];
    in property <[QuickLaunchCardRow]> welcome-quick-launch-favorite-items: [];
    in property <[QuickLaunchGroupRow]> welcome-quick-launch-group-items: [];
    in property <[QuickLaunchCardRow]> welcome-quick-launch-visible-group-items: [];
    in property <QuickLaunchDetailRow> welcome-quick-launch-selected-detail: {
        asset_id: "",
        title: "",
        subtitle: "",
        environment: "",
        auth_summary: "",
        proxy_summary: "",
        remark: "",
        recent_label: "",
    };
    in property <string> welcome-quick-launch-search-query: "";
    in property <image> workspace-session-surface-image;
    in property <int> workspace-session-native-frame-token: 0;
    in property <int> workspace-session-rows: 24;
    in property <int> workspace-session-cols: 80;
    in property <length> workspace-session-cell-width: 10px;
    in property <length> workspace-session-cell-height: 22px;
    in property <float> workspace-session-device-scale-factor: 1.0;
    in property <int> workspace-session-cursor-row: 0;
    in property <int> workspace-session-cursor-col: 0;
    in property <bool> workspace-session-cursor-visible: false;
    in property <bool> workspace-session-cursor-blinking: false;
    in property <string> workspace-session-cursor-shape: "block";
    in property <color> workspace-session-cursor-fg: ThemeTokens.terminal-cursor-fg;
    in property <color> workspace-session-cursor-bg: ThemeTokens.terminal-cursor-bg;
    in property <color> workspace-session-default-fg: ThemeTokens.terminal-default-fg;
    in property <color> workspace-session-default-bg: ThemeTokens.terminal-default-bg;
    in property <color> workspace-session-scrollbar-thumb: ThemeTokens.terminal-scrollbar-thumb-surface;
    in property <color> workspace-session-scrollbar-thumb-active: ThemeTokens.terminal-scrollbar-thumb-active-surface;
    in property <bool> workspace-session-mouse-grabbed: false;
    in property <[string]> workspace-session-visible-lines: [];
    in property <[TerminalCommandBlockRow]> workspace-session-command-blocks: [];
    in property <[TerminalOverviewMarkerRow]> workspace-session-overview-markers: [];
    in property <bool> workspace-session-search-open: false;
    in property <string> workspace-session-search-query: "";
    in property <int> workspace-session-search-match-count: 0;
    in property <int> workspace-session-search-focus-sequence: 0;
    in property <int> workspace-session-surface-seqno: 0;
    in property <int> workspace-session-viewport-offset-lines: 0;
    in property <int> workspace-session-viewport-max-offset-lines: 0;
    in property <bool> workspace-session-viewport-at-bottom: true;
    in-out property <bool> workspace-session-selection-active: false;
    in-out property <int> workspace-session-selection-start-row: -1;
    in-out property <int> workspace-session-selection-start-col: -1;
    in-out property <int> workspace-session-selection-end-row: -1;
    in-out property <int> workspace-session-selection-end-col: -1;
    in-out property <bool> workspace-session-context-menu-open: false;
    out property <length> layout-workspace-session-native-surface-x:
        content-host.x + session-host.native-surface-x;
    out property <length> layout-workspace-session-native-surface-y:
        content-host.y + session-host.native-surface-y;
    out property <length> layout-workspace-session-native-surface-width:
        session-host.native-surface-width;
    out property <length> layout-workspace-session-native-surface-height:
        session-host.native-surface-height;
    callback workspace-tab-selected(string);
    callback workspace-tab-close-requested(string);
    callback workspace-new-tab-requested();
    callback text-input(string);
    callback key-input(string, bool, bool, bool);
    callback surface-resize-requested(int, int);
    callback normalize-hit-col(int, int) -> int;
    callback normalize-selection-hit-col(int, int) -> int;
    callback open-url-requested(int, int) -> bool;
    callback copy-selection-requested(int, int, int, int);
    callback selection-changed();
    callback paste-requested();
    callback local-action-requested(string);
    callback scroll-requested(int, int, int, bool, bool, bool);
    callback scroll-thumb-drag-requested(float);
    callback scroll-jump-requested(float);
    callback mouse-input(string, string, int, int, bool, bool, bool);
    callback context-menu-open-changed(bool);
    callback search-open-requested();
    callback search-close-requested();
    callback search-query-changed(string);
    callback welcome-quick-launch-asset-selected(string);
    callback welcome-quick-launch-search-changed(string);
    callback welcome-quick-launch-connect-requested(string);
    callback welcome-quick-launch-connect-in-new-tab-requested(string);
    callback welcome-quick-launch-toggle-favorite-requested(string);
    callback welcome-quick-launch-reveal-in-assets-requested(string);
    callback welcome-open-saved-ssh-requested();

    public function restore-primary-focus() {
        session-host.restore-primary-focus();
    }

    horizontal-stretch: 1;
    min-width: 0px;
    background: ThemeTokens.terminal-frame-background;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        if root.workspace-tab-items.length > 0 : tab-strip := TabBar {
            width: 100%;
            min-width: 0px;
            items: root.workspace-tab-items;

            tab-selected(session-id) => {
                root.workspace-tab-selected(session-id);
            }

            tab-close-requested(session-id) => {
                root.workspace-tab-close-requested(session-id);
            }

            new-tab-requested => {
                root.workspace-new-tab-requested();
            }
        }

        content-host := Rectangle {
            width: 100%;
            min-width: 0px;
            vertical-stretch: 1;
            background: transparent;

            if root.workspace-session-host-mode == "sftp" : sftp-host := SftpWorkspaceHost {
                width: 100%;
                height: 100%;
                session-title: root.workspace-session-title;
                session-subtitle: root.workspace-session-subtitle;
                session-state: root.workspace-session-state;

                local-action-requested(action-id) => {
                    root.local-action-requested(action-id);
                }
            }

            session-host := TerminalSessionHost {
                width: 100%;
                height: 100%;
                visible: root.workspace-session-host-mode != "sftp";
                session-id: root.active-workspace-session-id;
                mode: root.workspace-session-host-mode;
                session-title: root.workspace-session-title;
                session-subtitle: root.workspace-session-subtitle;
                session-state: root.workspace-session-state;
                session-error-detail: root.workspace-session-error-detail;
                can-reconnect: root.workspace-session-can-reconnect;
                session-render-mode: root.workspace-session-render-mode;
                connection-progress-headline: root.workspace-session-connection-headline;
                connection-progress-current-hop: root.workspace-session-connection-current-hop;
                connection-progress-current-detail: root.workspace-session-connection-current-detail;
                connection-progress-host-key-prompt-host: root.workspace-session-host-key-prompt-host;
                connection-progress-host-key-prompt-fingerprint: root.workspace-session-host-key-prompt-fingerprint;
                connection-progress-steps: root.workspace-session-connection-steps;
                connection-progress-diagnostics: root.workspace-session-connection-diagnostics;
                welcome-quick-launch-recent-items: root.welcome-quick-launch-recent-items;
                welcome-quick-launch-favorite-items: root.welcome-quick-launch-favorite-items;
                welcome-quick-launch-group-items: root.welcome-quick-launch-group-items;
                welcome-quick-launch-visible-group-items: root.welcome-quick-launch-visible-group-items;
                welcome-quick-launch-selected-detail: root.welcome-quick-launch-selected-detail;
                welcome-quick-launch-search-query: root.welcome-quick-launch-search-query;
                session-surface-image: root.workspace-session-surface-image;
                session-native-frame-token: root.workspace-session-native-frame-token;
                session-rows: root.workspace-session-rows;
                session-cols: root.workspace-session-cols;
                session-cell-width: root.workspace-session-cell-width;
                session-cell-height: root.workspace-session-cell-height;
                session-device-scale-factor: root.workspace-session-device-scale-factor;
                session-cursor-row: root.workspace-session-cursor-row;
                session-cursor-col: root.workspace-session-cursor-col;
                session-cursor-visible: root.workspace-session-cursor-visible;
                session-cursor-blinking: root.workspace-session-cursor-blinking;
                session-cursor-shape: root.workspace-session-cursor-shape;
                session-cursor-fg: root.workspace-session-cursor-fg;
                session-cursor-bg: root.workspace-session-cursor-bg;
                session-default-fg: root.workspace-session-default-fg;
                session-default-bg: root.workspace-session-default-bg;
                session-scrollbar-thumb: root.workspace-session-scrollbar-thumb;
                session-scrollbar-thumb-active: root.workspace-session-scrollbar-thumb-active;
                session-mouse-grabbed: root.workspace-session-mouse-grabbed;
                session-visible-lines: root.workspace-session-visible-lines;
                session-command-blocks: root.workspace-session-command-blocks;
                session-overview-markers: root.workspace-session-overview-markers;
                session-search-open: root.workspace-session-search-open;
                session-search-query: root.workspace-session-search-query;
                session-search-match-count: root.workspace-session-search-match-count;
                session-search-focus-sequence: root.workspace-session-search-focus-sequence;
                session-surface-seqno: root.workspace-session-surface-seqno;
                session-viewport-offset-lines: root.workspace-session-viewport-offset-lines;
                session-viewport-max-offset-lines: root.workspace-session-viewport-max-offset-lines;
                session-viewport-at-bottom: root.workspace-session-viewport-at-bottom;
                selection-active <=> root.workspace-session-selection-active;
                selection-start-row <=> root.workspace-session-selection-start-row;
                selection-start-col <=> root.workspace-session-selection-start-col;
                selection-end-row <=> root.workspace-session-selection-end-row;
                selection-end-col <=> root.workspace-session-selection-end-col;
                context-menu-open <=> root.workspace-session-context-menu-open;

                text-input(text) => {
                    root.text-input(text);
                }

                key-input(key, alt, ctrl, shift) => {
                    root.key-input(key, alt, ctrl, shift);
                }

                surface-resize-requested(rows, cols) => {
                    root.surface-resize-requested(rows, cols);
                }

                normalize-hit-col(row, col) => {
                    return root.normalize-hit-col(row, col);
                }

                normalize-selection-hit-col(row, col) => {
                    return root.normalize-selection-hit-col(row, col);
                }

                open-url-requested(row, col) => {
                    return root.open-url-requested(row, col);
                }

                copy-selection-requested(start-row, start-col, end-row, end-col) => {
                    root.copy-selection-requested(start-row, start-col, end-row, end-col);
                }

                selection-changed() => {
                    root.selection-changed();
                }

                paste-requested() => {
                    root.paste-requested();
                }

                local-action-requested(action-id) => {
                    root.local-action-requested(action-id);
                }

                scroll-requested(delta-lines, row, col, shift, ctrl, alt) => {
                    root.scroll-requested(delta-lines, row, col, shift, ctrl, alt);
                }

                scroll-thumb-drag-requested(ratio) => {
                    root.scroll-thumb-drag-requested(ratio);
                }

                scroll-jump-requested(ratio) => {
                    root.scroll-jump-requested(ratio);
                }

                mouse-input(kind, button, row, col, shift, ctrl, alt) => {
                    root.mouse-input(kind, button, row, col, shift, ctrl, alt);
                }

                context-menu-open-changed(open) => {
                    root.context-menu-open-changed(open);
                }

                search-open-requested => {
                    root.search-open-requested();
                }

                search-close-requested => {
                    root.search-close-requested();
                }

                search-query-changed(query) => {
                    root.search-query-changed(query);
                }

                welcome-quick-launch-asset-selected(asset-id) => {
                    root.welcome-quick-launch-asset-selected(asset-id);
                }

                welcome-quick-launch-search-changed(query) => {
                    root.welcome-quick-launch-search-changed(query);
                }

                welcome-quick-launch-connect-requested(asset-id) => {
                    root.welcome-quick-launch-connect-requested(asset-id);
                }

                welcome-quick-launch-connect-in-new-tab-requested(asset-id) => {
                    root.welcome-quick-launch-connect-in-new-tab-requested(asset-id);
                }

                welcome-quick-launch-toggle-favorite-requested(asset-id) => {
                    root.welcome-quick-launch-toggle-favorite-requested(asset-id);
                }

                welcome-quick-launch-reveal-in-assets-requested(asset-id) => {
                    root.welcome-quick-launch-reveal-in-assets-requested(asset-id);
                }

                welcome-open-saved-ssh-requested => {
                    root.welcome-open-saved-ssh-requested();
                }
            }
        }
    }
}
