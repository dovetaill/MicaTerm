// Workspace pane that owns the tab strip and content host width contract.

import { ThemeTokens } from "../theme/tokens.slint";
import { QuickLaunchCardRow } from "../welcome/quick-launch-types.slint";
import { SftpPanelItem } from "./right-panel.slint";
import { SftpWorkspaceHost } from "./sftp-workspace-host.slint";
import { SftpBreadcrumbItem } from "./sftp-workspace-host.slint";
import { TabBar, WorkspaceTabItem } from "./tabbar.slint";
import { ConnectionProgressDiagnosticRow, ConnectionProgressFieldRow, ConnectionProgressHopRow, ConnectionProgressStepRow, TerminalCommandBlockRow, TerminalOverviewMarkerRow, TerminalSessionHost } from "./terminal-session-host.slint";

export component WorkspacePane inherits Rectangle {
    in property <[WorkspaceTabItem]> workspace-tab-items: [];
    in property <string> active-workspace-session-id: "";
    in property <string> workspace-session-host-mode: "welcome";
    in property <string> workspace-session-title: "";
    in property <string> workspace-session-subtitle: "";
    in property <string> workspace-session-state: "";
    in property <string> workspace-session-error-detail: "";
    in property <bool> workspace-session-can-reconnect: false;
    in property <string> workspace-sftp-host-label: "";
    in property <string> workspace-sftp-connection-label: "";
    in property <string> workspace-sftp-binding-label: "";
    in property <string> workspace-sftp-path: "";
    in property <bool> workspace-sftp-path-editing: false;
    in property <int> workspace-sftp-focus-sequence: 0;
    in property <bool> workspace-sftp-can-go-back: false;
    in property <bool> workspace-sftp-can-go-forward: false;
    in property <bool> workspace-sftp-can-go-up: false;
    in property <bool> workspace-sftp-can-go-home: false;
    in property <bool> workspace-sftp-actions-enabled: false;
    in property <string> workspace-sftp-toolbar-disabled-reason: "";
    in-out property <length> workspace-sftp-viewport-y: 0px;
    in property <length> workspace-sftp-row-height: 40px;
    in property <int> workspace-sftp-total-row-count: 0;
    in property <length> workspace-sftp-total-content-height: 0px;
    in property <length> workspace-sftp-top-spacer-height: 0px;
    in property <length> workspace-sftp-bottom-spacer-height: 0px;
    in property <[SftpBreadcrumbItem]> workspace-sftp-breadcrumb-items: [];
    in property <[string]> workspace-sftp-selected-entry-ids: [];
    in property <[SftpPanelItem]> workspace-sftp-items: [];
    in property <bool> transfer-center-open: false;
    in property <int> transfer-queue-active: 0;
    in property <int> transfer-queue-failed: 0;
    in property <int> transfer-queue-current-session: 0;
    in property <string> workspace-session-render-mode: "bitmap";
    in property <string> workspace-session-connection-headline: "";
    in property <string> workspace-session-connection-visual-state: "";
    in property <string> workspace-session-connection-current-hop: "";
    in property <string> workspace-session-connection-current-detail: "";
    in property <string> workspace-session-connection-page-mode: "";
    in property <string> workspace-session-connection-task-title: "";
    in property <string> workspace-session-connection-task-detail: "";
    in property <string> workspace-session-host-key-prompt-host: "";
    in property <string> workspace-session-host-key-prompt-fingerprint: "";
    in property <string> workspace-session-host-key-warning-host: "";
    in property <string> workspace-session-host-key-warning-expected: "";
    in property <string> workspace-session-host-key-warning-current: "";
    in property <[ConnectionProgressHopRow]> workspace-session-connection-hops: [];
    in property <[ConnectionProgressStepRow]> workspace-session-connection-steps: [];
    in property <[ConnectionProgressFieldRow]> workspace-session-connection-main-fields: [];
    in property <[ConnectionProgressFieldRow]> workspace-session-connection-detail-fields: [];
    in property <[ConnectionProgressDiagnosticRow]> workspace-session-connection-diagnostics: [];
    in property <[QuickLaunchCardRow]> welcome-quick-launch-recent-items: [];
    in property <image> workspace-session-surface-image;
    in property <int> workspace-session-native-frame-token: 0;
    in property <int> workspace-session-rows: 24;
    in property <int> workspace-session-cols: 80;
    in property <length> workspace-session-cell-width: 10px;
    in property <length> workspace-session-cell-height: 22px;
    in property <float> workspace-session-device-scale-factor: 1.0;
    in property <int> workspace-session-cursor-row: 0;
    in property <int> workspace-session-cursor-col: 0;
    in property <bool> workspace-session-cursor-visible: false;
    in property <bool> workspace-session-cursor-blinking: false;
    in property <string> workspace-session-cursor-shape: "block";
    in property <color> workspace-session-cursor-fg: ThemeTokens.terminal-cursor-fg;
    in property <color> workspace-session-cursor-bg: ThemeTokens.terminal-cursor-bg;
    in property <color> workspace-session-default-fg: ThemeTokens.terminal-default-fg;
    in property <color> workspace-session-default-bg: ThemeTokens.terminal-default-bg;
    in property <color> workspace-session-selection-surface: ThemeTokens.terminal-selection-surface;
    in property <color> workspace-session-scrollbar-track: ThemeTokens.terminal-scrollbar-track-surface;
    in property <color> workspace-session-scrollbar-thumb: ThemeTokens.terminal-scrollbar-thumb-surface;
    in property <color> workspace-session-scrollbar-thumb-active: ThemeTokens.terminal-scrollbar-thumb-active-surface;
    in property <color> workspace-session-frame-surface: ThemeTokens.terminal-frame-background;
    in property <color> workspace-session-frame-border: ThemeTokens.divider-subtle;
    in property <bool> workspace-session-mouse-grabbed: false;
    in property <bool> workspace-session-link-hovered: false;
    in property <bool> workspace-session-link-armed: false;
    in property <[string]> workspace-session-visible-lines: [];
    in property <[TerminalCommandBlockRow]> workspace-session-command-blocks: [];
    in property <[TerminalOverviewMarkerRow]> workspace-session-overview-markers: [];
    in property <bool> workspace-session-search-open: false;
    in property <string> workspace-session-search-query: "";
    in property <int> workspace-session-search-match-count: 0;
    in property <int> workspace-session-search-focus-sequence: 0;
    in property <int> workspace-session-surface-seqno: 0;
    in property <int> workspace-session-viewport-offset-lines: 0;
    in property <int> workspace-session-viewport-max-offset-lines: 0;
    in property <bool> workspace-session-viewport-at-bottom: true;
    in property <bool> workspace-session-alternate-screen-active: false;
    in-out property <bool> workspace-session-selection-active: false;
    in-out property <int> workspace-session-selection-start-row: -1;
    in-out property <int> workspace-session-selection-start-col: -1;
    in-out property <int> workspace-session-selection-end-row: -1;
    in-out property <int> workspace-session-selection-end-col: -1;
    in-out property <bool> workspace-session-context-menu-open: false;
    in property <bool> workspace-tab-context-menu-open: false;
    in property <color> shell-tabbar-background: ThemeTokens.tabbar-background;
    in property <color> shell-titlebar-background: ThemeTokens.titlebar-background;
    in property <color> shell-separator: ThemeTokens.separator;
    in property <color> shell-border: ThemeTokens.divider-subtle;
    in property <color> shell-hairline: ThemeTokens.hairline;
    in property <color> shell-text-primary: ThemeTokens.text-primary;
    in property <color> shell-text-secondary: ThemeTokens.text-secondary;
    in property <color> shell-text-muted: ThemeTokens.text-muted;
    in property <color> shell-text-inactive: ThemeTokens.text-muted;
    in property <color> shell-accent: ThemeTokens.accent;
    in property <color> shell-focus-ring: ThemeTokens.focus-ring;
    in property <color> shell-sidebar-item-hover: ThemeTokens.sidebar-item-hover-background;
    in property <color> shell-sidebar-item-selected: ThemeTokens.sidebar-item-selected-background;
    in property <color> shell-sidebar-item-selected-border: ThemeTokens.sidebar-item-selected-border;
    in property <color> shell-tab-active: ThemeTokens.tab-active-surface;
    in property <color> shell-tab-inactive: ThemeTokens.tab-inactive-surface;
    in property <color> shell-tab-hover: ThemeTokens.tab-hover-surface;
    in property <color> shell-tab-active-indicator: ThemeTokens.tab-active-indicator;
    out property <length> layout-workspace-session-native-surface-x:
        content-host.x + session-host.native-surface-x;
    out property <length> layout-workspace-session-native-surface-y:
        content-host.y + session-host.native-surface-y;
    out property <length> layout-workspace-session-native-surface-width:
        session-host.native-surface-width;
    out property <length> layout-workspace-session-native-surface-height:
        session-host.native-surface-height;
    out property <length> layout-workspace-session-preferred-surface-width:
        session-host.preferred-surface-width;
    out property <length> layout-workspace-session-preferred-surface-height:
        session-host.preferred-surface-height;
    out property <int> layout-workspace-session-preferred-rows:
        session-host.preferred-terminal-rows;
    out property <int> layout-workspace-session-preferred-cols:
        session-host.preferred-terminal-cols;
    callback workspace-tab-selected(string);
    callback workspace-tab-close-requested(string);
    callback workspace-tab-reorder-requested(string, int);
    callback workspace-tab-context-menu-requested(string, length, length);
    callback workspace-tab-hovered(string, length, length);
    callback workspace-tab-hover-ended(string);
    callback workspace-new-tab-requested();
    callback text-input(string);
    callback key-input(string, bool, bool, bool);
    callback surface-resize-requested(int, int);
    callback normalize-hit-col(int, int) -> int;
    callback normalize-selection-hit-col(int, int) -> int;
    callback copy-selection-requested(int, int, int, int);
    callback selection-changed();
    callback paste-requested();
    callback local-action-requested(string);
    callback scroll-requested(int, int, int, bool, bool, bool);
    callback scroll-thumb-drag-requested(float);
    callback scroll-jump-requested(float);
    callback mouse-input(string, string, int, int, bool, bool, bool);
    callback context-menu-open-changed(bool);
    callback search-open-requested();
    callback search-close-requested();
    callback search-query-changed(string);
    callback welcome-quick-launch-connect-requested(string);
    callback welcome-open-saved-ssh-requested();
    callback workspace-sftp-back-requested();
    callback workspace-sftp-forward-requested();
    callback workspace-sftp-up-requested();
    callback workspace-sftp-home-requested();
    callback workspace-sftp-refresh-requested();
    callback workspace-sftp-path-edit-requested();
    callback workspace-sftp-path-cancelled();
    callback workspace-sftp-path-submitted(string);
    callback workspace-sftp-breadcrumb-clicked(string);
    callback workspace-sftp-viewport-changed(length, length);
    callback workspace-sftp-item-selected(string, bool, bool);
    callback workspace-sftp-item-activated(string, string);
    callback workspace-sftp-context-menu-requested(string, string, length, length);
    callback workspace-sftp-upload-requested();
    callback workspace-sftp-new-folder-requested();
    callback workspace-sftp-retry-requested();
    callback open-transfer-center-requested();
    callback workspace-sftp-tooltip-open-requested(string, string, length, length, length);
    callback workspace-sftp-tooltip-close-requested(string);

    public function restore-primary-focus() {
        if root.workspace-session-host-mode == "sftp" && !root.workspace-sftp-path-editing {
            workspace-sftp-shortcut-focus-timer.restart();
        } else {
            session-host.restore-primary-focus();
        }
    }

    changed workspace-session-host-mode => {
        if root.workspace-session-host-mode == "sftp" && !root.workspace-sftp-path-editing {
            workspace-sftp-shortcut-focus-timer.restart();
        }
    }

    changed workspace-sftp-focus-sequence => {
        if root.workspace-session-host-mode == "sftp" && !root.workspace-sftp-path-editing {
            workspace-sftp-shortcut-focus-timer.restart();
        }
    }

    changed workspace-sftp-path-editing => {
        if root.workspace-session-host-mode == "sftp" && !root.workspace-sftp-path-editing {
            workspace-sftp-shortcut-focus-timer.restart();
        }
    }

    horizontal-stretch: 1;
    min-width: 0px;
    background: root.workspace-session-frame-surface;

    workspace-sftp-shortcut-anchor := TextInput {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 1px;
        text: "";
        color: transparent;
        selection-background-color: transparent;
        selection-foreground-color: transparent;
        visible: root.workspace-session-host-mode == "sftp";

        edited => {
            if self.text != "" {
                self.text = "";
            }
        }

        key-pressed(event) => {
            if root.workspace-session-host-mode != "sftp" {
                reject
            } else if (event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt) {
                accept
            } else if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                && (event.text == "l" || event.text == "L" || event.text == "\u{c}")) {
                root.workspace-sftp-path-edit-requested();
                accept
            } else {
                reject
            }
        }
    }

    workspace-sftp-shortcut-focus-timer := Timer {
        interval: 1ms;
        running: false;

        triggered => {
            self.running = false;
            workspace-sftp-shortcut-anchor.focus();
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        if root.workspace-tab-items.length > 0 : tab-strip := TabBar {
            width: 100%;
            min-width: 0px;
            items: root.workspace-tab-items;
            suppress-hover-tooltip: root.workspace-tab-context-menu-open
                || root.workspace-session-context-menu-open;
            shell-tabbar-background: root.shell-tabbar-background;
            shell-titlebar-background: root.shell-titlebar-background;
            shell-separator: root.shell-separator;
            shell-border: root.shell-border;
            shell-hairline: root.shell-hairline;
            shell-text-primary: root.shell-text-primary;
            shell-text-secondary: root.shell-text-secondary;
            shell-text-inactive: root.shell-text-inactive;
            shell-accent: root.shell-accent;
            shell-tab-active: root.shell-tab-active;
            shell-tab-inactive: root.shell-tab-inactive;
            shell-tab-hover: root.shell-tab-hover;
            shell-tab-active-indicator: root.shell-tab-active-indicator;

            tab-selected(tab-id) => {
                root.workspace-tab-selected(tab-id);
            }

            tab-close-requested(tab-id) => {
                root.workspace-tab-close-requested(tab-id);
            }

            tab-reorder-requested(tab-id, target-index) => {
                root.workspace-tab-reorder-requested(tab-id, target-index);
            }

            tab-context-menu-requested(tab-id, anchor-x, anchor-y) => {
                root.workspace-tab-context-menu-requested(tab-id, anchor-x, anchor-y);
            }

            tab-hovered(tab-id, anchor-x, anchor-y) => {
                root.workspace-tab-hovered(tab-id, anchor-x, anchor-y);
            }

            tab-hover-ended(tab-id) => {
                root.workspace-tab-hover-ended(tab-id);
            }

            new-tab-requested => {
                root.workspace-new-tab-requested();
            }
        }

        content-host := Rectangle {
            width: 100%;
            min-width: 0px;
            vertical-stretch: 1;
            background: transparent;

            if root.workspace-session-host-mode == "sftp" : sftp-host := SftpWorkspaceHost {
                width: 100%;
                height: 100%;
                session-title: root.workspace-session-title;
                session-subtitle: root.workspace-session-subtitle;
                session-state: root.workspace-session-state;
                session-error-detail: root.workspace-session-error-detail;
                workspace-sftp-host-label: root.workspace-sftp-host-label;
                workspace-sftp-connection-label: root.workspace-sftp-connection-label;
                workspace-sftp-binding-label: root.workspace-sftp-binding-label;
                workspace-sftp-path: root.workspace-sftp-path;
                workspace-sftp-path-editing: root.workspace-sftp-path-editing;
                workspace-sftp-can-go-back: root.workspace-sftp-can-go-back;
                workspace-sftp-can-go-forward: root.workspace-sftp-can-go-forward;
                workspace-sftp-can-go-up: root.workspace-sftp-can-go-up;
                workspace-sftp-can-go-home: root.workspace-sftp-can-go-home;
                workspace-sftp-actions-enabled: root.workspace-sftp-actions-enabled;
                workspace-sftp-toolbar-disabled-reason: root.workspace-sftp-toolbar-disabled-reason;
                workspace-sftp-viewport-y <=> root.workspace-sftp-viewport-y;
                workspace-sftp-row-height: root.workspace-sftp-row-height;
                workspace-sftp-total-row-count: root.workspace-sftp-total-row-count;
                workspace-sftp-total-content-height: root.workspace-sftp-total-content-height;
                workspace-sftp-top-spacer-height: root.workspace-sftp-top-spacer-height;
                workspace-sftp-bottom-spacer-height: root.workspace-sftp-bottom-spacer-height;
                workspace-sftp-breadcrumb-items: root.workspace-sftp-breadcrumb-items;
                workspace-sftp-selected-entry-ids: root.workspace-sftp-selected-entry-ids;
                workspace-sftp-items: root.workspace-sftp-items;
                transfer-center-open: root.transfer-center-open;
                transfer-queue-active: root.transfer-queue-active;
                transfer-queue-failed: root.transfer-queue-failed;
                transfer-queue-current-session: root.transfer-queue-current-session;
                workspace-session-frame-surface: root.workspace-session-frame-surface;
                workspace-session-frame-border: root.workspace-session-frame-border;
                shell-separator: root.shell-separator;
                shell-border: root.shell-border;
                shell-text-primary: root.shell-text-primary;
                shell-text-secondary: root.shell-text-secondary;
                shell-text-muted: root.shell-text-muted;
                shell-accent: root.shell-accent;
                shell-focus-ring: root.shell-focus-ring;
                shell-sidebar-item-hover: root.shell-sidebar-item-hover;
                shell-sidebar-item-selected: root.shell-sidebar-item-selected;
                shell-sidebar-item-selected-border: root.shell-sidebar-item-selected-border;

                workspace-sftp-back-requested => {
                    root.workspace-sftp-back-requested();
                }

                workspace-sftp-forward-requested => {
                    root.workspace-sftp-forward-requested();
                }

                workspace-sftp-up-requested => {
                    root.workspace-sftp-up-requested();
                }

                workspace-sftp-home-requested => {
                    root.workspace-sftp-home-requested();
                }

                workspace-sftp-refresh-requested => {
                    root.workspace-sftp-refresh-requested();
                }

                workspace-sftp-path-edit-requested => {
                    root.workspace-sftp-path-edit-requested();
                }

                workspace-sftp-path-cancelled => {
                    root.workspace-sftp-path-cancelled();
                }

                workspace-sftp-path-submitted(path) => {
                    root.workspace-sftp-path-submitted(path);
                }

                workspace-sftp-breadcrumb-clicked(path) => {
                    root.workspace-sftp-breadcrumb-clicked(path);
                }

                workspace-sftp-viewport-changed(viewport-y, visible-height) => {
                    root.workspace-sftp-viewport-changed(viewport-y, visible-height);
                }

                workspace-sftp-item-selected(item-id, ctrl, shift) => {
                    root.workspace-sftp-item-selected(item-id, ctrl, shift);
                }

                workspace-sftp-item-activated(item-id, item-kind) => {
                    root.workspace-sftp-item-activated(item-id, item-kind);
                }

                workspace-sftp-context-menu-requested(item-id, item-kind, anchor-x, anchor-y) => {
                    root.workspace-sftp-context-menu-requested(item-id, item-kind, anchor-x, anchor-y);
                }

                workspace-sftp-upload-requested => {
                    root.workspace-sftp-upload-requested();
                }

                workspace-sftp-new-folder-requested => {
                    root.workspace-sftp-new-folder-requested();
                }

                workspace-sftp-retry-requested => {
                    root.workspace-sftp-retry-requested();
                }

                open-transfer-center-requested => {
                    root.open-transfer-center-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                    root.workspace-sftp-tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width);
                }

                tooltip-close-requested(source-id) => {
                    root.workspace-sftp-tooltip-close-requested(source-id);
                }

                local-action-requested(action-id) => {
                    root.local-action-requested(action-id);
                }
            }

            session-host := TerminalSessionHost {
                width: 100%;
                height: 100%;
                visible: root.workspace-session-host-mode != "sftp";
                session-id: root.active-workspace-session-id;
                mode: root.workspace-session-host-mode;
                session-title: root.workspace-session-title;
                session-subtitle: root.workspace-session-subtitle;
                session-state: root.workspace-session-state;
                session-error-detail: root.workspace-session-error-detail;
                can-reconnect: root.workspace-session-can-reconnect;
                session-render-mode: root.workspace-session-render-mode;
                connection-progress-headline: root.workspace-session-connection-headline;
                connection-progress-visual-state: root.workspace-session-connection-visual-state;
                connection-progress-current-hop: root.workspace-session-connection-current-hop;
                connection-progress-current-detail: root.workspace-session-connection-current-detail;
                connection-progress-page-mode: root.workspace-session-connection-page-mode;
                connection-progress-task-title: root.workspace-session-connection-task-title;
                connection-progress-task-detail: root.workspace-session-connection-task-detail;
                connection-progress-host-key-prompt-host: root.workspace-session-host-key-prompt-host;
                connection-progress-host-key-prompt-fingerprint: root.workspace-session-host-key-prompt-fingerprint;
                connection-progress-host-key-warning-host: root.workspace-session-host-key-warning-host;
                connection-progress-host-key-warning-expected: root.workspace-session-host-key-warning-expected;
                connection-progress-host-key-warning-current: root.workspace-session-host-key-warning-current;
                connection-progress-hops: root.workspace-session-connection-hops;
                connection-progress-steps: root.workspace-session-connection-steps;
                connection-progress-main-fields: root.workspace-session-connection-main-fields;
                connection-progress-detail-fields: root.workspace-session-connection-detail-fields;
                connection-progress-diagnostics: root.workspace-session-connection-diagnostics;
                welcome-quick-launch-recent-items: root.welcome-quick-launch-recent-items;
                session-surface-image: root.workspace-session-surface-image;
                session-native-frame-token: root.workspace-session-native-frame-token;
                session-rows: root.workspace-session-rows;
                session-cols: root.workspace-session-cols;
                session-cell-width: root.workspace-session-cell-width;
                session-cell-height: root.workspace-session-cell-height;
                session-device-scale-factor: root.workspace-session-device-scale-factor;
                session-cursor-row: root.workspace-session-cursor-row;
                session-cursor-col: root.workspace-session-cursor-col;
                session-cursor-visible: root.workspace-session-cursor-visible;
                session-cursor-blinking: root.workspace-session-cursor-blinking;
                session-cursor-shape: root.workspace-session-cursor-shape;
                session-cursor-fg: root.workspace-session-cursor-fg;
                session-cursor-bg: root.workspace-session-cursor-bg;
                session-default-fg: root.workspace-session-default-fg;
                session-default-bg: root.workspace-session-default-bg;
                // Keep the live terminal host on session-scoped runtime chrome so shell palette props cannot split the renderer path.
                session-selection-surface: root.workspace-session-selection-surface;
                session-scrollbar-track: root.workspace-session-scrollbar-track;
                session-scrollbar-thumb: root.workspace-session-scrollbar-thumb;
                session-scrollbar-thumb-active: root.workspace-session-scrollbar-thumb-active;
                session-frame-surface: root.workspace-session-frame-surface;
                session-frame-border: root.workspace-session-frame-border;
                session-mouse-grabbed: root.workspace-session-mouse-grabbed;
                link-hovered: root.workspace-session-link-hovered;
                link-armed: root.workspace-session-link-armed;
                session-visible-lines: root.workspace-session-visible-lines;
                session-command-blocks: root.workspace-session-command-blocks;
                session-overview-markers: root.workspace-session-overview-markers;
                session-search-open: root.workspace-session-search-open;
                session-search-query: root.workspace-session-search-query;
                session-search-match-count: root.workspace-session-search-match-count;
                session-search-focus-sequence: root.workspace-session-search-focus-sequence;
                session-surface-seqno: root.workspace-session-surface-seqno;
                session-viewport-offset-lines: root.workspace-session-viewport-offset-lines;
                session-viewport-max-offset-lines: root.workspace-session-viewport-max-offset-lines;
                session-viewport-at-bottom: root.workspace-session-viewport-at-bottom;
                session-alternate-screen-active: root.workspace-session-alternate-screen-active;
                selection-active <=> root.workspace-session-selection-active;
                selection-start-row <=> root.workspace-session-selection-start-row;
                selection-start-col <=> root.workspace-session-selection-start-col;
                selection-end-row <=> root.workspace-session-selection-end-row;
                selection-end-col <=> root.workspace-session-selection-end-col;
                context-menu-open <=> root.workspace-session-context-menu-open;

                text-input(text) => {
                    root.text-input(text);
                }

                key-input(key, alt, ctrl, shift) => {
                    root.key-input(key, alt, ctrl, shift);
                }

                surface-resize-requested(rows, cols) => {
                    root.surface-resize-requested(rows, cols);
                }

                normalize-hit-col(row, col) => {
                    return root.normalize-hit-col(row, col);
                }

                normalize-selection-hit-col(row, col) => {
                    return root.normalize-selection-hit-col(row, col);
                }

                copy-selection-requested(start-row, start-col, end-row, end-col) => {
                    root.copy-selection-requested(start-row, start-col, end-row, end-col);
                }

                selection-changed() => {
                    root.selection-changed();
                }

                paste-requested() => {
                    root.paste-requested();
                }

                local-action-requested(action-id) => {
                    root.local-action-requested(action-id);
                }

                scroll-requested(delta-lines, row, col, shift, ctrl, alt) => {
                    root.scroll-requested(delta-lines, row, col, shift, ctrl, alt);
                }

                scroll-thumb-drag-requested(ratio) => {
                    root.scroll-thumb-drag-requested(ratio);
                }

                scroll-jump-requested(ratio) => {
                    root.scroll-jump-requested(ratio);
                }

                mouse-input(kind, button, row, col, shift, ctrl, alt) => {
                    root.mouse-input(kind, button, row, col, shift, ctrl, alt);
                }

                context-menu-open-changed(open) => {
                    root.context-menu-open-changed(open);
                }

                search-open-requested => {
                    root.search-open-requested();
                }

                search-close-requested => {
                    root.search-close-requested();
                }

                search-query-changed(query) => {
                    root.search-query-changed(query);
                }

                welcome-quick-launch-connect-requested(asset-id) => {
                    root.welcome-quick-launch-connect-requested(asset-id);
                }

                welcome-open-saved-ssh-requested => {
                    root.welcome-open-saved-ssh-requested();
                }
            }
        }
    }

}
