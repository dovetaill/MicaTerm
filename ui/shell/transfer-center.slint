import { ListView } from "std-widgets.slint";
import { MotionTokens } from "../theme/motion.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";
import { SidebarToolbarIconButton } from "../components/sidebar-toolbar-icon-button.slint";

component TransferCenterFilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    border-radius: 10px;
    border-width: 1px;
    border-color: self.active
        ? ThemeTokens.accent
        : ThemeTokens.divider-subtle;
    background: self.active
        ? ThemeTokens.control-active-surface
        : transparent;

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: root.active ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: center;
        font-size: 11px;
        font-weight: root.active ? 700 : AppTypography.ui-font-weight-regular;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component TransferProgressBar inherits Rectangle {
    in property <float> value: 0;
    in property <string> tone: "busy";

    private property <float> clamped-value: max(0.0, min(1.0, root.value));
    private property <brush> fill-brush: root.tone == "success"
        ? ThemeTokens.status-success-accent
        : root.tone == "error"
            ? ThemeTokens.status-error-accent
            : root.tone == "muted"
                ? ThemeTokens.text-muted
                : ThemeTokens.accent;

    border-radius: 3px;
    background: ThemeTokens.utility-panel-progress-track;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * root.clamped-value;
        height: parent.height;
        border-radius: 3px;
        background: root.fill-brush;
    }
}

component TransferCenterRowActionButton inherits Rectangle {
    in property <string> label;
    in property <image> icon-source;
    in property <bool> emphasized: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <string> tooltip-text: "";
    in property <string> tooltip-source-id: "";
    private property <brush> idle-border: !root.enabled
        ? ThemeTokens.divider-subtle
        : root.danger
            ? ThemeTokens.divider-subtle
            : root.emphasized
                ? ThemeTokens.status-pill-border
                : ThemeTokens.divider-subtle;
    private property <brush> chrome-border: root.has-focus
        ? ThemeTokens.focus-ring
        : !root.enabled
            ? ThemeTokens.divider-subtle
            : touch.pressed
                ? root.danger
                    ? ThemeTokens.status-error-accent
                    : root.emphasized
                        ? ThemeTokens.accent
                        : ThemeTokens.divider-strong
                : touch.has-hover
                    ? root.danger
                        ? ThemeTokens.status-error-accent
                        : root.emphasized
                            ? ThemeTokens.accent
                            : ThemeTokens.status-pill-border
                    : root.idle-border;
    private property <brush> content-color: !root.enabled
        ? ThemeTokens.text-muted
        : root.danger
            ? (touch.has-hover || touch.pressed || root.has-focus
                ? ThemeTokens.status-error-accent
                : ThemeTokens.text-muted)
            : root.emphasized
                ? ThemeTokens.text-primary
                : (touch.has-hover || touch.pressed || root.has-focus
                    ? ThemeTokens.text-primary
                    : ThemeTokens.text-secondary);
    out property <bool> has-hover: touch.has-hover;
    out property <bool> has-focus: action-focus.has-focus;
    out property <bool> tooltip-active: (root.has-hover || root.has-focus) && root.tooltip-text != "";
    callback clicked();
    callback tooltip-open-requested(string, string, length, length, length);
    callback tooltip-close-requested(string);
    callback tooltip-activity-changed(bool);

    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.chrome-border;
    background: !root.enabled
        ? ThemeTokens.control-disabled-surface
        : touch.pressed
            ? root.danger
                ? ThemeTokens.status-error-surface
                : ThemeTokens.control-pressed-surface
            : root.has-focus
                ? ThemeTokens.control-active-surface
                : touch.has-hover
                    ? root.danger
                        ? ThemeTokens.status-error-surface
                        : ThemeTokens.control-hover-surface
                    : root.emphasized
                        ? ThemeTokens.utility-panel-empty-surface
                        : ThemeTokens.utility-panel-section-surface;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { touch.clicked(); }
    forward-focus: action-focus;

    focus-halo := Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: parent.border-radius + 2px;
        border-width: root.has-focus ? 1px : 0px;
        border-color: ThemeTokens.focus-ring;
        background: transparent;
        opacity: root.has-focus ? 0.46 : 0;
        animate opacity { duration: 120ms; }
    }

    if (root.icon-source.width > 0 && root.icon-source.height > 0) : Image {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon-source;
        image-fit: contain;
        colorize: root.content-color;
    }

    Text {
        x: 32px;
        y: 0px;
        width: max(0px, parent.width - 40px);
        height: parent.height;
        text: root.label;
        color: root.content-color;
        vertical-alignment: center;
        horizontal-alignment: left;
        font-size: 10px;
        font-weight: 700;
        overflow: elide;
    }

    changed tooltip-active => {
        root.tooltip-activity-changed(self.tooltip-active);
        if self.tooltip-active {
            root.tooltip-open-requested(
                root.tooltip-source-id,
                root.tooltip-text,
                self.absolute-position.x + self.width / 2,
                self.absolute-position.y + self.height + 8px,
                self.width,
            );
        } else {
            root.tooltip-close-requested(root.tooltip-source-id);
        }
    }

    touch := TouchArea {
        clicked => {
            if root.enabled {
                root.tooltip-close-requested(root.tooltip-source-id);
                root.clicked();
            }
        }
    }

    action-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.visible && root.enabled;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                touch.clicked();
                accept
            } else {
                reject
            }
        }
    }
}

component TransferCenterFeedbackBanner inherits Rectangle {
    in property <string> label;
    in property <string> tone: "neutral";

    border-radius: 10px;
    border-width: 1px;
    border-color: root.tone == "error"
        ? ThemeTokens.status-error-accent
        : ThemeTokens.status-pill-border;
    background: root.tone == "error"
        ? ThemeTokens.status-error-surface
        : ThemeTokens.status-pill-surface;

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: root.tone == "error"
            ? ThemeTokens.status-error-accent
            : ThemeTokens.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: left;
        font-size: 10px;
        font-weight: 700;
        overflow: elide;
    }
}

component TransferCenterPrimaryButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    border-radius: 10px;
    border-width: 1px;
    border-color: ThemeTokens.accent;
    background: touch.pressed ? ThemeTokens.control-pressed-surface
        : touch.has-hover ? ThemeTokens.control-hover-surface
        : ThemeTokens.utility-panel-section-surface;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 11px;
        font-weight: 700;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export struct TransferCenterItem {
    id: string,
    title: string,
    host_label: string,
    direction_label: string,
    detail: string,
    status_label: string,
    status_tone: string,
    progress_value: float,
    progress_label: string,
    error_summary: string,
    error_tooltip: string,
    show_error: bool,
    can_show_error: bool,
    can_retry: bool,
    can_resolve_conflict: bool,
    can_open_workspace: bool,
    can_open_file: bool,
    can_open_folder: bool,
    can_remove: bool,
    remove_tooltip: string,
}

export component TransferCenter inherits Rectangle {
    in property <bool> open: false;
    in property <bool> pinned: false;
    in property <bool> collapsed: false;
    in property <int> queue-total: 0;
    in property <int> queued-count: 0;
    in property <int> running-count: 0;
    in property <int> paused-count: 0;
    in property <int> failed-count: 0;
    in property <int> completed-count: 0;
    in property <string> active-filter: "all";
    in property <[TransferCenterItem]> items: [];
    in property <string> feedback-text: "";
    in property <string> feedback-tone: "neutral";
    in property <int> feedback-sequence: 0;
    callback close-requested();
    callback pin-toggle-requested();
    callback collapse-toggle-requested();
    callback open-sftp-requested();
    callback filter-toggle-requested(string);
    callback retry-requested(string);
    callback resolve-conflict-requested(string);
    callback open-workspace-requested(string);
    callback open-file-requested(string);
    callback open-folder-requested(string);
    callback remove-requested(string);
    callback clear-completed-requested();
    private property <image> collapse-icon: @image-url("../../assets/icons/fluent/arrow-collapse-all-20-regular.svg");
    private property <image> expand-icon: @image-url("../../assets/icons/fluent/arrow-expand-all-20-regular.svg");
    private property <image> pin-icon: @image-url("../../assets/icons/fluent/pin-20-regular.svg");
    private property <image> pin-off-icon: @image-url("../../assets/icons/fluent/pin-off-20-regular.svg");
    private property <image> close-icon: @image-url("../../assets/icons/fluent/dismiss-20-regular.svg");
    private property <image> upload-icon: @image-url("../../assets/icons/fluent/arrow-upload-20-regular.svg");
    private property <image> download-icon: @image-url("../../assets/icons/fluent/arrow-download-20-regular.svg");
    private property <image> delete-icon: @image-url("../../assets/icons/fluent/delete-20-regular.svg");
    private property <image> move-icon: @image-url("../../assets/icons/fluent/arrow-sync-20-regular.svg");
    private property <image> document-icon: @image-url("../../assets/icons/fluent/document-20-regular.svg");
    private property <image> folder-open-icon: @image-url("../../assets/icons/fluent/folder-open-20-regular.svg");
    private property <image> retry-icon: @image-url("../../assets/icons/fluent/arrow-clockwise-20-regular.svg");
    private property <image> workspace-icon: @image-url("../../assets/icons/fluent/link-20-regular.svg");
    private property <image> details-icon: @image-url("../../assets/icons/fluent/list-20-regular.svg");
    private property <string> tooltip-text-value: "";
    private property <bool> tooltip-visible-value: false;
    private property <bool> feedback-visible-value: false;
    private property <string> tooltip-source-id-value: "";
    private property <string> tooltip-close-source-id-value: "";
    private property <length> tooltip-anchor-x-value: 0px;
    private property <length> tooltip-anchor-y-value: 0px;
    private property <length> tooltip-anchor-width-value: 0px;
    private property <length> panel-radius: 20px;
    private property <length> header-height: 68px;
    private property <length> filter-height: root.collapsed ? 0px : 38px;
    private property <length> footer-height: root.collapsed ? 0px : ((root.items.length > 0 || root.completed-count > 0) ? 44px : 0px);
    private property <length> content-y: root.header-height + (root.collapsed ? 0px : 60px);
    private property <length> content-height: max(0px, root.height - root.content-y - root.footer-height - 12px);
    private property <length> stage-inset: root.open ? 0px : 14px;
    private property <length> stage-offset-y: root.open ? 0px : 8px;
    out property <string> tooltip-text <=> root.tooltip-text-value;
    out property <bool> tooltip-visible <=> root.tooltip-visible-value;
    out property <length> tooltip-anchor-x <=> root.tooltip-anchor-x-value;
    out property <length> tooltip-anchor-y <=> root.tooltip-anchor-y-value;
    out property <length> tooltip-anchor-width <=> root.tooltip-anchor-width-value;

    background: transparent;
    clip: false;

    function status-chip-label(label: string, count: int) -> string {
        count > 0 ? label + " " + count : label
    }

    function filter-active(filter-id: string) -> bool {
        root.active-filter == filter-id
    }

    function summary-copy() -> string {
        if root.failed-count > 0 {
            return "" + root.failed-count + " need attention";
        }
        if root.running-count > 0 {
            return "" + root.running-count + " running";
        }
        if root.queued-count > 0 {
            return "" + root.queued-count + " queued";
        }
        if root.completed-count > 0 {
            return "" + root.completed-count + " completed";
        }
        return "Ready for the next transfer";
    }

    function queue-summary-copy() -> string {
        if root.queue-total > 0 {
            return "" + root.queue-total + " tasks across sessions";
        }
        return "Keeps transfer history close without covering the terminal.";
    }

    function schedule-tooltip(source-id: string, text: string, anchor-x: length, anchor-y: length, anchor-width: length) {
        root.tooltip-anchor-x-value = anchor-x;
        root.tooltip-anchor-y-value = anchor-y;
        root.tooltip-anchor-width-value = anchor-width;

        if root.tooltip-source-id-value == source-id && root.tooltip-text-value == text {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
        } else {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-source-id-value = source-id;
            root.tooltip-text-value = text;
            root.tooltip-visible-value = false;
            tooltip-delay.start();
        }
    }

    function queue-tooltip-close(source-id: string) {
        if root.tooltip-source-id-value == source-id && source-id != "" {
            root.tooltip-close-source-id-value = source-id;
            tooltip-close-delay.start();
        }
    }

    function close-tooltip(source-id: string) {
        if root.tooltip-source-id-value == source-id || source-id == "" {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-visible-value = false;
            root.tooltip-text-value = "";
            root.tooltip-source-id-value = "";
            tooltip-delay.stop();
        }
    }

    changed open => {
        if !root.open {
            root.close-tooltip("");
            feedback-hide.stop();
            root.feedback-visible-value = false;
        }
    }

    changed feedback-sequence => {
        feedback-hide.stop();
        root.feedback-visible-value = root.feedback-text != "";
        if root.feedback-visible-value {
            feedback-hide.start();
        }
    }

    focus-host := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.open;

        key-pressed(event) => {
            if (event.text == Key.Escape && !root.pinned) {
                root.close-requested();
                accept
            } else {
                reject
            }
        }

    shadow-far := Rectangle {
        x: 10px + root.stage-inset;
        y: 16px + root.stage-offset-y;
        width: max(0px, parent.width - 8px - root.stage-inset * 2);
        height: max(0px, parent.height - 8px - root.stage-offset-y);
        border-radius: root.panel-radius + 2px;
        background: ThemeTokens.utility-panel-shadow-strong;
        opacity: root.open ? 1 : 0.82;
        animate x { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate y { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate width { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate height { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate opacity { duration: MotionTokens.utility-panel-opacity-duration; }
    }

    shadow-near := Rectangle {
        x: 3px + root.stage-inset / 2;
        y: 7px + root.stage-offset-y / 2;
        width: max(0px, parent.width - 2px - root.stage-inset);
        height: max(0px, parent.height - 2px - root.stage-offset-y / 2);
        border-radius: root.panel-radius + 1px;
        background: ThemeTokens.utility-panel-shadow-soft;
        opacity: root.open ? 1 : 0.9;
        animate x { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate y { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate width { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate height { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate opacity { duration: MotionTokens.utility-panel-opacity-duration; }
    }

    glow-halo := Rectangle {
        x: -2px + root.stage-inset / 2;
        y: -2px + root.stage-offset-y / 2;
        width: parent.width + 4px - root.stage-inset;
        height: parent.height + 4px - root.stage-offset-y / 2;
        border-radius: root.panel-radius + 2px;
        background: ThemeTokens.utility-panel-glow;
        opacity: root.open ? 1 : 0.72;
        animate x { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate y { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate width { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate height { duration: MotionTokens.utility-panel-shadow-duration; easing: ease-out; }
        animate opacity { duration: MotionTokens.utility-panel-opacity-duration; }
    }

    panel-frame := Rectangle {
        x: root.stage-inset;
        y: root.stage-offset-y;
        width: max(0px, parent.width - root.stage-inset * 2);
        height: max(0px, parent.height - root.stage-offset-y);
        border-radius: root.panel-radius;
        border-width: 1px;
        border-color: ThemeTokens.utility-panel-border;
        background: ThemeTokens.utility-panel-surface;
        clip: true;
        opacity: root.open ? 1 : 0.94;
        animate x { duration: MotionTokens.utility-panel-frame-duration; easing: ease-out; }
        animate y { duration: MotionTokens.utility-panel-frame-duration; easing: ease-out; }
        animate width { duration: MotionTokens.utility-panel-frame-duration; easing: ease-out; }
        animate height { duration: MotionTokens.utility-panel-frame-duration; easing: ease-out; }
        animate opacity { duration: MotionTokens.utility-panel-opacity-duration; }

        header-strip := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height;
            background: ThemeTokens.utility-panel-header-surface;

            Text {
                x: 18px;
                y: 12px;
                text: "Transfers";
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: 700;
            }

            Text {
                x: 18px;
                y: 34px;
                width: max(0px, parent.width - 128px);
                text: root.summary-copy() + " - " + root.queue-summary-copy();
                color: ThemeTokens.text-secondary;
                font-size: 11px;
                overflow: elide;
            }

            collapse-button := SidebarToolbarIconButton {
                x: parent.width - 96px;
                y: 12px;
                icon-source: root.collapsed ? root.expand-icon : root.collapse-icon;
                active: root.collapsed;
                tooltip-text: root.collapsed ? "Expand transfer center" : "Collapse transfer center";
                tooltip-source-id: "transfer-center-collapse";
                clicked => {
                    root.collapse-toggle-requested();
                }
                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y + 10px, anchor-width);
                }
                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            pin-button := SidebarToolbarIconButton {
                x: parent.width - 64px;
                y: 12px;
                icon-source: root.pinned ? root.pin-icon : root.pin-off-icon;
                active: root.pinned;
                tooltip-text: root.pinned ? "Unpin transfer center" : "Pin transfer center";
                tooltip-source-id: "transfer-center-pin";
                clicked => {
                    root.pin-toggle-requested();
                }
                tooltip-open-requested(source-id, text, anchor-x, anchor_y, anchor_width) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor_y + 10px, anchor_width);
                }
                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            close-button := SidebarToolbarIconButton {
                x: parent.width - 32px;
                y: 12px;
                icon-source: root.close-icon;
                tooltip-text: root.pinned ? "Close transfer center" : "Close transfer center (Esc)";
                tooltip-source-id: "transfer-center-close";
                clicked => {
                    root.close-requested();
                }
                tooltip-open-requested(source-id, text, anchor-x, anchor_y, anchor_width) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor_y + 10px, anchor_width);
                }
                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            divider := Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }
        }

        if !root.collapsed : filter-shell := Rectangle {
            x: 14px;
            y: root.header-height + 10px;
            width: parent.width - 28px;
            height: 38px;
            border-radius: 12px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.utility-panel-section-surface;

            running-tab := TransferCenterFilterChip {
                x: 6px;
                y: 5px;
                width: (parent.width - 28px) / 5;
                height: 28px;
                label: status-chip-label("Running", root.running-count);
                active: root.filter-active("running");
                clicked => {
                    root.filter-toggle-requested("running");
                }
            }

            queued-tab := TransferCenterFilterChip {
                x: running-tab.x + running-tab.width + 4px;
                y: 5px;
                width: (parent.width - 28px) / 5;
                height: 28px;
                label: status-chip-label("Queued", root.queued-count);
                active: root.filter-active("queued");
                clicked => {
                    root.filter-toggle-requested("queued");
                }
            }

            paused-tab := TransferCenterFilterChip {
                x: queued-tab.x + queued-tab.width + 4px;
                y: 5px;
                width: (parent.width - 28px) / 5;
                height: 28px;
                label: status-chip-label("Paused", root.paused-count);
                active: root.filter-active("paused");
                clicked => {
                    root.filter-toggle-requested("paused");
                }
            }

            failed-tab := TransferCenterFilterChip {
                x: paused-tab.x + paused-tab.width + 4px;
                y: 5px;
                width: (parent.width - 28px) / 5;
                height: 28px;
                label: status-chip-label("Failed", root.failed-count);
                active: root.filter-active("failed");
                border-color: self.active ? ThemeTokens.status-error-accent : ThemeTokens.divider-subtle;
                background: self.active ? ThemeTokens.status-error-surface : transparent;
                clicked => {
                    root.filter-toggle-requested("failed");
                }
            }

            completed-tab := TransferCenterFilterChip {
                x: failed-tab.x + failed-tab.width + 4px;
                y: 5px;
                width: parent.width - self.x - 6px;
                height: 28px;
                label: status-chip-label("Completed", root.completed-count);
                active: root.filter-active("completed");
                clicked => {
                    root.filter-toggle-requested("completed");
                }
            }
        }

        if !root.collapsed : content-shell := Rectangle {
            x: 12px;
            y: root.content-y;
            width: parent.width - 24px;
            height: root.content-height;
            border-radius: 16px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.utility-panel-section-surface;
            clip: true;

            if root.items.length == 0 : empty-state := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: transparent;

                empty-icon-wrap := Rectangle {
                    x: (parent.width - 52px) / 2;
                    y: max(20px, (parent.height - 148px) / 2);
                    width: 52px;
                    height: 52px;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-subtle;
                    background: ThemeTokens.utility-panel-empty-surface;

                    Image {
                        x: 16px;
                        y: 16px;
                        width: 20px;
                        height: 20px;
                        source: root.upload-icon;
                        image-fit: contain;
                        colorize: ThemeTokens.accent;
                    }
                }

                Text {
                    x: 24px;
                    y: empty-icon-wrap.y + empty-icon-wrap.height + 16px;
                    width: parent.width - 48px;
                    text: "No transfers yet";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                }

                Text {
                    x: 40px;
                    y: empty-icon-wrap.y + empty-icon-wrap.height + 42px;
                    width: parent.width - 80px;
                    text: "Queue an upload or download from SFTP and it will appear here without covering the terminal.";
                    color: ThemeTokens.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    font-size: 11px;
                }

                open-sftp-button := TransferCenterPrimaryButton {
                    x: (parent.width - self.width) / 2;
                    y: empty-icon-wrap.y + empty-icon-wrap.height + 90px;
                    width: 112px;
                    height: 30px;
                    label: "Open SFTP";
                    clicked => {
                        root.open-sftp-requested();
                    }
                }
            }

            if root.items.length > 0 : list-shell := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: transparent;
                clip: true;

                list-host := ListView {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;

                    for item in root.items : row := Rectangle {
                        private property <bool> show-completed-actions: item.status_label == "Completed";
                        private property <bool> show-actions: self.show-completed-actions
                            || item.can_retry
                            || item.can_resolve_conflict
                            || item.can_open_workspace
                            || item.can_remove
                            || item.can_show_error;
                        private property <bool> retry-tooltip-active: false;
                        private property <bool> resolve-tooltip-active: false;
                        private property <bool> workspace-tooltip-active: false;
                        private property <bool> open-file-tooltip-active: false;
                        private property <bool> open-folder-tooltip-active: false;
                        private property <bool> details-tooltip-active: false;
                        private property <bool> remove-tooltip-active: false;
                        private property <bool> row-action-tooltip-active: self.retry-tooltip-active || self.resolve-tooltip-active || self.workspace-tooltip-active;
                        private property <bool> row-extra-action-tooltip-active: self.open-file-tooltip-active
                            || self.open-folder-tooltip-active
                            || self.details-tooltip-active
                            || self.remove-tooltip-active;
                        private property <bool> any-action-tooltip-active: self.row-action-tooltip-active || self.row-extra-action-tooltip-active;
                        private property <string> row-meta: item.host_label != ""
                            ? (item.detail != "" ? item.host_label + " - " + item.detail : item.host_label)
                            : (item.detail != "" ? item.detail : item.direction_label);
                        private property <image> direction-icon: item.direction_label == "Download"
                            ? root.download-icon
                            : item.direction_label == "Delete"
                                ? root.delete-icon
                                : item.direction_label == "Move"
                                    ? root.move-icon
                                    : root.upload-icon;
                        private property <brush> tone-accent: item.status_tone == "error"
                            ? ThemeTokens.status-error-accent
                            : item.status_tone == "success"
                                ? ThemeTokens.status-success-accent
                                : item.status_tone == "muted"
                                    ? ThemeTokens.text-muted
                                    : ThemeTokens.accent;
                        private property <brush> status-border: item.status_tone == "error"
                            ? ThemeTokens.status-error-accent
                            : item.status_tone == "success"
                                ? ThemeTokens.status-pill-border
                                : item.status_tone == "muted"
                                    ? ThemeTokens.status-pill-border
                                    : ThemeTokens.status-pill-border;
                        private property <brush> status-background: item.status_tone == "error"
                            ? ThemeTokens.status-error-surface
                            : item.status_tone == "success"
                                ? ThemeTokens.status-pill-surface
                                : item.status_tone == "muted"
                                    ? ThemeTokens.status-pill-surface
                                    : ThemeTokens.status-busy-surface;
                        private property <brush> status-foreground: item.status_tone == "error"
                            ? ThemeTokens.status-error-accent
                            : item.status_tone == "success"
                                ? ThemeTokens.status-success-accent
                                : item.status_tone == "muted"
                                    ? ThemeTokens.text-secondary
                                    : ThemeTokens.status-busy-accent;
                        private property <length> action-row-y: item.show_error ? 86px : 72px;
                        private property <length> action-divider-y: item.show_error ? 76px : 64px;
                        private property <length> action-start-x: 54px;
                        private property <length> action-gap: 8px;
                        private property <length> completed-open-file-width: 96px;
                        private property <length> completed-open-folder-width: 104px;
                        private property <length> attention-primary-width: 84px;
                        private property <length> attention-secondary-width: 96px;
                        private property <length> attention-danger-width: 80px;
                        private property <length> attention-secondary-x: row.action-start-x + row.attention-primary-width + row.action-gap;
                        private property <length> attention-tertiary-x: row.attention-secondary-x + row.attention-secondary-width + row.action-gap;
                        private property <bool> has-hover: touch.has-hover;
                        height: item.show_error
                            ? (self.show-actions ? 128px : 92px)
                            : (self.show-actions ? 114px : 78px);
                        background: transparent;
                        border-width: 0px;

                        touch := TouchArea {}

                        row-hover-shadow := Rectangle {
                            x: 12px;
                            y: row.has-hover ? 6px : 8px;
                            width: parent.width - 24px;
                            height: parent.height - 12px;
                            border-radius: 16px;
                            background: ThemeTokens.utility-panel-shadow-soft;
                            opacity: row.has-hover ? 0.78 : 0;
                            animate y { duration: 120ms; easing: ease-out; }
                            animate opacity { duration: 120ms; }
                        }

                        card := Rectangle {
                            x: 10px;
                            y: 4px;
                            width: parent.width - 20px;
                            height: parent.height - 8px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: row.has-hover ? ThemeTokens.divider-strong : ThemeTokens.divider-subtle;
                            background: row.has-hover ? ThemeTokens.utility-panel-row-hover-surface : ThemeTokens.utility-panel-section-surface;

                            Rectangle {
                                x: 12px;
                                y: 12px;
                                width: 30px;
                                height: 30px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: row.tone-accent;
                                background: ThemeTokens.utility-panel-empty-surface;

                                Image {
                                    x: 5px;
                                    y: 5px;
                                    width: 20px;
                                    height: 20px;
                                    source: row.direction-icon;
                                    image-fit: contain;
                                    colorize: row.tone-accent;
                                }
                            }

                            Text {
                                x: 54px;
                                y: 12px;
                                width: max(0px, parent.width - 158px);
                                text: item.title;
                                color: ThemeTokens.text-primary;
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                x: 54px;
                                y: 30px;
                                width: max(0px, parent.width - 158px);
                                text: row.row-meta;
                                color: ThemeTokens.text-secondary;
                                font-size: 10px;
                                overflow: elide;
                            }

                            Rectangle {
                                x: parent.width - 102px;
                                y: 12px;
                                width: 84px;
                                height: 22px;
                                border-radius: 11px;
                                border-width: 1px;
                                border-color: row.status-border;
                                background: row.status-background;

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: item.status_label;
                                    color: row.status-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-size: 10px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                            }

                            progress-bar := TransferProgressBar {
                                x: 54px;
                                y: 52px;
                                width: max(0px, parent.width - 154px);
                                height: 5px;
                                value: item.progress_value;
                                tone: item.status_tone;
                            }

                            Text {
                                x: parent.width - 98px;
                                y: 44px;
                                width: 80px;
                                text: item.progress_label;
                                color: ThemeTokens.text-secondary;
                                horizontal-alignment: right;
                                font-size: 10px;
                                overflow: elide;
                            }

                            if item.show_error : error-copy := Text {
                                x: 54px;
                                y: 64px;
                                width: max(0px, parent.width - 72px);
                                text: item.error_summary;
                                color: ThemeTokens.status-error-accent;
                                font-size: 10px;
                                overflow: elide;
                            }

                            if row.show-actions : action-divider := Rectangle {
                                x: 12px;
                                y: row.action-divider-y;
                                width: parent.width - 24px;
                                height: 1px;
                                background: ThemeTokens.divider-subtle;
                            }

                            if row.show-completed-actions : open-file-action := TransferCenterRowActionButton {
                                x: row.action-start-x;
                                y: row.action-row-y;
                                width: row.completed-open-file-width;
                                visible: row.show-completed-actions;
                                enabled: item.can_open_file;
                                emphasized: true;
                                icon-source: root.document-icon;
                                label: "Open File";
                                tooltip-text: item.can_open_file
                                    ? "Open this local file with the default app"
                                    : "This local file is no longer available";
                                tooltip-source-id: item.id + "-open-file";
                                clicked => {
                                    root.open-file-requested(item.id);
                                }
                                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                                }
                                tooltip-close-requested(source-id) => {
                                    root.queue-tooltip-close(source-id);
                                }
                                tooltip-activity-changed(active) => {
                                    row.open-file-tooltip-active = active;
                                }
                            }

                            if row.show-completed-actions : open-folder-action := TransferCenterRowActionButton {
                                x: row.action-start-x + row.completed-open-file-width + row.action-gap;
                                y: row.action-row-y;
                                width: row.completed-open-folder-width;
                                visible: row.show-completed-actions;
                                enabled: item.can_open_folder;
                                icon-source: root.folder-open-icon;
                                label: "Open Folder";
                                tooltip-text: item.can_open_folder
                                    ? "Open the containing folder for this transfer"
                                    : "The containing folder is no longer available";
                                tooltip-source-id: item.id + "-open-folder";
                                clicked => {
                                    root.open-folder-requested(item.id);
                                }
                                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                                }
                                tooltip-close-requested(source-id) => {
                                    root.queue-tooltip-close(source-id);
                                }
                                tooltip-activity-changed(active) => {
                                    row.open-folder-tooltip-active = active;
                                }
                            }

                            if row.show-completed-actions : completed-remove-action := TransferCenterRowActionButton {
                                x: row.action-start-x + row.completed-open-file-width + row.action-gap + row.completed-open-folder-width + row.action-gap;
                                y: row.action-row-y;
                                width: row.attention-danger-width;
                                visible: row.show-completed-actions;
                                enabled: item.can_remove;
                                danger: true;
                                icon-source: root.close-icon;
                                label: "Remove";
                                tooltip-text: item.remove_tooltip;
                                tooltip-source-id: item.id + "-remove";
                                clicked => {
                                    root.remove-requested(item.id);
                                }
                                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                                }
                                tooltip-close-requested(source-id) => {
                                    root.queue-tooltip-close(source-id);
                                }
                                tooltip-activity-changed(active) => {
                                    row.remove-tooltip-active = active;
                                }
                            }

                            if row.show-actions : details-action := TransferCenterRowActionButton {
                                x: row.attention-secondary-x;
                                y: row.action-row-y;
                                width: row.attention-secondary-width;
                                visible: !row.show-completed-actions && item.can_show_error && !item.can_open_workspace;
                                enabled: true;
                                icon-source: root.details-icon;
                                label: "Details";
                                tooltip-text: item.error_tooltip;
                                tooltip-source-id: item.id + "-details";
                                clicked => {
                                    root.schedule-tooltip(
                                        item.id + "-details",
                                        item.error_tooltip,
                                        details-action.absolute-position.x + details-action.width / 2,
                                        details-action.absolute-position.y + details-action.height + 8px,
                                        details-action.width,
                                    );
                                }
                                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                                }
                                tooltip-close-requested(source-id) => {
                                    root.queue-tooltip-close(source-id);
                                }
                                tooltip-activity-changed(active) => {
                                    row.details-tooltip-active = active;
                                }
                            }

                            if row.show-actions : retry-action := TransferCenterRowActionButton {
                                x: row.action-start-x;
                                y: row.action-row-y;
                                width: row.attention-primary-width;
                                visible: item.can_retry;
                                emphasized: true;
                                icon-source: root.retry-icon;
                                label: "Retry";
                                tooltip-text: "Retry failed transfer";
                                tooltip-source-id: item.id + "-retry";
                                clicked => {
                                    root.retry-requested(item.id);
                                }
                                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                                }
                                tooltip-close-requested(source-id) => {
                                    root.queue-tooltip-close(source-id);
                                }
                                tooltip-activity-changed(active) => {
                                    row.retry-tooltip-active = active;
                                }
                            }

                            if row.show-actions : resolve-action := TransferCenterRowActionButton {
                                x: row.action-start-x;
                                y: row.action-row-y;
                                width: row.attention-primary-width;
                                visible: item.can_resolve_conflict;
                                emphasized: true;
                                icon-source: root.move-icon;
                                label: "Resolve";
                                tooltip-text: "Resolve transfer conflict";
                                tooltip-source-id: item.id + "-resolve";
                                clicked => {
                                    root.resolve-conflict-requested(item.id);
                                }
                                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                                }
                                tooltip-close-requested(source-id) => {
                                    root.queue-tooltip-close(source-id);
                                }
                                tooltip-activity-changed(active) => {
                                    row.resolve-tooltip-active = active;
                                }
                            }

                            if row.show-actions : open-workspace-action := TransferCenterRowActionButton {
                                x: row.attention-secondary-x;
                                y: row.action-row-y;
                                width: row.attention-secondary-width;
                                visible: !row.show-completed-actions && item.can_open_workspace;
                                enabled: true;
                                icon-source: root.workspace-icon;
                                label: "Workspace";
                                tooltip-text: "Open task in SFTP workspace";
                                tooltip-source-id: item.id + "-workspace";
                                clicked => {
                                    root.open-workspace-requested(item.id);
                                }
                                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                                }
                                tooltip-close-requested(source-id) => {
                                    root.queue-tooltip-close(source-id);
                                }
                                tooltip-activity-changed(active) => {
                                    row.workspace-tooltip-active = active;
                                }
                            }

                            if row.show-actions : remove-action := TransferCenterRowActionButton {
                                x: item.can_open_workspace || (item.can_show_error && !item.can_open_workspace)
                                    ? row.attention-tertiary-x
                                    : item.can_retry || item.can_resolve_conflict
                                        ? row.attention-secondary-x
                                        : row.action-start-x;
                                y: row.action-row-y;
                                width: row.attention-danger-width;
                                visible: !row.show-completed-actions && item.can_remove;
                                enabled: true;
                                danger: true;
                                icon-source: root.close-icon;
                                label: "Remove";
                                tooltip-text: "Remove task from the transfer center";
                                tooltip-source-id: item.id + "-remove";
                                clicked => {
                                    root.remove-requested(item.id);
                                }
                                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                                }
                                tooltip-close-requested(source-id) => {
                                    root.queue-tooltip-close(source-id);
                                }
                                tooltip-activity-changed(active) => {
                                    row.remove-tooltip-active = active;
                                }
                            }
                        }

                        changed has-hover => {
                            if !self.row-action-tooltip-active && self.has-hover && item.error_tooltip != "" && !self.row-extra-action-tooltip-active {
                                root.schedule-tooltip(
                                    item.id,
                                    item.error_tooltip,
                                    self.absolute-position.x + 46px,
                                    self.absolute-position.y + self.height + 8px,
                                    max(140px, min(self.width - 40px, 320px)),
                                );
                            } else {
                                root.queue-tooltip-close(item.id);
                            }
                        }

                        changed row-action-tooltip-active => {
                            if self.row-action-tooltip-active {
                                root.queue-tooltip-close(item.id);
                            } else if !self.row-action-tooltip-active && self.has-hover && item.error_tooltip != "" && !self.row-extra-action-tooltip-active {
                                root.schedule-tooltip(
                                    item.id,
                                    item.error_tooltip,
                                    self.absolute-position.x + 46px,
                                    self.absolute-position.y + self.height + 8px,
                                    max(140px, min(self.width - 40px, 320px)),
                                );
                            }
                        }

                        changed any-action-tooltip-active => {
                            if self.any-action-tooltip-active {
                                root.queue-tooltip-close(item.id);
                            } else if self.has-hover && item.error_tooltip != "" {
                                root.schedule-tooltip(
                                    item.id,
                                    item.error_tooltip,
                                    self.absolute-position.x + 46px,
                                    self.absolute-position.y + self.height + 8px,
                                    max(140px, min(self.width - 40px, 320px)),
                                );
                            }
                        }
                    }
                }
            }
        }

        if root.feedback-visible-value && root.feedback-text != "" : feedback-banner := TransferCenterFeedbackBanner {
            x: 14px;
            y: root.footer-height > 0px ? parent.height - root.footer-height - 38px : parent.height - 42px;
            width: min(parent.width - 28px, 320px);
            height: 28px;
            label: root.feedback-text;
            tone: root.feedback-tone;
        }

        if !root.collapsed && root.footer-height > 0px : footer-strip := Rectangle {
            x: 14px;
            y: parent.height - root.footer-height;
            width: parent.width - 28px;
            height: root.footer-height - 10px;
            background: transparent;
            private property <length> footer-copy-width: root.completed-count > 0
                ? max(0px, parent.width - 146px)
                : parent.width;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }

            Text {
                x: 0px;
                y: 7px;
                width: footer-strip.footer-copy-width;
                height: parent.height - 8px;
                text: root.failed-count > 0
                    ? "Failed transfers stay here until you retry or remove them"
                    : root.completed-count > 0
                        ? "Completed transfers stay here until you clear them"
                        : root.queue-total > 0
                            ? "Transfers stay close without interrupting the terminal"
                            : "Ready for the next transfer";
                color: ThemeTokens.text-secondary;
                font-size: 10px;
                wrap: word-wrap;
            }

            clear-completed-action := TransferCenterRowActionButton {
                x: parent.width - 132px;
                y: 6px;
                width: 132px;
                visible: root.completed-count > 0;
                label: "Clear Completed";
                icon-source: root.close-icon;
                tooltip-text: "Remove finished rows from the transfer center";
                tooltip-source-id: "transfer-clear-completed";
                clicked => {
                    root.clear-completed-requested();
                }
                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                }
                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
                tooltip-activity-changed(active) => {
                    if !active {
                        root.queue-tooltip-close("transfer-clear-completed");
                    }
                }
            }
        }
    }
    }

    tooltip-delay := Timer {
        interval: 220ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-text-value != "" {
                root.tooltip-visible-value = true;
            }
        }
    }

    tooltip-close-delay := Timer {
        interval: 80ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-close-source-id-value != "" {
                root.close-tooltip(root.tooltip-close-source-id-value);
            }
        }
    }

    feedback-hide := Timer {
        interval: 3200ms;
        running: false;

        triggered => {
            self.running = false;
            root.feedback-visible-value = false;
        }
    }
}
