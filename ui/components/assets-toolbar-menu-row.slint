// Reusable row chrome for actions shown in the assets create menu.

import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

export component AssetsToolbarMenuRow inherits Rectangle {
    in property <string> label;
    in property <image> icon-source;
    callback invoked;

    height: 36px;
    border-radius: 0px;
    background: touch.pressed
        ? ThemeTokens.control-active-surface
        : touch.has-hover
            ? ThemeTokens.control-hover-surface
            : transparent;

    icon-slot := Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        background: transparent;

        Image {
            width: 16px;
            height: 16px;
            source <=> root.icon-source;
            image-fit: contain;
            colorize: ThemeTokens.text-primary;
        }
    }

    label-text := Text {
        x: 38px;
        width: parent.width - 50px;
        height: parent.height;
        text: root.label;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-body;
        font-weight: AppTypography.ui-font-weight-regular;
        letter-spacing: 0px;
        color: ThemeTokens.text-primary;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.invoked();
        }
    }
}
