import {
    DialogActionButton,
    DialogFormSection,
    DialogInlineBanner,
    DialogSectionCard,
    DialogSegmentButton,
    DialogTextField,
    ModalBodyScrollArea,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

component SyncStatusMetricRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";

    min-width: 0px;
    preferred-width: 0px;
    height: 22px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: min(144px, parent.width * 0.42);
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-secondary;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: min(152px, parent.width * 0.44);
        y: 0px;
        width: max(0px, parent.width - self.x);
        height: parent.height;
        text: root.value;
        color: ThemeTokens.text-primary;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component SyncVaultModal inherits Rectangle {
    in property <string> mode: "not-configured";
    in property <string> title: "Sync Settings";
    in property <string> headline: "";
    in property <string> status-text: "";
    in property <string> error-text: "";
    in property <string> provider-label: "";
    in property <string> target-label: "";
    in property <int> conflict-count: 0;
    in property <string> conflict-summary: "";
    in property <string> primary-action-label: "Set up sync";
    in property <string> secondary-action-label: "";
    in property <string> git-remote-url: "";
    in property <string> git-branch: "main";
    in property <string> git-auth-mode: "https";
    in property <string> git-https-username: "";
    in property <string> git-https-secret: "";
    in property <bool> git-https-secret-visible: false;
    in property <string> git-ssh-private-key: "";
    in property <string> git-ssh-passphrase: "";
    in property <bool> git-ssh-passphrase-visible: false;
    in property <string> master-password: "";
    in property <bool> master-password-visible: false;
    in property <string> local-last-sync-text: "Never synced";
    in property <string> remote-last-update-text: "Unknown";
    in property <string> primary-revision-text: "Unknown";
    in property <string> remote-status-text: "";
    in property <bool> remote-status-loading: false;
    callback close-requested();
    callback primary-action-requested();
    callback secondary-action-requested();
    callback draft-changed(string, string);
    callback toggle-changed(string, bool);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();

    private property <bool> compact-layout: root.height < 620px;
    private property <image> eye-icon: @image-url("../../assets/icons/fluent/eye-20-regular.svg");
    private property <image> eye-off-icon: @image-url("../../assets/icons/fluent/eye-off-20-regular.svg");
    private property <length> footer-height: ThemeTokens.modal-footer-min-height;

    background: transparent;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.title;
            subtitle: root.headline != "" ? root.headline : "Review sync status, repository settings, and authentication.";
            prominent: true;
            show-drag-handle: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: root.compact-layout ? 12px : 14px;
            content-padding-horizontal: root.compact-layout ? 15px : 17px;
            content-padding-vertical: root.compact-layout ? 12px : 16px;
            content-padding-bottom: root.compact-layout ? 12px : 18px;
            content-spacing: root.compact-layout ? 10px : 14px;
            viewport-surface: ThemeTokens.modal-body-surface;
            panel-surface: ThemeTokens.modal-body-surface;
            panel-border-color: transparent;

            content-column := Rectangle {
                width: body.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body.content-spacing;

                    if root.status-text != "" : DialogInlineBanner {
                        width: parent.width;
                        tone: root.remote-status-loading ? "busy" : "neutral";
                        message: root.status-text;
                    }

                    if root.error-text != "" : DialogInlineBanner {
                        width: parent.width;
                        tone: "error";
                        message: root.error-text;
                    }

                    if root.provider-label != "" || root.target-label != "" : DialogSectionCard {
                        width: parent.width;
                        spacing: 8px;

                        Text {
                            width: parent.width;
                            text: "Remote target";
                            color: ThemeTokens.text-secondary;
                            font-size: 11px;
                            overflow: elide;
                        }

                        Text {
                            width: parent.width;
                            text: (root.provider-label != "" ? root.provider-label : "Vault provider pending")
                                + (root.target-label != "" ? " - " + root.target-label : "");
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }
                    }

                    if root.mode != "not-configured" : DialogSectionCard {
                        width: parent.width;
                        spacing: 12px;
                        surface: ThemeTokens.modal-section-alt-surface;

                        Text {
                            width: parent.width;
                            text: "Latest sync status";
                            color: ThemeTokens.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        if root.remote-status-loading : Text {
                            width: parent.width;
                            text: "Refreshing remote head...";
                            color: ThemeTokens.status-busy-accent;
                            font-size: 11px;
                            overflow: elide;
                        }

                        SyncStatusMetricRow {
                            width: parent.width;
                            label: "Local last sync";
                            value: root.local-last-sync-text;
                        }

                        SyncStatusMetricRow {
                            width: parent.width;
                            label: "Remote last update";
                            value: root.remote-last-update-text;
                        }

                        SyncStatusMetricRow {
                            width: parent.width;
                            label: "Primary revision";
                            value: root.primary-revision-text;
                        }

                        Text {
                            width: parent.width;
                            text: root.remote-status-text != "" ? root.remote-status-text : root.status-text;
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }
                    }

                    if root.conflict-count > 0 : DialogSectionCard {
                        width: parent.width;
                        spacing: 10px;

                        Text {
                            width: parent.width;
                            text: root.conflict-count == 1
                                ? "1 conflict/recovery copy needs review"
                                : root.conflict-count + " conflict/recovery copies need review";
                            color: ThemeTokens.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            width: parent.width;
                            text: root.conflict-summary;
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }
                    }

                    if root.mode == "not-configured" : DialogFormSection {
                        width: parent.width;
                        title: "Vault bootstrap";
                        description: root.compact-layout ? "" : "Provide the master password only during first-time setup or unlock-style flows.";

                        DialogTextField {
                            width: parent.width;
                            label: "Master password";
                            value: root.master-password;
                            password-mode: !root.master-password-visible;
                            trailing-icon-visible: true;
                            trailing-icon-source: root.master-password-visible ? root.eye-off-icon : root.eye-icon;
                            trailing-icon-label: root.master-password-visible ? "Hide master password" : "Show master password";
                            helper-text: "Used only during initial setup or unlock-style flows. The actual mode-specific action still comes from the view model.";

                            value-changed(value) => {
                                root.draft-changed("master-password", value);
                            }

                            trailing-icon-requested => {
                                root.draft-changed(
                                    "master-password-visibility",
                                    root.master-password-visible ? "hidden" : "visible"
                                );
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Repository";
                        description: root.compact-layout ? "" : "Keep the remote URL and branch together so the sync target is easy to verify.";

                        git-remote-url-field := DialogTextField {
                            width: parent.width;
                            label: "Git remote URL";
                            value: root.git-remote-url;
                            helper-text: "HTTPS and SSH targets both live here so the rest of the dialog can stay mode-driven instead of duplicating fields.";

                            value-changed(value) => {
                                root.draft-changed("git-remote-url", value);
                            }
                        }

                        DialogTextField {
                            width: parent.width;
                            label: "Branch";
                            value: root.git-branch;

                            value-changed(value) => {
                                root.draft-changed("git-branch", value);
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Auth mode";
                        description: root.compact-layout ? "" : "Switch between HTTPS and SSH credentials without duplicating repository settings.";

                        HorizontalLayout {
                            width: parent.width;
                            height: 34px;
                            spacing: 8px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "HTTPS";
                                active: root.git-auth-mode == "https";

                                clicked => {
                                    root.draft-changed("git-auth-mode", "https");
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "SSH";
                                active: root.git-auth-mode == "ssh";

                                clicked => {
                                    root.draft-changed("git-auth-mode", "ssh");
                                }
                            }
                        }

                        if root.git-auth-mode == "https" : DialogTextField {
                            width: parent.width;
                            label: "HTTPS username";
                            value: root.git-https-username;

                            value-changed(value) => {
                                root.draft-changed("git-https-username", value);
                            }
                        }

                        if root.git-auth-mode == "https" : DialogTextField {
                            width: parent.width;
                            label: "HTTPS secret";
                            value: root.git-https-secret;
                            password-mode: !root.git-https-secret-visible;
                            trailing-icon-visible: true;
                            trailing-icon-source: root.git-https-secret-visible ? root.eye-off-icon : root.eye-icon;
                            trailing-icon-label: root.git-https-secret-visible ? "Hide HTTPS secret" : "Show HTTPS secret";

                            value-changed(value) => {
                                root.draft-changed("git-https-secret", value);
                            }

                            trailing-icon-requested => {
                                root.draft-changed(
                                    "git-https-secret-visibility",
                                    root.git-https-secret-visible ? "hidden" : "visible"
                                );
                            }
                        }

                        if root.git-auth-mode == "ssh" : DialogTextField {
                            width: parent.width;
                            label: "SSH private key";
                            value: root.git-ssh-private-key;
                            password-mode: true;
                            multiline: true;

                            value-changed(value) => {
                                root.draft-changed("git-ssh-private-key", value);
                            }
                        }

                        if root.git-auth-mode == "ssh" : DialogTextField {
                            width: parent.width;
                            label: "SSH passphrase";
                            value: root.git-ssh-passphrase;
                            password-mode: !root.git-ssh-passphrase-visible;
                            trailing-icon-visible: true;
                            trailing-icon-source: root.git-ssh-passphrase-visible ? root.eye-off-icon : root.eye-icon;
                            trailing-icon-label: root.git-ssh-passphrase-visible ? "Hide SSH passphrase" : "Show SSH passphrase";

                            value-changed(value) => {
                                root.draft-changed("git-ssh-passphrase", value);
                            }

                            trailing-icon-requested => {
                                root.draft-changed(
                                    "git-ssh-passphrase-visibility",
                                    root.git-ssh-passphrase-visible ? "hidden" : "visible"
                                );
                            }
                        }
                    }

                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            content-padding-top: root.compact-layout ? 10px : 14px;
            content-padding-bottom: root.compact-layout ? 10px : 14px;
            content-spacing: 8px;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                if root.secondary-action-label != "" : DialogActionButton {
                    width: 120px;
                    label: root.secondary-action-label;

                    clicked => {
                        root.secondary-action-requested();
                    }
                }

                DialogActionButton {
                    width: 132px;
                    label: root.primary-action-label;
                    primary: true;

                    clicked => {
                        root.primary-action-requested();
                    }
                }
            }
        }
    }
}
