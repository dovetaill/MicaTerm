import { ScrollView } from "std-widgets.slint";
import { ModalBodyScrollArea, ModalFooterBar, ModalHeaderBar } from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

component SyncModalActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked();

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 38px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary ? ThemeTokens.accent : ThemeTokens.divider-strong;
    background: root.primary
        ? action-touch.pressed
            ? ThemeTokens.control-pressed-surface
            : action-touch.has-hover
                ? #5aabff
                : ThemeTokens.accent
        : action-touch.pressed
            ? ThemeTokens.control-pressed-surface
            : action-touch.has-hover
                ? ThemeTokens.control-hover-surface
                : ThemeTokens.workspace-surface;

    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        font-weight: root.primary ? 700 : 600;
    }

    action-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

component SyncModalTextField inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> password-mode: false;
    callback value-changed(string);

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 64px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 18px;
        text: root.label;
        color: ThemeTokens.text-primary;
        opacity: 0.78;
    }

    field-shell := Rectangle {
        x: 0px;
        y: 26px;
        width: parent.width;
        height: 40px;
        border-radius: 0px;
        border-width: 1px;
        border-color: ThemeTokens.divider-strong;
        background: ThemeTokens.workspace-surface;

        field-input := TextInput {
            x: 12px;
            y: 9px;
            width: parent.width - 24px;
            height: parent.height - 18px;
            text: root.value;
            color: ThemeTokens.text-primary;
            single-line: true;
            input-type: root.password-mode ? InputType.password : InputType.text;
            selection-background-color: ThemeTokens.accent;
            selection-foreground-color: ThemeTokens.text-primary;

            edited => {
                root.value-changed(self.text);
            }
        }
    }
}

component SyncStatusMetricRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";

    min-width: 0px;
    preferred-width: 0px;
    height: 22px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: min(136px, parent.width * 0.42);
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        opacity: 0.7;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: min(144px, parent.width * 0.44);
        y: 0px;
        width: max(0px, parent.width - self.x);
        height: parent.height;
        text: root.value;
        color: ThemeTokens.text-primary;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component SyncVaultModal inherits Rectangle {
    in property <string> mode: "not-configured";
    in property <string> title: "Sync Settings";
    in property <string> headline: "";
    in property <string> status-text: "";
    in property <string> error-text: "";
    in property <string> provider-label: "";
    in property <string> target-label: "";
    in property <int> conflict-count: 0;
    in property <string> conflict-summary: "";
    in property <string> primary-action-label: "Set up sync";
    in property <string> secondary-action-label: "";
    in property <string> git-remote-url: "";
    in property <string> git-branch: "main";
    in property <string> git-auth-mode: "https";
    in property <string> git-https-username: "";
    in property <string> git-https-secret: "";
    in property <string> git-ssh-private-key: "";
    in property <string> git-ssh-passphrase: "";
    in property <string> master-password: "";
    in property <string> local-last-sync-text: "Never synced";
    in property <string> remote-last-update-text: "Unknown";
    in property <string> primary-revision-text: "Unknown";
    in property <string> remote-status-text: "";
    in property <bool> remote-status-loading: false;
    callback close-requested();
    callback primary-action-requested();
    callback secondary-action-requested();
    callback draft-changed(string, string);
    callback toggle-changed(string, bool);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();

    private property <bool> compact-layout: root.height < 576px;
    private property <length> header-height: 60px;
    private property <length> footer-height: root.compact-layout ? 60px : 82px;
    private property <length> body-height: max(0px, root.height - root.header-height - root.footer-height);

    background: transparent;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.title;
            subtitle: root.headline;
            prominent: true;
            show-drag-handle: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: root.compact-layout ? 10px : 12px;
            content-padding-horizontal: root.compact-layout ? 14px : 16px;
            content-padding-vertical: root.compact-layout ? 10px : 12px;
            content-padding-bottom: root.compact-layout ? 12px : 16px;
            content-spacing: root.compact-layout ? 8px : 10px;
            viewport-surface: ThemeTokens.inspector-surface;
            panel-surface: ThemeTokens.window-surface;
            panel-border-color: ThemeTokens.divider-strong;

            content-column := Rectangle {
                width: body.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body.content-spacing;

                    Text {
                        width: parent.width;
                        text: root.status-text;
                        color: ThemeTokens.text-primary;
                        opacity: 0.84;
                        wrap: word-wrap;
                    }

                    if root.error-text != "" : error-banner := Rectangle {
                        width: parent.width;
                        height: max(40px, error-copy.preferred-height + 16px);
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-strong;
                        background: ThemeTokens.status-error-surface;

                        error-copy := Text {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text: root.error-text;
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }
                    }

                    if root.provider-label != "" || root.target-label != "" : summary-card := Rectangle {
                        width: parent.width;
                        height: 44px;
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-strong;
                        background: ThemeTokens.workspace-surface;

                        Text {
                            x: 12px;
                            y: 0px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: (root.provider-label != "" ? "Provider: " + root.provider-label : "")
                                + (root.target-label != "" ? "  •  " + root.target-label : "");
                            color: ThemeTokens.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    sync-status-card := Rectangle {
                        width: parent.width;
                        height: max(118px, status-copy.preferred-height + 98px);
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-strong;
                        background: ThemeTokens.workspace-surface;

                        Text {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            text: "Latest sync status";
                            color: ThemeTokens.text-primary;
                            font-weight: 700;
                            overflow: elide;
                        }

                        if root.remote-status-loading : loading-copy := Text {
                            x: parent.width - 140px;
                            y: 10px;
                            width: 128px;
                            text: "Refreshing...";
                            color: ThemeTokens.accent;
                            horizontal-alignment: right;
                            overflow: elide;
                        }

                        SyncStatusMetricRow {
                            x: 12px;
                            y: 36px;
                            width: parent.width - 24px;
                            label: "Local last sync";
                            value: root.local-last-sync-text;
                        }

                        SyncStatusMetricRow {
                            x: 12px;
                            y: 58px;
                            width: parent.width - 24px;
                            label: "Remote last update";
                            value: root.remote-last-update-text;
                        }

                        SyncStatusMetricRow {
                            x: 12px;
                            y: 80px;
                            width: parent.width - 24px;
                            label: "Primary revision";
                            value: root.primary-revision-text;
                        }

                        status-copy := Text {
                            x: 12px;
                            y: 106px;
                            width: parent.width - 24px;
                            text: root.remote-status-text != "" ? root.remote-status-text : root.status-text;
                            color: ThemeTokens.text-primary;
                            opacity: 0.78;
                            wrap: word-wrap;
                        }
                    }

                    if root.conflict-count > 0 : conflict-summary-card := Rectangle {
                        width: parent.width;
                        height: max(56px, conflict-summary-copy.preferred-height + 30px);
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-strong;
                        background: ThemeTokens.workspace-surface;

                        Text {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 24px;
                            text: root.conflict-count == 1
                                ? "1 conflict/recovery copy needs review"
                                : root.conflict-count + " conflict/recovery copies need review";
                            color: ThemeTokens.text-primary;
                            font-weight: 700;
                            overflow: elide;
                        }

                        conflict-summary-copy := Text {
                            x: 12px;
                            y: 28px;
                            width: parent.width - 24px;
                            text: root.conflict-summary;
                            color: ThemeTokens.text-primary;
                            opacity: 0.78;
                            wrap: word-wrap;
                        }
                    }

                    SyncModalTextField {
                        width: parent.width;
                        label: "Git remote URL";
                        value: root.git-remote-url;

                        value-changed(value) => {
                            root.draft-changed("git-remote-url", value);
                        }
                    }

                    SyncModalTextField {
                        width: parent.width;
                        label: "Branch";
                        value: root.git-branch;

                        value-changed(value) => {
                            root.draft-changed("git-branch", value);
                        }
                    }

                    auth-mode-card := Rectangle {
                        width: parent.width;
                        height: 84px;
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-strong;
                        background: ThemeTokens.workspace-surface;

                        Text {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            text: "Auth mode";
                            color: ThemeTokens.text-primary;
                            opacity: 0.78;
                        }

                        HorizontalLayout {
                            x: 12px;
                            y: 36px;
                            width: parent.width - 24px;
                            spacing: 8px;

                            SyncModalActionButton {
                                label: "HTTPS";
                                primary: root.git-auth-mode == "https";

                                clicked => {
                                    root.draft-changed("git-auth-mode", "https");
                                }
                            }

                            SyncModalActionButton {
                                label: "SSH";
                                primary: root.git-auth-mode == "ssh";

                                clicked => {
                                    root.draft-changed("git-auth-mode", "ssh");
                                }
                            }
                        }
                    }

                    if root.git-auth-mode == "https" : https-username-field := SyncModalTextField {
                        width: parent.width;
                        label: "HTTPS username";
                        value: root.git-https-username;

                        value-changed(value) => {
                            root.draft-changed("git-https-username", value);
                        }
                    }

                    if root.git-auth-mode == "https" : https-secret-field := SyncModalTextField {
                        width: parent.width;
                        label: "HTTPS secret";
                        value: root.git-https-secret;
                        password-mode: true;

                        value-changed(value) => {
                            root.draft-changed("git-https-secret", value);
                        }
                    }

                    if root.git-auth-mode == "ssh" : ssh-private-key-field := SyncModalTextField {
                        width: parent.width;
                        label: "SSH private key";
                        value: root.git-ssh-private-key;
                        password-mode: true;

                        value-changed(value) => {
                            root.draft-changed("git-ssh-private-key", value);
                        }
                    }

                    if root.git-auth-mode == "ssh" : ssh-passphrase-field := SyncModalTextField {
                        width: parent.width;
                        label: "SSH passphrase";
                        value: root.git-ssh-passphrase;
                        password-mode: true;

                        value-changed(value) => {
                            root.draft-changed("git-ssh-passphrase", value);
                        }
                    }

                    if root.mode == "not-configured" : password-field := SyncModalTextField {
                        width: parent.width;
                        label: "Master Password";
                        value: root.master-password;
                        password-mode: true;

                        value-changed(value) => {
                            root.draft-changed("master-password", value);
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            surface: ThemeTokens.activity-surface;
            divider-color: ThemeTokens.divider-strong;
            content-padding-top: root.compact-layout ? 6px : 12px;
            content-padding-bottom: root.compact-layout ? 6px : 12px;
            content-spacing: root.compact-layout ? 4px : 6px;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: root.compact-layout ? 34px : 36px;
                spacing: 12px;

                if root.secondary-action-label != "" : secondary-button := SyncModalActionButton {
                    label: root.secondary-action-label;
                    primary: false;

                    clicked => {
                        root.secondary-action-requested();
                    }
                }

                primary-button := SyncModalActionButton {
                    label: root.primary-action-label;
                    primary: true;

                    clicked => {
                        root.primary-action-requested();
                    }
                }
            }
        }
    }
}
