import { ScrollView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";

component SyncModalActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked();

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 38px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary ? ThemeTokens.accent : ThemeTokens.divider-strong;
    background: root.primary
        ? action-touch.pressed
            ? ThemeTokens.control-pressed-surface
            : action-touch.has-hover
                ? #5aabff
                : ThemeTokens.accent
        : action-touch.pressed
            ? ThemeTokens.control-pressed-surface
            : action-touch.has-hover
                ? ThemeTokens.control-hover-surface
                : ThemeTokens.workspace-surface;

    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        font-weight: root.primary ? 700 : 600;
    }

    action-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

component SyncModalTextField inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> password-mode: false;
    callback value-changed(string);

    height: 64px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 18px;
        text: root.label;
        color: ThemeTokens.text-primary;
        opacity: 0.78;
    }

    field-shell := Rectangle {
        x: 0px;
        y: 26px;
        width: parent.width;
        height: 40px;
        border-radius: 0px;
        border-width: 1px;
        border-color: ThemeTokens.divider-strong;
        background: ThemeTokens.workspace-surface;

        field-input := TextInput {
            x: 12px;
            y: 9px;
            width: parent.width - 24px;
            height: parent.height - 18px;
            text: root.value;
            color: ThemeTokens.text-primary;
            single-line: true;
            input-type: root.password-mode ? InputType.password : InputType.text;
            selection-background-color: ThemeTokens.accent;
            selection-foreground-color: ThemeTokens.text-primary;

            edited => {
                root.value-changed(self.text);
            }
        }
    }
}

component SyncModalToggleRow inherits Rectangle {
    in property <string> label: "";
    in property <string> description: "";
    in property <bool> value: false;
    callback toggled(bool);

    height: 54px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-strong;
    background: ThemeTokens.workspace-surface;

    Text {
        x: 12px;
        y: 8px;
        width: parent.width - 78px;
        text: root.label;
        color: ThemeTokens.text-primary;
        font-weight: 600;
        overflow: elide;
    }

    Text {
        x: 12px;
        y: 28px;
        width: parent.width - 78px;
        text: root.description;
        color: ThemeTokens.text-primary;
        opacity: 0.72;
        font-size: 11px;
        overflow: elide;
    }

    toggle-shell := Rectangle {
        x: parent.width - 44px;
        y: 14px;
        width: 20px;
        height: 20px;
        border-radius: 0px;
        border-width: 1px;
        border-color: root.value ? ThemeTokens.accent : ThemeTokens.divider-subtle;
        background: root.value ? ThemeTokens.accent : ThemeTokens.control-active-surface;

        if root.value : toggle-check := Text {
            width: parent.width;
            height: parent.height;
            text: "✓";
            color: ThemeTokens.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 12px;
            font-weight: 700;
        }
    }

    toggle-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.toggled(!root.value);
        }
    }
}

export component SyncVaultModal inherits Rectangle {
    in property <string> mode: "not-configured";
    in property <string> title: "Sync Settings";
    in property <string> headline: "";
    in property <string> status-text: "";
    in property <string> error-text: "";
    in property <string> provider-label: "";
    in property <string> target-label: "";
    in property <string> primary-action-label: "Set up sync";
    in property <string> secondary-action-label: "";
    in property <bool> auto-sync-enabled: false;
    in property <string> primary-gist-id: "";
    in property <string> primary-pat: "";
    in property <bool> mirror-enabled: false;
    in property <string> mirror-gist-id: "";
    in property <string> mirror-pat: "";
    in property <string> master-password: "";
    callback close-requested();
    callback primary-action-requested();
    callback secondary-action-requested();
    callback draft-changed(string, string);
    callback toggle-changed(string, bool);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();

    private property <length> header-height: 60px;
    private property <length> footer-height: 82px;
    private property <length> body-height: max(0px, root.height - root.header-height - root.footer-height);

    background: transparent;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        header := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height;
            border-radius: 0px;
            border-width: 0px;
            background: ThemeTokens.titlebar-surface;

            drag-touch := TouchArea {
                width: parent.width - 48px;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left
                    {
                        root.drag-requested(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.move {
                        root.drag-moved(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.up {
                        root.drag-ended();
                    }
                }
            }

            Text {
                x: 20px;
                y: root.headline != "" ? 8px : 0px;
                width: parent.width - 84px;
                height: root.headline != "" ? 20px : parent.height;
                text: root.title;
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.headline != "" : headline-copy := Text {
                x: 20px;
                y: 32px;
                width: parent.width - 84px;
                text: root.headline;
                color: ThemeTokens.text-primary;
                opacity: 0.74;
                font-size: 11px;
                overflow: elide;
            }

            drag-handle := Rectangle {
                x: 20px;
                y: parent.height - 8px;
                width: 64px;
                height: 2px;
                background: ThemeTokens.divider-strong;
            }

            close-button := Rectangle {
                x: parent.width - 44px;
                y: 12px;
                width: 32px;
                height: 32px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: close-touch.pressed ? ThemeTokens.control-pressed-surface
                    : close-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 18px;
                }

                close-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }
            }

            header-divider := Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }
        }

        body-scroll := ScrollView {
            x: 0px;
            y: root.header-height;
            width: parent.width;
            height: root.body-height;
            mouse-drag-pan-enabled: true;
            viewport-width: scroll-body.width;
            viewport-height: scroll-body.height;

            scroll-body := Rectangle {
                width: body-scroll.visible-width;
                height: max(body-scroll.visible-height, body-panel.height + 12px);
                background: ThemeTokens.inspector-surface;

                body-panel := Rectangle {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: body-column.preferred-height + 24px;
                    border-radius: 0px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-strong;
                    background: ThemeTokens.window-surface;

                    body-column := VerticalLayout {
                        x: 16px;
                        y: 12px;
                        width: parent.width - 32px;
                        spacing: 10px;

                        Text {
                            width: parent.width;
                            text: root.status-text;
                            color: ThemeTokens.text-primary;
                            opacity: 0.84;
                            wrap: word-wrap;
                        }

                        if root.error-text != "" : error-banner := Rectangle {
                            width: parent.width;
                            height: max(40px, error-copy.preferred-height + 16px);
                            border-radius: 0px;
                            border-width: 1px;
                            border-color: ThemeTokens.divider-strong;
                            background: ThemeTokens.status-error-surface;

                            error-copy := Text {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                text: root.error-text;
                                color: ThemeTokens.text-primary;
                                wrap: word-wrap;
                            }
                        }

                        if root.provider-label != "" || root.target-label != "" : summary-card := Rectangle {
                            width: parent.width;
                            height: 44px;
                            border-radius: 0px;
                            border-width: 1px;
                            border-color: ThemeTokens.divider-strong;
                            background: ThemeTokens.workspace-surface;

                            Text {
                                x: 12px;
                                y: 0px;
                                width: parent.width - 24px;
                                height: parent.height;
                                text: (root.provider-label != "" ? "Provider: " + root.provider-label : "")
                                    + (root.target-label != "" ? "  •  " + root.target-label : "");
                                color: ThemeTokens.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        SyncModalToggleRow {
                            width: parent.width;
                            label: "Auto sync";
                            description: "Run sync automatically after local changes when the vault is unlocked.";
                            value: root.auto-sync-enabled;

                            toggled(value) => {
                                root.toggle-changed("auto-sync", value);
                            }
                        }

                        SyncModalTextField {
                            width: parent.width;
                            label: "Primary Gist ID";
                            value: root.primary-gist-id;

                            value-changed(value) => {
                                root.draft-changed("primary-gist-id", value);
                            }
                        }

                        SyncModalTextField {
                            width: parent.width;
                            label: "Primary Personal Access Token";
                            value: root.primary-pat;
                            password-mode: true;

                            value-changed(value) => {
                                root.draft-changed("primary-pat", value);
                            }
                        }

                        SyncModalToggleRow {
                            width: parent.width;
                            label: "Mirror target";
                            description: "Keep a second Gitee gist updated as a backup target.";
                            value: root.mirror-enabled;

                            toggled(value) => {
                                root.toggle-changed("mirror-enabled", value);
                            }
                        }

                        if root.mirror-enabled : mirror-gist-field := SyncModalTextField {
                            width: parent.width;
                            label: "Mirror Gist ID";
                            value: root.mirror-gist-id;

                            value-changed(value) => {
                                root.draft-changed("mirror-gist-id", value);
                            }
                        }

                        if root.mirror-enabled : mirror-pat-field := SyncModalTextField {
                            width: parent.width;
                            label: "Mirror Personal Access Token";
                            value: root.mirror-pat;
                            password-mode: true;

                            value-changed(value) => {
                                root.draft-changed("mirror-pat", value);
                            }
                        }

                        if root.mode == "not-configured" || root.mode == "locked" : password-field := SyncModalTextField {
                            width: parent.width;
                            label: "Master Password";
                            value: root.master-password;
                            password-mode: true;

                            value-changed(value) => {
                                root.draft-changed("master-password", value);
                            }
                        }
                    }
                }
            }
        }

        footer := Rectangle {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            background: ThemeTokens.activity-surface;

            footer-divider := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-strong;
            }

            footer-content := VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 6px;

                Rectangle {
                    height: 0px;
                    vertical-stretch: 1;
                    background: transparent;
                }

                HorizontalLayout {
                    height: 36px;
                    spacing: 12px;

                    if root.secondary-action-label != "" : secondary-button := SyncModalActionButton {
                        label: root.secondary-action-label;
                        primary: false;

                        clicked => {
                            root.secondary-action-requested();
                        }
                    }

                    primary-button := SyncModalActionButton {
                        label: root.primary-action-label;
                        primary: true;

                        clicked => {
                            root.primary-action-requested();
                        }
                    }
                }
            }
        }
    }
}
