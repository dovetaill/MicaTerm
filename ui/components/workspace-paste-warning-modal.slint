import { ScrollView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

component ModalActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> emphasized: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: button-focus.has-focus;
    callback clicked();

    width: emphasized ? 116px : 98px;
    height: 38px;
    border-radius: ThemeTokens.modal-control-radius;
    border-width: 1px;
    border-color: !root.enabled ? ThemeTokens.modal-inner-border
        : root.has-focus ? ThemeTokens.focus-ring
        : root.emphasized ? (ThemeTokens.dark-mode ? #7d9a87 : #a1b8a6)
        : ThemeTokens.modal-inner-border;
    background: !root.enabled ? ThemeTokens.control-disabled-surface
        : button-touch.pressed
            ? root.emphasized
                ? (ThemeTokens.dark-mode ? #2b3b31 : #d5e1d7)
                : ThemeTokens.modal-button-secondary-pressed-surface
            : button-touch.has-hover || root.has-focus
                ? root.emphasized
                    ? (ThemeTokens.dark-mode ? #33463a : #dde8df)
                    : ThemeTokens.modal-button-secondary-hover-surface
                : root.emphasized
                    ? (ThemeTokens.dark-mode ? #2e4035 : #e6eee7)
                    : ThemeTokens.modal-button-secondary-surface;
    opacity: root.enabled ? 1 : 0.54;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { button-touch.clicked(); }
    forward-focus: button-focus;

    public function focus-button() {
        button-focus.focus();
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: AppTypography.ui-font-family;
        font-size: 12px;
        font-weight: root.emphasized ? 700 : AppTypography.ui-font-weight-regular;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;

        clicked => {
            root.clicked();
        }
    }

    button-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.visible && root.enabled;
        focus-on-tab-navigation: root.enabled;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n" || event.text == Key.Return) {
                button-touch.clicked();
                accept
            } else {
                reject
            }
        }
    }
}

export component WorkspacePasteWarningModal inherits Rectangle {
    in property <string> dialog-title: "Paste Multiple Lines";
    in property <int> line-count: 0;
    in property <bool> editor-mode: false;
    in-out property <string> paste-text: "";
    in property <int> focus-sequence: 0;
    in-out property <bool> editor-focused: false;
    callback confirm-requested();
    callback cancel-requested();
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> header-height: 92px;
    private property <length> footer-height: 74px;
    private property <length> body-padding-horizontal: 22px;
    private property <length> body-padding-top: 18px;
    private property <length> editor-padding-horizontal: 16px;
    private property <length> editor-padding-vertical: 14px;
    private property <image> document-icon: @image-url("../../assets/icons/fluent/document-20-regular.svg");
    private property <image> close-icon: @image-url("../../assets/icons/fluent/dismiss-20-regular.svg");
    private property <string> review-shortcuts: root.editor-mode
        ? "Enter to paste  •  Esc to cancel  •  Click editor to edit"
        : "Enter to paste  •  Esc to cancel";

    background: transparent;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        review-key-anchor := TextInput {
            x: 0px;
            y: 0px;
            width: 1px;
            height: 1px;
            text: "";
            color: transparent;
            selection-background-color: transparent;
            selection-foreground-color: transparent;

            edited => {
                if self.text != "" {
                    self.text = "";
                }
            }

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.cancel-requested();
                    root.focus-restore-requested();
                    accept
                } else if !root.editor-focused
                    && (event.text == Key.Return || event.text == "\n")
                {
                    root.confirm-requested();
                    root.focus-restore-requested();
                    accept
                } else {
                    reject
                }
            }
        }

        header := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height;
            background: ThemeTokens.modal-header-surface;

            drag-touch := TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width - 72px;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left
                    {
                        root.drag-requested(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.move {
                        root.drag-moved(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.up {
                        root.drag-ended();
                    }
                }
            }

            icon-tile := Rectangle {
                x: 22px;
                y: 20px;
                width: 46px;
                height: 46px;
                border-radius: 14px;
                border-width: 1px;
                border-color: ThemeTokens.modal-inner-border;
                background: ThemeTokens.dark-mode ? #293650 : #dbe6f4;

                Image {
                    x: 13px;
                    y: 13px;
                    width: 20px;
                    height: 20px;
                    source: root.document-icon;
                    image-fit: contain;
                    colorize: ThemeTokens.link-accent;
                }

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    border-radius: 14px;
                    background: ThemeTokens.dark-mode ? #ffffff16 : #ffffff98;
                }
            }

            Text {
                x: 82px;
                y: 18px;
                width: parent.width - 166px;
                height: 28px;
                text: root.dialog-title;
                color: ThemeTokens.text-primary;
                font-family: AppTypography.ui-font-family;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 82px;
                y: 46px;
                width: parent.width - 166px;
                height: 20px;
                text: root.editor-mode
                    ? "Review pasted content before sending."
                    : "Confirm this paste before it reaches the terminal.";
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: 12px;
                font-weight: AppTypography.ui-font-weight-regular;
                vertical-alignment: center;
                overflow: elide;
            }

            close-button := Rectangle {
                x: parent.width - 58px;
                y: 20px;
                width: 36px;
                height: 36px;
                border-radius: 11px;
                border-width: 1px;
                border-color: close-touch.has-hover ? ThemeTokens.modal-field-border : ThemeTokens.modal-inner-border;
                background: close-touch.pressed ? ThemeTokens.control-pressed-surface
                    : close-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.dark-mode ? #202937 : ThemeTokens.modal-section-surface;

                Image {
                    x: 8px;
                    y: 8px;
                    width: 20px;
                    height: 20px;
                    source: root.close-icon;
                    image-fit: contain;
                    colorize: ThemeTokens.text-primary;
                }

                close-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;

                    clicked => {
                        root.cancel-requested();
                        root.focus-restore-requested();
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.modal-inner-border;
            }
        }

        body := Rectangle {
            x: 0px;
            y: root.header-height;
            width: parent.width;
            height: parent.height - root.header-height - root.footer-height;
            background: ThemeTokens.modal-body-surface;

            Text {
                x: root.body-padding-horizontal;
                y: root.body-padding-top;
                width: parent.width - (root.body-padding-horizontal * 2);
                text: root.editor-mode
                    ? "Press Enter to paste while the action button is focused. Click the editor to make changes; Enter inserts a newline while editing."
                    : "This shell has not advertised bracketed paste protection, so pasted lines may execute immediately.";
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: root.editor-mode ? 11px : 12px;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            Text {
                x: root.body-padding-horizontal;
                y: root.body-padding-top + (root.editor-mode ? 38px : 48px);
                width: parent.width - (root.body-padding-horizontal * 2);
                text: root.review-shortcuts;
                color: ThemeTokens.text-muted;
                font-family: AppTypography.ui-font-family;
                font-size: 11px;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            if root.editor-mode : editor-frame := Rectangle {
                x: root.body-padding-horizontal;
                y: 76px;
                width: parent.width - (root.body-padding-horizontal * 2);
                height: max(180px, parent.height - 92px);
                border-radius: 14px;
                border-width: 1px;
                border-color: paste-input.has-focus
                    ? ThemeTokens.input-focus-ring
                    : ThemeTokens.dark-mode ? #ffffff16 : #9eb2c82e;
                background: ThemeTokens.dark-mode ? #111923 : #fbfdff;
                clip: true;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: ThemeTokens.dark-mode ? #ffffff10 : #ffffff9a;
                }

                editor-scroll := ScrollView {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    viewport-width: editor-viewport.width;
                    viewport-height: editor-viewport.height;
                    vertical-scrollbar-policy: as-needed;
                    horizontal-scrollbar-policy: always-off;
                    mouse-drag-pan-enabled: false;

                    editor-viewport := Rectangle {
                        width: editor-scroll.visible-width;
                        height: max(
                            editor-scroll.visible-height,
                            paste-input.y + paste-input.height + root.editor-padding-vertical
                        );
                        background: transparent;

                        paste-input := TextInput {
                            x: root.editor-padding-horizontal;
                            y: root.editor-padding-vertical;
                            width: max(0px, editor-viewport.width - (root.editor-padding-horizontal * 2));
                            height: max(
                                editor-scroll.visible-height - (root.editor-padding-vertical * 2),
                                self.preferred-height
                            );
                            text: root.paste-text;
                            color: ThemeTokens.text-primary;
                            single-line: false;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            selection-background-color: ThemeTokens.focus-ring;
                            selection-foreground-color: ThemeTokens.text-primary;
                            font-family: AppTypography.ui-font-family;
                            font-size: AppTypography.ui-font-size-body;
                            font-weight: AppTypography.ui-font-weight-regular;

                            edited => {
                                root.paste-text = self.text;
                            }

                            changed has-focus => {
                                root.editor-focused = self.has-focus;
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    root.cancel-requested();
                                    root.focus-restore-requested();
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }
                }
            }
        }

        footer := Rectangle {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            background: ThemeTokens.modal-footer-surface;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.modal-inner-border;
            }

            cancel-button := ModalActionButton {
                x: parent.width - 248px;
                y: 18px;
                label: "Cancel";

                clicked => {
                    root.cancel-requested();
                    root.focus-restore-requested();
                }
            }

            confirm-button := ModalActionButton {
                x: parent.width - 138px;
                y: 18px;
                label: "Paste";
                emphasized: true;

                clicked => {
                    root.confirm-requested();
                    root.focus-restore-requested();
                }
            }
        }
    }

    changed focus-sequence => {
        review-key-anchor.focus();
    }
}
