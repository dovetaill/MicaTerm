import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

component DialogButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary && root.enabled ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: !root.enabled ? ThemeTokens.control-disabled-surface
        : touch.pressed ? ThemeTokens.control-pressed-surface
        : touch.has-hover ? ThemeTokens.control-hover-surface
        : root.primary ? ThemeTokens.accent : ThemeTokens.control-active-surface;
    opacity: root.enabled ? 1.0 : 0.56;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;

        clicked => {
            root.clicked();
        }
    }
}

export component SftpRemoteFileModal inherits Rectangle {
    in property <string> dialog-title: "Remote File";
    in property <string> remote-path: "";
    in property <string> content: "";
    in property <string> status-text: "";
    in property <string> error-text: "";
    in property <bool> can-save: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback save-requested();
    callback content-changed(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();

    background: transparent;

    public function focus-input() {
        editor-input.focus();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        header := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 72px;
            background: ThemeTokens.assets-surface;

            Text {
                x: 20px;
                y: 12px;
                width: parent.width - 72px;
                height: 22px;
                text: root.dialog-title;
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: AppTypography.ui-font-weight-regular;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 20px;
                y: 38px;
                width: parent.width - 72px;
                height: 18px;
                text: root.remote-path;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }

            drag-touch := TouchArea {
                width: parent.width - 48px;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left
                    {
                        root.drag-requested(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.move {
                        root.drag-moved(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.up {
                        root.drag-ended();
                    }
                }
            }

            close-button := Rectangle {
                x: parent.width - 40px;
                y: 12px;
                width: 28px;
                height: 28px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: close-touch.pressed ? ThemeTokens.control-pressed-surface
                    : close-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }
            }

            header-divider := Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }
        }

        body := Rectangle {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            background: ThemeTokens.assets-surface;

            if root.status-text != "" : status-line := Text {
                x: 20px;
                y: 12px;
                width: parent.width - 40px;
                height: 18px;
                text: root.status-text;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                font-size: 11px;
                overflow: elide;
            }

            if root.error-text != "" : error-line := Text {
                x: 20px;
                y: root.status-text != "" ? 32px : 12px;
                width: parent.width - 40px;
                height: 18px;
                text: root.error-text;
                color: ThemeTokens.accent;
                font-size: 11px;
                overflow: elide;
            }

            editor-frame := Rectangle {
                x: 20px;
                y: root.error-text != "" ? 58px : root.status-text != "" ? 38px : 12px;
                width: parent.width - 40px;
                height: parent.height - self.y - 16px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.inspector-surface;

                editor-input := TextInput {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    text: root.content;
                    color: ThemeTokens.text-primary;
                    single-line: false;
                    selection-background-color: ThemeTokens.accent;
                    selection-foreground-color: ThemeTokens.text-primary;

                    edited => {
                        root.content-changed(self.text);
                    }
                }
            }
        }

        footer := Rectangle {
            x: 0px;
            y: parent.height - 74px;
            width: parent.width;
            height: 74px;
            background: ThemeTokens.assets-surface;

            footer-divider := Rectangle {
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }

            cancel-button := DialogButton {
                x: parent.width - 204px;
                y: 20px;
                width: 88px;
                label: "Close";

                clicked => {
                    root.focus-restore-requested();
                    root.close-requested();
                }
            }

            save-button := DialogButton {
                x: parent.width - 108px;
                y: 20px;
                width: 88px;
                label: "Save";
                primary: true;
                enabled: root.can-save;

                clicked => {
                    root.save-requested();
                }
            }
        }
    }
}
