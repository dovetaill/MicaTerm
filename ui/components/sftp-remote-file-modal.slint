import {
    DialogActionButton,
    DialogInlineBanner,
    DialogSectionCard,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

export component SftpRemoteFileModal inherits Rectangle {
    in property <string> dialog-title: "Remote File";
    in property <string> remote-path: "";
    in property <string> content: "";
    in property <string> status-text: "";
    in property <string> error-text: "";
    in property <bool> can-save: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback save-requested();
    callback content-changed(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> footer-height: ThemeTokens.modal-footer-min-height;

    background: transparent;

    public function focus-input() {
        editor-input.focus();
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Edit the remote file in place without leaving the current workspace.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := Rectangle {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            background: ThemeTokens.modal-body-surface;

            body-layout := VerticalLayout {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                height: parent.height - 28px;
                spacing: 10px;

                DialogSectionCard {
                    width: parent.width;
                    padding-horizontal: 16px;
                    padding-vertical: 14px;
                    spacing: 8px;
                    surface: ThemeTokens.modal-section-alt-surface;

                    Text {
                        width: parent.width;
                        text: "Remote path";
                        color: ThemeTokens.text-secondary;
                        font-size: 11px;
                        overflow: elide;
                    }

                    Text {
                        width: parent.width;
                        text: root.remote-path;
                        color: ThemeTokens.text-primary;
                        wrap: word-wrap;
                    }
                }

                if root.status-text != "" : DialogInlineBanner {
                    width: parent.width;
                    tone: "neutral";
                    message: root.status-text;
                }

                if root.error-text != "" : DialogInlineBanner {
                    width: parent.width;
                    tone: "error";
                    message: root.error-text;
                }

                editor-frame := Rectangle {
                    width: parent.width;
                    height: 0px;
                    vertical-stretch: 1;
                    preferred-height: 220px;
                    border-radius: ThemeTokens.modal-section-radius;
                    border-width: 1px;
                    border-color: editor-input.has-focus
                        ? ThemeTokens.input-focus-ring
                        : ThemeTokens.modal-inner-border;
                    background: ThemeTokens.modal-section-surface;
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: ThemeTokens.modal-inner-border;
                    }

                    editor-input := TextInput {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        height: parent.height - 28px;
                        text: root.content;
                        color: ThemeTokens.text-primary;
                        single-line: false;
                        selection-background-color: ThemeTokens.focus-ring;
                        selection-foreground-color: ThemeTokens.text-primary;
                        font-family: AppTypography.ui-font-family;
                        font-size: AppTypography.ui-font-size-body;
                        font-weight: AppTypography.ui-font-weight-regular;

                        edited => {
                            root.content-changed(self.text);
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Close";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    width: 96px;
                    label: "Save";
                    primary: true;
                    enabled: root.can-save;

                    clicked => {
                        root.save-requested();
                    }
                }
            }
        }
    }
}
