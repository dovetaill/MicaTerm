import { ThemeTokens } from "../theme/tokens.slint";

export component SshHostKeyConfirmModal inherits Rectangle {
    in property <string> host: "";
    in property <string> fingerprint: "";
    callback accept-requested();
    callback reject-requested();

    width: 420px;
    height: 244px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-strong;
    background: ThemeTokens.assets-surface;
    z: 146;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.reject-requested();
                accept
            } else if (event.text == Key.Return) {
                root.accept-requested();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Text {
                x: 20px;
                y: 18px;
                text: "Verify Host Key";
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: 600;
            }

            Text {
                x: 20px;
                y: 56px;
                width: parent.width - 40px;
                text: "Trust the SSH host key for " + root.host + "?";
                color: ThemeTokens.text-primary;
                wrap: word-wrap;
            }

            Text {
                x: 20px;
                y: 102px;
                width: parent.width - 40px;
                text: root.fingerprint;
                color: ThemeTokens.text-primary;
                wrap: word-wrap;
            }

            Text {
                x: 20px;
                y: 154px;
                width: parent.width - 40px;
                text: "Accept to store this host key using TOFU, or reject to cancel the connection attempt.";
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                wrap: word-wrap;
            }

            reject-button := Rectangle {
                x: parent.width - 196px;
                y: parent.height - 54px;
                width: 84px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.control-hover-surface;

                Text {
                    text: "Reject";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.reject-requested();
                    }
                }
            }

            accept-button := Rectangle {
                x: parent.width - 104px;
                y: parent.height - 54px;
                width: 84px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.accent;
                background: ThemeTokens.control-active-surface;

                Text {
                    text: "Accept";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.accept-requested();
                    }
                }
            }
        }
    }
}
