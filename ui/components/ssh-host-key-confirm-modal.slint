import {
    DialogActionButton,
    DialogSectionCard,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component SshHostKeyConfirmModal inherits Rectangle {
    in property <string> dialog-title: "Verify Host Key";
    in property <string> host: "";
    in property <string> fingerprint: "";
    in property <int> focus-sequence: 0;
    callback accept-requested();
    callback reject-requested();
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> footer-height: ThemeTokens.modal-footer-min-height;

    background: transparent;

    changed focus-sequence => {
        accept-button.focus-button();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.accept-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Confirm the server fingerprint before trusting it with TOFU storage.";
            prominent: true;

            close-requested => {
                root.reject-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := Rectangle {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            background: ThemeTokens.modal-body-surface;

            VerticalLayout {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                spacing: 0px;

                DialogSectionCard {
                    width: parent.width;
                    spacing: 12px;

                    Text {
                        width: parent.width;
                        text: "Trust the SSH host key for " + root.host + "?";
                        color: ThemeTokens.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    Text {
                        width: parent.width;
                        text: "Accept to store this host key using TOFU, or reject to cancel the connection attempt.";
                        color: ThemeTokens.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    DialogSectionCard {
                        width: parent.width;
                        padding-horizontal: 14px;
                        padding-vertical: 12px;
                        spacing: 8px;
                        surface: ThemeTokens.modal-section-alt-surface;

                        Text {
                            width: parent.width;
                            text: "Fingerprint";
                            color: ThemeTokens.text-secondary;
                            font-size: 11px;
                            overflow: elide;
                        }

                        Text {
                            width: parent.width;
                            text: root.fingerprint;
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Reject";

                    clicked => {
                        root.focus-restore-requested();
                        root.reject-requested();
                    }
                }

                accept-button := DialogActionButton {
                    width: 96px;
                    label: "Accept";
                    primary: true;

                    clicked => {
                        root.accept-requested();
                    }
                }
            }
        }
    }
}
