import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

component DialogButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked();

    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: button-touch.pressed ? ThemeTokens.control-pressed-surface
        : button-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.primary ? ThemeTokens.accent : ThemeTokens.control-active-surface;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

export component SshHostKeyConfirmModal inherits Rectangle {
    in property <string> dialog-title: "Verify Host Key";
    in property <string> host: "";
    in property <string> fingerprint: "";
    callback accept-requested();
    callback reject-requested();
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> footer-height: 66px;

    background: transparent;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.reject-requested();
                accept
            } else if (event.text == Key.Return) {
                root.accept-requested();
                accept
            } else {
                reject
            }
        }

        header := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 56px;
            background: ThemeTokens.assets-surface;

            Text {
                x: 20px;
                y: 0px;
                width: parent.width - 72px;
                height: parent.height;
                text: root.dialog-title;
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: AppTypography.ui-font-weight-regular;
                vertical-alignment: center;
            }

            drag-touch := TouchArea {
                width: parent.width - 48px;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left
                    {
                        root.drag-requested(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.move {
                        root.drag-moved(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.up {
                        root.drag-ended();
                    }
                }
            }

            close-button := Rectangle {
                x: parent.width - 40px;
                y: 12px;
                width: 28px;
                height: 28px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: close-touch.pressed ? ThemeTokens.control-pressed-surface
                    : close-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.focus-restore-requested();
                        root.reject-requested();
                    }
                }
            }

            divider := Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }
        }

        body := Rectangle {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - root.footer-height;
            background: transparent;

            Text {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                text: "Trust the SSH host key for " + root.host + "?";
                color: ThemeTokens.text-primary;
                font-size: 16px;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            fingerprint-panel := Rectangle {
                x: 20px;
                y: 62px;
                width: parent.width - 40px;
                height: 72px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.inspector-surface;

                Text {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    text: root.fingerprint;
                    color: ThemeTokens.text-primary;
                    wrap: word-wrap;
                }
            }

            Text {
                x: 20px;
                y: 146px;
                width: parent.width - 40px;
                text: "Accept to store this host key using TOFU, or reject to cancel the connection attempt.";
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                wrap: word-wrap;
            }

        }

        footer := Rectangle {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            background: ThemeTokens.assets-surface;

            footer-divider := Rectangle {
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }

            reject-button := DialogButton {
                x: parent.width - 204px;
                y: 16px;
                width: 88px;
                label: "Reject";

                clicked => {
                    root.focus-restore-requested();
                    root.reject-requested();
                }
            }

            accept-button := DialogButton {
                x: parent.width - 104px;
                y: 16px;
                width: 84px;
                label: "Accept";
                primary: true;

                clicked => {
                    root.accept-requested();
                }
            }
        }
    }
}
