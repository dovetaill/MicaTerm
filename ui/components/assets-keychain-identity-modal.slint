import {
    DialogActionButton,
    DialogFormSection,
    DialogInlineBanner,
    DialogSectionCard,
    DialogSegmentButton,
    DialogTextField,
    ModalBodyScrollArea,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsKeychainIdentityModal inherits Rectangle {
    in property <string> dialog-title: "Identity";
    in property <string> name: "";
    in property <string> username: "";
    in property <string> auth-kind: "password";
    in property <string> password: "";
    in property <bool> password-visible: false;
    in property <string> ssh-key-label: "";
    in property <string> remark: "";
    in property <string> validation-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback draft-changed(string, string);
    callback action-requested(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <image> eye-icon: @image-url("../../assets/icons/fluent/eye-20-regular.svg");
    private property <image> eye-off-icon: @image-url("../../assets/icons/fluent/eye-off-20-regular.svg");
    private property <length> footer-height: root.validation-message == "" ? ThemeTokens.modal-footer-min-height : 116px;

    background: transparent;

    public function focus-input() {
        name-field.focus-input();
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Return && root.can-confirm) {
                root.confirm-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Store shared credentials for reusable connection flows.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body-scroll := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: 14px;
            content-padding-horizontal: 18px;
            content-padding-vertical: 16px;
            content-spacing: 14px;
            viewport-surface: ThemeTokens.modal-body-surface;
            panel-surface: ThemeTokens.modal-body-surface;
            panel-border-color: transparent;

            content-column := Rectangle {
                width: body-scroll.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body-scroll.content-spacing;

                    DialogFormSection {
                        width: parent.width;
                        title: "Identity profile";
                        description: "Use a stable label so SSH pickers and sync setup can reuse this identity.";

                        name-field := DialogTextField {
                            width: parent.width;
                            label: "Name";
                            required: true;
                            value: root.name;
                            invalid: root.validation-message != "";
                            helper-text: root.validation-message;

                            value-changed(value) => {
                                root.draft-changed("name", value);
                            }
                        }

                        DialogTextField {
                            width: parent.width;
                            label: "Username";
                            required: true;
                            value: root.username;

                            value-changed(value) => {
                                root.draft-changed("username", value);
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Authentication";
                        description: "Choose whether this identity stores a password or references a managed SSH key.";

                        Rectangle {
                            width: parent.width;
                            height: 34px;
                            background: transparent;

                            HorizontalLayout {
                                width: parent.width;
                                spacing: 8px;

                                DialogSegmentButton {
                                    horizontal-stretch: 1;
                                    label: "Password";
                                    active: root.auth-kind == "password";

                                    clicked => {
                                        root.draft-changed("auth_kind", "password");
                                    }
                                }

                                DialogSegmentButton {
                                    horizontal-stretch: 1;
                                    label: "SSH Key";
                                    active: root.auth-kind == "ssh-key";

                                    clicked => {
                                        root.draft-changed("auth_kind", "ssh-key");
                                    }
                                }
                            }
                        }

                        if root.auth-kind == "password" : DialogTextField {
                            width: parent.width;
                            label: "Password";
                            required: true;
                            value: root.password;
                            password-mode: !root.password-visible;
                            trailing-icon-visible: true;
                            trailing-icon-source: root.password-visible ? root.eye-off-icon : root.eye-icon;
                            trailing-icon-label: root.password-visible ? "Hide password" : "Show password";
                            helper-text: "Use the SSH key mode if this identity should point at a managed key instead of a stored password.";

                            value-changed(value) => {
                                root.draft-changed("password", value);
                            }

                            trailing-icon-requested => {
                                root.draft-changed(
                                    "password_visibility",
                                    root.password-visible ? "hidden" : "visible"
                                );
                            }
                        }

                        if root.auth-kind == "ssh-key" : DialogSectionCard {
                            width: parent.width;
                            padding-horizontal: 16px;
                            padding-vertical: 14px;
                            spacing: 10px;
                            surface: ThemeTokens.modal-section-surface;

                            Text {
                                width: parent.width;
                                text: "Linked SSH key";
                                color: ThemeTokens.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }

                            Text {
                                width: parent.width;
                                text: root.ssh-key-label == "" ? "No key selected" : root.ssh-key-label;
                                color: ThemeTokens.text-primary;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                width: parent.width;
                                height: 38px;
                                spacing: 10px;

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Use Existing Key";

                                    clicked => {
                                        root.action-requested("use-existing-ssh-key");
                                    }
                                }

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Create New Key";

                                    clicked => {
                                        root.action-requested("create-ssh-key");
                                    }
                                }
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Notes";
                        description: "Use this for environment or owner hints when the same username appears across systems.";

                        DialogTextField {
                            width: parent.width;
                            label: "Remark";
                            value: root.remark;
                            multiline: true;
                            helper-text: "Helpful for environment, scope, or owner notes when the same username exists across multiple systems.";

                            value-changed(value) => {
                                root.draft-changed("remark", value);
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            content-spacing: 8px;

            if root.validation-message != "" : DialogInlineBanner {
                width: parent.width;
                tone: "error";
                message: root.validation-message;
            }

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    width: 108px;
                    label: "Save";
                    primary: true;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
