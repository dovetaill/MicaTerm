import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";
import { TitlebarTooltip } from "titlebar-tooltip.slint";
import { ModalBodyScrollArea, ModalFooterBar } from "modal-chrome.slint";

component ConflictDialogButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> destructive: false;
    out property <bool> has-focus: button-focus.has-focus;
    callback clicked();

    min-width: 104px;
    preferred-width: max(104px, label-metric.preferred-width + 34px);
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.has-focus ? ThemeTokens.focus-ring
        : root.destructive ? ThemeTokens.conflict-dialog-destructive-border
        : root.primary ? ThemeTokens.accent
        : ThemeTokens.divider-subtle;
    background: button-touch.pressed
        ? root.destructive ? ThemeTokens.conflict-dialog-destructive-hover-surface
            : root.primary ? ThemeTokens.conflict-dialog-recommended-hover-surface
            : ThemeTokens.control-pressed-surface
        : root.has-focus
            ? root.destructive ? ThemeTokens.conflict-dialog-destructive-surface
                : root.primary ? ThemeTokens.conflict-dialog-recommended-surface
                : ThemeTokens.control-hover-surface
            : button-touch.has-hover
                ? root.destructive ? ThemeTokens.conflict-dialog-destructive-hover-surface
                    : root.primary ? ThemeTokens.conflict-dialog-recommended-hover-surface
                    : ThemeTokens.control-hover-surface
                : root.destructive ? ThemeTokens.conflict-dialog-destructive-surface
                    : root.primary ? ThemeTokens.conflict-dialog-recommended-surface
                    : ThemeTokens.control-active-surface;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { button-touch.clicked(); }
    forward-focus: button-focus;

    public function focus-button() {
        button-focus.focus();
    }

    label-metric := Text {
        width: 0px;
        height: 0px;
        text: root.label;
        color: transparent;
        font-family: AppTypography.ui-font-family;
        font-size: 12px;
        font-weight: AppTypography.ui-font-weight-regular;
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.primary ? ThemeTokens.danger-fg : ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: AppTypography.ui-font-family;
        font-size: 12px;
        font-weight: AppTypography.ui-font-weight-regular;
    }

    button-touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    button-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.visible;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                button-touch.clicked();
                accept
            } else {
                reject
            }
        }
    }
}

component ConflictIconButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> action-label: "";
    in property <string> tooltip-text: "";
    in property <string> tooltip-source-id: "";
    out property <bool> has-hover: button-touch.has-hover;
    out property <bool> has-focus: button-focus.has-focus;
    out property <bool> tooltip-active: (root.has-hover || root.has-focus) && root.tooltip-text != "";
    callback clicked();
    callback tooltip-open-requested(string, string, length, length, length);
    callback tooltip-close-requested(string);

    border-radius: 10px;
    border-width: 1px;
    border-color: root.has-focus ? ThemeTokens.focus-ring
        : root.has-hover ? ThemeTokens.divider-strong
        : ThemeTokens.divider-subtle;
    background: button-touch.pressed ? ThemeTokens.control-pressed-surface
        : root.has-focus ? ThemeTokens.control-hover-surface
        : button-touch.has-hover ? ThemeTokens.control-hover-surface
        : transparent;
    accessible-role: AccessibleRole.button;
    accessible-label: root.action-label;
    accessible-action-default => { button-touch.clicked(); }
    forward-focus: button-focus;

    if (root.icon-source.width > 0 && root.icon-source.height > 0) : Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source <=> root.icon-source;
        image-fit: contain;
        colorize: root.has-hover || root.has-focus ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
    }

    changed tooltip-active => {
        if self.tooltip-active {
            root.tooltip-open-requested(
                root.tooltip-source-id,
                root.tooltip-text,
                self.absolute-position.x + self.width / 2,
                self.absolute-position.y + self.height + 8px,
                self.width,
            );
        } else {
            root.tooltip-close-requested(root.tooltip-source-id);
        }
    }

    button-touch := TouchArea {
        clicked => {
            root.tooltip-close-requested(root.tooltip-source-id);
            root.clicked();
        }
    }

    button-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.visible;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                button-touch.clicked();
                accept
            } else {
                reject
            }
        }
    }
}

component ConflictInfoCard inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";

    height: max(64px, path-value.preferred-height + 34px);
    border-radius: 12px;
    border-width: 1px;
    border-color: ThemeTokens.conflict-dialog-section-border;
    background: ThemeTokens.conflict-dialog-path-surface;
    clip: true;

    Text {
        x: 14px;
        y: 10px;
        width: parent.width - 28px;
        text: root.label;
        color: ThemeTokens.text-muted;
        font-family: AppTypography.ui-font-family;
        font-size: 11px;
        font-weight: AppTypography.ui-font-weight-regular;
        overflow: elide;
    }

    path-value := Text {
        x: 14px;
        y: 29px;
        width: parent.width - 28px;
        text: root.value;
        color: ThemeTokens.text-primary;
        font-family: AppTypography.ui-font-family;
        font-size: 12px;
        font-weight: AppTypography.ui-font-weight-regular;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ConflictBatchToggleRow inherits Rectangle {
    in property <string> label: "";
    in property <bool> checked: false;
    out property <bool> has-hover: toggle-touch.has-hover;
    out property <bool> has-focus: toggle-focus.has-focus;
    callback toggled(bool);

    border-radius: 10px;
    border-width: 1px;
    border-color: root.has-focus ? ThemeTokens.focus-ring
        : root.has-hover ? ThemeTokens.divider-strong
        : ThemeTokens.conflict-dialog-section-border;
    background: toggle-touch.pressed ? ThemeTokens.control-pressed-surface
        : root.has-focus ? ThemeTokens.control-hover-surface
        : root.has-hover ? ThemeTokens.control-hover-surface
        : ThemeTokens.conflict-dialog-path-surface;
    accessible-role: AccessibleRole.checkbox;
    accessible-checkable: true;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { toggle-touch.clicked(); }
    forward-focus: toggle-focus;

    checkbox := Rectangle {
        x: 12px;
        y: 11px;
        width: 18px;
        height: 18px;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.checked ? ThemeTokens.accent
            : root.has-focus ? ThemeTokens.focus-ring
            : ThemeTokens.divider-strong;
        background: root.checked ? ThemeTokens.accent : transparent;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.checked ? "✓" : "";
            color: ThemeTokens.danger-fg;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: AppTypography.ui-font-family;
            font-size: 12px;
            font-weight: AppTypography.ui-font-weight-regular;
        }
    }

    Text {
        x: 40px;
        y: 10px;
        width: parent.width - 52px;
        text: root.label;
        color: ThemeTokens.text-primary;
        font-family: AppTypography.ui-font-family;
        font-size: 12px;
        font-weight: AppTypography.ui-font-weight-regular;
        wrap: word-wrap;
    }

    toggle-touch := TouchArea {
        clicked => {
            root.toggled(!root.checked);
        }
    }

    toggle-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.visible;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                toggle-touch.clicked();
                accept
            } else {
                reject
            }
        }
    }
}

export component SftpConflictModal inherits Rectangle {
    in property <string> kind: "remote";
    in property <string> source-path: "";
    in property <string> target-path: "";
    in property <int> batch-conflict-count: 0;
    in property <bool> apply-to-batch: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback apply-to-batch-toggled(bool);
    callback replace-requested();
    callback skip-requested();
    callback auto-rename-requested();
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <image> close-icon: @image-url("../../assets/icons/fluent/dismiss-20-regular.svg");
    private property <length> header-height: 76px;
    private property <length> footer-height: 84px;
    private property <string> tooltip-text-value: "";
    private property <bool> tooltip-visible-value: false;
    private property <string> tooltip-source-id-value: "";
    private property <string> tooltip-close-source-id-value: "";
    private property <length> tooltip-anchor-x-value: 0px;
    private property <length> tooltip-anchor-y-value: 0px;
    private property <length> tooltip-anchor-width-value: 0px;

    function subtitle-copy() -> string {
        if root.kind == "download" {
            return "This affects the current download only.";
        }
        return "This affects the current transfer only.";
    }

    function lead-copy() -> string {
        if root.kind == "download" {
            return "A file with the same name already exists locally.";
        }
        return "An item with the same name already exists at the destination.";
    }

    function detail-copy() -> string {
        if root.kind == "download" {
            return "Choose how to continue this download.";
        }
        return "Choose how to continue this transfer.";
    }

    function batch-scope-copy() -> string {
        if root.batch-conflict-count == 1 {
            return "Auto Rename or Replace Existing can also be applied to the other conflict in this folder. Skip This Download always affects only this item.";
        }
        return "Auto Rename or Replace Existing can also be applied to the other " + root.batch-conflict-count + " conflicts in this folder. Skip This Download always affects only this item.";
    }

    function batch-toggle-copy() -> string {
        if root.batch-conflict-count == 1 {
            return "Apply the selected action to the other conflict in this folder.";
        }
        return "Apply the selected action to the other " + root.batch-conflict-count + " conflicts in this folder.";
    }

    function close-action-label() -> string {
        if root.kind == "download" {
            return "Skip this download";
        }
        return "Skip this transfer";
    }

    function schedule-tooltip(source-id: string, text: string, anchor-x: length, anchor-y: length, anchor-width: length) {
        root.tooltip-anchor-x-value = anchor-x;
        root.tooltip-anchor-y-value = anchor-y;
        root.tooltip-anchor-width-value = anchor-width;

        if root.tooltip-source-id-value == source-id && root.tooltip-text-value == text {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
        } else {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-source-id-value = source-id;
            root.tooltip-text-value = text;
            root.tooltip-visible-value = false;
            tooltip-delay.start();
        }
    }

    function queue-tooltip-close(source-id: string) {
        if root.tooltip-source-id-value == source-id && source-id != "" {
            root.tooltip-close-source-id-value = source-id;
            tooltip-close-delay.start();
        }
    }

    function close-tooltip(source-id: string) {
        if root.tooltip-source-id-value == source-id || source-id == "" {
            tooltip-close-delay.stop();
            root.tooltip-close-source-id-value = "";
            root.tooltip-visible-value = false;
            root.tooltip-text-value = "";
            root.tooltip-source-id-value = "";
            tooltip-delay.stop();
        }
    }

    background: transparent;

    close-tooltip-overlay := TitlebarTooltip {
        text: root.tooltip-text-value;
        anchor-x: root.tooltip-anchor-x-value;
        anchor-y: root.tooltip-anchor-y-value;
        anchor-width: root.tooltip-anchor-width-value;
        tooltip-visible: root.tooltip-visible-value;
        host-width: root.width;
        host-height: root.height;
        place-right: false;
    }

    public function focus-dialog() {
        if root.kind == "download" {
            auto-rename-button.focus-button();
        } else {
            replace-button.focus-button();
        }
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        header := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height;
            background: ThemeTokens.conflict-dialog-header-surface;

            Text {
                x: 22px;
                y: 14px;
                width: parent.width - 86px;
                text: "Resolve Transfer Conflict";
                color: ThemeTokens.text-primary;
                font-family: AppTypography.ui-font-family;
                font-size: 18px;
                font-weight: AppTypography.ui-font-weight-regular;
                overflow: elide;
            }

            Text {
                x: 22px;
                y: 40px;
                width: parent.width - 86px;
                text: root.subtitle-copy();
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: 11px;
                font-weight: AppTypography.ui-font-weight-regular;
                overflow: elide;
            }

            drag-touch := TouchArea {
                width: parent.width - 60px;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left
                    {
                        root.drag-requested(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.move {
                        root.drag-moved(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.up {
                        root.drag-ended();
                    }
                }
            }

            close-button := ConflictIconButton {
                x: parent.width - 46px;
                y: 18px;
                width: 28px;
                height: 28px;
                icon-source: root.close-icon;
                action-label: root.close-action-label();
                tooltip-text: root.close-action-label();
                tooltip-source-id: "sftp-conflict-close";

                clicked => {
                    root.focus-restore-requested();
                    root.close-requested();
                }

                tooltip-open-requested(source-id, text, anchor-x, anchor-y, anchor-width) => {
                    root.schedule-tooltip(source-id, text, anchor-x, anchor-y, anchor-width);
                }

                tooltip-close-requested(source-id) => {
                    root.queue-tooltip-close(source-id);
                }
            }

            divider := Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.conflict-dialog-section-border;
            }
        }

        body := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: 0px;
            content-padding-horizontal: 22px;
            content-padding-vertical: 18px;
            content-padding-bottom: 18px;
            content-spacing: 12px;
            viewport-surface: ThemeTokens.conflict-dialog-surface;
            panel-surface: ThemeTokens.conflict-dialog-surface;
            panel-border-color: transparent;

            Text {
                text: root.lead-copy();
                color: ThemeTokens.text-primary;
                font-family: AppTypography.ui-font-family;
                font-size: 14px;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            Text {
                text: root.detail-copy();
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: 12px;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            incoming-card := ConflictInfoCard {
                width: body.content-column-width;
                label: root.kind == "download" ? "Remote item" : "Incoming item";
                value: root.source-path;
            }

            target-card := ConflictInfoCard {
                width: body.content-column-width;
                label: root.kind == "download" ? "Local target" : "Existing target";
                value: root.target-path;
            }

            if root.batch-conflict-count > 0 : scope-card := Rectangle {
                width: body.content-column-width;
                height: 118px;
                border-radius: 12px;
                border-width: 1px;
                border-color: ThemeTokens.conflict-dialog-section-border;
                background: ThemeTokens.conflict-dialog-section-surface;
                clip: true;

                Text {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    text: "Folder scope";
                    color: ThemeTokens.text-muted;
                    font-family: AppTypography.ui-font-family;
                    font-size: 11px;
                    font-weight: AppTypography.ui-font-weight-regular;
                    overflow: elide;
                }

                Text {
                    x: 14px;
                    y: 30px;
                    width: parent.width - 28px;
                    text: root.batch-scope-copy();
                    color: ThemeTokens.text-primary;
                    font-family: AppTypography.ui-font-family;
                    font-size: 12px;
                    font-weight: AppTypography.ui-font-weight-regular;
                    wrap: word-wrap;
                }

                batch-toggle-row := ConflictBatchToggleRow {
                    x: 14px;
                    y: 68px;
                    width: parent.width - 28px;
                    height: 38px;
                    label: root.batch-toggle-copy();
                    checked: root.apply-to-batch;

                    toggled(value) => {
                        root.apply-to-batch-toggled(value);
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            surface: ThemeTokens.conflict-dialog-header-surface;
            divider-color: ThemeTokens.conflict-dialog-section-border;
            content-padding-left: 22px;
            content-padding-right: 22px;
            content-padding-top: 14px;
            content-padding-bottom: 14px;
            content-spacing: 0px;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            action-row := HorizontalLayout {
                height: 40px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                skip-button := ConflictDialogButton {
                    label: root.kind == "download" ? "Skip This Download" : "Skip";

                    clicked => {
                        root.focus-restore-requested();
                        root.skip-requested();
                    }
                }

                auto-rename-button := ConflictDialogButton {
                    label: "Auto Rename";
                    primary: true;
                    visible: root.kind == "download";

                    clicked => {
                        root.focus-restore-requested();
                        root.auto-rename-requested();
                    }
                }

                replace-button := ConflictDialogButton {
                    label: root.kind == "download" ? "Replace Existing" : "Replace Existing";
                    destructive: true;

                    clicked => {
                        root.focus-restore-requested();
                        root.replace-requested();
                    }
                }
            }
        }
    }

    changed focus-sequence => {
        root.focus-dialog();
    }

    tooltip-delay := Timer {
        interval: 280ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-text-value != "" {
                root.tooltip-visible-value = true;
            }
        }
    }

    tooltip-close-delay := Timer {
        interval: 80ms;
        running: false;

        triggered => {
            self.running = false;

            if root.tooltip-close-source-id-value != "" {
                root.close-tooltip(root.tooltip-close-source-id-value);
            }
        }
    }
}
