import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

export component AssetsContextMenuRow inherits Rectangle {
    in property <string> action-id;
    in property <string> label;
    in property <image> icon-source;
    in property <bool> enabled: true;
    in property <bool> planned: false;
    in property <bool> has-children: false;
    in property <bool> divider-before: false;
    in property <bool> visual-hover: false;
    in property <bool> submenu-open: false;
    out property <bool> has-hover: touch.has-hover;
    callback invoked(string);
    callback hovered();
    callback pointer-moved(length, length);

    height: 32px;
    background: touch.pressed
        ? ThemeTokens.menu-row-open-surface
        : root.submenu-open
            ? ThemeTokens.menu-row-open-surface
            : (root.visual-hover || touch.has-hover)
                ? ThemeTokens.menu-row-hover-surface
                : transparent;

    if root.divider-before : Rectangle {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 1px;
        background: ThemeTokens.divider-subtle;
    }

    icon-slot := Rectangle {
        x: 12px;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        background: transparent;
        opacity: root.enabled ? 1.0 : 0.54;

        Image {
            width: 20px;
            height: 20px;
            source <=> root.icon-source;
            image-fit: contain;
            colorize: ThemeTokens.text-primary;
        }
    }

    label-text := Text {
        x: 38px;
        y: 0px;
        width: parent.width - 62px;
        height: parent.height;
        text: root.label;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-body;
        font-weight: AppTypography.ui-font-weight-medium;
        letter-spacing: 0.08px;
        color: ThemeTokens.text-primary;
        opacity: root.enabled ? 1.0 : 0.54;
        vertical-alignment: center;
    }

    if root.has-children : Text {
        x: parent.width - self.width - 16px;
        y: 0px;
        width: 8px;
        height: parent.height;
        text: "›";
        color: ThemeTokens.text-primary;
        opacity: 0.68;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled || root.planned;

        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-moved(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }

        clicked => {
            root.invoked(root.action-id);
        }
    }

    changed has-hover => {
        if self.has-hover {
            root.hovered();
        }
    }
}
