// Inline search control used by the assets sidebar header.

import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

export component AssetsSearchPopover inherits Rectangle {
    in property <string> query: "";
    callback query-changed(string);
    callback collapse-requested();
    callback close-requested();

    width: 272px;
    height: 32px;
    border-radius: 10px;
    background: transparent;
    z: 100;

    public function focus-input() {
        search-input.focus();
    }

    glow-frame := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: 10px;
        border-width: 1px;
        border-color: ThemeTokens.input-focus-ring;
        opacity: search-input.has-focus ? (ThemeTokens.dark-mode ? 0.34 : 0.28) : 0;
        background: transparent;
    }

    field-frame := Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 10px;
        border-width: 1px;
        border-color: search-input.has-focus ? ThemeTokens.input-focus-ring : ThemeTokens.input-border;
        background: ThemeTokens.input-surface;

        search-input := TextInput {
            x: 10px;
            y: 4px;
            width: parent.width - 20px;
            height: 24px;
            font-family: AppTypography.ui-font-family;
            font-size: AppTypography.ui-font-size-body;
            font-weight: AppTypography.ui-font-weight-regular;
            text: root.query;
            color: root.query == "" ? ThemeTokens.text-muted : ThemeTokens.text-primary;
            selection-background-color: ThemeTokens.focus-ring;
            selection-foreground-color: ThemeTokens.text-primary;

            changed has-focus => {
                if !self.has-focus {
                    root.collapse-requested();
                }
            }

            edited => {
                root.query-changed(self.text);
            }

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-requested();
                    accept
                } else {
                    reject
                }
            }
        }
    }
}
