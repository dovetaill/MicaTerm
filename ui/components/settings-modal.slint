import { ModalHeaderBar } from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

export component SettingsModal inherits Rectangle {
    callback close-requested();
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    in property <int> terminal-scrollback-limit: 1500;
    in property <bool> terminal-active-idle-shrink-enabled: true;
    in property <string> download-conflict-default: "ask";
    callback terminal-scrollback-limit-changed(int);
    callback terminal-active-idle-shrink-enabled-changed(bool);
    callback download-conflict-default-changed(string);

    background: ThemeTokens.assets-surface;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-subtle;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: "Settings";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := Rectangle {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height;
            background: ThemeTokens.inspector-surface;

            title-copy := Text {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                text: "Terminal settings";
                color: ThemeTokens.text-primary;
                font-size: 16px;
                font-weight: AppTypography.ui-font-weight-regular;
            }

            subtitle-copy := Text {
                x: 20px;
                y: 48px;
                width: parent.width - 40px;
                text: "Scrollback and memory controls are configured here.";
                color: ThemeTokens.text-primary;
                opacity: 0.74;
                wrap: word-wrap;
            }

            scrollback-label := Text {
                x: 20px;
                y: 96px;
                width: parent.width - 40px;
                text: "Scrollback limit";
                color: ThemeTokens.text-primary;
                opacity: 0.82;
            }

            scrollback-value := Text {
                x: 20px;
                y: 124px;
                width: parent.width - 40px;
                text: root.terminal-scrollback-limit + " lines";
                color: ThemeTokens.text-primary;
                font-size: 16px;
                font-weight: AppTypography.ui-font-weight-regular;
            }

            scrollback-dec := Rectangle {
                x: 20px;
                y: 156px;
                width: 120px;
                height: 32px;
                border-radius: 6px;
                background: ThemeTokens.control-hover-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "-500";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.terminal-scrollback-limit-changed(
                            root.terminal-scrollback-limit > 500
                                ? root.terminal-scrollback-limit - 500
                                : 1
                        );
                    }
                }
            }

            scrollback-inc := Rectangle {
                x: 152px;
                y: 156px;
                width: 120px;
                height: 32px;
                border-radius: 6px;
                background: ThemeTokens.control-hover-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "+500";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.terminal-scrollback-limit-changed(root.terminal-scrollback-limit + 500);
                    }
                }
            }

            idle-label := Text {
                x: 20px;
                y: 208px;
                width: parent.width - 40px;
                text: "Active idle cache shrink";
                color: ThemeTokens.text-primary;
                opacity: 0.82;
            }

            idle-toggle := Rectangle {
                x: 20px;
                y: 236px;
                width: 252px;
                height: 32px;
                border-radius: 6px;
                background: ThemeTokens.control-hover-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.terminal-active-idle-shrink-enabled ? "Enabled" : "Disabled";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.terminal-active-idle-shrink-enabled-changed(
                            !root.terminal-active-idle-shrink-enabled
                        );
                    }
                }
            }

            download-conflict-label := Text {
                x: 20px;
                y: 288px;
                width: parent.width - 40px;
                text: "Download conflict default";
                color: ThemeTokens.text-primary;
                opacity: 0.82;
            }

            download-conflict-toggle := Rectangle {
                x: 20px;
                y: 316px;
                width: parent.width - 40px;
                height: 32px;
                border-radius: 6px;
                background: ThemeTokens.control-hover-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.download-conflict-default == "ask" ? "Ask every time" : root.download-conflict-default == "overwrite" ? "Overwrite existing files" : "Auto rename downloads";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.download-conflict-default-changed(
                            root.download-conflict-default == "ask"
                                ? "overwrite"
                                : root.download-conflict-default == "overwrite"
                                    ? "auto-rename"
                                    : "ask"
                        );
                    }
                }
            }
        }
    }
}
