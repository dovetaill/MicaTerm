import {
    DialogActionButton,
    DialogFormSection,
    DialogSegmentButton,
    ModalBodyScrollArea,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component SettingsModal inherits Rectangle {
    callback close-requested();
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    in property <string> theme-variant: "premium_default";
    in property <int> terminal-scrollback-limit: 1500;
    in property <bool> terminal-active-idle-shrink-enabled: true;
    in property <bool> terminal-input-highlighting-enabled: true;
    in property <bool> terminal-output-rule-highlighting-enabled: true;
    in property <bool> terminal-command-decorations-enabled: true;
    in property <bool> terminal-overview-markers-enabled: false;
    in property <string> terminal-output-rule-profile: "focused";
    in property <string> terminal-search-match-highlight: "balanced";
    in property <string> download-conflict-default: "ask";
    callback terminal-scrollback-limit-changed(int);
    callback terminal-active-idle-shrink-enabled-changed(bool);
    callback terminal-input-highlighting-enabled-changed(bool);
    callback terminal-output-rule-highlighting-enabled-changed(bool);
    callback terminal-command-decorations-enabled-changed(bool);
    callback terminal-overview-markers-enabled-changed(bool);
    callback terminal-output-rule-profile-changed(string);
    callback terminal-search-match-highlight-changed(string);
    callback theme-variant-changed(string);
    callback download-conflict-default-changed(string);

    background: transparent;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: "Settings";
            subtitle: "Adjust terminal history, readability cues, memory, and conflict defaults.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: 14px;
            content-padding-horizontal: 18px;
            content-padding-vertical: 16px;
            content-spacing: 14px;
            viewport-surface: ThemeTokens.modal-body-surface;
            panel-surface: ThemeTokens.modal-body-surface;
            panel-border-color: transparent;

            content-column := Rectangle {
                width: body.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body.content-spacing;

                    DialogFormSection {
                        width: parent.width;
                        title: "Theme preset";
                        description: "Choose the default terminal personality without turning the whole app into a theme editor.";

                        Text {
                            width: parent.width;
                            text: root.theme-variant == "legacy_hacker_green"
                                ? "Legacy Hacker Green keeps the calm shell chrome but swaps the terminal into a nostalgic green phosphor palette."
                                : "Premium Default uses Ayu Dark and Ayu Light with restrained terminal chrome tuned for long sessions.";
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Premium Default";
                                active: root.theme-variant == "premium_default";

                                clicked => {
                                    root.theme-variant-changed("premium_default");
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Legacy Green";
                                active: root.theme-variant == "legacy_hacker_green";

                                clicked => {
                                    root.theme-variant-changed("legacy_hacker_green");
                                }
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Terminal history";
                        description: "Adjust how much output each live terminal keeps before older lines are trimmed.";

                        Text {
                            width: parent.width;
                            text: root.terminal-scrollback-limit + " lines";
                            color: ThemeTokens.text-primary;
                            font-size: 22px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            width: parent.width;
                            text: "Adjust how much history stays attached to each live terminal session before the shell trims older output.";
                            color: ThemeTokens.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogActionButton {
                                horizontal-stretch: 1;
                                label: "-500";

                                clicked => {
                                    root.terminal-scrollback-limit-changed(
                                        root.terminal-scrollback-limit > 500
                                            ? root.terminal-scrollback-limit - 500
                                            : 1
                                    );
                                }
                            }

                            DialogActionButton {
                                horizontal-stretch: 1;
                                label: "+500";
                                primary: true;

                                clicked => {
                                    root.terminal-scrollback-limit-changed(root.terminal-scrollback-limit + 500);
                                }
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Memory behavior";
                        description: "Control whether long-running idle tabs release memory more aggressively.";

                        Text {
                            width: parent.width;
                            text: root.terminal-active-idle-shrink-enabled
                                ? "Active idle cache shrink is enabled."
                                : "Active idle cache shrink is disabled.";
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }

                        Text {
                            width: parent.width;
                            text: "Keep this on when you want long-running tabs to free memory more aggressively while they sit idle.";
                            color: ThemeTokens.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Enabled";
                                active: root.terminal-active-idle-shrink-enabled;

                                clicked => {
                                    root.terminal-active-idle-shrink-enabled-changed(true);
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Disabled";
                                active: !root.terminal-active-idle-shrink-enabled;

                                clicked => {
                                    root.terminal-active-idle-shrink-enabled-changed(false);
                                }
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Terminal readability";
                        description: "Keep shell prompts, high-value output cues, and command status markers easy to scan without turning the terminal into a log viewer.";

                        Text {
                            width: parent.width;
                            text: root.terminal-input-highlighting-enabled
                                ? "Input highlighting is enabled."
                                : "Input highlighting is disabled.";
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Input On";
                                active: root.terminal-input-highlighting-enabled;

                                clicked => {
                                    root.terminal-input-highlighting-enabled-changed(true);
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Input Off";
                                active: !root.terminal-input-highlighting-enabled;

                                clicked => {
                                    root.terminal-input-highlighting-enabled-changed(false);
                                }
                            }
                        }

                        Text {
                            width: parent.width;
                            text: root.terminal-output-rule-highlighting-enabled
                                ? "Output rule cues are enabled."
                                : "Output rule cues are disabled.";
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Output On";
                                active: root.terminal-output-rule-highlighting-enabled;

                                clicked => {
                                    root.terminal-output-rule-highlighting-enabled-changed(true);
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Output Off";
                                active: !root.terminal-output-rule-highlighting-enabled;

                                clicked => {
                                    root.terminal-output-rule-highlighting-enabled-changed(false);
                                }
                            }
                        }

                        Text {
                            width: parent.width;
                            text: root.terminal-command-decorations-enabled
                                ? "Command status markers are enabled."
                                : "Command status markers are disabled.";
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Status On";
                                active: root.terminal-command-decorations-enabled;

                                clicked => {
                                    root.terminal-command-decorations-enabled-changed(true);
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Status Off";
                                active: !root.terminal-command-decorations-enabled;

                                clicked => {
                                    root.terminal-command-decorations-enabled-changed(false);
                                }
                            }
                        }

                        Text {
                            width: parent.width;
                            text: root.terminal-overview-markers-enabled
                                ? "Overview ruler markers are enabled."
                                : "Overview ruler markers are disabled.";
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Ruler On";
                                active: root.terminal-overview-markers-enabled;

                                clicked => {
                                    root.terminal-overview-markers-enabled-changed(true);
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Ruler Off";
                                active: !root.terminal-overview-markers-enabled;

                                clicked => {
                                    root.terminal-overview-markers-enabled-changed(false);
                                }
                            }
                        }

                        Text {
                            width: parent.width;
                            text: root.terminal-output-rule-profile == "focused"
                                ? "Focused output cues favor failures, links, paths, and diffs."
                                : "Balanced output cues keep the full calm default rule set.";
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Balanced";
                                active: root.terminal-output-rule-profile == "default";

                                clicked => {
                                    root.terminal-output-rule-profile-changed("default");
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Focused";
                                active: root.terminal-output-rule-profile == "focused";

                                clicked => {
                                    root.terminal-output-rule-profile-changed("focused");
                                }
                            }
                        }

                        Text {
                            width: parent.width;
                            text: root.terminal-search-match-highlight == "strong"
                                ? "Search matches will stand out more strongly."
                                : root.terminal-search-match-highlight == "subtle"
                                ? "Search matches will stay especially soft."
                                : "Search matches will use the balanced default emphasis.";
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Subtle";
                                active: root.terminal-search-match-highlight == "subtle";

                                clicked => {
                                    root.terminal-search-match-highlight-changed("subtle");
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Balanced";
                                active: root.terminal-search-match-highlight == "balanced";

                                clicked => {
                                    root.terminal-search-match-highlight-changed("balanced");
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Strong";
                                active: root.terminal-search-match-highlight == "strong";

                                clicked => {
                                    root.terminal-search-match-highlight-changed("strong");
                                }
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Download conflicts";
                        description: "Choose the default policy before the transfer center or resolve dialog needs to intervene.";

                        Text {
                            width: parent.width;
                            text: "Choose the default conflict policy before the transfer center or resolve dialog needs to intervene.";
                            color: ThemeTokens.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 34px;
                            spacing: 8px;

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Ask";
                                active: root.download-conflict-default == "ask";

                                clicked => {
                                    root.download-conflict-default-changed("ask");
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Overwrite";
                                active: root.download-conflict-default == "overwrite";

                                clicked => {
                                    root.download-conflict-default-changed("overwrite");
                                }
                            }

                            DialogSegmentButton {
                                horizontal-stretch: 1;
                                label: "Auto Rename";
                                active: root.download-conflict-default == "auto-rename";

                                clicked => {
                                    root.download-conflict-default-changed("auto-rename");
                                }
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - self.height;
            width: parent.width;
            height: ThemeTokens.modal-footer-min-height;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                done-button := DialogActionButton {
                    width: 108px;
                    label: "Done";
                    primary: true;

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }
            }
        }
    }
}
