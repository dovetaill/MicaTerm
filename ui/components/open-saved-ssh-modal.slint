import { ScrollView } from "std-widgets.slint";
import { DialogActionButton, ModalFooterBar, ModalHeaderBar } from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";
import { ConsoleAssetItem } from "../shell/assets-sidebar.slint";

component SavedSshPickerRow inherits Rectangle {
    in property <string> item-id;
    in property <string> item-kind;
    in property <string> label;
    in property <string> secondary-text: "";
    in property <int> depth: 0;
    in property <bool> has-children: false;
    in property <string> disclosure-state: "none";
    in property <bool> compact-flat-mode: false;
    in property <bool> expanded: false;
    in property <bool> selected: false;
    in property <bool> focused: false;
    callback clicked-requested(string);
    callback activated-requested(string);
    callback toggle-expanded-requested(string);
    callback became-selected();

    private property <bool> has-disclosure: root.disclosure-state != "none";
    private property <length> indent: root.compact-flat-mode ? 12px : 12px + (root.depth * 12px);
    private property <image> chevron-right-icon: @image-url("../../assets/icons/fluent/chevron-right-20-regular.svg");
    private property <image> chevron-down-icon: @image-url("../../assets/icons/fluent/chevron-down-20-regular.svg");
    private property <image> folder-icon: @image-url("../../assets/icons/fluent/folder-20-regular.svg");
    private property <image> folder-open-icon: @image-url("../../assets/icons/fluent/folder-open-20-regular.svg");
    private property <image> ssh-icon: @image-url("../../assets/icons/new-tab/server-stack.svg");
    private property <image> disclosure-icon: root.disclosure-state == "expanded"
        ? root.chevron-down-icon
        : root.chevron-right-icon;
    private property <image> kind-icon: root.item-kind == "folder"
        ? (root.expanded ? root.folder-open-icon : root.folder-icon)
        : root.ssh-icon;

    height: 54px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.focused
        ? ThemeTokens.focus-ring
        : row-touch.has-hover || root.selected
            ? ThemeTokens.modal-field-hover-border
            : ThemeTokens.modal-field-border;
    background: row-touch.pressed
        ? ThemeTokens.control-pressed-surface
        : root.selected
            ? ThemeTokens.control-active-surface
            : row-touch.has-hover
                ? ThemeTokens.control-hover-surface
                : ThemeTokens.modal-field-surface;

    Rectangle {
        x: root.indent;
        y: 0px;
        width: 16px;
        height: parent.height;
        background: transparent;

        if root.has-disclosure : Image {
            x: 0px;
            y: 19px;
            width: 14px;
            height: 14px;
            source: root.disclosure-icon;
            image-fit: contain;
            colorize: root.selected ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
            opacity: row-touch.has-hover || root.selected ? 1 : 0.76;
        }

        disclosure-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.has-disclosure;

            clicked => {
                root.toggle-expanded-requested(root.item-id);
            }
        }
    }

    icon-shell := Rectangle {
        x: root.indent + (root.has-disclosure ? 16px : 0px);
        y: 11px;
        width: 30px;
        height: 30px;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.selected ? ThemeTokens.focus-ring : ThemeTokens.modal-inner-border;
        background: root.selected ? ThemeTokens.control-hover-surface : ThemeTokens.modal-section-surface;

        Image {
            x: 7px;
            y: 7px;
            width: 16px;
            height: 16px;
            source: root.kind-icon;
            image-fit: contain;
            colorize: root.selected ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
        }
    }

    Text {
        x: icon-shell.x + icon-shell.width + 12px;
        y: root.secondary-text == "" ? 0px : 8px;
        width: parent.width - self.x - 18px;
        height: root.secondary-text == "" ? parent.height : 18px;
        text: root.label;
        color: ThemeTokens.text-primary;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-body;
        font-weight: root.selected ? 700 : AppTypography.ui-font-weight-regular;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.secondary-text != "" : Text {
        x: icon-shell.x + icon-shell.width + 12px;
        y: 27px;
        width: parent.width - self.x - 18px;
        height: 16px;
        text: root.secondary-text;
        color: ThemeTokens.text-secondary;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-caption;
        font-weight: AppTypography.ui-font-weight-regular;
        vertical-alignment: center;
        overflow: elide;
    }

    row-touch := TouchArea {
        x: root.indent + (root.has-disclosure ? 16px : 0px);
        width: parent.width - self.x;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;

        clicked => {
            root.clicked-requested(root.item-id);
        }

        double-clicked => {
            root.activated-requested(root.item-id);
        }
    }

    changed selected => {
        if root.selected {
            root.became-selected();
        }
    }
}

export component OpenSavedSshModal inherits Rectangle {
    in property <string> query: "";
    in property <[ConsoleAssetItem]> items: [];
    in property <bool> can-open-selection: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback query-changed(string);
    callback asset-selected(string);
    callback asset-activated(string);
    callback activate-selection-requested();
    callback move-selection-requested(int);
    callback toggle-expanded-requested(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();

    private property <image> search-icon: @image-url("../../assets/icons/fluent/search-20-regular.svg");
    private property <string> armed-activation-item-id: "";
    private property <length> list-row-height: 54px;
    private property <length> list-content-padding: 10px;
    private property <length> list-viewport-y: 0px;
    private property <length> list-visible-height: 0px;

    background: ThemeTokens.modal-body-surface;
    border-radius: 0px;
    border-width: 0px;
    border-color: transparent;

    public function focus-query() {
        search-input.focus();
    }

    public function clear-armed-activation() {
        root.armed-activation-item-id = "";
        activation-click-guard.running = false;
    }

    public function arm-activation(item-id: string) {
        root.armed-activation-item-id = item-id;
        activation-click-guard.restart();
    }

    public function ensure-item-visible(index: int) {
        if index < 0 {
            return;
        }

        let row-top = root.list-content-padding + (index * root.list-row-height);
        let row-bottom = row-top + root.list-row-height;
        if row-top < root.list-viewport-y {
            root.list-viewport-y = max(0px, row-top - 6px);
        } else if row-bottom > root.list-viewport-y + root.list-visible-height {
            root.list-viewport-y = max(
                0px,
                row-bottom - root.list-visible-height + 6px,
            );
        }
    }

    changed focus-sequence => {
        focus-query-timer.restart();
    }

    init => {
        focus-query-timer.restart();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: "Browse Saved SSH";
            subtitle: "Search and open a saved host without leaving New Tab.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := Rectangle {
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            background: ThemeTokens.modal-body-surface;

            search-panel := Rectangle {
                x: 18px;
                y: 16px;
                width: parent.width - 36px;
                height: 78px;
                border-radius: 14px;
                border-width: 1px;
                border-color: ThemeTokens.modal-inner-border;
                background: ThemeTokens.modal-section-surface;

                Text {
                    x: 16px;
                    y: 10px;
                    text: "Search saved hosts";
                    color: ThemeTokens.text-secondary;
                    font-family: AppTypography.ui-font-family;
                    font-size: AppTypography.ui-font-size-caption;
                    font-weight: AppTypography.ui-font-weight-regular;
                }

                search-shell := Rectangle {
                    x: 16px;
                    y: 32px;
                    width: parent.width - 32px;
                    height: 34px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: search-input.has-focus
                        ? ThemeTokens.input-focus-ring
                        : search-touch.has-hover
                            ? ThemeTokens.modal-field-hover-border
                            : ThemeTokens.modal-field-border;
                    background: ThemeTokens.modal-field-surface;

                    Image {
                        x: 10px;
                        y: 8px;
                        width: 18px;
                        height: 18px;
                        source: root.search-icon;
                        image-fit: contain;
                        colorize: ThemeTokens.text-secondary;
                    }

                    if search-input.text == "" : placeholder := Text {
                        x: 36px;
                        y: 0px;
                        width: parent.width - 46px;
                        height: parent.height;
                        text: "Search by name, user, or host";
                        color: ThemeTokens.text-muted;
                        font-family: AppTypography.ui-font-family;
                        font-size: AppTypography.ui-font-size-body;
                        font-weight: AppTypography.ui-font-weight-regular;
                        vertical-alignment: center;
                    }

                    search-input := TextInput {
                        x: 36px;
                        y: 5px;
                        width: parent.width - 46px;
                        height: 24px;
                        text: root.query;
                        color: ThemeTokens.text-primary;
                        font-family: AppTypography.ui-font-family;
                        font-size: AppTypography.ui-font-size-body;
                        font-weight: AppTypography.ui-font-weight-regular;
                        selection-background-color: ThemeTokens.accent;
                        selection-foreground-color: ThemeTokens.text-primary;

                        edited => {
                            root.clear-armed-activation();
                            root.query-changed(self.text);
                        }

                        key-pressed(event) => {
                            if event.text == Key.DownArrow {
                                root.clear-armed-activation();
                                root.move-selection-requested(1);
                                accept
                            } else if event.text == Key.UpArrow {
                                root.clear-armed-activation();
                                root.move-selection-requested(-1);
                                accept
                            } else if event.text == Key.Escape {
                                root.clear-armed-activation();
                                if root.query != "" {
                                    root.query-changed("");
                                } else {
                                    root.focus-restore-requested();
                                    root.close-requested();
                                }
                                accept
                            } else if (event.text == Key.Return || event.text == "\n")
                                && root.items.length > 0
                            {
                                root.clear-armed-activation();
                                root.activate-selection-requested();
                                accept
                            } else {
                                reject
                            }
                        }
                    }

                    search-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: MouseCursor.text;

                        clicked => {
                            root.focus-query();
                        }
                    }
                }
            }

            list-shell := Rectangle {
                x: 18px;
                y: search-panel.y + search-panel.height + 14px;
                width: parent.width - 36px;
                height: parent.height - self.y - 18px;
                border-radius: 14px;
                border-width: 1px;
                border-color: ThemeTokens.modal-inner-border;
                background: ThemeTokens.modal-section-surface;

                if root.items.length == 0 : Rectangle {
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: parent.height - 32px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: ThemeTokens.modal-field-border;
                    background: ThemeTokens.modal-field-surface;

                    Text {
                        x: 20px;
                        y: 0px;
                        width: parent.width - 40px;
                        height: parent.height;
                        text: root.query == ""
                            ? "No saved SSH targets yet. Add one from Assets and it will appear here."
                            : "No saved SSH targets match this search.";
                        color: ThemeTokens.text-secondary;
                        font-family: AppTypography.ui-font-family;
                        font-size: AppTypography.ui-font-size-body;
                        font-weight: AppTypography.ui-font-weight-regular;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.items.length > 0 : list-scroll := ScrollView {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    viewport-width: scroll-body.width;
                    viewport-height: scroll-body.height;
                    mouse-drag-pan-enabled: false;
                    horizontal-scrollbar-policy: always-off;
                    viewport-y <=> root.list-viewport-y;

                    changed visible-height => {
                        root.list-visible-height = self.visible-height;
                    }

                    init => {
                        root.list-visible-height = self.visible-height;
                    }

                    scroll-body := Rectangle {
                        width: list-scroll.visible-width;
                        height: max(
                            list-scroll.visible-height,
                            root.list-content-padding
                                + root.list-content-padding
                                + (root.items.length * root.list-row-height),
                        );
                        background: transparent;

                        for item[index] in root.items : SavedSshPickerRow {
                            x: 0px;
                            y: root.list-content-padding + (index * root.list-row-height);
                            width: scroll-body.width;
                            height: root.list-row-height;
                            item-id: item.id;
                            item-kind: item.kind;
                            label: item.label;
                            secondary-text: item.path_hint;
                            depth: item.depth;
                            has-children: item.has_children;
                            expanded: item.expanded;
                            selected: item.selected;
                            focused: item.focused;
                            disclosure-state: item.disclosure_state;
                            compact-flat-mode: item.compact_flat_mode;

                            clicked-requested(item-id) => {
                                if root.armed-activation-item-id == item-id {
                                    root.clear-armed-activation();
                                    root.asset-activated(item-id);
                                } else {
                                    root.arm-activation(item-id);
                                    root.asset-selected(item-id);
                                    root.focus-query();
                                }
                            }

                            activated-requested(item-id) => {
                                root.clear-armed-activation();
                                root.asset-activated(item-id);
                            }

                            toggle-expanded-requested(item-id) => {
                                root.clear-armed-activation();
                                root.toggle-expanded-requested(item-id);
                                root.focus-query();
                            }

                            became-selected => {
                                root.ensure-item-visible(index);
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            y: parent.height - self.height;
            width: parent.width;
            height: 54px;
            surface: ThemeTokens.modal-footer-surface;
            divider-color: ThemeTokens.modal-inner-border;
            content-padding-left: 18px;
            content-padding-right: 18px;
            content-padding-top: 8px;
            content-padding-bottom: 8px;
            content-spacing: 0px;

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Text {
                    vertical-alignment: center;
                    text: root.can-open-selection
                        ? "Up/Down selects, Enter opens the highlighted SSH."
                        : "Search or browse, then use Up/Down to choose a saved SSH.";
                    color: ThemeTokens.text-secondary;
                    font-family: AppTypography.ui-font-family;
                    font-size: AppTypography.ui-font-size-caption;
                    font-weight: AppTypography.ui-font-weight-regular;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    label: "Close";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    label: "Open";
                    primary: true;
                    enabled: root.can-open-selection;

                    clicked => {
                        root.activate-selection-requested();
                    }
                }
            }
        }
    }

    activation-click-guard := Timer {
        interval: 320ms;
        running: false;

        triggered => {
            root.clear-armed-activation();
        }
    }

    focus-query-timer := Timer {
        interval: 1ms;
        running: false;

        triggered => {
            self.running = false;
            root.focus-query();
        }
    }
}
