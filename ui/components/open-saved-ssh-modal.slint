import { ListView } from "std-widgets.slint";
import { ModalFooterBar, ModalHeaderBar } from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AssetNodeRow } from "./asset-node-row.slint";
import { ConsoleAssetItem } from "../shell/assets-sidebar.slint";

component DialogActionButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    width: 96px;
    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-subtle;
    background: action-touch.pressed
        ? ThemeTokens.control-pressed-surface
        : action-touch.has-hover
            ? ThemeTokens.control-hover-surface
            : ThemeTokens.control-active-surface;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    action-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

export component OpenSavedSshModal inherits Rectangle {
    in property <string> query: "";
    in property <[ConsoleAssetItem]> items: [];
    callback close-requested();
    callback query-changed(string);
    callback asset-selected(string);
    callback asset-activated(string);
    callback toggle-expanded-requested(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();

    background: ThemeTokens.assets-surface;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-subtle;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: "Open Saved SSH Connections";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := Rectangle {
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            background: transparent;

            search-shell := Rectangle {
                x: 18px;
                y: 16px;
                width: parent.width - 36px;
                height: 40px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.inspector-surface;

                TextInput {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    height: 24px;
                    text: root.query;
                    color: ThemeTokens.text-primary;
                    selection-background-color: ThemeTokens.accent;
                    selection-foreground-color: ThemeTokens.text-primary;

                    edited => {
                        root.query-changed(self.text);
                    }
                }
            }

            if root.items.length == 0 : Rectangle {
                x: 18px;
                y: 68px;
                width: parent.width - 36px;
                height: parent.height - 84px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.inspector-surface;

                Text {
                    x: 16px;
                    y: 0px;
                    width: parent.width - 32px;
                    height: parent.height;
                    text: "No saved SSH connections match this query.";
                    color: ThemeTokens.text-primary;
                    opacity: 0.6;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.items.length > 0 : list-shell := Rectangle {
                x: 18px;
                y: 68px;
                width: parent.width - 36px;
                height: parent.height - 84px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.inspector-surface;

                list-host := ListView {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;

                    for item in root.items : AssetNodeRow {
                        width: list-host.width;
                        item-id: item.id;
                        item-kind: item.kind;
                        label: item.label;
                        depth: item.depth;
                        has-children: item.has_children;
                        expanded: item.expanded;
                        selected: item.selected;
                        focused: item.focused;
                        disclosure-state: item.disclosure_state;
                        path-hint: item.path_hint;
                        compact-flat-mode: item.compact_flat_mode;

                        selected-requested(item-id) => {
                            root.asset-selected(item-id);
                        }

                        activated-requested(item-id) => {
                            root.asset-activated(item-id);
                        }

                        toggle-expanded-requested(item-id) => {
                            root.toggle-expanded-requested(item-id);
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            y: parent.height - self.height;
            width: parent.width;
            height: 56px;
            surface: ThemeTokens.activity-surface;
            divider-color: ThemeTokens.divider-strong;
            content-padding-top: 11px;
            content-padding-bottom: 11px;
            content-spacing: 0px;

            HorizontalLayout {
                height: 34px;
                spacing: 12px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                cancel-button := DialogActionButton {
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }
            }
        }
    }
}
