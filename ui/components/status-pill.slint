import { AppTypography } from "../theme/typography.slint";
// Simple status badge used by placeholder shell panels.

import { ThemeTokens } from "../theme/tokens.slint";

export component StatusPill inherits Rectangle {
    in property <string> label: "Connected";

    width: 120px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: ThemeTokens.status-pill-border;
    background: ThemeTokens.status-pill-surface;

    Text {
        text: root.label;
        color: ThemeTokens.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        font-weight: AppTypography.ui-font-weight-regular;
    }
}
