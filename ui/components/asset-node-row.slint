import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

export component AssetNodeRow inherits Rectangle {
    in property <string> item-id;
    in property <string> item-kind;
    in property <string> label;
    in property <string> path-hint: "";
    in property <int> depth: 0;
    in property <bool> has-children: false;
    in property <string> disclosure-state: "none";
    in property <bool> compact-flat-mode: false;
    in property <bool> expanded: false;
    in property <bool> selected: false;
    in property <bool> focused: false;
    callback selected-requested(string);
    callback activated-requested(string);
    callback toggle-expanded-requested(string);
    callback pointer-activity-requested();
    callback context-menu-requested(string, string, length, length);

    private property <length> indent: root.compact-flat-mode ? 10px : 10px + (root.depth * 12px);
    private property <bool> has-disclosure: root.disclosure-state != "none";
    private property <length> disclosure-width: 14px;
    private property <length> icon-x: root.indent + root.disclosure-width;
    private property <length> content-x: root.icon-x + 22px;
    private property <length> body-touch-x: root.indent + root.disclosure-width;
    private property <length> hint-width: root.path-hint == "" ? 0px : 96px;
    private property <length> row-height: AppTypography.ui-sidebar-row-height;
    private property <image> chevron-right-icon: @image-url("../../assets/icons/fluent/chevron-right-20-regular.svg");
    private property <image> chevron-down-icon: @image-url("../../assets/icons/fluent/chevron-down-20-regular.svg");
    private property <image> folder-icon: @image-url("../../assets/icons/fluent/folder-20-regular.svg");
    private property <image> folder-open-icon: @image-url("../../assets/icons/fluent/folder-open-20-regular.svg");
    private property <image> snippet-package-icon: @image-url("../../assets/icons/fluent/folder-20-regular.svg");
    private property <image> snippet-package-open-icon: @image-url("../../assets/icons/fluent/folder-open-20-regular.svg");
    private property <image> snippet-icon: @image-url("../../assets/icons/fluent/document-code-16-regular.svg");
    private property <image> keychain-identity-icon: @image-url("../../assets/icons/fluent/key-multiple-20-regular.svg");
    private property <image> keychain-ssh-key-icon: @image-url("../../assets/icons/fluent/key-multiple-20-regular.svg");
    private property <image> ssh-icon: @image-url("../../assets/icons/fluent/window-console-20-regular.svg");
    private property <image> disclosure-icon: root.disclosure-state == "expanded"
        ? root.chevron-down-icon
        : root.chevron-right-icon;
    private property <image> kind-icon: root.item-kind == "folder"
        ? (root.expanded ? root.folder-open-icon : root.folder-icon)
        : root.item-kind == "snippet-package"
            ? (root.expanded ? root.snippet-package-open-icon : root.snippet-package-icon)
            : root.item-kind == "snippet"
                ? root.snippet-icon
                : root.item-kind == "identity"
                    ? root.keychain-identity-icon
                    : root.item-kind == "ssh-key"
                        ? root.keychain-ssh-key-icon
                        : root.ssh-icon;

    height: root.row-height;
    border-radius: 8px;
    border-width: root.focused ? 1px : 0px;
    border-color: root.focused ? ThemeTokens.focus-ring : transparent;
    background: touch.pressed
        ? ThemeTokens.sidebar-selected-surface
        : root.selected
            ? ThemeTokens.sidebar-selected-surface
            : touch.has-hover
                ? ThemeTokens.sidebar-hover-surface
                : transparent;

    Rectangle {
        x: root.indent;
        y: 0px;
        width: 14px;
        height: parent.height;
        background: transparent;

        if root.has-disclosure : Image {
            x: 0px;
            y: 7px;
            width: 12px;
            height: 12px;
            source: root.disclosure-icon;
            image-fit: contain;
            colorize: root.selected || touch.has-hover ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
            opacity: root.disclosure-state == "expanded" ? 0.96 : 0.72;
        }

        chevron-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.has-disclosure;

            clicked => {
                root.pointer-activity-requested();
                root.toggle-expanded-requested(root.item-id);
            }
        }
    }

    Image {
        x: root.icon-x;
        y: 4px;
        width: 16px;
        height: 16px;
        source: root.kind-icon;
        image-fit: contain;
        colorize: root.selected || touch.has-hover ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
    }

    Text {
        x: root.content-x;
        y: 0px;
        width: parent.width - self.x - root.hint-width - 12px;
        height: parent.height;
        text: root.label;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-caption;
        font-weight: AppTypography.ui-font-weight-regular;
        color: ThemeTokens.text-primary;
        vertical-alignment: center;
    }

    if root.path-hint != "" : Text {
        x: parent.width - root.hint-width - 12px;
        y: 0px;
        width: root.hint-width;
        height: parent.height;
        text: root.path-hint;
        font-family: AppTypography.ui-font-family;
        font-weight: AppTypography.ui-font-weight-regular;
        color: ThemeTokens.text-secondary;
        font-size: AppTypography.ui-font-size-caption;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    touch := TouchArea {
        x: root.body-touch-x;
        width: parent.width - self.x;
        height: parent.height;
        enabled: true;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.pointer-activity-requested();
                root.context-menu-requested(
                    root.item-id,
                    root.item-kind,
                    self.mouse-x + self.absolute-position.x,
                    self.mouse-y + self.absolute-position.y,
                );
            }
        }

        clicked => {
            root.pointer-activity-requested();
            root.selected-requested(root.item-id);
        }

        double-clicked => {
            root.pointer-activity-requested();
            root.activated-requested(root.item-id);
        }
    }
}
