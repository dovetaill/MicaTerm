import { ThemeTokens } from "../theme/tokens.slint";

export component AssetNodeRow inherits Rectangle {
    in property <string> item-id;
    in property <string> item-kind;
    in property <string> label;
    in property <string> path-hint: "";
    in property <int> depth: 0;
    in property <bool> has-children: false;
    in property <bool> show-disclosure: false;
    in property <bool> compact-flat-mode: false;
    in property <bool> expanded: false;
    in property <bool> selected: false;
    in property <bool> focused: false;
    in property <bool> renaming: false;
    in property <string> rename-text: "";
    callback selected-requested(string);
    callback toggle-expanded-requested(string);
    callback pointer-activity-requested();
    callback context-menu-requested(string, string, length, length);
    callback rename-text-changed(string, string);
    callback rename-commit-requested(string, string);
    callback rename-cancel-requested(string);

    private property <length> indent: root.compact-flat-mode ? 10px : 10px + (root.depth * 12px);
    private property <length> disclosure-width: root.show-disclosure ? 14px : 0px;
    private property <length> icon-x: root.indent + root.disclosure-width;
    private property <length> content-x: root.icon-x + 22px;
    private property <length> body-touch-x: root.show-disclosure ? root.indent + root.disclosure-width : 0px;
    private property <length> hint-width: root.path-hint == "" ? 0px : 96px;
    private property <length> row-height: 28px;
    private property <image> chevron-icon: @image-url("../../assets/icons/fluent/chevron-down-20-regular.svg");
    private property <image> folder-icon: @image-url("../../assets/icons/fluent/folder-20-regular.svg");
    private property <image> folder-open-icon: @image-url("../../assets/icons/fluent/folder-open-20-regular.svg");
    private property <image> ssh-icon: @image-url("../../assets/icons/fluent/window-console-20-regular.svg");
    private property <image> kind-icon: root.item-kind == "folder"
        ? (root.expanded ? root.folder-open-icon : root.folder-icon)
        : root.ssh-icon;

    height: root.row-height;
    border-radius: 0px;
    border-width: root.focused ? 1px : 0px;
    border-color: root.focused ? ThemeTokens.divider-strong : transparent;
    background: touch.pressed
        ? ThemeTokens.explorer-row-selected-surface
        : root.selected
            ? ThemeTokens.explorer-row-selected-surface
            : touch.has-hover
                ? ThemeTokens.explorer-row-hover-surface
                : transparent;

    if root.show-disclosure : Rectangle {
        x: root.indent;
        y: 0px;
        width: 14px;
        height: parent.height;
        background: transparent;

        Image {
            x: 0px;
            y: 7px;
            width: 12px;
            height: 12px;
            source: root.chevron-icon;
            image-fit: contain;
            colorize: ThemeTokens.text-primary;
            opacity: root.expanded ? 1.0 : 0.72;
        }

        chevron-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: !root.renaming;

            clicked => {
                root.pointer-activity-requested();
                root.toggle-expanded-requested(root.item-id);
            }
        }
    }

    Image {
        x: root.icon-x;
        y: 4px;
        width: 16px;
        height: 16px;
        source: root.kind-icon;
        image-fit: contain;
        colorize: ThemeTokens.text-primary;
    }

    if !root.renaming : Text {
        x: root.content-x;
        y: 0px;
        width: parent.width - self.x - root.hint-width - 12px;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        vertical-alignment: center;
    }

    if !root.renaming && root.path-hint != "" : Text {
        x: parent.width - root.hint-width - 12px;
        y: 0px;
        width: root.hint-width;
        height: parent.height;
        text: root.path-hint;
        color: ThemeTokens.text-primary;
        opacity: 0.62;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    rename-frame := Rectangle {
        width: parent.width;
        height: parent.height;
        visible: root.renaming;
        background: transparent;

        rename-input := TextInput {
            x: root.content-x - 4px;
            y: 3px;
            width: parent.width - self.x - 8px;
            height: parent.height - 6px;
            visible: root.renaming;
            enabled: root.renaming;
            text: root.rename-text;
            color: ThemeTokens.text-primary;
            selection-background-color: ThemeTokens.accent;
            selection-foreground-color: ThemeTokens.text-primary;

            edited => {
                root.rename-text-changed(root.item-id, self.text);
            }

            key-pressed(event) => {
                if (event.text == Key.Return) {
                    root.rename-commit-requested(root.item-id, self.text);
                    accept
                } else if (event.text == Key.Escape) {
                    root.rename-cancel-requested(root.item-id);
                    accept
                } else {
                    reject
                }
            }
        }
    }

    touch := TouchArea {
        x: root.body-touch-x;
        width: parent.width - self.x;
        height: parent.height;
        enabled: !root.renaming;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.pointer-activity-requested();
                root.context-menu-requested(
                    root.item-id,
                    root.item-kind,
                    self.mouse-x + self.absolute-position.x,
                    self.mouse-y + self.absolute-position.y,
                );
            }
        }

        clicked => {
            root.pointer-activity-requested();
            root.selected-requested(root.item-id);
        }
    }

    changed renaming => {
        if root.renaming {
            rename-input.focus();
        }
    }
}
