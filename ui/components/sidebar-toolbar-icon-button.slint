// Compact icon button used by the assets sidebar toolbar.

import { ThemeTokens } from "../theme/tokens.slint";

export component SidebarToolbarIconButton inherits Rectangle {
    in property <image> icon-source;
    in property <image> active-icon-source;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> tooltip-text;
    in property <string> tooltip-source-id;
    callback clicked;
    callback tooltip-open-requested(string, string, length, length, length);
    callback tooltip-close-requested(string);

    private property <image> displayed-icon: root.active
        && root.active-icon-source.width > 0
        && root.active-icon-source.height > 0
        ? root.active-icon-source
        : root.icon-source;
    out property <bool> has-hover: touch.has-hover;

    width: 28px;
    height: 28px;
    border-radius: 6px;
    border-width: root.active || root.has-hover ? 1px : 0px;
    border-color: root.active ? ThemeTokens.divider-strong : ThemeTokens.divider-subtle;
    background: !root.enabled
        ? transparent
        : touch.pressed
            ? ThemeTokens.control-pressed-surface
            : root.active
                ? ThemeTokens.control-active-surface
                : touch.has-hover
                    ? ThemeTokens.control-hover-surface
                : transparent;

    if (root.displayed-icon.width > 0 && root.displayed-icon.height > 0) : Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source <=> root.displayed-icon;
        image-fit: contain;
        colorize: root.active || touch.has-hover ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
    }

    changed has-hover => {
        if self.has-hover && root.tooltip-text != "" {
            root.tooltip-open-requested(
                root.tooltip-source-id,
                root.tooltip-text,
                self.absolute-position.x,
                self.absolute-position.y + self.height / 2,
                self.width,
            );
        } else {
            root.tooltip-close-requested(root.tooltip-source-id);
        }
    }

    touch := TouchArea {
        clicked => {
            if root.enabled {
                root.tooltip-close-requested(root.tooltip-source-id);
                root.clicked();
            }
        }
    }
}
