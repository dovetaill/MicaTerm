import { ThemeTokens } from "../theme/tokens.slint";

component DialogButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary && root.enabled ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: !root.enabled ? ThemeTokens.control-disabled-surface
        : button-touch.pressed ? ThemeTokens.control-pressed-surface
        : button-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.primary ? ThemeTokens.accent : ThemeTokens.control-active-surface;
    opacity: root.enabled ? 1.0 : 0.56;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;

        clicked => {
            root.clicked();
        }
    }
}

export component AssetsSnippetModal inherits Rectangle {
    in property <string> dialog-title: "New Snippet";
    in property <string> name: "";
    in property <string> script: "";
    in property <string> package: "";
    in property <string> validation-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback draft-changed(string, string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> header-height: 56px;
    private property <length> footer-height: root.validation-message == "" ? 84px : 108px;
    private property <length> body-height: max(0px, root.height - root.header-height - root.footer-height);

    background: transparent;

    public function focus-input() {
        name-input.focus();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else if (event.text == Key.Return) {
                if (root.can-confirm) {
                    root.confirm-requested();
                }
                accept
            } else {
                reject
            }
        }

        header := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height;
            background: ThemeTokens.assets-surface;

            Text {
                x: 20px;
                y: 0px;
                width: parent.width - 72px;
                height: parent.height;
                text: root.dialog-title;
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
            }

            drag-touch := TouchArea {
                width: parent.width - 48px;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left
                    {
                        root.drag-requested(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.move {
                        root.drag-moved(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.up {
                        root.drag-ended();
                    }
                }
            }

            close-button := Rectangle {
                x: parent.width - 40px;
                y: 12px;
                width: 28px;
                height: 28px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: close-touch.pressed ? ThemeTokens.control-pressed-surface
                    : close-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }
            }

            header-divider := Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }
        }

        body := Rectangle {
            x: 0px;
            y: root.header-height;
            width: parent.width;
            height: root.body-height;
            background: transparent;

            content := VerticalLayout {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                spacing: 14px;

                Rectangle {
                    width: parent.width;
                    height: 72px;
                    background: transparent;

                    Text {
                        text: "Name";
                        color: ThemeTokens.text-primary;
                        opacity: 0.78;
                    }

                    Rectangle {
                        y: 28px;
                        width: parent.width;
                        height: 40px;
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-subtle;
                        background: ThemeTokens.inspector-surface;

                        name-input := TextInput {
                            x: 12px;
                            y: 9px;
                            width: parent.width - 24px;
                            height: 22px;
                            text: root.name;
                            color: ThemeTokens.text-primary;
                            selection-background-color: ThemeTokens.accent;
                            selection-foreground-color: ThemeTokens.text-primary;

                            edited => {
                                root.draft-changed("name", self.text);
                            }
                        }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: 178px;
                    background: transparent;

                    Text {
                        text: "Script";
                        color: ThemeTokens.text-primary;
                        opacity: 0.78;
                    }

                    Rectangle {
                        y: 28px;
                        width: parent.width;
                        height: 146px;
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-subtle;
                        background: ThemeTokens.inspector-surface;

                        script-input := TextInput {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 24px;
                            height: parent.height - 16px;
                            text: root.script;
                            color: ThemeTokens.text-primary;
                            single-line: false;
                            selection-background-color: ThemeTokens.accent;
                            selection-foreground-color: ThemeTokens.text-primary;

                            edited => {
                                root.draft-changed("script", self.text);
                            }
                        }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: 72px;
                    background: transparent;

                    Text {
                        text: "Package";
                        color: ThemeTokens.text-primary;
                        opacity: 0.78;
                    }

                    Rectangle {
                        y: 28px;
                        width: parent.width;
                        height: 40px;
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: ThemeTokens.divider-subtle;
                        background: ThemeTokens.inspector-surface;

                        package-input := TextInput {
                            x: 12px;
                            y: 9px;
                            width: parent.width - 24px;
                            height: 22px;
                            text: root.package;
                            color: ThemeTokens.text-primary;
                            selection-background-color: ThemeTokens.accent;
                            selection-foreground-color: ThemeTokens.text-primary;

                            edited => {
                                root.draft-changed("package", self.text);
                            }
                        }
                    }
                }
            }
        }

        footer := Rectangle {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            background: ThemeTokens.assets-surface;

            footer-divider := Rectangle {
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }

            validation-copy := Text {
                x: 20px;
                y: 12px;
                width: parent.width - 40px;
                text: root.validation-message;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                visible: root.validation-message != "";
                wrap: word-wrap;
            }

            cancel-button := DialogButton {
                x: parent.width - 204px;
                y: parent.height - 50px;
                width: 88px;
                label: "Cancel";

                clicked => {
                    root.focus-restore-requested();
                    root.close-requested();
                }
            }

            confirm-button := DialogButton {
                x: parent.width - 104px;
                y: parent.height - 50px;
                width: 84px;
                label: "Create";
                primary: true;
                enabled: root.can-confirm;

                clicked => {
                    root.confirm-requested();
                }
            }
        }
    }
}
