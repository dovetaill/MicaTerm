import {
    DialogActionButton,
    DialogSelectField,
    DialogSelectPopup,
    DialogFormSection,
    DialogTextField,
    ModalBodyScrollArea,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsSnippetModal inherits Rectangle {
    in property <string> dialog-title: "New Snippet";
    in property <string> name: "";
    in property <string> script: "";
    in property <string> package: "";
    in property <[string]> package-options: [];
    in property <string> package-selected-label: "";
    in property <string> validation-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback draft-changed(string, string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    out property <bool> select-overlay-open: root.package-popup-open;
    private property <length> header-height: ThemeTokens.modal-header-height + 10px;
    private property <length> footer-height: root.validation-message == "" ? ThemeTokens.modal-footer-min-height : 118px;
    private property <bool> package-popup-open: false;
    private property <length> package-popup-x: 0px;
    private property <length> package-popup-y: 0px;
    private property <length> package-popup-width: 0px;
    private property <length> package-popup-max-height: 240px;
    private property <int> package-popup-highlighted-index: -1;
    private property <int> package-popup-focus-sequence: 0;
    private property <int> package-select-focus-sequence: 0;

    background: transparent;

    public function focus-input() {
        name-field.focus-input();
    }

    public function dismiss-open-select() {
        if !root.package-popup-open {
            return;
        }

        root.package-popup-open = false;
        root.package-popup-highlighted-index = -1;
        root.package-select-focus-sequence += 1;
    }

    function package-popup-preferred-height() -> length {
        return min(240px, 8px + root.package-options.length * 32px + 8px);
    }

    function open-package-select(anchor-x: length, anchor-y: length, anchor-width: length) {
        if root.package-popup-open {
            root.dismiss-open-select();
            return;
        }

        root.package-popup-x = anchor-x;
        root.package-popup-y = anchor-y + 34px + 6px;
        root.package-popup-width = anchor-width;
        root.package-popup-max-height = min(
            root.package-popup-preferred-height(),
            max(120px, footer.y - root.package-popup-y - 8px)
        );
        root.package-popup-highlighted-index = 0;
        root.package-popup-open = true;
        root.package-popup-focus-sequence += 1;
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Return && root.can-confirm) {
                root.confirm-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Create a reusable command snippet.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: 14px;
            content-padding-horizontal: 18px;
            content-padding-vertical: 16px;
            content-spacing: 14px;
            viewport-surface: ThemeTokens.modal-body-surface;
            panel-surface: ThemeTokens.modal-body-surface;
            panel-border-color: transparent;

            content-column := Rectangle {
                width: body.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body.content-spacing;

                    DialogFormSection {
                        width: parent.width;
                        title: "Snippet details";
                        description: "Short, action-oriented labels scan best in quick launch and search.";

                        name-field := DialogTextField {
                            width: parent.width;
                            label: "Name";
                            required: true;
                            value: root.name;
                            invalid: root.validation-message != "";
                            helper-text: root.validation-message;

                            value-changed(value) => {
                                root.draft-changed("name", value);
                            }
                        }

                        VerticalLayout {
                            width: parent.width;
                            spacing: 8px;

                            snippet-package-select-group := Rectangle {
                                width: parent.width;
                                height: 58px;
                                background: transparent;

                                VerticalLayout {
                                    width: parent.width;
                                    spacing: 10px;

                                    Text {
                                        width: parent.width;
                                        text: "Package";
                                        color: ThemeTokens.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                    }

                                    package-select := DialogSelectField {
                                        width: parent.width;
                                        height: 34px;
                                        label: "Package";
                                        focus-sequence: root.package-select-focus-sequence;
                                        open: root.package-popup-open;
                                        selected-label: root.package-selected-label;
                                        placeholder-text: "No Package";

                                        toggle-requested => {
                                            root.open-package-select(
                                                self.absolute-position.x - root.absolute-position.x,
                                                self.absolute-position.y - root.absolute-position.y,
                                                self.width
                                            );
                                        }
                                    }
                                }
                            }

                            Text {
                                width: parent.width;
                                text: "Optional. Group snippets into packages for a cleaner palette and sidebar.";
                                color: ThemeTokens.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Script";
                        description: "Use multiline shell content without falling back to a web-style textarea.";

                        DialogTextField {
                            width: parent.width;
                            label: "Command body";
                            multiline: true;
                            value: root.script;

                            value-changed(value) => {
                                root.draft-changed("script", value);
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            content-spacing: 10px;

            if root.validation-message != "" : Text {
                width: parent.width;
                text: root.validation-message;
                color: ThemeTokens.status-error-accent;
                font-size: 11px;
                wrap: word-wrap;
            }

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    width: 108px;
                    label: "Save";
                    primary: true;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }

        if root.package-popup-open : package-popup-dismiss-layer := TouchArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height;

            clicked => {
                root.dismiss-open-select();
            }
        }

        if root.package-popup-open : package-popup := DialogSelectPopup {
            x: root.package-popup-x;
            y: root.package-popup-y;
            width: root.package-popup-width;
            open: root.package-popup-open;
            options: root.package-options;
            focus-sequence: root.package-popup-focus-sequence;
            highlighted-index: root.package-popup-highlighted-index;
            popup-max-height: root.package-popup-max-height;

            option-selected(value) => {
                root.draft-changed("package", value == "No Package" ? "" : value);
                root.dismiss-open-select();
            }

            dismiss-requested => {
                root.dismiss-open-select();
            }

            move-highlight-requested(delta) => {
                if root.package-options.length == 0 {
                    return;
                }

                root.package-popup-highlighted-index = max(
                    0,
                    min(root.package-options.length - 1, root.package-popup-highlighted-index + delta)
                );
            }
        }
    }
}
