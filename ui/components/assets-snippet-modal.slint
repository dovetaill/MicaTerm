import { ComboBox, ScrollView } from "std-widgets.slint";
import { ModalBodyScrollArea, ModalFooterBar, ModalHeaderBar } from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

component DialogButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary && root.enabled ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: !root.enabled ? ThemeTokens.control-disabled-surface
        : button-touch.pressed ? ThemeTokens.control-pressed-surface
        : button-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.primary ? ThemeTokens.accent : ThemeTokens.control-active-surface;
    opacity: root.enabled ? 1.0 : 0.56;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;

        clicked => {
            root.clicked();
        }
    }
}

export component AssetsSnippetModal inherits Rectangle {
    in property <string> dialog-title: "New Snippet";
    in property <string> name: "";
    in property <string> script: "";
    in property <string> package: "";
    in property <[string]> package-options: [];
    in property <string> package-selected-label: "";
    in property <string> validation-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback draft-changed(string, string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> header-height: 56px;
    private property <length> footer-height: root.validation-message == "" ? 88px : 118px;
    private property <length> body-height: max(0px, root.height - root.header-height - root.footer-height);

    background: transparent;

    public function focus-input() {
        name-input.focus();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else if (event.text == Key.Return) {
                if (root.can-confirm) {
                    root.confirm-requested();
                }
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: 12px;
            content-padding-horizontal: 16px;
            content-padding-vertical: 14px;
            content-spacing: 16px;
            viewport-surface: ThemeTokens.inspector-surface;
            panel-surface: ThemeTokens.window-surface;
            panel-border-color: ThemeTokens.divider-strong;

            content-column := Rectangle {
                width: body.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body.content-spacing;

                    Rectangle {
                        width: parent.width;
                        height: 72px;
                        background: transparent;

                        Text {
                            text: "Name";
                            color: ThemeTokens.text-primary;
                            opacity: 0.78;
                        }

                        Rectangle {
                            y: 28px;
                            width: parent.width;
                            height: 40px;
                            border-radius: 0px;
                            border-width: 1px;
                            border-color: ThemeTokens.divider-subtle;
                            background: ThemeTokens.inspector-surface;

                            name-input := TextInput {
                                x: 12px;
                                y: 9px;
                                width: parent.width - 24px;
                                height: 22px;
                                text: root.name;
                                color: ThemeTokens.text-primary;
                                selection-background-color: ThemeTokens.accent;
                                selection-foreground-color: ThemeTokens.text-primary;

                                edited => {
                                    root.draft-changed("name", self.text);
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: parent.width;
                        height: 178px;
                        background: transparent;

                        Text {
                            text: "Script";
                            color: ThemeTokens.text-primary;
                            opacity: 0.78;
                        }

                        Rectangle {
                            y: 28px;
                            width: parent.width;
                            height: 146px;
                            border-radius: 0px;
                            border-width: 1px;
                            border-color: ThemeTokens.divider-subtle;
                            background: ThemeTokens.inspector-surface;

                            script-input := TextInput {
                                x: 12px;
                                y: 8px;
                                width: parent.width - 24px;
                                height: parent.height - 16px;
                                text: root.script;
                                color: ThemeTokens.text-primary;
                                single-line: false;
                                selection-background-color: ThemeTokens.accent;
                                selection-foreground-color: ThemeTokens.text-primary;

                                edited => {
                                    root.draft-changed("script", self.text);
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: parent.width;
                        height: 102px;
                        background: transparent;

                        VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 8px;

                            Text {
                                text: "Package";
                                color: ThemeTokens.text-primary;
                                opacity: 0.78;
                            }

                            ComboBox {
                                width: parent.width;
                                height: 34px;
                                model: root.package-options;
                                current-value: root.package-selected-label;

                                selected(value) => {
                                    root.draft-changed("package", value == "No Package" ? "" : value);
                                }
                            }

                            Text {
                                width: parent.width;
                                text: "Optional. Choose a package or keep the snippet at the root level.";
                                color: ThemeTokens.text-primary;
                                opacity: 0.62;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            surface: ThemeTokens.activity-surface;
            divider-color: ThemeTokens.divider-strong;
            content-spacing: 12px;

            validation-copy := Text {
                width: parent.width;
                text: root.validation-message;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                visible: root.validation-message != "";
                wrap: word-wrap;
            }

            Rectangle {
                width: parent.width;
                height: 34px;
                background: transparent;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    cancel-button := DialogButton {
                        width: 88px;
                        label: "Cancel";

                        clicked => {
                            root.focus-restore-requested();
                            root.close-requested();
                        }
                    }

                    confirm-button := DialogButton {
                        width: 84px;
                        label: "Create";
                        primary: true;
                        enabled: root.can-confirm;

                        clicked => {
                            root.confirm-requested();
                        }
                    }
                }
            }
        }
    }
}
