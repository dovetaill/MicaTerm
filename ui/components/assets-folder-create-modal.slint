import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsFolderCreateModal inherits Rectangle {
    in property <string> folder-name: "";
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback folder-name-changed(string);

    private property <bool> can-confirm: root.folder-name != "";

    width: 360px;
    height: 188px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-strong;
    background: ThemeTokens.assets-surface;
    z: 140;

    public function focus-input() {
        name-input.focus();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                accept
            } else if (event.text == Key.Return) {
                if (root.can-confirm) {
                    root.confirm-requested();
                }
                accept
            } else {
                reject
            }
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: transparent;

            Text {
                x: 20px;
                y: 18px;
                text: "New Folder";
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: 600;
            }

            Rectangle {
                x: 20px;
                y: 58px;
                width: parent.width - 40px;
                height: 42px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.inspector-surface;

                name-input := TextInput {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: 22px;
                    text: root.folder-name;
                    color: ThemeTokens.text-primary;
                    selection-background-color: ThemeTokens.accent;
                    selection-foreground-color: ThemeTokens.text-primary;

                    edited => {
                        root.folder-name-changed(self.text);
                    }

                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.close-requested();
                            accept
                        } else if (event.text == Key.Return) {
                            if (root.can-confirm) {
                                root.confirm-requested();
                            }
                            accept
                        } else {
                            reject
                        }
                    }
                }
            }

            cancel-button := Rectangle {
                x: parent.width - 196px;
                y: parent.height - 54px;
                width: 84px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.control-hover-surface;

                Text {
                    text: "Cancel";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.close-requested();
                    }
                }
            }

            confirm-button := Rectangle {
                x: parent.width - 104px;
                y: parent.height - 54px;
                width: 84px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: root.can-confirm ? ThemeTokens.accent : ThemeTokens.divider-subtle;
                background: root.can-confirm ? ThemeTokens.accent : ThemeTokens.control-active-surface;
                opacity: root.can-confirm ? 1.0 : 0.55;

                Text {
                    text: "Create";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }

    changed focus-sequence => {
        root.focus-input();
    }
}
