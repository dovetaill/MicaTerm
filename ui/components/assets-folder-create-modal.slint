import {
    DialogActionButton,
    DialogSectionCard,
    DialogTextField,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsFolderCreateModal inherits Rectangle {
    in property <string> dialog-title: "New Folder";
    in property <string> folder-name: "";
    in property <string> validation-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback folder-name-changed(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> footer-height: ThemeTokens.modal-footer-min-height;

    background: transparent;

    public function focus-input() {
        name-field.focus-input();
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Return && root.can-confirm) {
                root.confirm-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Create a new item in the current location.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := Rectangle {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            background: ThemeTokens.modal-body-surface;

            VerticalLayout {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                spacing: 0px;

                DialogSectionCard {
                    width: parent.width;
                    spacing: 12px;
                    surface: ThemeTokens.modal-section-surface;

                    Text {
                        width: parent.width;
                        text: "Name";
                        color: ThemeTokens.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                    }

                        name-field := DialogTextField {
                            width: parent.width;
                            label: "Folder name";
                            required: true;
                        value: root.folder-name;
                        invalid: root.validation-message != "";
                        helper-text: root.validation-message != ""
                            ? root.validation-message
                            : "Shown in the assets tree, the create menu, and SFTP quick actions.";

                            value-changed(value) => {
                                root.folder-name-changed(value);
                            }

                            submitted => {
                                if root.can-confirm {
                                    root.confirm-requested();
                                }
                            }
                        }
                    }
                }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    width: 108px;
                    label: "Create";
                    primary: true;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
