// Workspace tab chip that exposes selection and close affordances.

import { ThemeTokens } from "../theme/tokens.slint";

export component ActiveTab inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> state: "connected";
    in property <bool> active: false;
    callback selected();
    callback close-requested();

    min-width: 176px;
    height: 28px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.active ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: root.active ? ThemeTokens.control-active-surface : ThemeTokens.control-hover-surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            y: 11px;
            background: root.state == "error" || root.state == "disconnected" ? #c94f4f :
                        root.state == "connecting" ? ThemeTokens.accent : #4da36d;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            VerticalLayout {
                spacing: 0px;

                Text {
                    text: root.title;
                    color: ThemeTokens.text-primary;
                    font-size: 12px;
                    font-weight: root.active ? 700 : 600;
                    overflow: elide;
                }

                Text {
                    text: root.subtitle;
                    color: ThemeTokens.dark-mode ? #aeb8c7 : #516174;
                    font-size: 10px;
                    overflow: elide;
                }
            }
        }

        close-button := Rectangle {
            width: 16px;
            height: 16px;
            y: 6px;
            background: transparent;

            Text {
                text: "×";
                width: parent.width;
                height: parent.height;
                color: ThemeTokens.dark-mode ? #aeb8c7 : #516174;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;

                clicked => {
                    root.close-requested();
                }
            }
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.selected();
        }
    }
}
