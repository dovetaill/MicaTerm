// Workspace tab chip that exposes selection and close affordances.

import { ThemeTokens } from "../theme/tokens.slint";

export component ActiveTab inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> state: "connected";
    in property <bool> active: false;
    callback selected();
    callback close-requested();

    in property <length> min-chip-width: 120px;
    in property <length> max-chip-width: 220px;

    min-width: 0px;
    height: 28px;
    preferred-width: min(root.max-chip-width, max(root.min-chip-width, title-metric.preferred-width + 62px));
    border-radius: 0px;
    border-width: 1px;
    border-color: root.active ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: root.active ? ThemeTokens.control-active-surface : ThemeTokens.control-hover-surface;
    clip: true;

    title-metric := Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        text: root.title;
        color: transparent;
        font-size: 12px;
        font-weight: root.active ? 700 : 600;
    }

    state-dot := Rectangle {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.state == "error" || root.state == "disconnected" ? #c94f4f :
                    root.state == "connecting" ? ThemeTokens.accent : #4da36d;
    }

    close-button := Rectangle {
        x: parent.width - self.width - 4px;
        y: 2px;
        width: 24px;
        height: 24px;
        background: transparent;

        Text {
            text: "×";
            width: parent.width;
            height: parent.height;
            color: ThemeTokens.dark-mode ? #aeb8c7 : #516174;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    title-label := Text {
        x: 26px;
        y: 0px;
        width: max(0px, close-button.x - 34px);
        height: parent.height;
        text: root.title;
        color: ThemeTokens.text-primary;
        font-size: 12px;
        font-weight: root.active ? 700 : 600;
        vertical-alignment: center;
        overflow: elide;
    }

    content-hit-target := TouchArea {
        width: close-button.x;
        height: parent.height;

        clicked => { root.selected(); }
    }

    close-hit-target := TouchArea {
        x: close-button.x;
        width: parent.width - close-button.x;
        height: parent.height;

        clicked => { root.close-requested(); }
    }
}
