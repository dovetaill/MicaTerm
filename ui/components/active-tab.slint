// Workspace tab chip that exposes selection and close affordances.

import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

export component ActiveTab inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> state: "connected";
    in property <bool> active: false;
    in property <bool> drag-active: false;
    in property <bool> show-leading-insertion-line: false;
    in property <length> leading-gap-width: 0px;
    callback selected();
    callback close-requested();
    callback context-menu-requested(length, length);
    callback hovered(length, length);
    callback hover-ended();
    callback drag-started(length, length);
    callback drag-moved(length, length);
    callback drag-ended(length, length);
    callback drag-cancelled();

    in property <length> min-chip-width: 120px;
    in property <length> max-chip-width: 220px;
    in property <color> shell-border: ThemeTokens.divider-subtle;
    in property <color> shell-text-primary: ThemeTokens.text-primary;
    in property <color> shell-text-secondary: ThemeTokens.text-secondary;
    in property <color> shell-tab-active: ThemeTokens.tab-active-surface;
    in property <color> shell-tab-inactive: ThemeTokens.tab-inactive-surface;
    in property <color> shell-tab-hover: ThemeTokens.tab-hover-surface;
    in property <color> shell-tab-active-indicator: ThemeTokens.tab-active-indicator;
    private property <image> close-icon: @image-url("../../assets/icons/fluent/dismiss-20-regular.svg");
    private property <length> close-zone-width: 28px;
    private property <length> reorder-threshold: 6px;
    private property <length> tab-surface-width: max(0px, root.width - root.leading-gap-width);
    private property <length> preview-marker-x: root.leading-gap-width > 0px
        ? max(3px, root.leading-gap-width - 4px)
        : 0px;
    out property <bool> has-hover: content-hit-target.has-hover || close-hit-target.has-hover;
    private property <bool> close-visible: root.active || root.has-hover || root.drag-active;

    function absolute-length(value: length) -> length {
        return value < 0px ? -value : value;
    }

    function should-start-reorder(delta-x: length, delta-y: length) -> bool {
        let horizontal = root.absolute-length(delta-x);
        let vertical = root.absolute-length(delta-y);
        return horizontal >= root.reorder-threshold && horizontal > vertical;
    }

    min-width: 0px;
    height: 34px;
    preferred-width: min(root.max-chip-width, max(root.min-chip-width, title-metric.preferred-width + 62px))
        + root.leading-gap-width;
    y: root.drag-active ? -3px : 0px;
    background: transparent;
    clip: false;
    animate y { duration: 110ms; easing: ease-out; }

    title-metric := Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        text: root.title;
        color: transparent;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-body;
        font-weight: AppTypography.ui-font-weight-regular;
        letter-spacing: 0px;
    }

    preview-gap := Rectangle {
        x: 0px;
        y: 4px;
        width: max(0px, root.leading-gap-width - 4px);
        height: parent.height - 8px;
        border-radius: 8px;
        border-width: root.leading-gap-width > 0px ? 1px : 0px;
        border-color: root.shell-border;
        background: root.shell-tab-hover;
        opacity: root.leading-gap-width > 0px ? 0.72 : 0;
        visible: root.leading-gap-width > 0px;
        animate width { duration: 140ms; easing: ease-out; }
        animate opacity { duration: 120ms; }
    }

    insertion-line := Rectangle {
        x: root.preview-marker-x;
        y: 4px;
        width: 3px;
        height: parent.height - 8px;
        border-radius: 2px;
        background: root.shell-tab-active-indicator;
        opacity: root.show-leading-insertion-line ? 1 : 0;
        visible: root.show-leading-insertion-line;
        animate x { duration: 140ms; easing: ease-out; }
        animate opacity { duration: 120ms; }
    }

    tab-surface := Rectangle {
        x: root.leading-gap-width;
        y: 0px;
        width: root.tab-surface-width;
        height: parent.height;
        border-radius: 10px;
        border-width: root.drag-active ? 1px : 0px;
        border-color: root.drag-active ? root.shell-border : transparent;
        background: root.drag-active
            ? root.shell-tab-active
            : root.active
                ? root.shell-tab-active
                : (content-hit-target.pressed || close-hit-target.pressed)
                    ? ThemeTokens.control-pressed-surface
                    : root.has-hover
                        ? root.shell-tab-hover
                        : transparent;
        clip: true;
        opacity: root.drag-active ? 0.98 : 1;
        animate x { duration: 140ms; easing: ease-out; }
        animate width { duration: 140ms; easing: ease-out; }
        animate opacity { duration: 110ms; }

        state-dot := Rectangle {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: 2px;
            height: 14px;
            border-radius: 1px;
            background: root.state == "error" || root.state == "disconnected"
                ? ThemeTokens.status-error-accent
                : root.state == "connecting"
                    ? ThemeTokens.status-busy-accent
                    : root.state == "launcher" ? ThemeTokens.divider-subtle
                    : ThemeTokens.status-success-accent;
        }

        active-indicator := Rectangle {
            x: 10px;
            y: parent.height - 2px;
            width: parent.width - 20px;
            height: 2px;
            border-radius: 1px;
            background: root.shell-tab-active-indicator;
            visible: root.active && !root.drag-active;
        }

        bottom-divider := Rectangle {
            x: 0px;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: root.active || root.drag-active ? transparent : root.shell-border;
        }

        trailing-divider := Rectangle {
            x: parent.width - 1px;
            y: 8px;
            width: 1px;
            height: parent.height - 16px;
            background: root.active || root.has-hover || root.drag-active
                ? transparent
                : root.shell-border;
        }

        close-button := Rectangle {
            x: parent.width - root.close-zone-width - 4px;
            y: 3px;
            width: root.close-zone-width;
            height: 24px;
            border-radius: 4px;
            background: close-hit-target.pressed
                ? ThemeTokens.control-pressed-surface
                : close-hit-target.has-hover
                    ? ThemeTokens.control-hover-surface
                    : transparent;
            opacity: root.close-visible ? 1 : 0;

            if (root.close-icon.width > 0 && root.close-icon.height > 0) : Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source <=> root.close-icon;
                image-fit: contain;
                colorize: close-hit-target.has-hover ? root.shell-text-primary : root.shell-text-secondary;
            }
        }

        title-label := Text {
            x: 18px;
            y: 0px;
            width: max(0px, close-button.x - 24px);
            height: parent.height;
            text: root.title;
            font-family: AppTypography.ui-font-family;
            color: root.active || root.drag-active ? root.shell-text-primary : root.shell-text-secondary;
            font-size: AppTypography.ui-font-size-body;
            font-weight: AppTypography.ui-font-weight-regular;
            letter-spacing: 0px;
            vertical-alignment: center;
            overflow: elide;
        }

        content-hit-target := TouchArea {
            width: max(0px, close-button.x);
            height: parent.height;
            mouse-cursor: root.drag-active ? MouseCursor.grabbing : MouseCursor.grab;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.context-menu-requested(
                        self.mouse-x + self.absolute-position.x,
                        self.mouse-y + self.absolute-position.y,
                    );
                } else if event.kind == PointerEventKind.move && self.pressed {
                    let delta-x = self.mouse-x - self.pressed-x;
                    let delta-y = self.mouse-y - self.pressed-y;
                    if !root.drag-active && root.should-start-reorder(delta-x, delta-y) {
                        root.hover-ended();
                        root.drag-started(
                            self.pressed-x + self.absolute-position.x,
                            self.pressed-y + self.absolute-position.y,
                        );
                    }
                    if root.drag-active {
                        root.drag-moved(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    }
                } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left
                {
                    if root.drag-active {
                        root.drag-ended(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else {
                        root.selected();
                    }
                } else if event.kind == PointerEventKind.cancel {
                    root.drag-cancelled();
                }
            }
        }

        close-hit-target := TouchArea {
            x: close-button.x;
            width: root.close-zone-width + 4px;
            height: parent.height;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.context-menu-requested(
                        self.mouse-x + self.absolute-position.x,
                        self.mouse-y + self.absolute-position.y,
                    );
                }
            }

            clicked => { root.close-requested(); }
        }
    }

    changed has-hover => {
        if root.has-hover {
            root.hovered(
                root.absolute-position.x + root.width / 2,
                root.absolute-position.y + root.height + 8px,
            );
        } else {
            root.hover-ended();
        }
    }

    changed drag-active => {
        if root.drag-active {
            root.hover-ended();
        }
    }
}
