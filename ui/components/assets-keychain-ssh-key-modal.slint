import {
    DialogActionButton,
    DialogFormSection,
    DialogInlineBanner,
    DialogSectionCard,
    DialogTextField,
    ModalBodyScrollArea,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsKeychainSshKeyModal inherits Rectangle {
    in property <string> dialog-title: "SSH Key";
    in property <string> name: "";
    in property <string> private-key: "";
    in property <string> public-key: "";
    in property <string> fingerprint: "";
    in property <string> validation-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    in property <string> text-context-menu-action-id: "";
    in property <string> text-context-menu-action-field-id: "";
    in property <int> text-context-menu-action-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback draft-changed(string, string);
    callback action-requested(string);
    callback text-context-menu-requested(string, string, bool, bool, bool, bool, length, length);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> footer-height: root.validation-message == "" ? ThemeTokens.modal-footer-min-height : 116px;

    background: transparent;

    public function focus-input() {
        name-field.focus-input();
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Return && root.can-confirm) {
                root.confirm-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Manage one reusable SSH key profile.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body-scroll := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: 14px;
            content-padding-horizontal: 18px;
            content-padding-vertical: 16px;
            content-spacing: 14px;
            viewport-surface: ThemeTokens.modal-body-surface;
            panel-surface: ThemeTokens.modal-body-surface;
            panel-border-color: transparent;

            content-column := Rectangle {
                width: body-scroll.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body-scroll.content-spacing;

                    DialogFormSection {
                        width: parent.width;
                        title: "Key profile";
                        description: "Use a stable label so identities and SSH profiles can reference this key clearly.";

                        name-field := DialogTextField {
                            width: parent.width;
                            label: "Name";
                            field-id: "keychain-ssh-key.name";
                            field-kind: "label";
                            text-context-menu-action-id: root.text-context-menu-action-id;
                            active-text-context-menu-field-id: root.text-context-menu-action-field-id;
                            text-context-menu-action-sequence: root.text-context-menu-action-sequence;
                            value: root.name;
                            invalid: root.validation-message != "";
                            helper-text: root.validation-message != ""
                                ? root.validation-message
                                : "Use a stable label so identities and SSH profiles can reference this key without ambiguity.";

                            value-changed(value) => {
                                root.draft-changed("name", value);
                            }

                            text-context-menu-requested(
                                field-id,
                                field-kind,
                                read-only,
                                is-secret,
                                has-selection,
                                supports-multiline,
                                anchor-x,
                                anchor-y,
                            ) => {
                                root.text-context-menu-requested(
                                    field-id,
                                    field-kind,
                                    read-only,
                                    is-secret,
                                    has-selection,
                                    supports-multiline,
                                    anchor-x,
                                    anchor-y,
                                );
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Private key";
                        description: "Import, paste, or edit the private key material used for SSH auth.";

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogActionButton {
                                horizontal-stretch: 1;
                                label: "Import Private Key";

                                clicked => {
                                    root.action-requested("import-private-key");
                                }
                            }

                            DialogActionButton {
                                horizontal-stretch: 1;
                                label: "Paste Private Key";

                                clicked => {
                                    root.action-requested("paste-private-key");
                                }
                            }
                        }

                        private-key-field := DialogTextField {
                            width: parent.width;
                            label: "Private key";
                            field-id: "keychain-ssh-key.private-key";
                            field-kind: "private-key";
                            context-menu-secret: true;
                            text-context-menu-action-id: root.text-context-menu-action-id;
                            active-text-context-menu-field-id: root.text-context-menu-action-field-id;
                            text-context-menu-action-sequence: root.text-context-menu-action-sequence;
                            value: root.private-key;
                            multiline: true;
                            helper-text: "Keep the private key material here; the matching public key and fingerprint are shown below for confirmation.";

                            value-changed(value) => {
                                root.draft-changed("private_key", value);
                            }

                            text-context-menu-requested(
                                field-id,
                                field-kind,
                                read-only,
                                is-secret,
                                has-selection,
                                supports-multiline,
                                anchor-x,
                                anchor-y,
                            ) => {
                                root.text-context-menu-requested(
                                    field-id,
                                    field-kind,
                                    read-only,
                                    is-secret,
                                    has-selection,
                                    supports-multiline,
                                    anchor-x,
                                    anchor-y,
                                );
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Public key and fingerprint";
                        description: "Review the derived public key and fingerprint that other surfaces will reference.";

                        VerticalLayout {
                            width: parent.width;
                            spacing: 10px;

                            HorizontalLayout {
                                width: parent.width;
                                height: 38px;
                                spacing: 10px;

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Import Public Key";

                                    clicked => {
                                        root.action-requested("import-public-key");
                                    }
                                }

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Paste Public Key";

                                    clicked => {
                                        root.action-requested("paste-public-key");
                                    }
                                }
                            }

                            HorizontalLayout {
                                width: parent.width;
                                height: 38px;
                                spacing: 10px;

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Generate Key Pair";

                                    clicked => {
                                        root.action-requested("generate-key-pair");
                                    }
                                }

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Copy Public Key";

                                    clicked => {
                                        root.action-requested("copy-public-key");
                                    }
                                }
                            }
                        }

                        public-key-field := DialogTextField {
                            width: parent.width;
                            label: "Public key";
                            field-id: "keychain-ssh-key.public-key";
                            field-kind: "public-key";
                            context-menu-secret: true;
                            text-context-menu-action-id: root.text-context-menu-action-id;
                            active-text-context-menu-field-id: root.text-context-menu-action-field-id;
                            text-context-menu-action-sequence: root.text-context-menu-action-sequence;
                            value: root.public-key;
                            multiline: true;

                            value-changed(value) => {
                                root.draft-changed("public_key", value);
                            }

                            text-context-menu-requested(
                                field-id,
                                field-kind,
                                read-only,
                                is-secret,
                                has-selection,
                                supports-multiline,
                                anchor-x,
                                anchor-y,
                            ) => {
                                root.text-context-menu-requested(
                                    field-id,
                                    field-kind,
                                    read-only,
                                    is-secret,
                                    has-selection,
                                    supports-multiline,
                                    anchor-x,
                                    anchor-y,
                                );
                            }
                        }

                        fingerprint-field := DialogTextField {
                            width: parent.width;
                            label: "Fingerprint";
                            field-id: "keychain-ssh-key.fingerprint";
                            field-kind: "fingerprint";
                            context-menu-secret: true;
                            text-context-menu-action-id: root.text-context-menu-action-id;
                            active-text-context-menu-field-id: root.text-context-menu-action-field-id;
                            text-context-menu-action-sequence: root.text-context-menu-action-sequence;
                            value: root.fingerprint;
                            helper-text: "This fingerprint is shown in identity pickers and conflict confirmation surfaces.";

                            value-changed(value) => {
                                root.draft-changed("fingerprint", value);
                            }

                            text-context-menu-requested(
                                field-id,
                                field-kind,
                                read-only,
                                is-secret,
                                has-selection,
                                supports-multiline,
                                anchor-x,
                                anchor-y,
                            ) => {
                                root.text-context-menu-requested(
                                    field-id,
                                    field-kind,
                                    read-only,
                                    is-secret,
                                    has-selection,
                                    supports-multiline,
                                    anchor-x,
                                    anchor-y,
                                );
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            content-spacing: 8px;

            if root.validation-message != "" : DialogInlineBanner {
                width: parent.width;
                tone: "error";
                message: root.validation-message;
            }

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    width: 108px;
                    label: "Save";
                    primary: true;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
