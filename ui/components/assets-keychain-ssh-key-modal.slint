import { ScrollView } from "std-widgets.slint";
import { ModalBodyScrollArea, ModalFooterBar, ModalHeaderBar } from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

component DialogButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary && root.enabled ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: !root.enabled ? ThemeTokens.control-disabled-surface
        : button-touch.pressed ? ThemeTokens.control-pressed-surface
        : button-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.primary ? ThemeTokens.accent : ThemeTokens.control-active-surface;
    opacity: root.enabled ? 1.0 : 0.56;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;

        clicked => {
            root.clicked();
        }
    }
}

component TextField inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> multiline: false;
    callback value-changed(string);

    min-width: 0px;
    preferred-width: 0px;
    height: root.multiline ? 138px : 72px;
    background: transparent;

    public function focus-input() {
        field-input.focus();
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 6px;

        Text {
            text: root.label;
            color: ThemeTokens.text-primary;
            opacity: 0.8;
        }

        Rectangle {
            height: root.multiline ? 104px : 40px;
            border-radius: 0px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.inspector-surface;

            field-input := TextInput {
                x: 12px;
                y: root.multiline ? 8px : 9px;
                width: parent.width - 24px;
                height: parent.height - (root.multiline ? 16px : 18px);
                text: root.value;
                color: ThemeTokens.text-primary;
                single-line: !root.multiline;
                selection-background-color: ThemeTokens.accent;
                selection-foreground-color: ThemeTokens.text-primary;

                edited => {
                    root.value-changed(self.text);
                }
            }
        }
    }
}

export component AssetsKeychainSshKeyModal inherits Rectangle {
    in property <string> dialog-title: "SSH Key";
    in property <string> name: "";
    in property <string> private-key: "";
    in property <string> public-key: "";
    in property <string> fingerprint: "";
    in property <string> validation-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback draft-changed(string, string);
    callback action-requested(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> header-height: 56px;
    private property <length> footer-height: root.validation-message == "" ? 78px : 100px;

    background: transparent;

    public function focus-input() {
        name-field.focus-input();
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else if (event.text == Key.Return) {
                if (root.can-confirm) {
                    root.confirm-requested();
                }
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body-scroll := ModalBodyScrollArea {
            x: 0px;
            y: root.header-height;
            width: parent.width;
            height: parent.height - root.header-height - root.footer-height;
            frame-padding: 12px;
            content-padding-horizontal: 16px;
            content-padding-vertical: 14px;
            content-spacing: 14px;
            viewport-surface: ThemeTokens.inspector-surface;
            panel-surface: ThemeTokens.window-surface;
            panel-border-color: ThemeTokens.divider-strong;

            name-field := TextField {
                width: parent.width;
                label: "Name";
                value: root.name;

                value-changed(value) => {
                    root.draft-changed("name", value);
                }
            }

            Text {
                width: parent.width;
                text: "Private Key";
                color: ThemeTokens.text-primary;
                font-weight: 600;
            }

            HorizontalLayout {
                width: parent.width;
                spacing: 8px;

                DialogButton {
                    horizontal-stretch: 1;
                    label: "Import Private Key";

                    clicked => {
                        root.action-requested("import-private-key");
                    }
                }

                DialogButton {
                    horizontal-stretch: 1;
                    label: "Paste Private Key";

                    clicked => {
                        root.action-requested("paste-private-key");
                    }
                }
            }

            TextField {
                width: parent.width;
                label: "Private Key";
                value: root.private-key;
                multiline: true;

                value-changed(value) => {
                    root.draft-changed("private_key", value);
                }
            }

            Text {
                width: parent.width;
                text: "Public Key";
                color: ThemeTokens.text-primary;
                font-weight: 600;
            }

            HorizontalLayout {
                width: parent.width;
                spacing: 8px;

                DialogButton {
                    horizontal-stretch: 1;
                    label: "Import Public Key";

                    clicked => {
                        root.action-requested("import-public-key");
                    }
                }

                DialogButton {
                    horizontal-stretch: 1;
                    label: "Paste Public Key";

                    clicked => {
                        root.action-requested("paste-public-key");
                    }
                }

                DialogButton {
                    horizontal-stretch: 1;
                    label: "Generate Key Pair";

                    clicked => {
                        root.action-requested("generate-key-pair");
                    }
                }

                DialogButton {
                    horizontal-stretch: 1;
                    label: "Copy Public Key";

                    clicked => {
                        root.action-requested("copy-public-key");
                    }
                }
            }

            TextField {
                width: parent.width;
                label: "Public Key";
                value: root.public-key;
                multiline: true;

                value-changed(value) => {
                    root.draft-changed("public_key", value);
                }
            }

            TextField {
                width: parent.width;
                label: "Fingerprint";
                value: root.fingerprint;

                value-changed(value) => {
                    root.draft-changed("fingerprint", value);
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            surface: ThemeTokens.activity-surface;
            divider-color: ThemeTokens.divider-strong;
            content-padding-top: 14px;
            content-padding-bottom: 14px;

            if root.validation-message != "" : Text {
                width: parent.width;
                text: root.validation-message;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 34px;
                spacing: 12px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogButton {
                    width: 88px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogButton {
                    width: 88px;
                    label: "Save";
                    primary: true;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
