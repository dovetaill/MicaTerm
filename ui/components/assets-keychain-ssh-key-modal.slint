import {
    DialogActionButton,
    DialogInlineBanner,
    DialogSectionCard,
    DialogTextField,
    ModalBodyScrollArea,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsKeychainSshKeyModal inherits Rectangle {
    in property <string> dialog-title: "SSH Key";
    in property <string> name: "";
    in property <string> private-key: "";
    in property <string> public-key: "";
    in property <string> fingerprint: "";
    in property <string> validation-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback draft-changed(string, string);
    callback action-requested(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> footer-height: root.validation-message == "" ? ThemeTokens.modal-footer-min-height : 116px;

    background: transparent;

    public function focus-input() {
        name-field.focus-input();
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Return && root.can-confirm) {
                root.confirm-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Bring imported keys, pasted keys, and generated keys into one consistent editor surface.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body-scroll := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: 14px;
            content-padding-horizontal: 18px;
            content-padding-vertical: 16px;
            content-spacing: 14px;
            viewport-surface: ThemeTokens.modal-body-surface;
            panel-surface: ThemeTokens.modal-body-surface;
            panel-border-color: transparent;

            content-column := Rectangle {
                width: body-scroll.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body-scroll.content-spacing;

                    DialogSectionCard {
                        width: parent.width;
                        spacing: 14px;

                        Text {
                            width: parent.width;
                            text: "Key profile";
                            color: ThemeTokens.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        name-field := DialogTextField {
                            width: parent.width;
                            label: "Name";
                            value: root.name;
                            invalid: root.validation-message != "";
                            helper-text: root.validation-message != ""
                                ? root.validation-message
                                : "Use a stable label so identities and SSH profiles can reference this key without ambiguity.";

                            value-changed(value) => {
                                root.draft-changed("name", value);
                            }
                        }
                    }

                    DialogSectionCard {
                        width: parent.width;
                        spacing: 14px;
                        surface: ThemeTokens.modal-section-alt-surface;

                        Text {
                            width: parent.width;
                            text: "Private key";
                            color: ThemeTokens.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: 38px;
                            spacing: 10px;

                            DialogActionButton {
                                horizontal-stretch: 1;
                                label: "Import Private Key";

                                clicked => {
                                    root.action-requested("import-private-key");
                                }
                            }

                            DialogActionButton {
                                horizontal-stretch: 1;
                                label: "Paste Private Key";

                                clicked => {
                                    root.action-requested("paste-private-key");
                                }
                            }
                        }

                        DialogTextField {
                            width: parent.width;
                            label: "Private key";
                            value: root.private-key;
                            multiline: true;
                            helper-text: "Keep the private key material here; the matching public key and fingerprint are shown below for confirmation.";

                            value-changed(value) => {
                                root.draft-changed("private_key", value);
                            }
                        }
                    }

                    DialogSectionCard {
                        width: parent.width;
                        spacing: 14px;

                        Text {
                            width: parent.width;
                            text: "Public key and fingerprint";
                            color: ThemeTokens.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        VerticalLayout {
                            width: parent.width;
                            spacing: 10px;

                            HorizontalLayout {
                                width: parent.width;
                                height: 38px;
                                spacing: 10px;

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Import Public Key";

                                    clicked => {
                                        root.action-requested("import-public-key");
                                    }
                                }

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Paste Public Key";

                                    clicked => {
                                        root.action-requested("paste-public-key");
                                    }
                                }
                            }

                            HorizontalLayout {
                                width: parent.width;
                                height: 38px;
                                spacing: 10px;

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Generate Key Pair";

                                    clicked => {
                                        root.action-requested("generate-key-pair");
                                    }
                                }

                                DialogActionButton {
                                    horizontal-stretch: 1;
                                    label: "Copy Public Key";

                                    clicked => {
                                        root.action-requested("copy-public-key");
                                    }
                                }
                            }
                        }

                        DialogTextField {
                            width: parent.width;
                            label: "Public key";
                            value: root.public-key;
                            multiline: true;

                            value-changed(value) => {
                                root.draft-changed("public_key", value);
                            }
                        }

                        DialogTextField {
                            width: parent.width;
                            label: "Fingerprint";
                            value: root.fingerprint;
                            helper-text: "This fingerprint is shown in identity pickers and conflict confirmation surfaces.";

                            value-changed(value) => {
                                root.draft-changed("fingerprint", value);
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            content-spacing: 8px;

            if root.validation-message != "" : DialogInlineBanner {
                width: parent.width;
                tone: "error";
                message: root.validation-message;
            }

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    width: 108px;
                    label: "Save";
                    primary: true;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
