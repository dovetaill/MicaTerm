// Global menu surface opened from the navigation button in the custom titlebar.

import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";

component MenuActionItem inherits Rectangle {
    in property <string> label;
    callback invoked;

    height: 36px;
    border-radius: 8px;
    background: touch.pressed
        ? ThemeTokens.menu-row-open-surface
        : touch.has-hover
            ? ThemeTokens.menu-row-hover-surface
            : transparent;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-body;
        font-weight: AppTypography.ui-font-weight-medium;
        color: touch.has-hover ? ThemeTokens.text-primary : ThemeTokens.text-secondary;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.invoked();
        }
    }
}

export component TitlebarMenu inherits PopupWindow {
    callback sync-settings-selected;
    callback settings-selected;
    callback close-requested;

    width: 196px;
    height: 132px;
    close-policy: PopupClosePolicy.close-on-click;

    background-layer := Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 12px;
        border-width: 1px;
        border-color: ThemeTokens.divider-strong;
        background: ThemeTokens.panel-surface;

        VerticalLayout {
            padding: 6px;
            spacing: 4px;

            MenuActionItem {
                label: "Sync Settings";
                invoked => {
                    root.sync-settings-selected();
                    root.close-requested();
                    root.close();
                }
            }

            MenuActionItem {
                label: "Settings";
                invoked => {
                    root.settings-selected();
                    root.close-requested();
                    root.close();
                }
            }

            MenuActionItem {
                label: "Close menu";
                invoked => {
                    root.close-requested();
                    root.close();
                }
            }
        }
    }
}
