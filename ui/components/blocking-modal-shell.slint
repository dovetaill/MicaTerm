import { ThemeTokens } from "../theme/tokens.slint";

export component BlockingModalShell inherits Rectangle {
    in property <length> host-titlebar-height: 0px;
    in property <length> modal-width: 360px;
    in property <length> modal-height: 240px;
    in-out property <length> offset-x: 0px;
    in-out property <length> offset-y: 0px;
    in property <int> focus-sequence: 0;
    in property <bool> escape-enabled: true;
    in property <length> modal-radius: ThemeTokens.modal-radius;
    in property <brush> modal-surface: ThemeTokens.modal-surface;
    in property <brush> modal-border-color: ThemeTokens.modal-border;
    in property <brush> modal-shadow-soft: ThemeTokens.modal-shadow-soft;
    in property <brush> modal-shadow-strong: ThemeTokens.modal-shadow-strong;
    in property <brush> modal-glow: ThemeTokens.modal-glow;
    out property <length> content-width: content-host.width;
    out property <length> content-height: content-host.height;
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    callback consume-event();
    callback escape-requested();

    width: 100%;
    height: 100%;
    background: transparent;

    private property <length> viewport-margin: root.width < 960px || root.height - root.host-titlebar-height < 720px ? 8px : 24px;
    private property <length> available-width: max(280px, root.width - (root.viewport-margin * 2));
    private property <length> available-height: max(
        220px,
        root.height - root.host-titlebar-height - (root.viewport-margin * 2)
    );
    private property <length> resolved-modal-width: min(root.modal-width, root.available-width);
    private property <length> resolved-modal-height: root.available-height > root.modal-height
        && root.available-height - root.modal-height <= 40px
        ? root.available-height
        : min(root.modal-height, root.available-height);
    private property <length> resolved-modal-x: max(
        root.viewport-margin,
        min(
            root.width - root.viewport-margin - root.resolved-modal-width,
            (root.width - root.resolved-modal-width) / 2 + root.offset-x
        )
    );
    private property <length> resolved-modal-y: max(
        root.host-titlebar-height + root.viewport-margin,
        min(
            root.height - root.viewport-margin - root.resolved-modal-height,
            root.host-titlebar-height
                + (root.height - root.host-titlebar-height - root.resolved-modal-height) / 2
                + root.offset-y
        )
    );

    backdrop-scrim := Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.modal-backdrop;
    }

    backdrop := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.consume-event();
        }
    }

    modal-shadow-far := Rectangle {
        x: root.resolved-modal-x + 9px;
        y: root.resolved-modal-y + 14px;
        width: root.resolved-modal-width;
        height: root.resolved-modal-height;
        border-radius: root.modal-radius + 2px;
        background: root.modal-shadow-strong;
    }

    modal-shadow-near := Rectangle {
        x: root.resolved-modal-x + 3px;
        y: root.resolved-modal-y + 7px;
        width: root.resolved-modal-width;
        height: root.resolved-modal-height;
        border-radius: root.modal-radius + 1px;
        background: root.modal-shadow-soft;
    }

    modal-glow-frame := Rectangle {
        x: root.resolved-modal-x - 2px;
        y: root.resolved-modal-y - 2px;
        width: root.resolved-modal-width + 4px;
        height: root.resolved-modal-height + 4px;
        border-radius: root.modal-radius + 2px;
        background: root.modal-glow;
    }

    modal-frame := Rectangle {
        x: root.resolved-modal-x;
        y: root.resolved-modal-y;
        width: root.resolved-modal-width;
        height: root.resolved-modal-height;
        clip: true;
        border-radius: root.modal-radius;
        border-width: 1px;
        border-color: root.modal-border-color;
        background: root.modal-surface;

        edge-highlight := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 1px;
            background: ThemeTokens.dark-mode ? #ffffff12 : #ffffff66;
        }

        modal-event-scope := FocusScope {
            width: parent.width;
            height: parent.height;
            focus-on-tab-navigation: false;

            capture-key-pressed(event) => {
                if root.escape-enabled && event.text == Key.Escape {
                    root.focus-restore-requested();
                    root.escape-requested();
                    accept
                } else {
                    reject
                }
            }

            content-host := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: transparent;

                @children
            }
        }
    }

    changed focus-sequence => {
        modal-event-scope.focus();
    }
}
