import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsDeleteConfirmModal inherits Rectangle {
    in property <string> target-label;
    in property <int> descendant-count;
    callback confirm-requested();
    callback close-requested();

    width: 392px;
    height: 228px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-strong;
    background: ThemeTokens.assets-surface;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                accept
            } else if (event.text == Key.Return) {
                root.confirm-requested();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Text {
                x: 20px;
                y: 18px;
                text: "Delete Asset";
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: 600;
            }

            Text {
                x: 20px;
                y: 58px;
                width: parent.width - 40px;
                text: "Delete \"" + root.target-label + "\"?";
                color: ThemeTokens.text-primary;
                wrap: word-wrap;
            }

            Text {
                x: 20px;
                y: 94px;
                width: parent.width - 40px;
                text: root.descendant-count == 0
                    ? "This action cannot be undone."
                    : "This action removes the selected folder and its nested assets.";
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                wrap: word-wrap;
            }

            if root.descendant-count > 0 : Text {
                x: 20px;
                y: 140px;
                width: parent.width - 40px;
                text: "Nested assets removed: " + root.descendant-count;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
            }

            cancel-button := Rectangle {
                x: parent.width - 196px;
                y: parent.height - 54px;
                width: 84px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.control-hover-surface;

                Text {
                    text: "Cancel";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.close-requested();
                    }
                }
            }

            confirm-button := Rectangle {
                x: parent.width - 104px;
                y: parent.height - 54px;
                width: 84px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.accent;
                background: ThemeTokens.control-active-surface;

                Text {
                    text: "Delete";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
