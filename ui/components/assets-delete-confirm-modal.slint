import { ThemeTokens } from "../theme/tokens.slint";

component DialogButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked();

    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: button-touch.pressed ? ThemeTokens.control-pressed-surface
        : button-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.primary ? ThemeTokens.accent : ThemeTokens.control-active-surface;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

export component AssetsDeleteConfirmModal inherits Rectangle {
    in property <string> target-label;
    in property <int> descendant-count;
    callback confirm-requested();
    callback close-requested();
    callback focus-restore-requested();

    width: 100%;
    height: 100%;
    background: transparent;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else if (event.text == Key.Return) {
                root.confirm-requested();
                accept
            } else {
                reject
            }
        }

        body := Rectangle {
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: transparent;

            Text {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                text: "Delete \"" + root.target-label + "\"?";
                color: ThemeTokens.text-primary;
                font-size: 16px;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                x: 20px;
                y: 58px;
                width: parent.width - 40px;
                text: root.descendant-count == 0
                    ? "This action cannot be undone."
                    : "This action removes the selected folder and all nested assets.";
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                wrap: word-wrap;
            }

            if root.descendant-count > 0 : Text {
                x: 20px;
                y: 104px;
                width: parent.width - 40px;
                text: "Nested assets removed: " + root.descendant-count;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
            }

            footer-divider := Rectangle {
                y: parent.height - 66px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }

            cancel-button := DialogButton {
                x: parent.width - 204px;
                y: parent.height - 50px;
                width: 88px;
                label: "Cancel";

                clicked => {
                    root.focus-restore-requested();
                    root.close-requested();
                }
            }

            confirm-button := DialogButton {
                x: parent.width - 104px;
                y: parent.height - 50px;
                width: 84px;
                label: "Delete";
                primary: true;

                clicked => {
                    root.confirm-requested();
                }
            }
        }
    }
}
