import {
    DialogActionButton,
    DialogSectionCard,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsDeleteConfirmModal inherits Rectangle {
    in property <string> dialog-title: "Delete Asset";
    in property <string> target-label;
    in property <int> descendant-count;
    in property <int> focus-sequence: 0;
    callback confirm-requested();
    callback close-requested();
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> footer-height: ThemeTokens.modal-footer-min-height;

    background: transparent;

    changed focus-sequence => {
        confirm-button.focus-button();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.confirm-requested();
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Review the target one last time before removing it from the current asset scope.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := Rectangle {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            background: ThemeTokens.modal-body-surface;

            VerticalLayout {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                spacing: 0px;

                DialogSectionCard {
                    width: parent.width;
                    spacing: 12px;
                    surface: ThemeTokens.modal-section-alt-surface;
                    stroke-color: ThemeTokens.modal-button-danger-border;

                    Text {
                        width: parent.width;
                        text: "Delete \"" + root.target-label + "\"?";
                        color: ThemeTokens.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    Text {
                        width: parent.width;
                        text: root.descendant-count == 0
                            ? "This action cannot be undone."
                            : "This action removes the selected folder and all nested assets.";
                        color: ThemeTokens.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if root.descendant-count > 0 : Text {
                        width: parent.width;
                        text: "Nested assets removed: " + root.descendant-count;
                        color: ThemeTokens.status-error-accent;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                confirm-button := DialogActionButton {
                    width: 96px;
                    label: "Delete";
                    destructive: true;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
