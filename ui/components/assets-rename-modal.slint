import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsRenameModal inherits Rectangle {
    in property <string> item-name;
    in property <string> validation-message;
    in property <bool> can-confirm;
    callback name-changed(string);
    callback confirm-requested();
    callback close-requested();

    width: 360px;
    height: 214px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-strong;
    background: ThemeTokens.assets-surface;
    z: 142;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                accept
            } else if (event.text == Key.Return) {
                if (root.can-confirm) {
                    root.confirm-requested();
                }
                accept
            } else {
                reject
            }
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Text {
                x: 20px;
                y: 18px;
                text: "Rename";
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: 600;
            }

            Rectangle {
                x: 20px;
                y: 58px;
                width: parent.width - 40px;
                height: 42px;
                border-radius: 0px;
                border-width: 1px;
                border-color: root.validation-message == "" ? ThemeTokens.divider-subtle : ThemeTokens.accent;
                background: ThemeTokens.inspector-surface;

                name-input := TextInput {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: 22px;
                    text: root.item-name;
                    color: ThemeTokens.text-primary;
                    selection-background-color: ThemeTokens.accent;
                    selection-foreground-color: ThemeTokens.text-primary;

                    edited => {
                        root.name-changed(self.text);
                    }

                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.close-requested();
                            accept
                        } else if (event.text == Key.Return) {
                            if (root.can-confirm) {
                                root.confirm-requested();
                            }
                            accept
                        } else {
                            reject
                        }
                    }
                }
            }

            validation-copy := Text {
                x: 20px;
                y: 110px;
                width: parent.width - 40px;
                text: root.validation-message;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                visible: root.validation-message != "";
                wrap: word-wrap;
            }

            cancel-button := Rectangle {
                x: parent.width - 196px;
                y: parent.height - 54px;
                width: 84px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.control-hover-surface;

                Text {
                    text: "Cancel";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.close-requested();
                    }
                }
            }

            confirm-button := Rectangle {
                x: parent.width - 104px;
                y: parent.height - 54px;
                width: 84px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: root.can-confirm ? ThemeTokens.accent : ThemeTokens.divider-subtle;
                background: root.can-confirm ? ThemeTokens.accent : ThemeTokens.control-active-surface;
                opacity: root.can-confirm ? 1.0 : 0.55;

                Text {
                    text: "Save";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
