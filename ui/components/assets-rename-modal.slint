import {
    DialogActionButton,
    DialogSectionCard,
    DialogTextField,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsRenameModal inherits Rectangle {
    in property <string> dialog-title: "Rename Asset";
    in property <string> item-name;
    in property <string> validation-message;
    in property <bool> can-confirm;
    in property <int> focus-sequence: 0;
    callback name-changed(string);
    callback confirm-requested();
    callback close-requested();
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    private property <length> footer-height: ThemeTokens.modal-footer-min-height;

    background: transparent;

    public function focus-input() {
        name-field.focus-input();
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Return) {
                if (root.can-confirm) {
                    root.confirm-requested();
                }
                accept
            } else {
                reject
            }
        }

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: "Rename the selected asset without breaking the surrounding workspace flow.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body := Rectangle {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            background: ThemeTokens.modal-body-surface;

            VerticalLayout {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                spacing: 0px;

                DialogSectionCard {
                    width: parent.width;
                    spacing: 12px;
                    surface: ThemeTokens.modal-section-surface;

                    Text {
                        width: parent.width;
                        text: "Asset label";
                        color: ThemeTokens.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                    }

                    Text {
                        width: parent.width;
                        text: "Use a stable name so the tree, search results, and quick actions stay easy to scan.";
                        color: ThemeTokens.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    name-field := DialogTextField {
                        width: parent.width;
                        label: "New name";
                        required: true;
                        value: root.item-name;
                        invalid: root.validation-message != "";
                        helper-text: root.validation-message != ""
                            ? root.validation-message
                            : "Shown in the asset tree and related context menus.";

                        value-changed(value) => {
                            root.name-changed(value);
                        }

                        submitted => {
                            if root.can-confirm {
                                root.confirm-requested();
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    width: 96px;
                    label: "Save";
                    primary: true;
                    enabled: root.can-confirm;

                    clicked => {
                        root.confirm-requested();
                    }
                }
            }
        }
    }
}
