import { ComboBox, ScrollView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";

component ModalTabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.active ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: tab-touch.pressed ? ThemeTokens.control-pressed-surface
        : tab-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.active ? ThemeTokens.control-active-surface : ThemeTokens.assets-surface;

    Text {
        width: parent.width - 16px;
        height: parent.height;
        x: 8px;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    tab-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

component DialogActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> action-enabled: true;
    callback clicked();

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.action-enabled ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: !root.action-enabled ? ThemeTokens.control-disabled-surface
        : action-touch.pressed ? ThemeTokens.control-pressed-surface
        : action-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.primary ? ThemeTokens.accent : ThemeTokens.control-active-surface;
    opacity: root.action-enabled ? 1.0 : 0.56;

    Text {
        width: parent.width - 16px;
        height: parent.height;
        x: 8px;
        text: root.label;
        color: !root.action-enabled ? ThemeTokens.text-primary
            : root.primary ? ThemeTokens.text-primary
            : ThemeTokens.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    action-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.action-enabled;

        clicked => {
            root.clicked();
        }
    }
}

component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> required: false;
    in property <bool> password-mode: false;
    in property <bool> multiline: false;
    in property <string> trailing-action-text: "";
    callback value-changed(string);
    callback trailing-action-requested();

    min-width: 0px;
    preferred-width: 0px;
    private property <length> field-height: root.multiline ? 120px : 40px;

    height: root.multiline ? 154px : 72px;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 6px;

        Text {
            text: root.required ? root.label + " *" : root.label;
            color: ThemeTokens.text-primary;
            opacity: 0.8;
        }

        Rectangle {
            height: root.field-height;
            border-radius: 0px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.inspector-surface;

            field-input := TextInput {
                x: 12px;
                y: root.multiline ? 8px : 9px;
                width: parent.width - 24px - (root.trailing-action-text != "" ? 70px : 0px);
                height: parent.height - (root.multiline ? 16px : 18px);
                text: root.value;
                color: ThemeTokens.text-primary;
                single-line: !root.multiline;
                input-type: root.password-mode ? InputType.password : InputType.text;
                selection-background-color: ThemeTokens.accent;
                selection-foreground-color: ThemeTokens.text-primary;

                edited => {
                    root.value-changed(self.text);
                }
            }

            if root.trailing-action-text != "" : trailing-action := Rectangle {
                x: parent.width - 62px;
                y: 6px;
                width: 50px;
                height: 28px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: trailing-touch.pressed ? ThemeTokens.control-pressed-surface
                    : trailing-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.trailing-action-text;
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 11px;
                }

                trailing-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.trailing-action-requested();
                    }
                }
            }
        }
    }
}

component FeedbackBanner inherits Rectangle {
    in property <string> state: "idle";
    in property <string> message: "";

    height: root.message == "" ? 0px : 28px;
    visible: root.message != "";
    border-radius: 0px;
    border-width: root.message == "" ? 0px : 1px;
    border-color: root.state == "busy" ? ThemeTokens.accent : ThemeTokens.divider-strong;
    background: root.state == "busy" ? ThemeTokens.status-busy-surface
        : root.state == "success" ? ThemeTokens.status-success-surface
        : root.state == "error" ? ThemeTokens.status-error-surface
        : transparent;

    Text {
        x: 10px;
        y: 5px;
        width: parent.width - 20px;
        text: root.message;
        color: ThemeTokens.text-primary;
        overflow: elide;
    }
}

export component AssetsSshConnectionModal inherits Rectangle {
    in property <string> dialog-title: "New SSH Connection";
    in property <string> name: "";
    in property <string> host: "";
    in property <string> user: "";
    in property <string> port: "22";
    in property <string> auth-source: "manual";
    in property <[string]> keychain-identity-options: [];
    in property <string> keychain-identity-selected-label: "";
    in property <string> keychain-identity-username: "";
    in property <string> keychain-identity-auth-summary: "";
    in property <string> auth-method: "password";
    in property <string> private-key-source: "content";
    in property <string> password: "";
    in property <string> private-key-content: "";
    in property <string> private-key-path: "";
    in property <string> passphrase: "";
    in property <bool> password-visible: false;
    in property <string> remark: "";
    in property <string> environment: "";
    in property <string> proxy-type: "none";
    in property <string> proxy-socks5-host: "";
    in property <string> proxy-socks5-port: "";
    in property <string> proxy-socks5-username: "";
    in property <string> proxy-socks5-password: "";
    in property <bool> proxy-socks5-password-visible: false;
    in property <string> proxy-ssh-asset-id: "";
    in property <[string]> proxy-ssh-options: [];
    in property <string> proxy-ssh-selected-label: "";
    in property <string> proxy-method: "";
    in property <string> validation-message: "";
    in property <bool> connect-family-enabled: false;
    in property <string> feedback-state: "idle";
    in property <string> feedback-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback draft-changed(string, string);
    callback action-requested(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();

    private property <bool> compact-layout: root.width < 620px;
    private property <length> header-height: 56px;
    private property <length> footer-height: root.feedback-message != "" || root.validation-message != "" ? 112px : 84px;
    private property <length> body-height: max(0px, root.height - root.header-height - root.footer-height);

    background: transparent;

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        header := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height;
            background: ThemeTokens.assets-surface;

            Text {
                x: 20px;
                y: 0px;
                width: parent.width - 72px;
                height: parent.height;
                text: root.dialog-title;
                color: ThemeTokens.text-primary;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            drag-touch := TouchArea {
                width: parent.width - 48px;
                height: parent.height;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left
                    {
                        root.drag-requested(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.move {
                        root.drag-moved(
                            self.mouse-x + self.absolute-position.x,
                            self.mouse-y + self.absolute-position.y,
                        );
                    } else if event.kind == PointerEventKind.up {
                        root.drag-ended();
                    }
                }
            }

            close-button := Rectangle {
                x: parent.width - 40px;
                y: 12px;
                width: 28px;
                height: 28px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: close-touch.pressed ? ThemeTokens.control-pressed-surface
                    : close-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }
            }

            header-divider := Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }
        }

        body-scroll := ScrollView {
            x: 0px;
            y: root.header-height;
            width: parent.width;
            height: root.body-height;
            viewport-width: scroll-body.width;
            viewport-height: scroll-body.height;

            scroll-body := Rectangle {
                width: body-scroll.visible-width;
                height: max(body-scroll.visible-height, body-column.preferred-height + 24px);
                background: transparent;

                body-column := VerticalLayout {
                    x: 20px;
                    y: 20px;
                    width: parent.width - 40px;
                    spacing: 18px;

                    Text {
                        width: parent.width;
                        text: "Basic";
                        color: ThemeTokens.text-primary;
                        font-weight: 600;
                    }

                    VerticalLayout {
                        width: parent.width;
                        spacing: 16px;

                        if root.compact-layout : VerticalLayout {
                            width: parent.width;
                            spacing: 12px;

                            FormField {
                                width: parent.width;
                                label: "Name";
                                required: true;
                                value: root.name;

                                value-changed(value) => {
                                    root.draft-changed("name", value);
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Host";
                                required: true;
                                value: root.host;

                                value-changed(value) => {
                                    root.draft-changed("host", value);
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "User";
                                required: true;
                                value: root.user;

                                value-changed(value) => {
                                    root.draft-changed("user", value);
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Port";
                                value: root.port;

                                value-changed(value) => {
                                    root.draft-changed("port", value);
                                }
                            }
                        }

                        if !root.compact-layout : Rectangle {
                            width: parent.width;
                            height: 72px;
                            background: transparent;

                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 12px;

                                FormField {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    label: "Name";
                                    required: true;
                                    value: root.name;

                                    value-changed(value) => {
                                        root.draft-changed("name", value);
                                    }
                                }

                                FormField {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    label: "Host";
                                    required: true;
                                    value: root.host;

                                    value-changed(value) => {
                                        root.draft-changed("host", value);
                                    }
                                }
                            }
                        }

                        if !root.compact-layout : Rectangle {
                            width: parent.width;
                            height: 72px;
                            background: transparent;

                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 12px;

                                FormField {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    label: "User";
                                    required: true;
                                    value: root.user;

                                    value-changed(value) => {
                                        root.draft-changed("user", value);
                                    }
                                }

                                FormField {
                                    width: 132px;
                                    height: parent.height;
                                    label: "Port";
                                    value: root.port;

                                    value-changed(value) => {
                                        root.draft-changed("port", value);
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        width: parent.width;
                        text: "Authentication";
                        color: ThemeTokens.text-primary;
                        font-weight: 600;
                    }

                    VerticalLayout {
                        width: parent.width;
                        spacing: 16px;

                        Rectangle {
                            width: parent.width;
                            height: root.auth-source == "keychain-identity" ? 164px : 118px;
                            background: transparent;

                            VerticalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 8px;

                                VerticalLayout {
                                    width: parent.width;
                                    spacing: 8px;

                                    Text {
                                        width: parent.width;
                                        text: "Source";
                                        color: ThemeTokens.text-primary;
                                        opacity: 0.8;
                                    }

                                    ComboBox {
                                        width: parent.width;
                                        height: 34px;
                                        model: ["Manual", "Keychain Identity"];
                                        current-value: root.auth-source == "keychain-identity" ? "Keychain Identity" : "Manual";

                                        selected(value) => {
                                            root.draft-changed("auth_source", value == "Keychain Identity" ? "keychain-identity" : "manual");
                                        }
                                    }
                                }

                                if root.auth-source == "manual" : HorizontalLayout {
                                    width: parent.width;
                                    height: 34px;
                                    spacing: 8px;

                                    for auth-option in ["password", "private-key"] : ModalTabButton {
                                        label: auth-option == "password" ? "Password" : "Private Key";
                                        active: root.auth-method == auth-option;

                                        clicked => {
                                            root.draft-changed("auth_method", auth-option);
                                        }
                                    }
                                }

                                if root.auth-source == "keychain-identity" : VerticalLayout {
                                    width: parent.width;
                                    spacing: 8px;

                                    Text {
                                        width: parent.width;
                                        text: "Identity";
                                        color: ThemeTokens.text-primary;
                                        opacity: 0.8;
                                    }

                                    ComboBox {
                                        width: parent.width;
                                        height: 34px;
                                        model: root.keychain-identity-options;
                                        current-value: root.keychain-identity-selected-label;

                                        selected(value) => {
                                            root.draft-changed("keychain_identity_label", value);
                                        }
                                    }

                                    Text {
                                        width: parent.width;
                                        text: "Username";
                                        color: ThemeTokens.text-primary;
                                        opacity: 0.8;
                                    }

                                    Text {
                                        width: parent.width;
                                        text: root.keychain-identity-username == "" ? "Not selected" : root.keychain-identity-username;
                                        color: ThemeTokens.text-primary;
                                    }

                                    Text {
                                        width: parent.width;
                                        text: "Authentication Summary";
                                        color: ThemeTokens.text-primary;
                                        opacity: 0.8;
                                    }

                                    Text {
                                        width: parent.width;
                                        text: root.keychain-identity-auth-summary == "" ? "Not selected" : root.keychain-identity-auth-summary;
                                        color: ThemeTokens.text-primary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        if root.auth-source == "manual" && root.auth-method == "password" : FormField {
                            width: parent.width;
                            label: "Password";
                            required: true;
                            value: root.password;
                            password-mode: !root.password-visible;
                            trailing-action-text: root.password-visible ? "Hide" : "Show";

                            value-changed(value) => {
                                root.draft-changed("password", value);
                            }

                            trailing-action-requested => {
                                root.draft-changed(
                                    "password_visibility",
                                    root.password-visible ? "hidden" : "visible"
                                );
                            }
                        }

                        if root.auth-source == "manual" && root.auth-method == "private-key" : VerticalLayout {
                            width: parent.width;
                            spacing: 12px;

                            Text {
                                width: parent.width;
                                text: "Only the private key is needed here. The public key must already be installed on the server.";
                                color: ThemeTokens.text-primary;
                                opacity: 0.72;
                                wrap: word-wrap;
                            }

                            if root.private-key-source == "path" : VerticalLayout {
                                width: parent.width;
                                spacing: 8px;

                                FormField {
                                    width: parent.width;
                                    label: "Legacy File Path";
                                    required: true;
                                    value: root.private-key-path;

                                    value-changed(value) => {
                                        root.draft-changed("private_key_path", value);
                                    }
                                }

                                Text {
                                    width: parent.width;
                                    text: "Paste or import a new private key to replace the legacy path.";
                                    color: ThemeTokens.text-primary;
                                    opacity: 0.72;
                                    wrap: word-wrap;
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Private Key";
                                required: root.private-key-source != "path";
                                multiline: true;
                                value: root.private-key-content;
                                trailing-action-text: "Import";

                                value-changed(value) => {
                                    root.draft-changed("private_key_content", value);
                                }

                                trailing-action-requested => {
                                    root.action-requested("import-private-key");
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Passphrase";
                                value: root.passphrase;
                                password-mode: true;

                                value-changed(value) => {
                                    root.draft-changed("passphrase", value);
                                }
                            }

                        }
                    }

                    Text {
                        width: parent.width;
                        text: "Proxy";
                        color: ThemeTokens.text-primary;
                        font-weight: 600;
                    }

                    VerticalLayout {
                        width: parent.width;
                        spacing: 16px;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 8px;

                            Text {
                                width: parent.width;
                                text: "Proxy Type";
                                color: ThemeTokens.text-primary;
                                opacity: 0.8;
                            }

                            ComboBox {
                                width: parent.width;
                                height: 34px;
                                model: ["None", "SOCKS5", "HTTP", "Existing SSH Connection"];
                                current-value: root.proxy-type == "socks5" ? "SOCKS5"
                                    : root.proxy-type == "http" ? "HTTP"
                                    : root.proxy-type == "ssh-asset" ? "Existing SSH Connection"
                                    : "None";

                                selected(value) => {
                                    root.draft-changed(
                                        "proxy_type",
                                        value == "SOCKS5" ? "socks5"
                                            : value == "HTTP" ? "http"
                                            : value == "Existing SSH Connection" ? "ssh-asset"
                                            : "none"
                                    );
                                }
                            }
                        }

                        if root.proxy-type == "socks5" : VerticalLayout {
                            width: parent.width;
                            spacing: 12px;

                            if root.compact-layout : VerticalLayout {
                                width: parent.width;
                                spacing: 12px;

                                FormField {
                                    width: parent.width;
                                    label: "SOCKS5 Host";
                                    value: root.proxy-socks5-host;

                                    value-changed(value) => {
                                        root.draft-changed("proxy_socks5_host", value);
                                    }
                                }

                                FormField {
                                    width: parent.width;
                                    label: "SOCKS5 Port";
                                    value: root.proxy-socks5-port;

                                    value-changed(value) => {
                                        root.draft-changed("proxy_socks5_port", value);
                                    }
                                }
                            }

                            if !root.compact-layout : Rectangle {
                                width: parent.width;
                                height: 72px;
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 12px;

                                    FormField {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        label: "SOCKS5 Host";
                                        value: root.proxy-socks5-host;

                                        value-changed(value) => {
                                            root.draft-changed("proxy_socks5_host", value);
                                        }
                                    }

                                    FormField {
                                        width: 132px;
                                        height: parent.height;
                                        label: "SOCKS5 Port";
                                        value: root.proxy-socks5-port;

                                        value-changed(value) => {
                                            root.draft-changed("proxy_socks5_port", value);
                                        }
                                    }
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Username";
                                value: root.proxy-socks5-username;

                                value-changed(value) => {
                                    root.draft-changed("proxy_socks5_username", value);
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Password";
                                value: root.proxy-socks5-password;
                                password-mode: !root.proxy-socks5-password-visible;
                                trailing-action-text: root.proxy-socks5-password-visible ? "Hide" : "Show";

                                value-changed(value) => {
                                    root.draft-changed("proxy_socks5_password", value);
                                }

                                trailing-action-requested => {
                                    root.draft-changed(
                                        "proxy_socks5_password_visibility",
                                        root.proxy-socks5-password-visible ? "hidden" : "visible"
                                    );
                                }
                            }
                        }

                        if root.proxy-type == "http" : VerticalLayout {
                            width: parent.width;
                            spacing: 12px;

                            if root.compact-layout : VerticalLayout {
                                width: parent.width;
                                spacing: 12px;

                                FormField {
                                    width: parent.width;
                                    label: "HTTP Host";
                                    value: root.proxy-socks5-host;

                                    value-changed(value) => {
                                        root.draft-changed("proxy_socks5_host", value);
                                    }
                                }

                                FormField {
                                    width: parent.width;
                                    label: "HTTP Port";
                                    value: root.proxy-socks5-port;

                                    value-changed(value) => {
                                        root.draft-changed("proxy_socks5_port", value);
                                    }
                                }
                            }

                            if !root.compact-layout : Rectangle {
                                width: parent.width;
                                height: 72px;
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 12px;

                                    FormField {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        label: "HTTP Host";
                                        value: root.proxy-socks5-host;

                                        value-changed(value) => {
                                            root.draft-changed("proxy_socks5_host", value);
                                        }
                                    }

                                    FormField {
                                        width: 132px;
                                        height: parent.height;
                                        label: "HTTP Port";
                                        value: root.proxy-socks5-port;

                                        value-changed(value) => {
                                            root.draft-changed("proxy_socks5_port", value);
                                        }
                                    }
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Username";
                                value: root.proxy-socks5-username;

                                value-changed(value) => {
                                    root.draft-changed("proxy_socks5_username", value);
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Password";
                                value: root.proxy-socks5-password;
                                password-mode: !root.proxy-socks5-password-visible;
                                trailing-action-text: root.proxy-socks5-password-visible ? "Hide" : "Show";

                                value-changed(value) => {
                                    root.draft-changed("proxy_socks5_password", value);
                                }

                                trailing-action-requested => {
                                    root.draft-changed(
                                        "proxy_socks5_password_visibility",
                                        root.proxy-socks5-password-visible ? "hidden" : "visible"
                                    );
                                }
                            }
                        }

                        if root.proxy-type == "ssh-asset" : VerticalLayout {
                            width: parent.width;
                            spacing: 8px;

                            Text {
                                width: parent.width;
                                text: "Upstream SSH Connection";
                                color: ThemeTokens.text-primary;
                                opacity: 0.8;
                            }

                            ComboBox {
                                width: parent.width;
                                height: 34px;
                                model: root.proxy-ssh-options;
                                current-value: root.proxy-ssh-selected-label;

                                selected(value) => {
                                    root.draft-changed("proxy_ssh_asset_label", value);
                                }
                            }
                        }
                    }

                    Text {
                        width: parent.width;
                        text: "Notes";
                        color: ThemeTokens.text-primary;
                        font-weight: 600;
                    }

                    VerticalLayout {
                        width: parent.width;
                        spacing: 12px;

                        FormField {
                            width: parent.width;
                            label: "Remark";
                            value: root.remark;
                            multiline: true;

                            value-changed(value) => {
                                root.draft-changed("remark", value);
                            }
                        }
                    }
                }
            }
        }

        footer := Rectangle {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            background: ThemeTokens.assets-surface;

            footer-content := VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 8px;

                if root.feedback-message != "" : FeedbackBanner {
                    width: parent.width;
                    state: root.feedback-state;
                    message: root.feedback-message;
                }

                if root.feedback-message == "" && root.validation-message != "" : Text {
                    width: parent.width;
                    text: root.validation-message;
                    color: ThemeTokens.text-primary;
                    opacity: 0.72;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 0px;
                    vertical-stretch: 1;
                    background: transparent;
                }

                HorizontalLayout {
                    height: 34px;
                    spacing: 12px;

                    test-button := DialogActionButton {
                        width: 84px;
                        height: 34px;
                        horizontal-stretch: 0;
                        label: "Test";
                        action-enabled: root.connect-family-enabled;

                        clicked => {
                            root.action-requested("test");
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    save-button := DialogActionButton {
                        width: 84px;
                        height: 34px;
                        horizontal-stretch: 0;
                        label: "Save";
                        primary: true;
                        action-enabled: root.can-confirm;

                        clicked => {
                            root.action-requested("save");
                        }
                    }
                }
            }
        }
    }

}
