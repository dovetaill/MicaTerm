import { ScrollView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";

component ModalTabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    min-width: 0px;
    horizontal-stretch: 1;
    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.active ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: tab-touch.pressed ? ThemeTokens.control-pressed-surface
        : tab-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.active ? ThemeTokens.control-active-surface : ThemeTokens.assets-surface;

    Text {
        width: parent.width - 16px;
        height: parent.height;
        x: 8px;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    tab-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

component DialogActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> action-enabled: true;
    callback clicked();

    min-width: 0px;
    horizontal-stretch: 1;
    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary && root.action-enabled ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: !root.action-enabled ? ThemeTokens.control-disabled-surface
        : action-touch.pressed ? ThemeTokens.control-pressed-surface
        : action-touch.has-hover ? ThemeTokens.control-hover-surface
        : root.primary ? ThemeTokens.accent : ThemeTokens.control-active-surface;
    opacity: root.action-enabled ? 1.0 : 0.56;

    Text {
        width: parent.width - 16px;
        height: parent.height;
        x: 8px;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    action-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.action-enabled;

        clicked => {
            root.clicked();
        }
    }
}

component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> required: false;
    in property <bool> password-mode: false;
    in property <bool> multiline: false;
    in property <string> trailing-action-text: "";
    callback value-changed(string);
    callback trailing-action-requested();

    private property <length> field-height: root.multiline ? 120px : 40px;

    height: root.multiline ? 154px : 72px;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 6px;

        Text {
            text: root.required ? root.label + " *" : root.label;
            color: ThemeTokens.text-primary;
            opacity: 0.8;
        }

        Rectangle {
            height: root.field-height;
            border-radius: 0px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.inspector-surface;

            field-input := TextInput {
                x: 12px;
                y: root.multiline ? 8px : 9px;
                width: parent.width - 24px - (root.trailing-action-text != "" ? 70px : 0px);
                height: parent.height - (root.multiline ? 16px : 18px);
                text: root.value;
                color: ThemeTokens.text-primary;
                single-line: !root.multiline;
                input-type: root.password-mode ? InputType.password : InputType.text;
                selection-background-color: ThemeTokens.accent;
                selection-foreground-color: ThemeTokens.text-primary;

                edited => {
                    root.value-changed(self.text);
                }
            }

            if root.trailing-action-text != "" : trailing-action := Rectangle {
                x: parent.width - 62px;
                y: 6px;
                width: 50px;
                height: 28px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: trailing-touch.pressed ? ThemeTokens.control-pressed-surface
                    : trailing-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.trailing-action-text;
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 11px;
                }

                trailing-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.trailing-action-requested();
                    }
                }
            }
        }
    }
}

component FeedbackBanner inherits Rectangle {
    in property <string> state: "idle";
    in property <string> message: "";

    height: root.message == "" ? 0px : 28px;
    visible: root.message != "";
    border-radius: 0px;
    border-width: root.message == "" ? 0px : 1px;
    border-color: root.state == "busy" ? ThemeTokens.accent : ThemeTokens.divider-strong;
    background: root.state == "busy" ? ThemeTokens.status-busy-surface
        : root.state == "success" ? ThemeTokens.status-success-surface
        : root.state == "error" ? ThemeTokens.status-error-surface
        : transparent;

    Text {
        x: 10px;
        y: 5px;
        width: parent.width - 20px;
        text: root.message;
        color: ThemeTokens.text-primary;
        overflow: elide;
    }
}

export component AssetsSshConnectionModal inherits Rectangle {
    in property <string> name: "";
    in property <string> host: "";
    in property <string> user: "";
    in property <string> port: "22";
    in property <string> auth-method: "password";
    in property <string> private-key-source: "content";
    in property <string> password: "";
    in property <string> private-key-content: "";
    in property <string> private-key-path: "";
    in property <string> passphrase: "";
    in property <bool> password-visible: false;
    in property <string> secret-retention-message: "";
    in property <bool> can-clear-saved-secret: false;
    in property <bool> clear-saved-secret-requested: false;
    in property <string> remark: "";
    in property <string> environment: "";
    in property <string> proxy-method: "";
    in property <string> validation-message: "";
    in property <bool> connect-family-enabled: false;
    in property <string> feedback-state: "idle";
    in property <string> feedback-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback draft-changed(string, string);
    callback action-requested(string);
    callback focus-restore-requested();

    private property <bool> compact-layout: root.width < 780px;
    private property <length> footer-height: root.compact-layout ? 120px : 92px;
    private property <length> body-height: max(0px, root.height - root.footer-height);

    width: 100%;
    height: 100%;
    background: transparent;

    public function focus-primary-field() {
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.focus-restore-requested();
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        body-scroll := ScrollView {
            y: 0px;
            width: parent.width;
            height: root.body-height;
            viewport-width: scroll-body.width;
            viewport-height: scroll-body.height;

            scroll-body := Rectangle {
                width: body-scroll.visible-width;
                height: max(body-scroll.visible-height, body-column.preferred-height + 24px);
                background: transparent;

                body-column := VerticalLayout {
                    x: 20px;
                    y: 20px;
                    width: parent.width - 40px;
                    spacing: 24px;

                    Rectangle {
                        width: parent.width;
                        background: transparent;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 16px;

                            Text {
                                text: "Connection";
                                color: ThemeTokens.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            Text {
                                width: parent.width;
                                text: "Define the saved SSH endpoint and default identity for this profile.";
                                color: ThemeTokens.text-primary;
                                opacity: 0.72;
                                wrap: word-wrap;
                            }

                            if root.compact-layout : VerticalLayout {
                                width: parent.width;
                                spacing: 12px;

                                FormField {
                                    width: parent.width;
                                    label: "Name";
                                    required: true;
                                    value: root.name;

                                    value-changed(value) => {
                                        root.draft-changed("name", value);
                                    }
                                }

                                FormField {
                                    width: parent.width;
                                    label: "Host";
                                    required: true;
                                    value: root.host;

                                    value-changed(value) => {
                                        root.draft-changed("host", value);
                                    }
                                }

                                FormField {
                                    width: parent.width;
                                    label: "User";
                                    required: true;
                                    value: root.user;

                                    value-changed(value) => {
                                        root.draft-changed("user", value);
                                    }
                                }

                                FormField {
                                    width: parent.width;
                                    label: "Port";
                                    value: root.port;

                                    value-changed(value) => {
                                        root.draft-changed("port", value);
                                    }
                                }
                            }

                            if !root.compact-layout : Rectangle {
                                width: parent.width;
                                height: 72px;
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 12px;

                                    FormField {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        label: "Name";
                                        required: true;
                                        value: root.name;

                                        value-changed(value) => {
                                            root.draft-changed("name", value);
                                        }
                                    }

                                    FormField {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        label: "Host";
                                        required: true;
                                        value: root.host;

                                        value-changed(value) => {
                                            root.draft-changed("host", value);
                                        }
                                    }
                                }
                            }

                            if !root.compact-layout : Rectangle {
                                width: parent.width;
                                height: 72px;
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 12px;

                                    FormField {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        label: "User";
                                        required: true;
                                        value: root.user;

                                        value-changed(value) => {
                                            root.draft-changed("user", value);
                                        }
                                    }

                                    FormField {
                                        width: 148px;
                                        height: parent.height;
                                        label: "Port";
                                        value: root.port;

                                        value-changed(value) => {
                                            root.draft-changed("port", value);
                                        }
                                    }
                                }
                            }

                        }
                    }

                    Rectangle {
                        width: parent.width;
                        background: transparent;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 16px;

                            Text {
                                text: "Authentication";
                                color: ThemeTokens.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            Text {
                                width: parent.width;
                                text: "Pick how the session authenticates and keep sensitive values inside the same dialog.";
                                color: ThemeTokens.text-primary;
                                opacity: 0.72;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                height: 34px;
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 8px;

                                    for auth-option in ["password", "private-key"] : ModalTabButton {
                                        label: auth-option == "password" ? "Password" : "Private Key";
                                        active: root.auth-method == auth-option;

                                        clicked => {
                                            root.draft-changed("auth_method", auth-option);
                                        }
                                    }
                                }
                            }

                            if root.secret-retention-message != "" : VerticalLayout {
                                width: parent.width;
                                spacing: 8px;

                                Text {
                                    width: parent.width;
                                    text: root.secret-retention-message;
                                    color: ThemeTokens.text-primary;
                                    opacity: 0.72;
                                    wrap: word-wrap;
                                }

                                if root.can-clear-saved-secret : Rectangle {
                                    width: parent.width;
                                    height: root.clear-saved-secret-requested ? 56px : 34px;
                                    background: transparent;

                                    VerticalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        spacing: 6px;

                                        ModalTabButton {
                                            width: 180px;
                                            horizontal-stretch: 0;
                                            label: root.clear-saved-secret-requested ? "Keep Saved Secret" : "Clear Saved Secret";
                                            active: root.clear-saved-secret-requested;

                                            clicked => {
                                                root.draft-changed(
                                                    "clear_saved_secret",
                                                    root.clear-saved-secret-requested ? "false" : "true"
                                                );
                                            }
                                        }

                                        if root.clear-saved-secret-requested : Text {
                                            width: parent.width;
                                            text: "Saved secret will be removed on Save.";
                                            color: ThemeTokens.text-primary;
                                            opacity: 0.72;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            if root.auth-method == "password" : FormField {
                                width: parent.width;
                                label: "Password";
                                required: true;
                                value: root.password;
                                password-mode: !root.password-visible;
                                trailing-action-text: root.password-visible ? "Hide" : "Show";

                                value-changed(value) => {
                                    root.draft-changed("password", value);
                                }

                                trailing-action-requested => {
                                    root.draft-changed(
                                        "password_visibility",
                                        root.password-visible ? "hidden" : "visible"
                                    );
                                }
                            }

                            if root.auth-method == "private-key" : Rectangle {
                                width: parent.width;
                                background: transparent;

                                VerticalLayout {
                                    width: parent.width;
                                    spacing: 12px;

                                    Rectangle {
                                        height: 34px;
                                        background: transparent;

                                        HorizontalLayout {
                                            width: parent.width;
                                            height: parent.height;
                                            spacing: 8px;

                                            for key-option in ["content", "path"] : ModalTabButton {
                                                label: key-option == "content" ? "Inline Content" : "File Path";
                                                active: root.private-key-source == key-option;

                                                clicked => {
                                                    root.draft-changed("private_key_source", key-option);
                                                }
                                            }
                                        }
                                    }

                                    if root.private-key-source == "content" : FormField {
                                        width: parent.width;
                                        label: "Private Key Content";
                                        required: true;
                                        multiline: true;
                                        value: root.private-key-content;

                                        value-changed(value) => {
                                            root.draft-changed("private_key_content", value);
                                        }
                                    }

                                    if root.private-key-source == "path" : FormField {
                                        width: parent.width;
                                        label: "Private Key Path";
                                        required: true;
                                        value: root.private-key-path;

                                        value-changed(value) => {
                                            root.draft-changed("private_key_path", value);
                                        }
                                    }

                                    FormField {
                                        width: parent.width;
                                        label: "Passphrase";
                                        value: root.passphrase;
                                        password-mode: true;

                                        value-changed(value) => {
                                            root.draft-changed("passphrase", value);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: parent.width;
                        background: transparent;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 16px;

                            Text {
                                text: "Metadata";
                                color: ThemeTokens.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            Text {
                                width: parent.width;
                                text: "Capture operator notes and profile context without leaving the dialog.";
                                color: ThemeTokens.text-primary;
                                opacity: 0.72;
                                wrap: word-wrap;
                            }

                            FormField {
                                width: parent.width;
                                label: "Remark";
                                value: root.remark;
                                multiline: true;

                                value-changed(value) => {
                                    root.draft-changed("remark", value);
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: parent.width;
                        background: transparent;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 16px;

                            Text {
                                text: "More Settings";
                                color: ThemeTokens.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            Text {
                                width: parent.width;
                                text: "Keep environment overrides and proxy hints attached to the same SSH profile.";
                                color: ThemeTokens.text-primary;
                                opacity: 0.72;
                                wrap: word-wrap;
                            }

                            FormField {
                                width: parent.width;
                                label: "Environment";
                                value: root.environment;
                                multiline: true;

                                value-changed(value) => {
                                    root.draft-changed("environment", value);
                                }
                            }

                            FormField {
                                width: parent.width;
                                label: "Proxy Method";
                                value: root.proxy-method;

                                value-changed(value) => {
                                    root.draft-changed("proxy_method", value);
                                }
                            }
                        }
                    }
                }
            }
        }

        footer := Rectangle {
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            background: ThemeTokens.assets-surface;

            footer-divider := Rectangle {
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }

            footer-column := VerticalLayout {
                x: 20px;
                y: 12px;
                width: parent.width - 40px;
                height: parent.height - 24px;
                spacing: 8px;

                FeedbackBanner {
                    width: parent.width;
                    state: root.feedback-state;
                    message: root.feedback-message;
                }

                if root.validation-message != "" : Text {
                    width: parent.width;
                    text: root.validation-message;
                    color: ThemeTokens.text-primary;
                    opacity: 0.72;
                    wrap: word-wrap;
                }

                if root.compact-layout : VerticalLayout {
                    width: parent.width;
                    spacing: 8px;

                    HorizontalLayout {
                        width: parent.width;
                        spacing: 8px;

                        DialogActionButton {
                            label: "Test Connection";
                            action-enabled: root.connect-family-enabled;

                            clicked => {
                                root.action-requested("test");
                            }
                        }

                        DialogActionButton {
                            label: "Connect";
                            action-enabled: root.connect-family-enabled;

                            clicked => {
                                root.action-requested("connect");
                            }
                        }
                    }

                    HorizontalLayout {
                        width: parent.width;
                        spacing: 8px;

                        DialogActionButton {
                            label: "Save";
                            primary: true;
                            action-enabled: root.can-confirm;

                            clicked => {
                                root.action-requested("save");
                            }
                        }

                        DialogActionButton {
                            label: "Save and Connect";
                            action-enabled: root.connect-family-enabled;

                            clicked => {
                                root.action-requested("save-and-connect");
                            }
                        }
                    }
                }

                if !root.compact-layout : HorizontalLayout {
                    width: parent.width;
                    spacing: 8px;

                    DialogActionButton {
                        label: "Test Connection";
                        action-enabled: root.connect-family-enabled;

                        clicked => {
                            root.action-requested("test");
                        }
                    }

                    DialogActionButton {
                        label: "Connect";
                        action-enabled: root.connect-family-enabled;

                        clicked => {
                            root.action-requested("connect");
                        }
                    }

                    DialogActionButton {
                        label: "Save";
                        primary: true;
                        action-enabled: root.can-confirm;

                        clicked => {
                            root.action-requested("save");
                        }
                    }

                    DialogActionButton {
                        label: "Save and Connect";
                        action-enabled: root.connect-family-enabled;

                        clicked => {
                            root.action-requested("save-and-connect");
                        }
                    }
                }
            }
        }
    }

    changed focus-sequence => {
        root.focus-primary-field();
    }
}
