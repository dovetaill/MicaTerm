import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsSshConnectionModal inherits Rectangle {
    in property <string> active-tab: "standard";
    in property <string> name: "";
    in property <string> host: "";
    in property <string> user: "";
    in property <string> port: "22";
    in property <string> auth-method: "password";
    in property <string> private-key-source: "content";
    in property <string> password: "";
    in property <string> private-key-content: "";
    in property <string> private-key-path: "";
    in property <string> passphrase: "";
    in property <string> remark: "";
    in property <string> environment: "";
    in property <string> proxy-method: "";
    in property <string> validation-message: "";
    in property <bool> connect-family-enabled: false;
    in property <string> feedback-state: "idle";
    in property <string> feedback-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback confirm-requested();
    callback tab-selected(string);
    callback draft-changed(string, string);
    callback action-requested(string);

    width: 760px;
    height: 720px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-strong;
    background: ThemeTokens.assets-surface;

    public function focus-primary-field() {
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Text {
                x: 24px;
                y: 22px;
                text: "New SSH Connection";
                color: ThemeTokens.text-primary;
                font-size: 20px;
                font-weight: 700;
            }

            close-button := Rectangle {
                x: parent.width - 56px;
                y: 18px;
                width: 32px;
                height: 32px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.control-hover-surface;

                Text {
                    text: "×";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.close-requested();
                    }
                }
            }

            Rectangle {
                x: 24px;
                y: 72px;
                width: parent.width - 48px;
                height: 40px;
                background: transparent;

                HorizontalLayout {
                    spacing: 8px;

                    for tab-id in ["standard", "tunnel", "proxy", "environment", "advanced"] : Rectangle {
                        min-width: 110px;
                        height: 36px;
                        border-radius: 0px;
                        border-width: 1px;
                        border-color: root.active-tab == tab-id ? ThemeTokens.accent : ThemeTokens.divider-subtle;
                        background: root.active-tab == tab-id ? ThemeTokens.control-active-surface : ThemeTokens.control-hover-surface;

                        Text {
                            text: tab-id == "standard" ? "Standard" :
                                  tab-id == "tunnel" ? "Tunnel" :
                                  tab-id == "proxy" ? "Proxy" :
                                  tab-id == "environment" ? "Environment" : "Advanced";
                            color: ThemeTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }

                        TouchArea {
                            width: parent.width;
                            height: parent.height;

                            clicked => {
                                root.tab-selected(tab-id);
                            }
                        }
                    }
                }
            }

            if root.active-tab == "standard" : Rectangle {
                x: 24px;
                y: 132px;
                width: parent.width - 48px;
                height: 484px;
                background: transparent;

                VerticalLayout {
                    spacing: 14px;

                    Text {
                        text: "Connection";
                        color: ThemeTokens.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;

                            VerticalLayout {
                                spacing: 6px;

                                Text {
                                    text: "Name *";
                                    color: ThemeTokens.text-primary;
                                }

                                Rectangle {
                                    height: 40px;
                                    border-radius: 0px;
                                    border-width: 1px;
                                    border-color: ThemeTokens.divider-subtle;
                                    background: ThemeTokens.inspector-surface;

                                    name_input := TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: 20px;
                                        text: root.name;
                                        color: ThemeTokens.text-primary;
                                        selection-background-color: ThemeTokens.accent;
                                        selection-foreground-color: ThemeTokens.text-primary;

                                        edited => {
                                            root.draft-changed("name", self.text);
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;

                            VerticalLayout {
                                spacing: 6px;

                                Text {
                                    text: "Host *";
                                    color: ThemeTokens.text-primary;
                                }

                                Rectangle {
                                    height: 40px;
                                    border-radius: 0px;
                                    border-width: 1px;
                                    border-color: ThemeTokens.divider-subtle;
                                    background: ThemeTokens.inspector-surface;

                                    TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: 20px;
                                        text: root.host;
                                        color: ThemeTokens.text-primary;
                                        selection-background-color: ThemeTokens.accent;
                                        selection-foreground-color: ThemeTokens.text-primary;

                                        edited => {
                                            root.draft-changed("host", self.text);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;

                            VerticalLayout {
                                spacing: 6px;

                                Text {
                                    text: "User *";
                                    color: ThemeTokens.text-primary;
                                }

                                Rectangle {
                                    height: 40px;
                                    border-radius: 0px;
                                    border-width: 1px;
                                    border-color: ThemeTokens.divider-subtle;
                                    background: ThemeTokens.inspector-surface;

                                    TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: 20px;
                                        text: root.user;
                                        color: ThemeTokens.text-primary;
                                        selection-background-color: ThemeTokens.accent;
                                        selection-foreground-color: ThemeTokens.text-primary;

                                        edited => {
                                            root.draft-changed("user", self.text);
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: 140px;
                            background: transparent;

                            VerticalLayout {
                                spacing: 6px;

                                Text {
                                    text: "Port";
                                    color: ThemeTokens.text-primary;
                                }

                                Rectangle {
                                    height: 40px;
                                    border-radius: 0px;
                                    border-width: 1px;
                                    border-color: ThemeTokens.divider-subtle;
                                    background: ThemeTokens.inspector-surface;

                                    TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: 20px;
                                        text: root.port;
                                        color: ThemeTokens.text-primary;
                                        selection-background-color: ThemeTokens.accent;
                                        selection-foreground-color: ThemeTokens.text-primary;

                                        edited => {
                                            root.draft-changed("port", self.text);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: "Authentication";
                        color: ThemeTokens.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 38px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 8px;

                            for auth-option in ["password", "private-key"] : Rectangle {
                                min-width: 140px;
                                height: 34px;
                                border-radius: 0px;
                                border-width: 1px;
                                border-color: root.auth-method == auth-option ? ThemeTokens.accent : ThemeTokens.divider-subtle;
                                background: root.auth-method == auth-option ? ThemeTokens.control-active-surface : ThemeTokens.control-hover-surface;

                                Text {
                                    text: auth-option == "password" ? "Password" : "Private Key";
                                    color: ThemeTokens.text-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }

                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;

                                    clicked => {
                                        root.draft-changed("auth_method", auth-option);
                                    }
                                }
                            }
                        }
                    }

                    if root.auth-method == "password" : Rectangle {
                        background: transparent;

                        VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "Password *";
                                color: ThemeTokens.text-primary;
                            }

                            Rectangle {
                                height: 40px;
                                border-radius: 0px;
                                border-width: 1px;
                                border-color: ThemeTokens.divider-subtle;
                                background: ThemeTokens.inspector-surface;

                                TextInput {
                                    x: 12px;
                                    y: 10px;
                                    width: parent.width - 24px;
                                    height: 20px;
                                    text: root.password;
                                    color: ThemeTokens.text-primary;
                                    selection-background-color: ThemeTokens.accent;
                                    selection-foreground-color: ThemeTokens.text-primary;

                                    edited => {
                                        root.draft-changed("password", self.text);
                                    }
                                }
                            }
                        }
                    }

                    if root.auth-method == "private-key" : Rectangle {
                        background: transparent;

                        VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: "Private Key Source";
                                color: ThemeTokens.text-primary;
                            }

                            Rectangle {
                                height: 38px;
                                background: transparent;

                                HorizontalLayout {
                                    spacing: 8px;

                                    for key-option in ["content", "path"] : Rectangle {
                                        min-width: 140px;
                                        height: 34px;
                                        border-radius: 0px;
                                        border-width: 1px;
                                        border-color: root.private-key-source == key-option ? ThemeTokens.accent : ThemeTokens.divider-subtle;
                                        background: root.private-key-source == key-option ? ThemeTokens.control-active-surface : ThemeTokens.control-hover-surface;

                                        Text {
                                            text: key-option == "content" ? "Inline Content" : "File Path";
                                            color: ThemeTokens.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }

                                        TouchArea {
                                            width: parent.width;
                                            height: parent.height;

                                            clicked => {
                                                root.draft-changed("private_key_source", key-option);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.private-key-source == "content" : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: "Private Key Content *";
                                        color: ThemeTokens.text-primary;
                                    }

                                    Rectangle {
                                        height: 40px;
                                        border-radius: 0px;
                                        border-width: 1px;
                                        border-color: ThemeTokens.divider-subtle;
                                        background: ThemeTokens.inspector-surface;

                                        TextInput {
                                            x: 12px;
                                            y: 10px;
                                            width: parent.width - 24px;
                                            height: 20px;
                                            text: root.private-key-content;
                                            color: ThemeTokens.text-primary;
                                            selection-background-color: ThemeTokens.accent;
                                            selection-foreground-color: ThemeTokens.text-primary;

                                            edited => {
                                                root.draft-changed("private_key_content", self.text);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.private-key-source == "path" : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: "Private Key Path *";
                                        color: ThemeTokens.text-primary;
                                    }

                                    Rectangle {
                                        height: 40px;
                                        border-radius: 0px;
                                        border-width: 1px;
                                        border-color: ThemeTokens.divider-subtle;
                                        background: ThemeTokens.inspector-surface;

                                        TextInput {
                                            x: 12px;
                                            y: 10px;
                                            width: parent.width - 24px;
                                            height: 20px;
                                            text: root.private-key-path;
                                            color: ThemeTokens.text-primary;
                                            selection-background-color: ThemeTokens.accent;
                                            selection-foreground-color: ThemeTokens.text-primary;

                                            edited => {
                                                root.draft-changed("private_key_path", self.text);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: "Passphrase";
                                        color: ThemeTokens.text-primary;
                                    }

                                    Rectangle {
                                        height: 40px;
                                        border-radius: 0px;
                                        border-width: 1px;
                                        border-color: ThemeTokens.divider-subtle;
                                        background: ThemeTokens.inspector-surface;

                                        TextInput {
                                            x: 12px;
                                            y: 10px;
                                            width: parent.width - 24px;
                                            height: 20px;
                                            text: root.passphrase;
                                            color: ThemeTokens.text-primary;
                                            selection-background-color: ThemeTokens.accent;
                                            selection-foreground-color: ThemeTokens.text-primary;

                                            edited => {
                                                root.draft-changed("passphrase", self.text);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: "Metadata";
                        color: ThemeTokens.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    Rectangle {
                        background: transparent;

                        VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "Remark";
                                color: ThemeTokens.text-primary;
                            }

                            Rectangle {
                                height: 40px;
                                border-radius: 0px;
                                border-width: 1px;
                                border-color: ThemeTokens.divider-subtle;
                                background: ThemeTokens.inspector-surface;

                                TextInput {
                                    x: 12px;
                                    y: 10px;
                                    width: parent.width - 24px;
                                    height: 20px;
                                    text: root.remark;
                                    color: ThemeTokens.text-primary;
                                    selection-background-color: ThemeTokens.accent;
                                    selection-foreground-color: ThemeTokens.text-primary;

                                    edited => {
                                        root.draft-changed("remark", self.text);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.active-tab == "tunnel" : Rectangle {
                x: 24px;
                y: 132px;
                width: parent.width - 48px;
                height: 484px;
                background: ThemeTokens.inspector-surface;

                Text {
                    text: "Tunnel settings are not wired in this phase.";
                    color: ThemeTokens.text-primary;
                    x: 16px;
                    y: 16px;
                }
            }

            if root.active-tab == "proxy" : Rectangle {
                x: 24px;
                y: 132px;
                width: parent.width - 48px;
                height: 484px;
                background: ThemeTokens.inspector-surface;

                Text {
                    text: "Proxy settings are not wired in this phase.";
                    color: ThemeTokens.text-primary;
                    x: 16px;
                    y: 16px;
                }
            }

            if root.active-tab == "environment" : Rectangle {
                x: 24px;
                y: 132px;
                width: parent.width - 48px;
                height: 484px;
                background: ThemeTokens.inspector-surface;

                Text {
                    text: "Environment settings are not wired in this phase.";
                    color: ThemeTokens.text-primary;
                    x: 16px;
                    y: 16px;
                }
            }

            if root.active-tab == "advanced" : Rectangle {
                x: 24px;
                y: 132px;
                width: parent.width - 48px;
                height: 484px;
                background: ThemeTokens.inspector-surface;

                Text {
                    text: "Advanced settings are not wired in this phase.";
                    color: ThemeTokens.text-primary;
                    x: 16px;
                    y: 16px;
                }
            }

            feedback-panel := Rectangle {
                x: 24px;
                y: 596px;
                width: parent.width - 48px;
                height: 28px;
                border-radius: 0px;
                border-width: 1px;
                border-color: root.feedback-state == "busy" ? ThemeTokens.accent
                    : root.feedback-state == "success" ? ThemeTokens.divider-strong
                    : root.feedback-state == "error" ? ThemeTokens.divider-strong
                    : transparent;
                background: root.feedback-state == "busy" ? ThemeTokens.status-busy-surface
                    : root.feedback-state == "success" ? ThemeTokens.status-success-surface
                    : root.feedback-state == "error" ? ThemeTokens.status-error-surface
                    : transparent;
                visible: root.feedback-message != "";

                Text {
                    x: 10px;
                    y: 5px;
                    width: parent.width - 20px;
                    text: root.feedback-message;
                    color: ThemeTokens.text-primary;
                    overflow: elide;
                }
            }

            validation-copy := Text {
                x: 24px;
                y: 632px;
                width: parent.width - 48px;
                text: root.validation-message;
                color: ThemeTokens.text-primary;
                opacity: 0.72;
                visible: root.validation-message != "";
                wrap: word-wrap;
            }

            test-button := Rectangle {
                x: parent.width - 492px;
                y: parent.height - 56px;
                width: 132px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: root.connect-family-enabled ? ThemeTokens.divider-subtle : ThemeTokens.divider-subtle;
                background: !root.connect-family-enabled ? ThemeTokens.control-disabled-surface
                    : test-touch.pressed ? ThemeTokens.control-pressed-surface
                    : test-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;
                opacity: root.connect-family-enabled ? 1.0 : 0.64;

                Text {
                    text: "Test Connection";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                test-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        if root.connect-family-enabled {
                            root.action-requested("test");
                        }
                    }
                }
            }

            connect-button := Rectangle {
                x: parent.width - 348px;
                y: parent.height - 56px;
                width: 100px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: !root.connect-family-enabled ? ThemeTokens.control-disabled-surface
                    : connect-touch.pressed ? ThemeTokens.control-pressed-surface
                    : connect-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;
                opacity: root.connect-family-enabled ? 1.0 : 0.64;

                Text {
                    text: "Connect";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                connect-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        if root.connect-family-enabled {
                            root.action-requested("connect");
                        }
                    }
                }
            }

            save-button := Rectangle {
                x: parent.width - 236px;
                y: parent.height - 56px;
                width: 88px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: root.can-confirm ? ThemeTokens.accent : ThemeTokens.divider-subtle;
                background: !root.can-confirm ? ThemeTokens.control-disabled-surface
                    : save-touch.pressed ? ThemeTokens.control-pressed-surface
                    : save-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.accent;
                opacity: root.can-confirm ? 1.0 : 0.64;

                Text {
                    text: "Save";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                save-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        if root.can-confirm {
                            root.action-requested("save");
                        }
                    }
                }
            }

            save-connect-button := Rectangle {
                x: parent.width - 136px;
                y: parent.height - 56px;
                width: 112px;
                height: 34px;
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: !root.connect-family-enabled ? ThemeTokens.control-disabled-surface
                    : save-connect-touch.pressed ? ThemeTokens.control-pressed-surface
                    : save-connect-touch.has-hover ? ThemeTokens.control-hover-surface
                    : ThemeTokens.control-active-surface;
                opacity: root.connect-family-enabled ? 1.0 : 0.64;

                Text {
                    text: "Save and Connect";
                    color: ThemeTokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                save-connect-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        if root.connect-family-enabled {
                            root.action-requested("save-and-connect");
                        }
                    }
                }
            }
        }
    }

    changed focus-sequence => {
        root.focus-primary-field();
    }
}
