import {
    DialogActionButton,
    DialogFormSection,
    DialogInlineBanner,
    DialogSelectField,
    DialogSelectPopup,
    DialogSectionCard,
    DialogSegmentButton,
    DialogTextField,
    ModalBodyScrollArea,
    ModalFooterBar,
    ModalHeaderBar,
} from "./modal-chrome.slint";
import { ThemeTokens } from "../theme/tokens.slint";

export component AssetsSshConnectionModal inherits Rectangle {
    in property <string> dialog-title: "New SSH Connection";
    in property <string> name: "";
    in property <string> host: "";
    in property <string> user: "";
    in property <string> port: "22";
    in property <string> auth-source: "manual";
    in property <[string]> keychain-identity-options: [];
    in property <string> keychain-identity-selected-label: "";
    in property <string> keychain-identity-username: "";
    in property <string> keychain-identity-auth-summary: "";
    in property <string> auth-method: "password";
    in property <string> private-key-source: "content";
    in property <string> password: "";
    in property <string> private-key-content: "";
    in property <string> private-key-path: "";
    in property <string> passphrase: "";
    in property <bool> password-visible: false;
    in property <bool> passphrase-visible: false;
    in property <string> remark: "";
    in property <string> environment: "";
    in property <string> proxy-type: "none";
    in property <string> proxy-socks5-host: "";
    in property <string> proxy-socks5-port: "";
    in property <string> proxy-socks5-username: "";
    in property <string> proxy-socks5-password: "";
    in property <bool> proxy-socks5-password-visible: false;
    in property <string> proxy-ssh-asset-id: "";
    in property <[string]> proxy-ssh-options: [];
    in property <string> proxy-ssh-selected-label: "";
    in property <string> proxy-method: "";
    in property <string> validation-message: "";
    in property <bool> connect-family-enabled: false;
    in property <string> feedback-state: "idle";
    in property <string> feedback-message: "";
    in property <bool> can-confirm: false;
    in property <int> focus-sequence: 0;
    callback close-requested();
    callback draft-changed(string, string);
    callback action-requested(string);
    callback drag-requested(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback focus-restore-requested();
    out property <bool> select-overlay-open: root.open-select-id != "";

    private property <bool> compact-layout: root.width < 620px;
    private property <bool> dense-layout: root.height < 620px;
    private property <image> eye-icon: @image-url("../../assets/icons/fluent/eye-20-regular.svg");
    private property <image> eye-off-icon: @image-url("../../assets/icons/fluent/eye-off-20-regular.svg");
    private property <string> open-select-id: "";
    private property <[string]> open-select-options: [];
    private property <length> select-popup-x: 0px;
    private property <length> select-popup-y: 0px;
    private property <length> select-popup-width: 0px;
    private property <length> select-popup-max-height: 0px;
    private property <bool> select-popup-opens-upward: false;
    private property <int> select-popup-highlighted-index: -1;
    private property <int> select-popup-focus-sequence: 0;
    private property <int> auth-source-select-focus-sequence: 0;
    private property <int> keychain-identity-select-focus-sequence: 0;
    private property <int> proxy-type-select-focus-sequence: 0;
    private property <int> proxy-ssh-select-focus-sequence: 0;
    private property <length> select-popup-gap: 6px;
    private property <length> select-popup-option-height: 32px;
    private property <length> select-popup-default-max-height: 240px;
    private property <length> footer-height: root.feedback-message != "" || root.validation-message != ""
        ? root.dense-layout ? 114px : 132px
        : ThemeTokens.modal-footer-min-height;

    background: transparent;

    public function focus-input() {
        modal-focus.focus();
    }

    public function dismiss-open-select() {
        if root.open-select-id == "" {
            return;
        }

        if root.open-select-id == "auth_source" {
            root.auth-source-select-focus-sequence += 1;
        } else if root.open-select-id == "keychain_identity_label" {
            root.keychain-identity-select-focus-sequence += 1;
        } else if root.open-select-id == "proxy_type" {
            root.proxy-type-select-focus-sequence += 1;
        } else if root.open-select-id == "proxy_ssh_asset_label" {
            root.proxy-ssh-select-focus-sequence += 1;
        } else {
            modal-focus.focus();
        }

        root.open-select-id = "";
        root.open-select-options = [];
        root.select-popup-highlighted-index = -1;
        root.select-popup-max-height = 0px;
    }

    function popup-preferred-height(option-count: int) -> length {
        return min(
            root.select-popup-default-max-height,
            8px + option-count * root.select-popup-option-height + 8px
        );
    }

    function open-select(
        select-id: string,
        anchor-x: length,
        anchor-y: length,
        anchor-width: length,
        option-count: int,
        highlighted-index: int,
    ) {
        if root.open-select-id == select-id {
            root.dismiss-open-select();
            return;
        }

        let preferred-height = root.popup-preferred-height(option-count);
        let below-space = max(0px, footer.y - (anchor-y + 34px) - root.select-popup-gap);
        let above-space = max(0px, anchor-y - body-scroll.y - root.select-popup-gap);
        if below-space >= preferred-height || below-space >= above-space {
            root.select-popup-opens-upward = false;
            root.select-popup-max-height = min(preferred-height, below-space);
            root.select-popup-y = anchor-y + 34px + root.select-popup-gap;
        } else {
            root.select-popup-opens-upward = true;
            root.select-popup-max-height = min(preferred-height, above-space);
            root.select-popup-y = anchor-y - root.select-popup-max-height - root.select-popup-gap;
        }
        root.select-popup-x = max(18px, min(root.width - anchor-width - 18px, anchor-x));
        root.select-popup-width = anchor-width;
        root.select-popup-highlighted-index = highlighted-index;
        root.open-select-id = select-id;
        root.select-popup-focus-sequence += 1;
    }

    changed focus-sequence => {
        root.focus-input();
    }

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        header := ModalHeaderBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            title: root.dialog-title;
            subtitle: root.dense-layout ? "" : "Edit the connection profile, authentication, and optional proxy settings.";
            prominent: true;

            close-requested => {
                root.close-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.drag-ended();
            }

            focus-restore-requested => {
                root.focus-restore-requested();
            }
        }

        body-scroll := ModalBodyScrollArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height - footer.height;
            frame-padding: root.dense-layout ? 12px : 14px;
            content-padding-horizontal: root.dense-layout ? 15px : 17px;
            content-padding-vertical: root.dense-layout ? 12px : 16px;
            content-padding-bottom: root.dense-layout ? 12px : 18px;
            content-spacing: root.dense-layout ? 10px : 14px;
            viewport-surface: ThemeTokens.modal-body-surface;
            panel-surface: ThemeTokens.modal-body-surface;
            panel-border-color: transparent;

            content-column := Rectangle {
                width: body-scroll.content-column-width;
                height: content-layout.preferred-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    spacing: body-scroll.content-spacing;

                    DialogFormSection {
                        width: parent.width;
                        title: "Connection";
                        description: root.dense-layout ? "" : "Keep the core profile compact. Authentication, proxy chain, and notes live in the sections below.";

                        if root.compact-layout : VerticalLayout {
                            width: parent.width;
                            spacing: 12px;

                            compact-name-field := DialogTextField {
                                width: parent.width;
                                label: "Name";
                                required: true;
                                value: root.name;
                                invalid: root.validation-message != "";
                                helper-text: root.validation-message;

                                value-changed(value) => {
                                    root.draft-changed("name", value);
                                }
                            }

                            DialogTextField {
                                width: parent.width;
                                label: "Host";
                                required: true;
                                value: root.host;

                                value-changed(value) => {
                                    root.draft-changed("host", value);
                                }
                            }

                            DialogTextField {
                                width: parent.width;
                                label: "User";
                                required: true;
                                value: root.user;

                                value-changed(value) => {
                                    root.draft-changed("user", value);
                                }
                            }

                            DialogTextField {
                                width: parent.width;
                                label: "Port";
                                value: root.port;

                                value-changed(value) => {
                                    root.draft-changed("port", value);
                                }
                            }
                        }

                        if !root.compact-layout : name-host-row := Rectangle {
                            width: parent.width;
                            height: max(wide-name-field.height, host-field.height);
                            background: transparent;

                            HorizontalLayout {
                                width: parent.width;
                                spacing: 14px;

                                wide-name-field := DialogTextField {
                                    width: max(0px, (parent.width - 14px) / 2);
                                    label: "Name";
                                    required: true;
                                    value: root.name;
                                    invalid: root.validation-message != "";
                                    helper-text: root.validation-message;

                                    value-changed(value) => {
                                        root.draft-changed("name", value);
                                    }
                                }

                                host-field := DialogTextField {
                                    width: max(0px, (parent.width - 14px) / 2);
                                    label: "Host";
                                    required: true;
                                    value: root.host;

                                    value-changed(value) => {
                                        root.draft-changed("host", value);
                                    }
                                }
                            }
                        }

                        if !root.compact-layout : user-port-row := Rectangle {
                            width: parent.width;
                            height: max(user-field.height, port-field.height);
                            background: transparent;

                            HorizontalLayout {
                                width: parent.width;
                                spacing: 14px;

                                user-field := DialogTextField {
                                    width: max(0px, parent.width - 156px);
                                    label: "User";
                                    required: true;
                                    value: root.user;

                                    value-changed(value) => {
                                        root.draft-changed("user", value);
                                    }
                                }

                                port-field := DialogTextField {
                                    width: 142px;
                                    label: "Port";
                                    value: root.port;

                                    value-changed(value) => {
                                        root.draft-changed("port", value);
                                    }
                                }
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Authentication";
                        description: root.dense-layout ? "" : "Choose whether this connection stores its own secret material or points at a shared identity.";

                        Rectangle {
                            width: parent.width;
                            height: 88px;
                            background: transparent;

                            VerticalLayout {
                                width: parent.width;
                                spacing: 8px;

                                Text {
                                    width: parent.width;
                                    text: "Source";
                                    color: ThemeTokens.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }

                                auth-source-select := DialogSelectField {
                                    width: parent.width;
                                    height: 34px;
                                    label: "Source";
                                    focus-sequence: root.auth-source-select-focus-sequence;
                                    open: root.open-select-id == "auth_source";
                                    selected-label: root.auth-source == "keychain-identity" ? "Keychain Identity" : "Manual";
                                    placeholder-text: "Select source";

                                    toggle-requested => {
                                        root.open-select-options = ["Manual", "Keychain Identity"];
                                        root.open-select(
                                            "auth_source",
                                            self.absolute-position.x - root.absolute-position.x,
                                            self.absolute-position.y - root.absolute-position.y,
                                            self.width,
                                            root.open-select-options.length,
                                            root.auth-source == "keychain-identity" ? 1 : 0
                                        );
                                    }

                                }

                                Text {
                                    width: parent.width;
                                    text: root.auth-source == "manual"
                                        ? "Keep secrets local to this connection, or switch to a shared keychain identity."
                                        : "The selected keychain identity controls username and auth material for this profile.";
                                    color: ThemeTokens.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.auth-source == "manual" : Rectangle {
                            width: parent.width;
                            height: 34px;
                            background: transparent;

                            HorizontalLayout {
                                width: parent.width;
                                spacing: 8px;

                                DialogSegmentButton {
                                    horizontal-stretch: 1;
                                    label: "Password";
                                    active: root.auth-method == "password";

                                    clicked => {
                                        root.draft-changed("auth_method", "password");
                                    }
                                }

                                DialogSegmentButton {
                                    horizontal-stretch: 1;
                                    label: "Private Key";
                                    active: root.auth-method == "private-key";

                                    clicked => {
                                        root.draft-changed("auth_method", "private-key");
                                    }
                                }
                            }
                        }

                        if root.auth-source == "keychain-identity" : DialogSectionCard {
                            width: parent.width;
                            padding-horizontal: 16px;
                            padding-vertical: 14px;
                            spacing: 10px;
                            surface: ThemeTokens.modal-section-surface;

                            keychain-identity-select-group := Rectangle {
                                width: parent.width;
                                height: 58px;
                                background: transparent;

                                VerticalLayout {
                                    width: parent.width;
                                    spacing: 10px;

                                    Text {
                                        width: parent.width;
                                        text: "Identity";
                                        color: ThemeTokens.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                    }

                                    keychain-identity-select := DialogSelectField {
                                        width: parent.width;
                                        height: 34px;
                                        label: "Identity";
                                        focus-sequence: root.keychain-identity-select-focus-sequence;
                                        open: root.open-select-id == "keychain_identity_label";
                                        selected-label: root.keychain-identity-selected-label;
                                        placeholder-text: root.keychain-identity-options.length == 0 ? "No keychain identity available" : "Select identity";
                                        enabled: root.keychain-identity-options.length > 0;

                                        toggle-requested => {
                                            root.open-select-options = root.keychain-identity-options;
                                            root.open-select(
                                                "keychain_identity_label",
                                                self.absolute-position.x - root.absolute-position.x,
                                                self.absolute-position.y - root.absolute-position.y,
                                                self.width,
                                                root.open-select-options.length,
                                                0
                                            );
                                        }
                                    }
                                }
                            }
                            Text {
                                width: parent.width;
                                text: "Username";
                                color: ThemeTokens.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }

                            Text {
                                width: parent.width;
                                text: root.keychain-identity-username == "" ? "Not selected" : root.keychain-identity-username;
                                color: ThemeTokens.text-primary;
                                wrap: word-wrap;
                            }

                            Text {
                                width: parent.width;
                                text: "Authentication summary";
                                color: ThemeTokens.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }

                            Text {
                                width: parent.width;
                                text: root.keychain-identity-auth-summary == "" ? "Not selected" : root.keychain-identity-auth-summary;
                                color: ThemeTokens.text-primary;
                                wrap: word-wrap;
                            }
                        }

                        if root.auth-source == "manual" && root.auth-method == "password" : DialogTextField {
                            width: parent.width;
                            label: "Password";
                            required: true;
                            value: root.password;
                            password-mode: !root.password-visible;
                            trailing-icon-visible: true;
                            trailing-icon-source: root.password-visible ? root.eye-off-icon : root.eye-icon;
                            trailing-icon-label: root.password-visible ? "Hide password" : "Show password";
                            helper-text: "Use the keychain source above if you want this secret managed outside the connection profile.";

                            value-changed(value) => {
                                root.draft-changed("password", value);
                            }

                            trailing-icon-requested => {
                                root.draft-changed(
                                    "password_visibility",
                                    root.password-visible ? "hidden" : "visible"
                                );
                            }
                        }

                        if root.auth-source == "manual" && root.auth-method == "private-key" : VerticalLayout {
                            width: parent.width;
                            spacing: 12px;

                            if root.private-key-source == "path" : DialogTextField {
                                width: parent.width;
                                label: "Legacy file path";
                                required: true;
                                value: root.private-key-path;
                                helper-text: "Paste or import a fresh key below to replace the legacy path reference.";

                                value-changed(value) => {
                                    root.draft-changed("private_key_path", value);
                                }
                            }

                            DialogTextField {
                                width: parent.width;
                                label: "Private key";
                                required: root.private-key-source != "path";
                                multiline: true;
                                value: root.private-key-content;
                                trailing-action-text: "Import";
                                helper-text: "Only the private key is needed here. The public key stays on the server.";

                                value-changed(value) => {
                                    root.draft-changed("private_key_content", value);
                                }

                                trailing-action-requested => {
                                    root.action-requested("import-private-key");
                                }
                            }

                            DialogTextField {
                                width: parent.width;
                                label: "Passphrase";
                                value: root.passphrase;
                                password-mode: !root.passphrase-visible;
                                trailing-icon-visible: true;
                                trailing-icon-source: root.passphrase-visible ? root.eye-off-icon : root.eye-icon;
                                trailing-icon-label: root.passphrase-visible ? "Hide passphrase" : "Show passphrase";

                                value-changed(value) => {
                                    root.draft-changed("passphrase", value);
                                }

                                trailing-icon-requested => {
                                    root.draft-changed(
                                        "passphrase_visibility",
                                        root.passphrase-visible ? "hidden" : "visible"
                                    );
                                }
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Proxy chain";
                        description: root.dense-layout ? "" : "Add a jump host or local proxy only when the target network requires it.";

                        Rectangle {
                            width: parent.width;
                            height: 88px;
                            background: transparent;

                            VerticalLayout {
                                width: parent.width;
                                spacing: 8px;

                                Text {
                                    width: parent.width;
                                    text: "Proxy type";
                                    color: ThemeTokens.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }

                                proxy-type-select := DialogSelectField {
                                    width: parent.width;
                                    height: 34px;
                                    label: "Proxy type";
                                    focus-sequence: root.proxy-type-select-focus-sequence;
                                    open: root.open-select-id == "proxy_type";
                                    selected-label: root.proxy-type == "socks5" ? "SOCKS5"
                                        : root.proxy-type == "http" ? "HTTP"
                                        : root.proxy-type == "ssh-asset" ? "Existing SSH Connection"
                                        : "None";
                                    placeholder-text: "Select proxy type";

                                    toggle-requested => {
                                        root.open-select-options = ["None", "SOCKS5", "HTTP", "Existing SSH Connection"];
                                        root.open-select(
                                            "proxy_type",
                                            self.absolute-position.x - root.absolute-position.x,
                                            self.absolute-position.y - root.absolute-position.y,
                                            self.width,
                                            root.open-select-options.length,
                                            root.proxy-type == "socks5" ? 1
                                                : root.proxy-type == "http" ? 2
                                                : root.proxy-type == "ssh-asset" ? 3
                                                : 0
                                        );
                                    }

                                }

                                Text {
                                    width: parent.width;
                                    text: root.proxy-type == "none"
                                        ? "Add a jump host or local proxy only when the target network requires it."
                                        : "Proxy credentials and upstream targets are grouped here to keep the main connection clean.";
                                    color: ThemeTokens.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.proxy-type == "socks5" || root.proxy-type == "http" : VerticalLayout {
                            width: parent.width;
                            spacing: 12px;

                            if root.compact-layout : VerticalLayout {
                                width: parent.width;
                                spacing: 12px;

                                DialogTextField {
                                    width: parent.width;
                                    label: root.proxy-type == "http" ? "HTTP host" : "SOCKS5 host";
                                    value: root.proxy-socks5-host;

                                    value-changed(value) => {
                                        root.draft-changed("proxy_socks5_host", value);
                                    }
                                }

                                DialogTextField {
                                    width: parent.width;
                                    label: root.proxy-type == "http" ? "HTTP port" : "SOCKS5 port";
                                    value: root.proxy-socks5-port;

                                    value-changed(value) => {
                                        root.draft-changed("proxy_socks5_port", value);
                                    }
                                }
                            }

                            if !root.compact-layout : proxy-host-port-row := Rectangle {
                                width: parent.width;
                                height: max(proxy-host-field.height, proxy-port-field.height);
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    spacing: 14px;

                                    proxy-host-field := DialogTextField {
                                        width: max(0px, parent.width - 156px);
                                        label: root.proxy-type == "http" ? "HTTP host" : "SOCKS5 host";
                                        value: root.proxy-socks5-host;

                                        value-changed(value) => {
                                            root.draft-changed("proxy_socks5_host", value);
                                        }
                                    }

                                    proxy-port-field := DialogTextField {
                                        width: 142px;
                                        label: root.proxy-type == "http" ? "HTTP port" : "SOCKS5 port";
                                        value: root.proxy-socks5-port;

                                        value-changed(value) => {
                                            root.draft-changed("proxy_socks5_port", value);
                                        }
                                    }
                                }
                            }

                            DialogTextField {
                                width: parent.width;
                                label: "Username";
                                value: root.proxy-socks5-username;

                                value-changed(value) => {
                                    root.draft-changed("proxy_socks5_username", value);
                                }
                            }

                            DialogTextField {
                                width: parent.width;
                                label: "Password";
                                value: root.proxy-socks5-password;
                                password-mode: !root.proxy-socks5-password-visible;
                                trailing-icon-visible: true;
                                trailing-icon-source: root.proxy-socks5-password-visible ? root.eye-off-icon : root.eye-icon;
                                trailing-icon-label: root.proxy-socks5-password-visible ? "Hide proxy password" : "Show proxy password";

                                value-changed(value) => {
                                    root.draft-changed("proxy_socks5_password", value);
                                }

                                trailing-icon-requested => {
                                    root.draft-changed(
                                        "proxy_socks5_password_visibility",
                                        root.proxy-socks5-password-visible ? "hidden" : "visible"
                                    );
                                }
                            }
                        }

                        if root.proxy-type == "ssh-asset" : DialogSectionCard {
                            width: parent.width;
                            padding-horizontal: 16px;
                            padding-vertical: 14px;
                            spacing: 10px;
                            surface: ThemeTokens.modal-section-alt-surface;

                            proxy-ssh-select-group := Rectangle {
                                width: parent.width;
                                height: 58px;
                                background: transparent;

                                VerticalLayout {
                                    width: parent.width;
                                    spacing: 10px;

                                    Text {
                                        width: parent.width;
                                        text: "Upstream SSH connection";
                                        color: ThemeTokens.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                    }

                                    proxy-ssh-select := DialogSelectField {
                                        width: parent.width;
                                        height: 34px;
                                        label: "Upstream SSH connection";
                                        focus-sequence: root.proxy-ssh-select-focus-sequence;
                                        open: root.open-select-id == "proxy_ssh_asset_label";
                                        selected-label: root.proxy-ssh-selected-label;
                                        placeholder-text: root.proxy-ssh-options.length == 0 ? "No SSH connection available" : "Select SSH connection";
                                        enabled: root.proxy-ssh-options.length > 0;

                                        toggle-requested => {
                                            root.open-select-options = root.proxy-ssh-options;
                                            root.open-select(
                                                "proxy_ssh_asset_label",
                                                self.absolute-position.x - root.absolute-position.x,
                                                self.absolute-position.y - root.absolute-position.y,
                                                self.width,
                                                root.open-select-options.length,
                                                0
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }

                    DialogFormSection {
                        width: parent.width;
                        title: "Notes";
                        description: root.dense-layout ? "" : "Use this for host purpose, environment, or operator hints instead of overloading the profile name.";

                        DialogTextField {
                            width: parent.width;
                            label: "Remark";
                            value: root.remark;
                            multiline: true;
                            helper-text: "Use this area for host purpose, environment, or operator hints instead of overloading the profile name.";

                            value-changed(value) => {
                                root.draft-changed("remark", value);
                            }
                        }
                    }
                }
            }
        }

        footer := ModalFooterBar {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            content-padding-top: root.dense-layout ? 8px : 14px;
            content-padding-bottom: root.dense-layout ? 8px : 14px;
            content-spacing: 8px;

            if root.feedback-message != "" : DialogInlineBanner {
                width: parent.width;
                tone: root.feedback-state == "busy" ? "busy"
                    : root.feedback-state == "success" ? "success"
                    : root.feedback-state == "error" ? "error"
                    : "neutral";
                message: root.feedback-message;
            }

            if root.feedback-message == "" && root.validation-message != "" : DialogInlineBanner {
                width: parent.width;
                tone: "error";
                message: root.validation-message;
            }

            Rectangle {
                height: 0px;
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 38px;
                spacing: 10px;

                DialogActionButton {
                    width: 92px;
                    label: "Test";
                    enabled: root.connect-family-enabled;

                    clicked => {
                        root.action-requested("test");
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                DialogActionButton {
                    width: 96px;
                    label: "Cancel";

                    clicked => {
                        root.focus-restore-requested();
                        root.close-requested();
                    }
                }

                DialogActionButton {
                    width: 108px;
                    label: "Save";
                    primary: true;
                    enabled: root.can-confirm;

                    clicked => {
                        root.action-requested("save");
                    }
                }
            }
        }

        if root.open-select-id != "" : select-popup-dismiss-layer := TouchArea {
            x: 0px;
            y: header.height;
            width: parent.width;
            height: parent.height - header.height;

            clicked => {
                root.dismiss-open-select();
            }
        }

        if root.open-select-id != "" : select-popup := DialogSelectPopup {
            x: root.select-popup-x;
            y: root.select-popup-y;
            width: root.select-popup-width;
            open: true;
            options: root.open-select-options;
            focus-sequence: root.select-popup-focus-sequence;
            highlighted-index: root.select-popup-highlighted-index;
            popup-max-height: root.select-popup-max-height;
            opens-upward: root.select-popup-opens-upward;

            option-selected(value) => {
                if root.open-select-id == "auth_source" {
                    root.draft-changed(
                        "auth_source",
                        value == "Keychain Identity" ? "keychain-identity" : "manual"
                    );
                } else if root.open-select-id == "keychain_identity_label" {
                    root.draft-changed("keychain_identity_label", value);
                } else if root.open-select-id == "proxy_type" {
                    root.draft-changed(
                        "proxy_type",
                        value == "SOCKS5" ? "socks5"
                            : value == "HTTP" ? "http"
                            : value == "Existing SSH Connection" ? "ssh-asset"
                            : "none"
                    );
                } else if root.open-select-id == "proxy_ssh_asset_label" {
                    root.draft-changed("proxy_ssh_asset_label", value);
                }
                root.dismiss-open-select();
            }

            dismiss-requested => {
                root.dismiss-open-select();
            }

            move-highlight-requested(delta) => {
                if root.open-select-options.length == 0 {
                    return;
                }

                if root.select-popup-highlighted-index < 0 {
                    root.select-popup-highlighted-index = delta > 0 ? 0 : root.open-select-options.length - 1;
                } else {
                    root.select-popup-highlighted-index = max(
                        0,
                        min(
                            root.open-select-options.length - 1,
                            root.select-popup-highlighted-index + delta
                        )
                    );
                }
            }
        }
    }
}
