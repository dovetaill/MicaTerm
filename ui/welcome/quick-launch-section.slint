import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";
import { QuickLaunchCardRow } from "quick-launch-types.slint";
import { QuickLaunchCard } from "quick-launch-card.slint";

export component QuickLaunchSection inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <[QuickLaunchCardRow]> items: [];
    in property <string> empty_text: "No saved SSH connections yet.";
    callback item-activated(string);

    private property <image> empty-icon: @image-url("../../assets/icons/new-tab/open-saved-ssh.svg");

    height: (root.subtitle != "" ? 54px : 42px) + section-body.preferred-height;
    background: transparent;

    section-title := Text {
        x: 0px;
        y: 0px;
        text: root.title;
        color: ThemeTokens.text-primary;
        font-size: 18px;
        font-weight: 700;
    }

    if root.subtitle != "" : Text {
        x: 0px;
        y: 26px;
        width: parent.width;
        text: root.subtitle;
        color: ThemeTokens.text-secondary;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-caption;
        font-weight: AppTypography.ui-font-weight-regular;
    }

    section-body := VerticalLayout {
        x: 0px;
        y: root.subtitle != "" ? 54px : 42px;
        width: parent.width;
        spacing: 8px;

        if root.items.length == 0 : Rectangle {
            width: parent.width;
            height: 104px;
            border-radius: 10px;
            border-width: 1px;
            border-color: ThemeTokens.divider-subtle;
            background: ThemeTokens.assets-surface;

            icon-shell := Rectangle {
                x: 20px;
                y: (parent.height - self.height) / 2;
                width: 52px;
                height: 52px;
                border-radius: 12px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.inspector-surface;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 26px;
                    height: 26px;
                    source: root.empty-icon;
                    image-fit: contain;
                    colorize: ThemeTokens.text-secondary;
                }
            }

            Text {
                x: 92px;
                y: 0px;
                width: parent.width - 120px;
                height: parent.height;
                text: root.empty_text;
                color: ThemeTokens.text-muted;
                font-family: AppTypography.ui-font-family;
                font-size: AppTypography.ui-font-size-body;
                font-weight: AppTypography.ui-font-weight-regular;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        for item in root.items : QuickLaunchCard {
            width: parent.width;
            item: item;

            activated(asset-id) => {
                root.item-activated(asset-id);
            }
        }
    }
}
