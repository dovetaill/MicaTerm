// Minimal launcher surface shown by the workspace new-tab flow.

import { ScrollView } from "std-widgets.slint";
import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";
import { QuickLaunchCardRow, QuickLaunchDetailRow, QuickLaunchGroupRow } from "quick-launch-types.slint";
import { QuickLaunchSection } from "quick-launch-section.slint";

component LauncherPrimaryActionButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    height: 38px;
    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.accent;
    background: button-touch.pressed
        ? ThemeTokens.control-pressed-surface
        : button-touch.has-hover
            ? ThemeTokens.control-hover-surface
            : ThemeTokens.accent;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-family: AppTypography.ui-font-family;
        font-size: AppTypography.ui-font-size-body;
        font-weight: AppTypography.ui-font-weight-medium;
        letter-spacing: 0.08px;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

export component WelcomeView inherits Rectangle {
    in property <[QuickLaunchCardRow]> recent-items: [];
    in property <[QuickLaunchCardRow]> favorite-items: [];
    in property <[QuickLaunchGroupRow]> group-items: [];
    in property <[QuickLaunchCardRow]> visible-group-items: [];
    in property <QuickLaunchDetailRow> selected-detail: {
        asset_id: "",
        title: "",
        subtitle: "",
        environment: "",
        auth_summary: "",
        proxy_summary: "",
        remark: "",
        recent_label: "",
    };
    in property <string> search-query: "";
    callback asset-selected(string);
    callback search-changed(string);
    callback connect-requested(string);
    callback connect-in-new-tab-requested(string);
    callback toggle-favorite-requested(string);
    callback reveal-in-assets-requested(string);
    callback open-saved-ssh-requested();

    background: transparent;

    body-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: scroll-body.width;
        viewport-height: scroll-body.height;

        scroll-body := Rectangle {
            width: body-scroll.visible-width;
            height: max(body-scroll.visible-height, body-column.preferred-height + 48px);
            background: transparent;

            body-column := VerticalLayout {
                x: 28px;
                y: 28px;
                width: parent.width - 56px;
                spacing: 18px;

                header-card := Rectangle {
                    width: parent.width;
                    height: 132px;
                    border-radius: 0px;
                    border-width: 1px;
                    border-color: ThemeTokens.divider-subtle;
                    background: ThemeTokens.assets-surface;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 4px;
                        height: parent.height;
                        background: ThemeTokens.accent;
                    }

                    Text {
                        x: 24px;
                        y: 18px;
                        text: "New Tab";
                        color: ThemeTokens.text-primary;
                        font-size: 30px;
                        font-weight: 700;
                    }

                    Text {
                        x: 24px;
                        y: 58px;
                        width: parent.width - 48px;
                        text: "Open a recent connection or browse saved SSH targets.";
                        color: ThemeTokens.text-secondary;
                        font-family: AppTypography.ui-font-family;
                        font-size: AppTypography.ui-font-size-body;
                        font-weight: AppTypography.ui-font-weight-medium;
                    }

                    open-saved-ssh-button := LauncherPrimaryActionButton {
                        x: 24px;
                        y: 84px;
                        width: 240px;
                        label: "Open Saved SSH Connections";

                        clicked => {
                            root.open-saved-ssh-requested();
                        }
                    }
                }

                QuickLaunchSection {
                    width: parent.width;
                    title: "Recent Connections";
                    subtitle: "Most recently launched saved SSH sessions";
                    items: root.recent-items;
                    empty_text: "No recent SSH connections yet. Use Open Saved SSH Connections to browse your saved hosts.";

                    item-selected(asset-id) => {
                        root.asset-selected(asset-id);
                    }

                    item-activated(asset-id) => {
                        root.connect-requested(asset-id);
                    }

                    toggle-favorite-requested(asset-id) => {
                        root.toggle-favorite-requested(asset-id);
                    }
                }
            }
        }
    }
}
