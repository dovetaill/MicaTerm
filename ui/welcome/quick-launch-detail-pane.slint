import { ThemeTokens } from "../theme/tokens.slint";
import { AppTypography } from "../theme/typography.slint";
import { QuickLaunchDetailRow } from "quick-launch-types.slint";

component QuickLaunchActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    border-radius: 0px;
    border-width: 1px;
    border-color: root.primary ? ThemeTokens.accent : ThemeTokens.divider-subtle;
    background: !root.enabled
        ? ThemeTokens.control-disabled-surface
        : touch.pressed
            ? ThemeTokens.control-pressed-surface
            : touch.has-hover
                ? ThemeTokens.control-hover-surface
                : root.primary
                    ? ThemeTokens.accent
                    : ThemeTokens.control-active-surface;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ThemeTokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.enabled ? 1.0 : 0.5;
    }

    touch := TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

export component QuickLaunchDetailPane inherits Rectangle {
    in property <QuickLaunchDetailRow> detail: {
        asset_id: "",
        title: "",
        subtitle: "",
        environment: "",
        auth_summary: "",
        proxy_summary: "",
        remark: "",
        recent_label: "",
    };
    callback connect-requested(string);
    callback connect-in-new-tab-requested(string);
    callback reveal-in-assets-requested(string);

    private property <bool> has-selection: root.detail.asset_id != "";

    border-radius: 0px;
    border-width: 1px;
    border-color: ThemeTokens.divider-subtle;
    background: ThemeTokens.inspector-surface;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Text {
            text: "Connection Detail";
            color: ThemeTokens.text-primary;
            font-size: 20px;
            font-weight: 700;
        }

        if !root.has-selection : Rectangle {
            width: parent.width;
            height: 184px;
            background: transparent;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Select a saved SSH connection to inspect its environment, auth path, proxy route, and launch actions.";
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: AppTypography.ui-font-size-body;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        if root.has-selection : VerticalLayout {
            width: parent.width;
            spacing: 10px;

            Text {
                width: parent.width;
                text: root.detail.title;
                color: ThemeTokens.text-primary;
                font-size: 22px;
                font-weight: 700;
                wrap: word-wrap;
            }

            Text {
                width: parent.width;
                text: root.detail.subtitle;
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: AppTypography.ui-font-size-body;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: ThemeTokens.divider-subtle;
            }

            Text {
                width: parent.width;
                text: root.detail.environment != ""
                    ? "Environment: " + root.detail.environment
                    : "Environment: Unspecified";
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: AppTypography.ui-font-size-body;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            Text {
                width: parent.width;
                text: "Auth: " + root.detail.auth_summary;
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: AppTypography.ui-font-size-body;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            Text {
                width: parent.width;
                text: "Proxy: " + root.detail.proxy_summary;
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: AppTypography.ui-font-size-body;
                font-weight: AppTypography.ui-font-weight-regular;
                wrap: word-wrap;
            }

            if root.detail.recent_label != "" : Text {
                width: parent.width;
                text: root.detail.recent_label;
                color: ThemeTokens.text-secondary;
                font-family: AppTypography.ui-font-family;
                font-size: AppTypography.ui-font-size-caption;
                font-weight: AppTypography.ui-font-weight-regular;
            }

            if root.detail.remark != "" : Rectangle {
                width: parent.width;
                height: max(60px, remark-text.preferred-height + 18px);
                border-radius: 0px;
                border-width: 1px;
                border-color: ThemeTokens.divider-subtle;
                background: ThemeTokens.assets-surface;

                remark-text := Text {
                    x: 12px;
                    y: 9px;
                    width: parent.width - 24px;
                    text: root.detail.remark;
                    color: ThemeTokens.text-secondary;
                    font-family: AppTypography.ui-font-family;
                    font-size: AppTypography.ui-font-size-body;
                    font-weight: AppTypography.ui-font-weight-regular;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;

                QuickLaunchActionButton {
                    horizontal-stretch: 1;
                    label: "Connect";
                    primary: true;

                    clicked => {
                        root.connect-requested(root.detail.asset_id);
                    }
                }

                QuickLaunchActionButton {
                    horizontal-stretch: 1;
                    label: "Connect in New Tab";

                    clicked => {
                        root.connect-in-new-tab-requested(root.detail.asset_id);
                    }
                }
            }

            QuickLaunchActionButton {
                width: parent.width;
                label: "Reveal in Assets";

                clicked => {
                    root.reveal-in-assets-requested(root.detail.asset_id);
                }
            }
        }
    }
}
