// Shared typography contract for shell UI surfaces.

export global AppTypography {
    out property <string> ui-font-family: "MiSans";
    out property <int> ui-font-weight-regular: 400;
    out property <int> ui-font-weight-medium: 500;
    out property <int> ui-font-weight-semibold: 600;
    out property <length> ui-font-size-body: 13px;
    out property <length> ui-font-size-caption: 12px;
}
