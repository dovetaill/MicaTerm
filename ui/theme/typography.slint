// Shared typography contract for shell UI surfaces.

export global AppTypography {
    out property <string> ui-font-family: "JetBrains Maple Mono";
    out property <int> ui-font-weight-regular: 400;
    out property <int> ui-font-weight-medium: 400;
    out property <int> ui-font-weight-semibold: 400;
    out property <length> ui-font-size-body: 14px;
    out property <length> ui-font-size-caption: 13px;
    out property <length> ui-sidebar-row-height: 30px;
}
