// Central semantic theme tokens shared across the Slint desktop shell.

export global ThemeTokens {
    in property <bool> dark-mode: true;

    out property <brush> accent: dark-mode ? #6f8fb7 : #587daa;
    out property <brush> link-accent: dark-mode ? #7a97bc : #6388b4;
    out property <brush> focus-ring: dark-mode ? #7c9bc3 : #7e9ec5;

    out property <brush> text-primary: dark-mode ? #e6ecf3 : #24303d;
    out property <brush> text-secondary: dark-mode ? #b8c2cf : #49586a;
    out property <brush> text-muted: dark-mode ? #8b98a9 : #677789;
    out property <brush> text-inactive: dark-mode ? #738095 : #7b8a9c;

    out property <brush> window-surface: dark-mode ? #141b23 : #f2f5f8;
    out property <brush> titlebar-background: dark-mode ? #181f27 : #f7f9fc;
    out property <brush> tabbar-background: dark-mode ? #1a222c : #eef2f7;
    out property <brush> sidebar-background: dark-mode ? #18212b : #ebf0f5;
    out property <brush> sidebar-panel-background: dark-mode ? #1b2430 : #f1f5f9;
    out property <brush> terminal-frame-background: dark-mode ? #101924 : #fbfcfd;
    out property <brush> terminal-surface-background: dark-mode ? #0c141c : #f8fafc;
    out property <brush> tab-active-background: dark-mode ? #223040 : #ffffff;
    out property <brush> tab-inactive-background: dark-mode ? #1a222c : #eef2f7;
    out property <brush> tab-hover-background: dark-mode ? #202b38 : #e8edf4;
    out property <brush> tab-active-line: dark-mode ? #7a97bc : #6388b4;
    out property <brush> sidebar-item-hover-background: dark-mode ? #22303d : #e4ebf3;
    out property <brush> sidebar-item-selected-background: dark-mode ? #2a3949 : #dce6f2;
    out property <brush> sidebar-item-selected-border: dark-mode ? #6c88ae66 : #6e8cb333;

    // Compatibility aliases for unchanged shell/modal surfaces outside the redesign slice.
    out property <brush> titlebar-surface: titlebar-background;
    out property <brush> activity-surface: sidebar-background;
    out property <brush> assets-surface: sidebar-panel-background;
    out property <brush> tabbar-surface: tabbar-background;
    out property <brush> tab-active-surface: tab-active-background;
    out property <brush> tab-inactive-surface: tab-inactive-background;
    out property <brush> tab-active-indicator: tab-active-line;
    out property <brush> workspace-surface: terminal-frame-background;
    out property <brush> panel-surface: sidebar-panel-background;
    out property <brush> inspector-surface: sidebar-panel-background;
    out property <brush> utility-panel-surface: dark-mode ? #1c2431 : #f3f6fb;
    out property <brush> utility-panel-header-surface: dark-mode ? #222c39 : #fafcff;
    out property <brush> utility-panel-section-surface: dark-mode ? #141c26 : #f8fbff;
    out property <brush> utility-panel-row-hover-surface: dark-mode ? #243040 : #edf3fb;
    out property <brush> utility-panel-border: dark-mode ? #ffffff24 : #0f172a1c;
    out property <brush> utility-panel-shadow-soft: dark-mode ? #0000001c : #0f172a0c;
    out property <brush> utility-panel-shadow-strong: dark-mode ? #00000034 : #0f172a16;
    out property <brush> utility-panel-glow: dark-mode ? #7da8d916 : #4d80c810;
    out property <brush> utility-panel-progress-track: dark-mode ? #ffffff12 : #0f172a12;
    out property <brush> utility-panel-empty-surface: dark-mode ? #202a38 : #edf3fa;
    out property <brush> conflict-dialog-surface: dark-mode ? #1a2330 : #f2f6fb;
    out property <brush> conflict-dialog-header-surface: dark-mode ? #202a38 : #fbfdff;
    out property <brush> conflict-dialog-section-surface: dark-mode ? #131b26 : #ffffff;
    out property <brush> conflict-dialog-path-surface: dark-mode ? #101822 : #f7faff;
    out property <brush> conflict-dialog-border: dark-mode ? #ffffff2d : #8ea4bf36;
    out property <brush> conflict-dialog-section-border: dark-mode ? #ffffff14 : #8ea4bf20;
    out property <brush> conflict-dialog-shadow-soft: utility-panel-shadow-soft;
    out property <brush> conflict-dialog-shadow-strong: utility-panel-shadow-strong;
    out property <brush> conflict-dialog-glow: dark-mode ? #7da8d914 : #7c9fc90c;
    out property <brush> conflict-dialog-recommended-surface: dark-mode ? #6f9bd4 : #4d80c8;
    out property <brush> conflict-dialog-recommended-hover-surface: dark-mode ? #82abd9 : #5d8cd0;
    out property <brush> conflict-dialog-destructive-border: dark-mode ? #cf9ca5aa : #bc6f7f88;
    out property <brush> conflict-dialog-destructive-surface: dark-mode ? #251d23 : #fbf3f5;
    out property <brush> conflict-dialog-destructive-hover-surface: dark-mode ? #302329 : #f8eaee;
    out property <brush> modal-backdrop: dark-mode ? #030811b8 : #0f172a20;
    out property <brush> modal-surface: dark-mode ? #1a2330 : #f9fbfe;
    out property <brush> modal-header-surface: dark-mode ? #202a37f2 : #fcfdff;
    out property <brush> modal-body-surface: dark-mode ? #18212c : #f8fbff;
    out property <brush> modal-footer-surface: dark-mode ? #1a2330 : #f9fbfe;
    out property <brush> modal-footer-rail-surface: dark-mode ? #243142 : #ffffff;
    out property <brush> modal-footer-rail-border: dark-mode ? #ffffff22 : #cdd8e6;
    out property <brush> modal-section-surface: dark-mode ? #111a25 : #ffffff;
    out property <brush> modal-section-alt-surface: dark-mode ? #15202b : #f5f8fc;
    out property <brush> modal-border: dark-mode ? #ffffff22 : #8ea4bf2e;
    out property <brush> modal-inner-border: dark-mode ? #ffffff12 : #8ea4bf1a;
    out property <brush> modal-shadow-soft: utility-panel-shadow-soft;
    out property <brush> modal-shadow-strong: utility-panel-shadow-strong;
    out property <brush> modal-glow: dark-mode ? #7da8d914 : #4d80c80d;
    out property <brush> modal-section-shadow: dark-mode ? #00000010 : #0f172a08;
    out property <brush> modal-field-surface: dark-mode ? #101923 : #ffffff;
    out property <brush> modal-field-border: dark-mode ? #ffffff16 : #8ea4bf28;
    out property <brush> modal-field-hover-border: dark-mode ? #ffffff20 : #8ea4bf38;
    out property <brush> modal-button-primary-surface: dark-mode ? #6f9bd4 : #4d80c8;
    out property <brush> modal-button-primary-hover-surface: dark-mode ? #82abd9 : #5d8cd0;
    out property <brush> modal-button-primary-pressed-surface: dark-mode ? #5f8cc7 : #3d6db2;
    out property <brush> modal-button-secondary-surface: dark-mode ? #1d2733 : #e8f0fa;
    out property <brush> modal-button-secondary-hover-surface: dark-mode ? #24303f : #dee8f5;
    out property <brush> modal-button-secondary-pressed-surface: dark-mode ? #2a3646 : #d5e1f1;
    out property <brush> modal-button-danger-surface: conflict-dialog-destructive-surface;
    out property <brush> modal-button-danger-hover-surface: conflict-dialog-destructive-hover-surface;
    out property <brush> modal-button-danger-border: conflict-dialog-destructive-border;

    out property <length> modal-radius: 16px;
    out property <length> modal-section-radius: 12px;
    out property <length> modal-control-radius: 10px;
    out property <length> modal-header-height: 58px;
    out property <length> modal-footer-min-height: 72px;

    out property <brush> sidebar-hover-surface: sidebar-item-hover-background;
    out property <brush> sidebar-selected-surface: sidebar-item-selected-background;
    out property <brush> explorer-row-hover-surface: sidebar-item-hover-background;
    out property <brush> explorer-row-selected-surface: sidebar-item-selected-background;

    out property <brush> input-surface: dark-mode ? #161d27 : #ffffff;
    out property <brush> input-border: dark-mode ? #2b3646 : #d7e0ec;
    out property <brush> input-focus-ring: focus-ring;

    out property <brush> divider-subtle: dark-mode ? #ffffff14 : #1c27330f;
    out property <brush> divider-strong: dark-mode ? #ffffff24 : #1c273324;

    out property <brush> control-hover-surface: dark-mode ? #242d3a : #eef3fa;
    out property <brush> control-active-surface: dark-mode ? #1d2632 : #f4f7fb;
    out property <brush> control-pressed-surface: dark-mode ? #2a3545 : #e4edf8;
    out property <brush> control-disabled-surface: dark-mode ? #171d26 : #f2f5f8;
    out property <brush> menu-row-hover-surface: dark-mode ? #252f3d : #edf3fb;
    out property <brush> menu-row-open-surface: dark-mode ? #2c3747 : #e3ebf7;

    out property <brush> status-busy-surface: dark-mode ? #233344 : #e8eef9;
    out property <brush> status-success-surface: dark-mode ? #21372a : #e7f5ea;
    out property <brush> status-error-surface: dark-mode ? #40292e : #fbeaec;
    out property <brush> status-busy-accent: dark-mode ? #7da8d9 : #5f87c0;
    out property <brush> status-success-accent: dark-mode ? #7bc593 : #4d8f66;
    out property <brush> status-error-accent: dark-mode ? #de8b95 : #c36473;
    out property <brush> status-pill-surface: dark-mode ? #202936 : #eef4fb;
    out property <brush> status-pill-border: dark-mode ? #314153 : #d8e2ef;
    out property <brush> danger-hover-surface: dark-mode ? #a73550 : #d84b6a;
    out property <brush> danger-pressed-surface: dark-mode ? #8f2943 : #c53d5c;
    out property <brush> danger-fg: #ffffff;

    out property <brush> terminal-canvas-surface: dark-mode ? #08131d : #f4f6f8;
    out property <brush> terminal-default-fg: dark-mode ? #d7e0e8 : #1f2933;
    out property <brush> terminal-default-bg: dark-mode ? #08131d : #f4f6f8;
    out property <brush> terminal-cursor-fg: dark-mode ? #08131d : #f4f6f8;
    out property <brush> terminal-cursor-bg: dark-mode ? #dce6ee : #24313c;
    out property <brush> terminal-selection-surface: dark-mode ? #7a8fa94a : #7895b33a;
    out property <brush> terminal-scrollbar-track-surface: dark-mode ? #ffffff0c : #1c273308;
    out property <brush> terminal-scrollbar-thumb-surface: dark-mode ? #5a6a79 : #b6c0ca;
    out property <brush> terminal-scrollbar-thumb-active-surface: dark-mode ? #728495 : #9facb8;
}
