// Central color tokens shared across the Slint desktop shell.

export global ThemeTokens {
    in property <bool> dark-mode: true;

    out property <brush> window-surface: dark-mode ? #171a20 : #f4f6fa;
    out property <brush> titlebar-surface: dark-mode ? #202734ee : #edf3fbea;
    out property <brush> activity-surface: dark-mode ? #14181f : #eef2f7;
    out property <brush> assets-surface: dark-mode ? #1a2029 : #f7f9fc;
    out property <brush> workspace-surface: dark-mode ? #101419 : #ffffff;
    out property <brush> inspector-surface: dark-mode ? #1e2632 : #e9eef7;
    out property <brush> terminal-canvas-surface: dark-mode ? #1e1e2e : #eff1f5;
    out property <brush> terminal-default-fg: dark-mode ? #cdd6f4 : #4c4f69;
    out property <brush> terminal-default-bg: dark-mode ? #1e1e2e : #eff1f5;
    out property <brush> terminal-cursor-fg: dark-mode ? #1e1e2e : #eff1f5;
    out property <brush> terminal-cursor-bg: dark-mode ? #cdd6f4 : #4c4f69;
    out property <brush> terminal-selection-surface: dark-mode ? #585b705c : #acb0be70;
    out property <brush> divider-subtle: dark-mode ? #ffffff14 : #0f172a12;
    out property <brush> divider-strong: dark-mode ? #ffffff22 : #0f172a1e;
    out property <brush> control-hover-surface: dark-mode ? #232c39 : #eef3fb;
    out property <brush> control-active-surface: dark-mode ? #283240 : #e7edf7;
    out property <brush> control-pressed-surface: dark-mode ? #314156 : #dbe6f7;
    out property <brush> control-disabled-surface: dark-mode ? #1a212d : #edf1f7;
    out property <brush> explorer-row-hover-surface: dark-mode ? #243041 : #e6edf8;
    out property <brush> explorer-row-selected-surface: dark-mode ? #2b3850 : #dce7f7;
    out property <brush> menu-row-hover-surface: dark-mode ? #2a3648 : #e2ebfa;
    out property <brush> menu-row-open-surface: dark-mode ? #32425a : #d8e6fb;
    out property <brush> status-busy-surface: dark-mode ? #233247 : #dfeaf8;
    out property <brush> status-success-surface: dark-mode ? #1f3528 : #dff3e5;
    out property <brush> status-error-surface: dark-mode ? #3a2327 : #f7dfe2;
    out property <brush> terminal-scrollbar-track-surface: dark-mode ? #31324466 : #ccd0da66;
    out property <brush> terminal-scrollbar-thumb-surface: dark-mode ? #585b70 : #acb0be;
    out property <brush> terminal-scrollbar-thumb-active-surface: dark-mode ? #6c7086 : #9ca0b0;
    out property <brush> terminal-jump-to-latest-surface: dark-mode ? #313244 : #ccd0da;
    out property <brush> terminal-jump-to-latest-hover-surface: dark-mode ? #45475a : #bcc0cc;
    out property <brush> terminal-jump-to-latest-pressed-surface: dark-mode ? #585b70 : #acb0be;
    out property <brush> terminal-jump-to-latest-border: dark-mode ? #6c7086 : #9ca0b0;
    out property <brush> terminal-jump-to-latest-fg: dark-mode ? #cdd6f4 : #4c4f69;
    out property <brush> accent: #4ea1ff;
    out property <brush> text-primary: dark-mode ? #f5f7fb : #101418;
}
