// Central semantic theme tokens shared across the Slint desktop shell.

export global ThemeTokens {
    in property <bool> dark-mode: true;

    out property <brush> accent: dark-mode ? #6f9bd4 : #4d80c8;
    out property <brush> link-accent: dark-mode ? #86b5ea : #2d6fc7;
    out property <brush> focus-ring: dark-mode ? #7099cc : #83aadf;

    out property <brush> text-primary: dark-mode ? #eef3f8 : #0f1722;
    out property <brush> text-secondary: dark-mode ? #b9c3d0 : #3f4d5d;
    out property <brush> text-muted: dark-mode ? #8794a6 : #5f7084;

    out property <brush> window-surface: dark-mode ? #171c24 : #f6f8fb;
    out property <brush> titlebar-surface: dark-mode ? #1b212be8 : #fbfcfeee;
    out property <brush> activity-surface: dark-mode ? #151b24 : #f2f5f9;
    out property <brush> assets-surface: dark-mode ? #181f29 : #f7f9fc;
    out property <brush> tabbar-surface: dark-mode ? #181f28 : #f9fbfe;
    out property <brush> tab-active-surface: dark-mode ? #1f2732 : #ffffff;
    out property <brush> tab-inactive-surface: dark-mode ? #17202a : #f4f7fb;
    out property <brush> tab-active-indicator: dark-mode ? #78a6d9 : #3d77bf;
    out property <brush> workspace-surface: dark-mode ? #10151d : #ffffff;
    out property <brush> panel-surface: dark-mode ? #181f29 : #f5f8fc;
    out property <brush> inspector-surface: panel-surface;

    out property <brush> sidebar-hover-surface: dark-mode ? #232d39 : #edf3fb;
    out property <brush> sidebar-selected-surface: dark-mode ? #293442 : #e4edf9;
    out property <brush> explorer-row-hover-surface: sidebar-hover-surface;
    out property <brush> explorer-row-selected-surface: sidebar-selected-surface;

    out property <brush> input-surface: dark-mode ? #161d27 : #ffffff;
    out property <brush> input-border: dark-mode ? #2b3646 : #d7e0ec;
    out property <brush> input-focus-ring: focus-ring;

    out property <brush> divider-subtle: dark-mode ? #ffffff12 : #0f172a14;
    out property <brush> divider-strong: dark-mode ? #ffffff24 : #0f172a26;

    out property <brush> control-hover-surface: dark-mode ? #242d3a : #eef3fa;
    out property <brush> control-active-surface: dark-mode ? #1d2632 : #f4f7fb;
    out property <brush> control-pressed-surface: dark-mode ? #2a3545 : #e4edf8;
    out property <brush> control-disabled-surface: dark-mode ? #171d26 : #f2f5f8;
    out property <brush> menu-row-hover-surface: dark-mode ? #252f3d : #edf3fb;
    out property <brush> menu-row-open-surface: dark-mode ? #2c3747 : #e3ebf7;

    out property <brush> status-busy-surface: dark-mode ? #233344 : #e8eef9;
    out property <brush> status-success-surface: dark-mode ? #21372a : #e7f5ea;
    out property <brush> status-error-surface: dark-mode ? #40292e : #fbeaec;
    out property <brush> status-busy-accent: dark-mode ? #7da8d9 : #5f87c0;
    out property <brush> status-success-accent: dark-mode ? #7bc593 : #4d8f66;
    out property <brush> status-error-accent: dark-mode ? #de8b95 : #c36473;
    out property <brush> status-pill-surface: dark-mode ? #202936 : #eef4fb;
    out property <brush> status-pill-border: dark-mode ? #314153 : #d8e2ef;
    out property <brush> danger-hover-surface: dark-mode ? #a73550 : #d84b6a;
    out property <brush> danger-pressed-surface: dark-mode ? #8f2943 : #c53d5c;
    out property <brush> danger-fg: #ffffff;

    out property <brush> terminal-canvas-surface: dark-mode ? #07111a : #fbfcfe;
    out property <brush> terminal-default-fg: dark-mode ? #e5ebf5 : #243142;
    out property <brush> terminal-default-bg: dark-mode ? #07111a : #fbfcfe;
    out property <brush> terminal-cursor-fg: dark-mode ? #07111a : #fbfcfe;
    out property <brush> terminal-cursor-bg: dark-mode ? #e5ebf5 : #243142;
    out property <brush> terminal-selection-surface: dark-mode ? #7c92af40 : #95add34d;
    out property <brush> terminal-scrollbar-track-surface: dark-mode ? #ffffff0d : #0f172a0d;
    out property <brush> terminal-scrollbar-thumb-surface: dark-mode ? #4a586a : #bcc8da;
    out property <brush> terminal-scrollbar-thumb-active-surface: dark-mode ? #5c6d82 : #a8b8ce;
}
