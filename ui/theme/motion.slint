// Shared motion durations for lightweight shell reveals and dismissals.

export global MotionTokens {
    out property <duration> drawer-duration: 220ms;
    out property <duration> welcome-duration: 160ms;
    out property <duration> utility-panel-frame-duration: 180ms;
    out property <duration> utility-panel-shadow-duration: 200ms;
    out property <duration> utility-panel-opacity-duration: 150ms;
}
