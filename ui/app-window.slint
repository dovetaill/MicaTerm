    }

    tooltip-overlay := TitlebarTooltip {
        text: titlebar.tooltip-text;
        anchor-x: titlebar.tooltip-anchor-x;
        anchor-y: titlebar.tooltip-anchor-y;
        tooltip-visible: titlebar.tooltip-visible;
        host-width: root.width;
        host-height: root.height;
    }

    sync-feedback-overlay := TitlebarTooltip {
        text: root.sync-feedback-text;
        anchor-x: titlebar.sync-feedback-anchor-x;
        anchor-y: titlebar.sync-feedback-anchor-y;
        tooltip-visible: titlebar.sync-feedback-visible;
        host-width: root.width;
        host-height: root.height;
    }

    sidebar-tooltip-overlay := TitlebarTooltip {
        text: sidebar.tooltip-text;
        anchor-x: sidebar.tooltip-anchor-x;
        anchor-y: sidebar.tooltip-anchor-y;
        anchor-width: sidebar.tooltip-anchor-width;
        tooltip-visible: sidebar.tooltip-visible;
        host-width: root.width;
        host-height: root.height;
        place-right: true;
    }

    quick-browser-tooltip-overlay := TitlebarTooltip {
        text: right-panel.tooltip-text;
        anchor-x: right-panel.tooltip-anchor-x;
        anchor-y: right-panel.tooltip-anchor-y;
        anchor-width: right-panel.tooltip-anchor-width;
        tooltip-visible: right-panel.tooltip-visible;
        host-width: root.width;
        host-height: root.height;
        place-right: false;
    }

    right-panel-revive-tooltip-overlay := TitlebarTooltip {
        text: "Click to expand";
        anchor-x: root.right-panel-revive-tooltip-anchor-x;
        anchor-y: root.right-panel-revive-tooltip-anchor-y;
        anchor-width: root.right-panel-revive-tooltip-anchor-width;
        tooltip-visible: root.right-panel-revive-tooltip-visible;
        host-width: root.width;
        host-height: root.height;
        place-right: false;
    }

