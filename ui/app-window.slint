                        remove-requested(task-id) => {
                            root.transfer-center-remove-requested(task-id);
                        }
                        clear-completed-requested => {
                            root.transfer-center-clear-completed-requested();
                        }
                    }
                }
            }
        }
    }

    resize-grips := WindowResizeGrips {
        width: root.width;
        height: root.height;

        resize-requested(direction) => {
