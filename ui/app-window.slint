    }

    if root.asset-delete-confirm-modal-open : asset-delete-confirm-modal-shell := BlockingModalShell {
        host-titlebar-height: titlebar.height;
        modal-width: 440px;
        modal-height: 268px;
        offset-x: root.blocking-modal-offset-x;
        offset-y: root.blocking-modal-offset-y;

        focus-restore-requested => {
            root.blocking-modal-focus-restore-requested();
        }

        consume-event => {
        }

        asset-delete-confirm-modal-overlay := AssetsDeleteConfirmModal {
            x: 0px;
            y: 0px;
            width: asset-delete-confirm-modal-shell.content-width;
            height: asset-delete-confirm-modal-shell.content-height;
            dialog-title: "Delete Asset";
            target-label: root.asset-delete-confirm-target-label;
            descendant-count: root.asset-delete-confirm-descendant-count;

            close-requested => {
                root.close-asset-modal-requested();
            }

            confirm-requested => {
                root.confirm-delete-asset-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.blocking-modal-drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.blocking-modal-drag-moved(pointer-x, pointer-y);
