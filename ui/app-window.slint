    if root.workspace-paste-warning-modal-open : workspace-paste-warning-modal-shell := BlockingModalShell {
        host-titlebar-height: titlebar.height;
        modal-width: root.workspace-paste-warning-editor-mode ? 760px : 440px;
        modal-height: root.workspace-paste-warning-editor-mode ? 432px : 248px;
        offset-x: root.blocking-modal-offset-x;
        offset-y: root.blocking-modal-offset-y;
        focus-sequence: root.blocking-modal-focus-sequence;

        focus-restore-requested => {
            main-workspace.restore-primary-focus();
            root.blocking-modal-focus-restore-requested();
        }

        consume-event => {
        }

        escape-requested => {
            root.workspace-paste-warning-cancel-requested();
        }

        workspace-paste-warning-modal-overlay := WorkspacePasteWarningModal {
            x: 0px;
            y: 0px;
            width: workspace-paste-warning-modal-shell.content-width;
            height: workspace-paste-warning-modal-shell.content-height;
            line-count: root.workspace-paste-warning-line-count;
            editor-mode: root.workspace-paste-warning-editor-mode;
            paste-text <=> root.workspace-paste-warning-text;
            focus-sequence: root.workspace-paste-warning-focus-sequence;

            confirm-requested => {
                root.workspace-paste-warning-confirm-requested();
            }

            cancel-requested => {
                root.workspace-paste-warning-cancel-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.blocking-modal-drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.blocking-modal-drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.blocking-modal-drag-ended();
            }

            focus-restore-requested => {
                main-workspace.restore-primary-focus();
                root.blocking-modal-focus-restore-requested();
            }
        }
    }

    if root.sftp-conflict-modal-open : sftp-conflict-modal-shell := BlockingModalShell {
        host-titlebar-height: titlebar.height;
        modal-width: 560px;
        modal-height: 432px;
        modal-radius: 18px;
        modal-surface: ThemeTokens.conflict-dialog-surface;
        modal-border-color: ThemeTokens.conflict-dialog-border;
        modal-shadow-soft: ThemeTokens.conflict-dialog-shadow-soft;
        modal-shadow-strong: ThemeTokens.conflict-dialog-shadow-strong;
        modal-glow: ThemeTokens.conflict-dialog-glow;
        offset-x: root.blocking-modal-offset-x;
        offset-y: root.blocking-modal-offset-y;
        focus-sequence: root.blocking-modal-focus-sequence;

        focus-restore-requested => {
            main-workspace.restore-primary-focus();
            root.blocking-modal-focus-restore-requested();
        }

        consume-event => {
        }

        escape-requested => {
            root.sftp-conflict-modal-close-requested();
        }

        sftp-conflict-modal-overlay := SftpConflictModal {
            x: 0px;
            y: 0px;
            width: sftp-conflict-modal-shell.content-width;
            height: sftp-conflict-modal-shell.content-height;
            kind: root.sftp-conflict-modal-kind;
            source-path: root.sftp-conflict-modal-source-path;
            target-path: root.sftp-conflict-modal-target-path;
            batch-conflict-count: root.sftp-conflict-modal-batch-conflict-count;
            apply-to-batch: root.sftp-conflict-modal-apply-to-batch;
            focus-sequence: root.sftp-conflict-modal-focus-sequence;

            close-requested => {
                root.sftp-conflict-modal-close-requested();
            }

            apply-to-batch-toggled(value) => {
                root.sftp-conflict-modal-apply-to-batch-toggled(value);
            }

            replace-requested => {
                root.sftp-conflict-modal-replace-requested();
            }

            skip-requested => {
                root.sftp-conflict-modal-skip-requested();
            }

            auto-rename-requested => {
                root.sftp-conflict-modal-auto-rename-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.blocking-modal-drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.blocking-modal-drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.blocking-modal-drag-ended();
            }

            focus-restore-requested => {
                main-workspace.restore-primary-focus();
                root.blocking-modal-focus-restore-requested();
            }
        }
    }

    if root.sftp-remote-file-modal-open : sftp-remote-file-modal-shell := BlockingModalShell {
        host-titlebar-height: titlebar.height;
        modal-width: 860px;
        modal-height: 620px;
        offset-x: root.blocking-modal-offset-x;
        offset-y: root.blocking-modal-offset-y;
        focus-sequence: root.blocking-modal-focus-sequence;

        focus-restore-requested => {
            main-workspace.restore-primary-focus();
            root.blocking-modal-focus-restore-requested();
        }

        consume-event => {
        }

        escape-requested => {
            root.sftp-remote-file-modal-close-requested();
        }

        sftp-remote-file-modal-overlay := SftpRemoteFileModal {
            x: 0px;
            y: 0px;
            width: sftp-remote-file-modal-shell.content-width;
            height: sftp-remote-file-modal-shell.content-height;
            dialog-title: root.sftp-remote-file-modal-title;
            remote-path: root.sftp-remote-file-modal-path;
            content <=> root.sftp-remote-file-modal-content;
            status-text: root.sftp-remote-file-modal-status-text;
            error-text: root.sftp-remote-file-modal-error-text;
            can-save: root.sftp-remote-file-modal-can-save;
            focus-sequence: root.blocking-modal-focus-sequence;

            close-requested => {
                root.sftp-remote-file-modal-close-requested();
            }

            save-requested => {
                root.sftp-remote-file-modal-save-requested();
            }

            content-changed(value) => {
                root.sftp-remote-file-modal-content-changed(value);
            }

            drag-requested(pointer-x, pointer-y) => {
                root.blocking-modal-drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.blocking-modal-drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.blocking-modal-drag-ended();
            }

            focus-restore-requested => {
                main-workspace.restore-primary-focus();
                root.blocking-modal-focus-restore-requested();
            }
        }
    }

    if root.context-menu-feedback-text != "" : StatusPill {
        x: min(root.width - self.width - 16px, assets-context-menu-overlay.x);
        y: max(16px, assets-context-menu-overlay.y - self.height - 8px);
        width: 280px;
        label: root.context-menu-feedback-text;
    }
}
