    asset-modal-dismiss-layer := TouchArea {
        x: 0px;
        y: titlebar.height;
        width: root.width;
        height: root.height - titlebar.height;
        enabled: root.sync-modal-open || root.settings-modal-open || root.asset-modal-open || root.asset-rename-modal-open || root.asset-delete-confirm-modal-open || root.ssh-host-key-modal-open || root.workspace-paste-warning-modal-open || root.open-saved-ssh-modal-open || root.sftp-conflict-modal-open || root.sftp-remote-file-modal-open;

        clicked => { }
    }

    if root.open-saved-ssh-modal-open : open-saved-ssh-modal-shell := BlockingModalShell {
        host-titlebar-height: titlebar.height;
        modal-width: 620px;
        modal-height: 600px;
        offset-x: root.blocking-modal-offset-x;
        offset-y: root.blocking-modal-offset-y;
        focus-sequence: root.blocking-modal-focus-sequence;

        focus-restore-requested => {
            main-workspace.restore-primary-focus();
            root.blocking-modal-focus-restore-requested();
        }

        consume-event => {
        }

        escape-requested => {
            root.open-saved-ssh-modal-close-requested();
        }

        open-saved-ssh-modal-overlay := OpenSavedSshModal {
            x: 0px;
            y: 0px;
            width: open-saved-ssh-modal-shell.content-width;
            height: open-saved-ssh-modal-shell.content-height;
            query: root.open-saved-ssh-modal-query;
            items: root.open-saved-ssh-modal-items;

            close-requested => {
                root.open-saved-ssh-modal-close-requested();
            }

            query-changed(value) => {
                root.open-saved-ssh-modal-query-changed(value);
            }

            asset-selected(item-id) => {
                root.open-saved-ssh-modal-asset-selected(item-id);
            }

            asset-activated(item-id) => {
                root.open-saved-ssh-modal-asset-activated(item-id);
            }

            toggle-expanded-requested(item-id) => {
                root.open-saved-ssh-modal-toggle-expanded-requested(item-id);
            }

            drag-requested(pointer-x, pointer-y) => {
                root.blocking-modal-drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.blocking-modal-drag-moved(pointer-x, pointer-y);
            }

            drag-ended => {
                root.blocking-modal-drag-ended();
            }

            focus-restore-requested => {
                main-workspace.restore-primary-focus();
                root.blocking-modal-focus-restore-requested();
            }
        }
    }

    if root.sync-modal-open : sync-modal-shell := BlockingModalShell {
        host-titlebar-height: titlebar.height;
        modal-width: 640px;
        modal-height: 680px;
        offset-x: root.blocking-modal-offset-x;
        offset-y: root.blocking-modal-offset-y;
        focus-sequence: root.blocking-modal-focus-sequence;

        focus-restore-requested => {
            main-workspace.restore-primary-focus();
            root.blocking-modal-focus-restore-requested();
        }

        consume-event => {
        }

        escape-requested => {
            root.sync-modal-close-requested();
        }

        sync-vault-modal-overlay := SyncVaultModal {
            x: 0px;
            y: 0px;
            width: sync-modal-shell.content-width;
            height: sync-modal-shell.content-height;
            mode: root.sync-modal-mode;
            title: root.sync-modal-title;
            headline: root.sync-modal-headline;
            status-text: root.sync-modal-status-text;
            error-text: root.sync-modal-error-text;
            provider-label: root.sync-modal-provider-label;
            target-label: root.sync-modal-target-label;
            conflict-count: root.sync-modal-conflict-count;
            conflict-summary: root.sync-modal-conflict-summary;
            primary-action-label: root.sync-modal-primary-action-label;
            secondary-action-label: root.sync-modal-secondary-action-label;
            git-remote-url: root.sync-modal-git-remote-url;
            git-branch: root.sync-modal-git-branch;
            git-auth-mode: root.sync-modal-git-auth-mode;
