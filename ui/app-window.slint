    shell-body-empty-search-dismiss-layer := TouchArea {
        x: sidebar.width;
        y: titlebar.height;
        width: root.width - sidebar.width;
        height: root.height - titlebar.height;
        enabled: root.asset-search-expanded && root.assets-search-query == "";

        clicked => {
            root.collapse-assets-search-requested();
        }
    }

    assets-create-menu-dismiss-layer := TouchArea {
        x: 0px;
        y: titlebar.height;
        width: root.width;
        height: root.height - titlebar.height;
        enabled: root.asset-create-menu-open;

        clicked => {
            root.close-assets-create-menu-requested();
        }
    }

    assets-create-menu-overlay := AssetsCreateMenu {
        visible: root.asset-create-menu-open;
        x: sidebar.create-menu-anchor-x + sidebar.create-menu-anchor-width - self.width;
        y: sidebar.create-menu-anchor-y + sidebar.create-menu-anchor-height + 6px;
        active-panel: root.active-sidebar-destination;

        close-requested => {
            root.close-assets-create-menu-requested();
