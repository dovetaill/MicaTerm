    in-out property <string> asset-ssh-modal-port: "22";
    in-out property <string> asset-ssh-modal-auth-source: "manual";
    in-out property <[string]> asset-ssh-modal-keychain-identity-options: [];
    in-out property <string> asset-ssh-modal-keychain-identity-selected-label: "";
