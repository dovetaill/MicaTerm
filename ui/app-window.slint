            root.blocking-modal-offset-x = 0px;
            root.blocking-modal-offset-y = 0px;
            root.blocking-modal-focus-sequence = root.blocking-modal-focus-sequence + 1;
        }
    }

    changed assets-context-menu-open => {
        if root.assets-context-menu-open {
            assets-context-menu-overlay.focus-menu();
        }
    }

    // The shell frame owns the full frameless surface so Rust can query a single set of geometry
    // exports for titlebar hit-testing and responsive panel layout.
    shell-frame := Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 0px;
        border-width: 1px;
        border-color: ThemeTokens.divider-subtle;
        background: ThemeTokens.window-surface;

        chrome-host := Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 0px;
            clip: true;
            background: transparent;

            titlebar := Titlebar {
                x: 0px;
                y: 0px;
                width: parent.width;
                dark-mode: root.dark-mode;
                sync-modal-open: root.sync-modal-open;
                sync-feedback-text: root.sync-feedback-text;
                sync-feedback-sequence: root.sync-feedback-sequence;
                sync-feedback-running: root.sync-feedback-running;
                show-right-panel: root.effective-show-right-panel;
                transfer-center-open: root.transfer-center-open;
                transfer-queue-total: root.transfer-queue-total;
                transfer-queue-active: root.transfer-queue-active;
                transfer-queue-failed: root.transfer-queue-failed;
                transfer-queue-current-session: root.transfer-queue-current-session;
                show-global-menu: root.show-global-menu;
                workspace-focus-mode: root.workspace-focus-mode;
                is-window-maximized: root.is-window-maximized;
                is-window-active: root.is-window-active;
                is-window-always-on-top: root.is-window-always-on-top;

                drag-requested => {
                    root.drag-requested();
                }

                drag-double-clicked => {
                    root.drag-double-clicked();
                }

                minimize-requested => {
                    root.minimize-requested();
                }

                maximize-toggle-requested => {
                    root.maximize-toggle-requested();
                }

                close-requested => {
                    root.close-requested();
                }

                toggle-right-panel-requested => {
                    root.toggle-right-panel-requested();
                }

                toggle-workspace-focus-mode-requested => {
                    root.toggle-workspace-focus-mode-requested();
                }

                sync-now-requested => {
                    root.sync-now-requested();
                }

                open-transfer-center-requested => {
                    root.open-transfer-center-requested();
                }

                open-sync-modal-requested => {
                    root.open-sync-modal-requested();
                }

                toggle-global-menu-requested => {
                    root.toggle-global-menu-requested();
                }

                close-global-menu-requested => {
                    root.close-global-menu-requested();
                }

                open-settings-panel-requested => {
                    root.open-settings-panel-requested();
                }

                open-appearance-panel-requested => {
                    root.open-appearance-panel-requested();
                }

                toggle-theme-mode-requested => {
                    root.toggle-theme-mode-requested();
                }

                toggle-window-always-on-top-requested => {
                    root.toggle-window-always-on-top-requested();
                }
            }

            body-host := Rectangle {
                x: 0px;
                y: titlebar.height;
                width: parent.width;
                height: max(0px, parent.height - titlebar.height);
                background: transparent;

                shell-body := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    sidebar := Sidebar {
                        x: 0px;
                        y: 0px;
                        height: parent.height;
                        items: root.sidebar-items;
                        show-assets-sidebar: root.effective-show-assets-sidebar;
                        assets-sidebar-expanded-width: root.assets-sidebar-expanded-width;
                        active-sidebar-destination: root.active-sidebar-destination;
                        assets-search-query: root.assets-search-query;
                        asset-search-expanded: root.asset-search-expanded;
                        asset-create-menu-open: root.asset-create-menu-open;
                        asset-uses-create-popover: root.asset-uses-create-popover;
                        asset-tree-fully-expanded: root.asset-tree-fully-expanded;
                        asset-view-mode: root.asset-view-mode;
                        asset-primary-create-action-id: root.asset-primary-create-action-id;
                        asset-primary-create-tooltip: root.asset-primary-create-tooltip;
                        asset-search-tooltip: root.asset-search-tooltip;
                        asset-view-mode-tooltip: root.asset-view-mode-tooltip;
                        asset-tree-expansion-tooltip: root.asset-tree-expansion-tooltip;
                        asset-show-tree-controls: root.asset-show-tree-controls;
                        asset-tree-controls-enabled: root.asset-tree-controls-enabled;
                        console-asset-items: root.console-asset-items;
                        snippet-asset-items: root.snippet-asset-items;
                        keychain-asset-items: root.keychain-asset-items;

                        toggle-assets-sidebar-requested => {
                            root.toggle-assets-sidebar-requested();
                        }

                        assets-sidebar-edge-toggle-requested => {
                            root.assets-sidebar-edge-toggle-requested();
                        }

                        assets-sidebar-edge-drag-start-requested(width) => {
                            root.assets-sidebar-edge-drag-start-requested(width);
