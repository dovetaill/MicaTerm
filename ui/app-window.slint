    in-out property <string> asset-ssh-modal-remark: "";
    in-out property <string> asset-ssh-modal-environment: "";
    in-out property <string> asset-ssh-modal-proxy-type: "none";
    in-out property <string> asset-ssh-modal-proxy-socks5-host: "";
    in-out property <string> asset-ssh-modal-proxy-socks5-port: "";
    in-out property <string> asset-ssh-modal-proxy-socks5-username: "";
    in-out property <string> asset-ssh-modal-proxy-socks5-password: "";
    in-out property <bool> asset-ssh-modal-proxy-socks5-password-visible: false;
    in-out property <string> asset-ssh-modal-proxy-ssh-asset-id: "";
    in-out property <[string]> asset-ssh-modal-proxy-ssh-options: [];
    in-out property <string> asset-ssh-modal-proxy-ssh-selected-label: "";
    in-out property <string> asset-ssh-modal-proxy-method: "";
    in-out property <bool> asset-ssh-modal-connect-family-enabled: false;
    in-out property <string> asset-ssh-modal-feedback-state: "idle";
    in-out property <string> asset-ssh-modal-feedback-message: "";
    in-out property <string> asset-ssh-modal-dialog-title: "New SSH Connection";
    in-out property <string> asset-primary-create-action-id: "";
    in-out property <string> asset-primary-create-tooltip: "";
    in-out property <string> asset-search-tooltip: "";
    in-out property <string> asset-view-mode-tooltip: "";
    in-out property <string> asset-tree-expansion-tooltip: "";
    in-out property <bool> asset-show-tree-controls: true;
    in-out property <bool> asset-tree-controls-enabled: true;
    in-out property <length> blocking-modal-offset-x: 0px;
    in-out property <length> blocking-modal-offset-y: 0px;
    in-out property <[ConsoleAssetItem]> console-asset-items: [];
    in-out property <[ConsoleAssetItem]> snippet-asset-items: [];
    in-out property <[ConsoleAssetItem]> keychain-asset-items: [];
    in-out property <string> keychain-identity-modal-name: "";
    in-out property <string> keychain-identity-modal-username: "";
    in-out property <string> keychain-identity-modal-auth-kind: "password";
    in-out property <string> keychain-identity-modal-password: "";
    in-out property <string> keychain-identity-modal-ssh-key-label: "";
    in-out property <string> keychain-identity-modal-remark: "";
    in-out property <string> keychain-ssh-key-modal-name: "";
    in-out property <string> keychain-ssh-key-modal-private-key: "";
    in-out property <string> keychain-ssh-key-modal-public-key: "";
    in-out property <string> keychain-ssh-key-modal-fingerprint: "";
    in-out property <[WorkspaceTabItem]> workspace-tab-items: [];
    in-out property <string> active-workspace-session-id: "";
    in-out property <string> workspace-session-host-mode: "welcome";
    in-out property <string> workspace-session-title: "";
    in-out property <string> workspace-session-subtitle: "";
    in-out property <string> workspace-session-state: "";
    in-out property <string> workspace-session-error-detail: "";
    in-out property <bool> workspace-session-can-reconnect: false;
    in-out property <image> workspace-session-surface-image;
    in-out property <int> workspace-session-rows: 24;
    in-out property <int> workspace-session-cols: 80;
    in-out property <length> workspace-session-cell-width: 10px;
    in-out property <length> workspace-session-cell-height: 22px;
    in-out property <int> workspace-session-cursor-row: 0;
    in-out property <int> workspace-session-cursor-col: 0;
    in-out property <bool> workspace-session-cursor-visible: false;
    in-out property <bool> workspace-session-cursor-blinking: false;
    in-out property <string> workspace-session-cursor-shape: "block";
    in-out property <color> workspace-session-cursor-fg: ThemeTokens.dark-mode ? #11161d : #ffffff;
    in-out property <color> workspace-session-cursor-bg: ThemeTokens.dark-mode ? #7fb7ff : #2563eb;
    in-out property <color> workspace-session-default-fg: ThemeTokens.dark-mode ? #d7dee9 : #1f2328;
    in-out property <color> workspace-session-default-bg: ThemeTokens.dark-mode ? #11161d : #f7f9fc;
    in-out property <bool> workspace-session-mouse-grabbed: false;
    in-out property <[string]> workspace-session-visible-lines: [];
    in-out property <int> workspace-session-surface-seqno: 0;
    in-out property <int> workspace-session-viewport-offset-lines: 0;
    in-out property <int> workspace-session-viewport-max-offset-lines: 0;
    in-out property <bool> workspace-session-viewport-at-bottom: true;
    in-out property <bool> workspace-session-follow-paused: false;
    in-out property <int> workspace-session-pending-output-lines: 0;
    in-out property <bool> workspace-session-selection-active: false;
    in-out property <int> workspace-session-selection-start-row: -1;
    in-out property <int> workspace-session-selection-start-col: -1;
    in-out property <int> workspace-session-selection-end-row: -1;
    in-out property <int> workspace-session-selection-end-col: -1;
    in-out property <bool> assets-context-menu-open: false;
    in-out property <length> assets-context-menu-anchor-x: 0px;
    in-out property <length> assets-context-menu-anchor-y: 0px;
    in-out property <length> assets-context-menu-origin-x: 0px;
    in-out property <length> assets-context-menu-origin-y: 0px;
    in-out property <bool> assets-context-menu-child-flows-left: false;
    in-out property <[AssetsContextMenuItem]> assets-context-menu-primary-items: [];
    in-out property <[AssetsContextMenuItem]> assets-context-menu-secondary-items: [];
    in-out property <[AssetsContextMenuItem]> assets-context-menu-tertiary-items: [];
    in-out property <string> context-menu-feedback-text: "";
    in-out property <string> vault-panel-title: "Sync & Vault";
    in-out property <string> vault-lock-state-label: "Locked";
    in-out property <string> vault-primary-status-label: "Primary not configured";
    in-out property <string> vault-primary-action-label: "Set";
    in-out property <string> vault-secondary-action-label: "Change";
    in-out property <string> vault-tertiary-action-label: "Lock now";
    in-out property <string> vault-sync-now-label: "Sync now";
    in-out property <string> vault-export-bootstrap-label: "Export bootstrap";
    in-out property <string> vault-import-bootstrap-label: "Import bootstrap";
    in-out property <[SidebarNavItem]> sidebar-items: [];
    in-out property <length> shell-body-height-cache: 852px;
    out property <length> layout-titlebar-content-width: titlebar.layout-content-width;
    out property <length> layout-titlebar-nav-zone-width: titlebar.layout-nav-zone-width;
    out property <length> layout-titlebar-window-controls-width: titlebar.layout-window-controls-width;
    out property <length> layout-titlebar-width: titlebar.width;
    out property <length> layout-titlebar-height: titlebar.height;
    out property <length> layout-titlebar-radius: titlebar.layout-radius;
    out property <length> layout-titlebar-border-width: titlebar.layout-border-width;
    out property <length> layout-titlebar-maximize-button-x: titlebar.layout-maximize-button-x;
    out property <length> layout-titlebar-maximize-button-y: titlebar.layout-maximize-button-y;
    out property <length> layout-titlebar-maximize-button-width: titlebar.layout-maximize-button-width;
    out property <length> layout-titlebar-maximize-button-height: titlebar.layout-maximize-button-height;
    out property <length> layout-shell-body-height: shell-frame.height - titlebar.height;
    out property <length> layout-shell-body-actual-height: body-host.height;
    out property <length> layout-shell-body-width: body-host.width;
    out property <length> layout-shell-frame-radius: shell-frame.border-radius;
    out property <length> layout-resize-border-width: root.resize-border-width;
    out property <length> layout-main-workspace-x: main-workspace.x;
    out property <length> layout-main-workspace-width: main-workspace.width;
    out property <length> layout-right-panel-x: right-panel.x;
    out property <length> layout-right-panel-width: right-panel.width;
    out property <length> layout-right-panel-height: right-panel.height;
    out property <length> layout-right-panel-radius: right-panel.layout-radius;
    out property <length> layout-right-panel-border-width: right-panel.layout-border-width;
    out property <length> layout-activity-bar-width: sidebar.activity-bar-width;
    out property <length> layout-assets-sidebar-width: sidebar.assets-sidebar-width;
    out property <length> layout-assets-search-row-height: sidebar.search-row-height;
    out property <length> layout-assets-create-menu-anchor-x: sidebar.create-menu-anchor-x;
    out property <length> layout-assets-create-menu-anchor-y: sidebar.create-menu-anchor-y;
    out property <length> layout-assets-create-menu-anchor-width: sidebar.create-menu-anchor-width;
    out property <length> layout-assets-create-menu-anchor-height: sidebar.create-menu-anchor-height;
    out property <length> layout-assets-context-menu-origin-x: assets-context-menu-overlay.x;
    out property <length> layout-assets-context-menu-origin-y: assets-context-menu-overlay.y;
    out property <length> layout-assets-context-menu-width: assets-context-menu-overlay.width;
    out property <length> layout-assets-context-menu-height: assets-context-menu-overlay.height;

    callback drag-requested();
    callback drag-resize-requested(string);
    callback drag-double-clicked();
    callback minimize-requested();
    callback maximize-toggle-requested();
    callback close-requested();
    callback toggle-right-panel-requested();
    callback open-settings-panel-requested();
    callback open-appearance-panel-requested();
    callback vault-create-requested(string);
    callback vault-unlock-requested(string);
    callback vault-sync-now-requested();
    callback vault-lock-requested();
    callback toggle-global-menu-requested();
    callback close-global-menu-requested();
    callback toggle-theme-mode-requested();
    callback toggle-window-always-on-top-requested();
    callback toggle-assets-sidebar-requested();
    callback sidebar-destination-selected(string);
    callback toggle-assets-search-requested();
    callback assets-search-query-changed(string);
    callback close-assets-search-requested();
    callback collapse-assets-search-requested();
    callback toggle-assets-view-mode-requested();
    callback toggle-assets-tree-expansion-requested();
    callback toggle-assets-create-menu-requested();
    callback close-assets-create-menu-requested();
    callback assets-create-action-selected(string);
    callback close-asset-modal-requested();
    callback confirm-asset-modal-requested();
    callback asset-rename-modal-name-changed(string);
    callback confirm-asset-rename-requested();
    callback confirm-delete-asset-requested();
    callback asset-folder-modal-name-changed(string);
    callback asset-snippet-modal-draft-changed(string, string);
    callback asset-snippet-package-modal-name-changed(string);
    callback asset-ssh-modal-draft-changed(string, string);
    callback asset-ssh-modal-action-requested(string);
    callback keychain-identity-modal-draft-changed(string, string);
    callback keychain-identity-modal-action-requested(string);
    callback keychain-ssh-key-modal-draft-changed(string, string);
    callback keychain-ssh-key-modal-action-requested(string);
    callback ssh-host-key-modal-accept-requested();
    callback ssh-host-key-modal-reject-requested();
    callback workspace-paste-warning-confirm-requested();
    callback workspace-paste-warning-cancel-requested();
    callback blocking-modal-drag-requested(length, length);
    callback blocking-modal-drag-moved(length, length);
    callback blocking-modal-drag-ended();
    callback blocking-modal-focus-restore-requested();
    callback workspace-tab-selected(string);
    callback workspace-tab-close-requested(string);
    callback workspace-session-text-input(string);
    callback workspace-session-key-input(string, bool, bool, bool);
    callback workspace-session-resize-requested(int, int);
    callback workspace-session-copy-selection-requested(int, int, int, int);
    callback workspace-session-selection-changed();
    callback workspace-session-paste-requested();
    callback workspace-session-local-action-requested(string);
    callback workspace-session-scroll-requested(int, int, int, bool, bool, bool);
    callback workspace-session-scroll-thumb-drag-requested(float);
    callback workspace-session-scroll-jump-requested(float);
    callback workspace-session-jump-to-latest-requested();
    callback workspace-session-mouse-input(string, string, int, int, bool, bool, bool);
    callback asset-selected(string);
    callback asset-activated(string);
    callback toggle-expanded-requested(string);
    callback asset-context-menu-requested(string, string, length, length);
    callback shell-interaction-requested();
    callback assets-context-menu-action-invoked(string);
    callback assets-context-menu-key-pressed(string);
    callback assets-context-menu-row-hovered(int, int);
    callback assets-context-menu-pointer-moved(length, length);
    callback close-assets-context-menu-requested();
    callback shell-layout-invalidated(length, length);

    in property <string> window-title: "Mica Term";

    title: root.window-title;
    no-frame: true;
    resize-border-width: 6px;
    always-on-top: root.is-window-always-on-top;
    background: transparent;
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 688px;
    min-height: 640px;

    function sync-shell-body-height() {
        root.shell-body-height-cache = max(0px, root.height - titlebar.height);
    }

    changed width => {
        root.sync-shell-body-height();
        root.shell-layout-invalidated(self.width, self.height);
    }

    changed height => {
        root.sync-shell-body-height();
        root.shell-layout-invalidated(self.width, self.height);
    }

    changed asset-create-menu-open => {
        if root.asset-create-menu-open {
            assets-create-menu-overlay.focus-menu();
        }
    }

    changed asset-modal-open => {
        if root.asset-modal-open {
            root.blocking-modal-offset-x = 0px;
            root.blocking-modal-offset-y = 0px;
        }
    }

    changed asset-rename-modal-open => {
        if root.asset-rename-modal-open {
            root.blocking-modal-offset-x = 0px;
            root.blocking-modal-offset-y = 0px;
        }
    }

    changed asset-delete-confirm-modal-open => {
        if root.asset-delete-confirm-modal-open {
            root.blocking-modal-offset-x = 0px;
            root.blocking-modal-offset-y = 0px;
        }
    }

    changed ssh-host-key-modal-open => {
        if root.ssh-host-key-modal-open {
            root.blocking-modal-offset-x = 0px;
            root.blocking-modal-offset-y = 0px;
        }
    }

    changed workspace-paste-warning-modal-open => {
        if root.workspace-paste-warning-modal-open {
            root.blocking-modal-offset-x = 0px;
            root.blocking-modal-offset-y = 0px;
            root.workspace-paste-warning-focus-sequence = root.workspace-paste-warning-focus-sequence + 1;
        }
    }

    changed assets-context-menu-open => {
        if root.assets-context-menu-open {
            assets-context-menu-overlay.focus-menu();
        }
    }

    // The shell frame owns the full frameless surface so Rust can query a single set of geometry
    // exports for titlebar hit-testing and responsive panel layout.
    shell-frame := Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 0px;
        border-width: 1px;
        border-color: ThemeTokens.divider-subtle;
        background: ThemeTokens.window-surface;

        chrome-host := Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 0px;
            clip: true;
            background: transparent;

            titlebar := Titlebar {
                x: 0px;
                y: 0px;
                width: parent.width;
                dark-mode: root.dark-mode;
                show-right-panel: root.effective-show-right-panel;
                show-global-menu: root.show-global-menu;
                is-window-maximized: root.is-window-maximized;
                is-window-active: root.is-window-active;
                is-window-always-on-top: root.is-window-always-on-top;

                drag-requested => {
                    root.drag-requested();
                }

                drag-double-clicked => {
                    root.drag-double-clicked();
                }

                minimize-requested => {
                    root.minimize-requested();
                }

                maximize-toggle-requested => {
                    root.maximize-toggle-requested();
                }

                close-requested => {
                    root.close-requested();
                }

                toggle-right-panel-requested => {
                    root.toggle-right-panel-requested();
                }

                toggle-global-menu-requested => {
                    root.toggle-global-menu-requested();
                }

                close-global-menu-requested => {
                    root.close-global-menu-requested();
                }

                open-settings-panel-requested => {
                    root.open-settings-panel-requested();
                }

                open-appearance-panel-requested => {
                    root.open-appearance-panel-requested();
                }

                toggle-theme-mode-requested => {
                    root.toggle-theme-mode-requested();
                }

                toggle-window-always-on-top-requested => {
                    root.toggle-window-always-on-top-requested();
                }
            }

            body-host := Rectangle {
                x: 0px;
                y: titlebar.height;
                width: parent.width;
                height: max(0px, parent.height - titlebar.height);
                background: transparent;

                shell-body := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    sidebar := Sidebar {
                        x: 0px;
                        y: 0px;
                        height: parent.height;
                        items: root.sidebar-items;
                        show-assets-sidebar: root.effective-show-assets-sidebar;
                        active-sidebar-destination: root.active-sidebar-destination;
                        assets-search-query: root.assets-search-query;
                        asset-search-expanded: root.asset-search-expanded;
                        asset-create-menu-open: root.asset-create-menu-open;
                        asset-uses-create-popover: root.asset-uses-create-popover;
                        asset-tree-fully-expanded: root.asset-tree-fully-expanded;
                        asset-view-mode: root.asset-view-mode;
                        asset-primary-create-action-id: root.asset-primary-create-action-id;
                        asset-primary-create-tooltip: root.asset-primary-create-tooltip;
                        asset-search-tooltip: root.asset-search-tooltip;
                        asset-view-mode-tooltip: root.asset-view-mode-tooltip;
                        asset-tree-expansion-tooltip: root.asset-tree-expansion-tooltip;
                        asset-show-tree-controls: root.asset-show-tree-controls;
                        asset-tree-controls-enabled: root.asset-tree-controls-enabled;
                        console-asset-items: root.console-asset-items;
                        snippet-asset-items: root.snippet-asset-items;
                        keychain-asset-items: root.keychain-asset-items;

                        toggle-assets-sidebar-requested => {
                            root.toggle-assets-sidebar-requested();
                        }

                        destination-selected(id) => {
                            root.sidebar-destination-selected(id);
                        }

                        toggle-assets-search-requested => {
                            root.toggle-assets-search-requested();
                        }

                        assets-search-query-changed(query) => {
                            root.assets-search-query-changed(query);
                        }

                        close-assets-search-requested => {
                            root.close-assets-search-requested();
                        }

                        collapse-assets-search-requested => {
                            root.collapse-assets-search-requested();
                        }

                        toggle-assets-view-mode-requested => {
                            root.toggle-assets-view-mode-requested();
                        }

                        toggle-assets-tree-expansion-requested => {
                            root.toggle-assets-tree-expansion-requested();
                        }

                        toggle-assets-create-menu-requested => {
