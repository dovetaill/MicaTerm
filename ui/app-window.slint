    in-out property <string> asset-snippet-modal-package: "";
    in-out property <[string]> asset-snippet-modal-package-options: [];
    in-out property <string> asset-snippet-modal-package-selected-label: "";
    in-out property <string> asset-snippet-package-modal-name: "";
    in-out property <bool> asset-rename-modal-open: false;
    in-out property <string> asset-rename-modal-name: "";
    in-out property <string> asset-rename-modal-validation-message: "";
    in-out property <bool> asset-rename-modal-can-confirm: false;
    in-out property <bool> asset-delete-confirm-modal-open: false;
    in-out property <string> asset-delete-confirm-target-label: "";
    in-out property <int> asset-delete-confirm-descendant-count: 0;
    in-out property <bool> ssh-host-key-modal-open: false;
    in-out property <string> ssh-host-key-modal-host: "";
    in-out property <string> ssh-host-key-modal-fingerprint: "";
    in-out property <bool> workspace-paste-warning-modal-open: false;
    in-out property <int> workspace-paste-warning-line-count: 0;
    in-out property <bool> workspace-paste-warning-editor-mode: false;
    in-out property <string> workspace-paste-warning-text: "";
    in-out property <int> workspace-paste-warning-focus-sequence: 0;
    in-out property <string> asset-ssh-modal-name: "";
