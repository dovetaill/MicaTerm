            drag-ended => {
                root.blocking-modal-drag-ended();
            }

            focus-restore-requested => {
                root.blocking-modal-focus-restore-requested();
            }
        }
    }

    if root.ssh-host-key-modal-open : ssh-host-key-modal-shell := BlockingModalShell {
        host-titlebar-height: titlebar.height;
        modal-width: 420px;
        modal-height: 332px;
        offset-x: root.blocking-modal-offset-x;
        offset-y: root.blocking-modal-offset-y;

        focus-restore-requested => {
            root.blocking-modal-focus-restore-requested();
        }

        consume-event => {
        }

        ssh-host-key-modal-overlay := SshHostKeyConfirmModal {
            x: 0px;
            y: 0px;
            width: ssh-host-key-modal-shell.content-width;
            height: ssh-host-key-modal-shell.content-height;
            dialog-title: "Verify Host Key";
            host: root.ssh-host-key-modal-host;
            fingerprint: root.ssh-host-key-modal-fingerprint;

            accept-requested => {
                root.ssh-host-key-modal-accept-requested();
            }

            reject-requested => {
                root.ssh-host-key-modal-reject-requested();
            }

            drag-requested(pointer-x, pointer-y) => {
                root.blocking-modal-drag-requested(pointer-x, pointer-y);
            }

            drag-moved(pointer-x, pointer-y) => {
                root.blocking-modal-drag-moved(pointer-x, pointer-y);
