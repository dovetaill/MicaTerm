                    - (root.effective-show-right-panel ? root.right-panel-expanded-width : 0px)
                    - 36px,
            ),
        ),
        max(
            280px,
            root.width
                - (44px + (root.effective-show-assets-sidebar ? root.assets-sidebar-expanded-width : 0px))
