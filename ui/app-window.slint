                        }

                        transfer-center-close-requested => {
                            root.close-transfer-center-requested();
                        }
                    }

                    if !root.effective-show-right-panel : right-panel-revive-strip := Rectangle {
                        x: parent.width - 12px;
                        y: 0px;
                        width: 12px;
                        height: parent.height;
                        background: revive-touch.has-hover || revive-touch.pressed
                            ? ThemeTokens.control-hover-surface
                            : transparent;

                        revive-touch := TouchArea {
                            changed has-hover => {
                                root.right-panel-revive-tooltip-visible = self.has-hover;
                                if self.has-hover {
                                    root.right-panel-revive-tooltip-anchor-x = parent.absolute-position.x + parent.width / 2;
                                    root.right-panel-revive-tooltip-anchor-y = parent.absolute-position.y + parent.height / 2;
                                    root.right-panel-revive-tooltip-anchor-width = parent.width;
                                }
                            }

                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: MouseCursor.w-resize;

                            clicked => {
                                root.right-panel-revive-tooltip-visible = false;
                                root.right-panel-edge-toggle-requested();
                            }
                        }
                    }

                    if root.transfer-center-open && !root.transfer-center-pinned : transfer-center-outside-dismiss-hitbox := TouchArea {
                        x: 0px;
                        y: titlebar.height;
                        width: parent.width;
                        height: parent.height - titlebar.height;

                        clicked => {
                            root.close-transfer-center-requested();
                        }
                    }

                    transfer-center := TransferCenter {
                        z: 20;
                        x: root.transfer-center-open
                            ? max(
                                sidebar.width + 12px,
                                parent.width - self.width - right-panel.width - 20px,
                            )
                            : parent.width + 24px;
                        y: root.transfer-center-open
                            ? 12px
                            : max(12px, titlebar.layout-transfer-button-anchor-y - 18px);
                        width: root.transfer-center-open
                            ? root.transfer-center-target-width
                            : root.transfer-center-closed-width;
                        height: root.transfer-center-collapsed
                            ? 76px
                            : min(max(320px, min(460px, parent.height - 24px)), max(260px, parent.height - 12px));
                        opacity: root.transfer-center-open ? 1 : 0;
                        animate x { duration: MotionTokens.drawer-duration; easing: ease-out; }
                        animate y { duration: MotionTokens.utility-panel-frame-duration; easing: ease-out; }
                        animate width { duration: MotionTokens.utility-panel-frame-duration; easing: ease-out; }
                        animate height { duration: MotionTokens.utility-panel-frame-duration; easing: ease-out; }
                        animate opacity { duration: MotionTokens.utility-panel-opacity-duration; }
                        open: root.transfer-center-open;
                        pinned: root.transfer-center-pinned;
                        collapsed: root.transfer-center-collapsed;
                        queue-total: root.transfer-queue-total;
                        queued-count: root.transfer-queue-queued;
                        running-count: root.transfer-queue-running;
                        paused-count: root.transfer-queue-paused;
                        failed-count: root.transfer-queue-failed;
                        completed-count: root.transfer-queue-completed;
                        active-filter: root.transfer-center-active-filter;
                        items: root.transfer-center-items;
                        feedback-text: root.transfer-center-feedback-text;
                        feedback-tone: root.transfer-center-feedback-tone;
                        feedback-sequence: root.transfer-center-feedback-sequence;
                        close-requested => {
                            root.close-transfer-center-requested();
                        }
                        pin-toggle-requested => {
                            root.transfer-center-pin-toggle-requested();
                        }
                        collapse-toggle-requested => {
                            root.transfer-center-collapse-toggle-requested();
                        }
                        open-sftp-requested => {
                            root.open-sftp-panel-requested();
                        }
                        filter-toggle-requested(filter-id) => {
                            root.transfer-center-filter-toggle-requested(filter-id);
                        }
                        transfer-row-resume-requested(task-id) => {
                            root.transfer-center-resume-requested(task-id);
                        }
                        transfer-row-restart-requested(task-id) => {
                            root.transfer-center-restart-requested(task-id);
                        }
                        transfer-row-pause-requested(task-id) => {
                            root.transfer-center-pause-requested(task-id);
                        }
                        retry-requested(task-id) => {
